HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# SMTP - Hostinger email (required for contact form)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hola@novamarketing.es
SMTP_PASS=your_email_password_here

# Contact form destination
CONTACT_TO=hola@novamarketing.es

# OpenAI Ads Conversions API (server-side conversion on form submit).
# Sin estas dos variables no se envía nada: el píxel del navegador sigue
# funcionando por su cuenta. La clave es secreta, nunca va al repositorio.
OPENAI_ADS_PIXEL_ID=your_pixel_id_here
OPENAI_ADS_API_KEY=your_conversions_api_key_here
