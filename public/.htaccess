# Nova Marketing - 301 Redirects & WWW Cleanup

# Custom 404 pages (ES + CA)
ErrorDocument 404 /404.html
RewriteCond %{REQUEST_URI} ^/ca/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /ca/404.html [L,R=404]

# Force Non-WWW
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.novamarketing\.es [NC]
RewriteRule ^(.*)$ https://novamarketing.es/$1 [L,R=301]

# Collapse duplicate slashes in the URL path (//foo → /foo) with a 301.
# THE_REQUEST sees the raw request line, so this catches leading // too.
RewriteCond %{THE_REQUEST} \s[^?\s]*// [NC]
RewriteCond %{REQUEST_URI} ^(.*?)//+(.*)$
RewriteRule . https://novamarketing.es%1/%2 [R=301,L]

