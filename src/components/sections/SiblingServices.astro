---
/**
 * SiblingServices.astro — Sección "Todos los servicios" dentro de una página
 * de subservicio (ej. agencia-inmobiliarias/seo). Enlaza a los otros 5
 * subservicios del mismo sector y a la landing pilar del sector.
 * Lee de src/lib/sectors.ts, así que al añadir un sector o servicio nuevo
 * esta sección se actualiza sola en todas las páginas que ya la usan.
 */
import { SECTORS, SERVICES } from '../../lib/sectors';

interface Props {
  lang: 'es' | 'ca';
  currentSector: string;
  currentService: string;
}
const { lang, currentSector, currentService } = Astro.props as Props;

const sector = SECTORS.find(s => s.key === currentSector);
const others = SERVICES.filter(sv => sv.key !== currentService);

const siloSlug = sector ? (lang === 'ca' ? sector.silo.ca : sector.silo.es) : '';
const base = lang === 'ca' ? `/ca/${siloSlug}/` : `/${siloSlug}/`;
const sectorName = sector ? sector.name[lang] : '';

const eyebrow = lang === 'ca' ? 'Tots els serveis' : 'Todos los servicios';
const h2 = lang === 'ca'
  ? `Tots els serveis de màrqueting per a ${sectorName.toLowerCase()}`
  : `Todos los servicios de marketing para ${sectorName.toLowerCase()}`;
const intro = lang === 'ca'
  ? `Aquest servei és una peça més de l’estratègia. Aquesta és la resta de serveis que treballem per a ${sectorName.toLowerCase()}.`
  : `Este servicio es una pieza más de la estrategia. Estos son el resto de servicios que trabajamos para ${sectorName.toLowerCase()}.`;
const pillarLabel = lang === 'ca' ? `Marketing per a ${sectorName}` : `Marketing para ${sectorName}`;
const connector = lang === 'ca' ? 'per a' : 'para';
---

<section class="py-20 sm:py-28 bg-white px-4 sm:px-6 border-t border-black/5">
    <div class="max-w-4xl mx-auto text-center reveal">
        <span class="text-[10px] sm:text-xs font-black uppercase tracking-[0.3em] text-accent mb-4 block">{eyebrow}</span>
        <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tighter uppercase mb-6 text-zinc-900 leading-[0.9]">
            {h2}
        </h2>
        <p class="text-zinc-500 font-light text-sm sm:text-base leading-relaxed max-w-2xl mx-auto mb-10">
            {intro}
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
            {others.map(sv => (
                <a href={`${base}${sv.key}/`} class="bg-white border border-black/5 rounded-full px-6 py-3 text-sm text-zinc-800 shadow-sm hover:border-accent/30 hover:text-accent transition-colors">{sv.label[lang]} {connector} {sectorName}</a>
            ))}
            <a href={base} class="bg-accent/5 border border-accent/20 rounded-full px-6 py-3 text-sm font-bold text-accent shadow-sm hover:bg-accent/10 transition-colors">{pillarLabel}</a>
        </div>
    </div>
</section>
