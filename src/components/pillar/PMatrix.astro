---
/**
 * Matriz 2x2 (p. ej. impacto / esfuerzo) con puntos etiquetados.
 * x e y van de 0 a 100; el cuadrante superior izquierdo es el prioritario.
 */
import '../../styles/pillar.css';

interface Point { label: string; x: number; y: number; }
interface Props { xLabel: string; yLabel: string; quadrants: [string, string, string, string]; points: Point[]; caption?: string; }
const { xLabel, yLabel, quadrants, points, caption } = Astro.props;
---

<figure class="pd-figure reveal">
  <div class="relative bg-white border border-black/5 rounded-3xl p-5 sm:p-7 shadow-[0_20px_60px_rgba(0,0,0,0.05)]">
    <div class="flex gap-3">
      <div class="flex items-center"><span class="text-[10px] font-black uppercase tracking-[0.2em] text-zinc-500 [writing-mode:vertical-rl] rotate-180">{yLabel} →</span></div>
      <div class="flex-1">
        <div class="relative aspect-square sm:aspect-[5/4] grid grid-cols-2 grid-rows-2 gap-1.5">
          {quadrants.map((q, i) => (
            <div class:list={['rounded-xl border p-3 text-[10px] sm:text-[11px] font-black uppercase tracking-wider', i === 0 ? 'bg-accent/15 border-accent/30 text-accent' : i === 3 ? 'bg-zinc-200/70 border-zinc-300 text-zinc-500' : 'bg-zinc-100 border-zinc-200 text-zinc-500']}>{q}</div>
          ))}
          {points.map((p, i) => (
            <span
              class:list={['pd-pop absolute translate-y-1/2 flex items-center gap-1.5', p.x > 55 ? 'flex-row-reverse translate-x-1.5' : '-translate-x-1.5']}
              style={p.x > 55 ? `right:${100 - p.x}%;bottom:${p.y}%;--i:${i}` : `left:${p.x}%;bottom:${p.y}%;--i:${i}`}
            >
              <i class="w-3 h-3 rounded-full bg-accent ring-4 ring-accent/20 flex-shrink-0"></i>
              <span class="text-[10px] sm:text-[11px] font-semibold text-zinc-800 bg-white rounded-md px-1.5 py-0.5 shadow-sm border border-zinc-200 leading-tight whitespace-nowrap">{p.label}</span>
            </span>
          ))}
        </div>
        <div class="text-right mt-2"><span class="text-[10px] font-black uppercase tracking-[0.2em] text-zinc-500">{xLabel} →</span></div>
      </div>
    </div>
  </div>
  {caption && <figcaption class="pd-caption" set:html={caption} />}
</figure>
