---
/**
 * Rejilla de H3 con su texto. `html` admite enlaces internos.
 * variant: card (tarjeta con icono), numbered (01, 02…), check (lista con ✓),
 * rows (filas a dos columnas: título | texto).
 * Si la última fila queda con un hueco (5 tarjetas en 3 columnas, 3 en 2…),
 * se rellena con una tarjeta de contacto que abre el formulario.
 */
import '../../styles/pillar.css';

export interface PCardItem { title: string; html: string; icon?: string; tag?: string; }
interface Props {
  items: PCardItem[];
  cols?: 2 | 3 | 4;
  variant?: 'card' | 'numbered' | 'check' | 'rows';
  tone?: 'white' | 'soft' | 'dark';
  class?: string;
}
const { items, cols = 3, variant = 'card', tone = 'white', class: extra } = Astro.props;
const grid = cols === 2 ? 'md:grid-cols-2' : cols === 4 ? 'md:grid-cols-2 lg:grid-cols-4' : 'md:grid-cols-2 lg:grid-cols-3';
const dark = tone === 'dark';
const cardBg = dark ? 'bg-white/[0.04] border-white/10' : tone === 'soft' ? 'bg-white border-black/5' : 'bg-zinc-50/70 border-black/5';
const titleC = dark ? 'text-white' : 'text-zinc-900';
const bodyC = dark ? 'text-zinc-400' : 'text-zinc-500';
const narrowOverride = /grid-cols-1/.test(extra ?? '');
const withCta = variant !== 'rows' && !narrowOverride && ((cols === 3 && items.length % 3 === 2) || (cols === 2 && items.length % 2 === 1));
const ca = Astro.url.pathname.startsWith('/ca/');
const cta = ca
  ? { kicker: 'Primer pas', title: 'Vols saber per on començar a la teva empresa?', text: 'Revisem el teu cas i et diem quines prioritats tenen més impacte, sense compromís.', btn: 'PARLEM DEL TEU NEGOCI' }
  : { kicker: 'Primer paso', title: '¿Quieres saber por dónde empezar en tu empresa?', text: 'Revisamos tu caso y te decimos qué prioridades tienen más impacto, sin compromiso.', btn: 'HABLEMOS DE TU NEGOCIO' };
---

{variant === 'rows' ? (
  <div class:list={['@container mt-12 reveal overflow-hidden rounded-2xl border', dark ? 'border-white/15 bg-white/[0.03]' : 'border-zinc-200 bg-white shadow-[0_15px_40px_rgba(0,0,0,0.05)]', extra]} role="table">
    {items.map((it, i) => (
      <div
        class:list={['pd-rise grid @2xl:grid-cols-[minmax(0,0.85fr)_minmax(0,1.6fr)]', i > 0 && (dark ? 'border-t border-white/10' : 'border-t border-zinc-200')]}
        style={`--i:${i}`}
        role="row"
      >
        <div class:list={['px-5 sm:px-7 pt-5 pb-1 @2xl:py-6 @2xl:border-r', dark ? '@2xl:bg-white/[0.04] @2xl:border-white/10' : '@2xl:bg-zinc-50 @2xl:border-zinc-200']} role="rowheader">
          <h3 class:list={['text-[15px] sm:text-base font-black tracking-tight leading-snug', titleC]}>{it.title}</h3>
        </div>
        <div class="px-5 sm:px-7 pt-1 pb-5 @2xl:py-6" role="cell">
          <p class:list={['pc-body text-sm sm:text-[15px] font-light leading-relaxed', dark ? 'text-zinc-300' : 'text-zinc-600']} set:html={it.html} />
        </div>
      </div>
    ))}
  </div>
) : (
  <div class:list={['mt-12 grid grid-cols-1 gap-5 sm:gap-6 reveal', grid, extra]}>
    {items.map((it, i) => (
      <div class:list={['pc-card pd-rise border rounded-2xl p-6 sm:p-7 transition-all duration-300 hover:-translate-y-1', dark ? 'hover:border-accent/40' : 'hover:shadow-xl hover:border-accent/15', cardBg]} style={`--i:${i}`}>
        {variant === 'numbered' && <div class="text-3xl font-black tracking-tighter text-accent/80 leading-none mb-4">{String(i + 1).padStart(2, '0')}</div>}
        {variant === 'card' && it.icon && (
          <div class="w-10 h-10 rounded-full bg-accent/10 border border-accent/20 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d={it.icon} /></svg>
          </div>
        )}
        <div class:list={[variant === 'check' && 'flex gap-3']}>
          {variant === 'check' && <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>}
          <div>
            {it.tag && <span class="block text-[10px] font-black uppercase tracking-[0.25em] text-accent mb-2">{it.tag}</span>}
            <h3 class:list={['text-base font-black tracking-tight leading-snug mb-2', titleC]}>{it.title}</h3>
            <p class:list={['pc-body text-sm font-light leading-relaxed', bodyC]} set:html={it.html} />
          </div>
        </div>
      </div>
    ))}
    {withCta && (
      <a
        href="#contacto"
        class="contact-modal-trigger pd-rise group relative overflow-hidden rounded-2xl p-6 sm:p-7 flex flex-col justify-between gap-6 bg-accent text-white shadow-[0_20px_50px_rgba(59,130,246,0.35)] hover:-translate-y-1 transition-all duration-300"
        style={`--i:${items.length}`}
      >
        <span class="absolute -top-16 -right-16 w-48 h-48 rounded-full bg-white/10 blur-2xl group-hover:bg-white/20 transition-colors" aria-hidden="true"></span>
        <span class="relative">
          <span class="block text-[10px] font-black uppercase tracking-[0.3em] text-white/70 mb-3">{cta.kicker}</span>
          <span class="block text-lg sm:text-xl font-black tracking-tight leading-snug mb-2">{cta.title}</span>
          <span class="block text-sm font-light text-white/85 leading-relaxed">{cta.text}</span>
        </span>
        <span class="relative inline-flex items-center gap-3 self-start rounded-full bg-white text-accent px-5 py-3 text-[11px] font-black tracking-widest group-hover:gap-4 transition-all">
          {cta.btn}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-5-5 5 5-5 5"/></svg>
        </span>
      </a>
    )}
  </div>
)}

<script>
  // Luz que sigue al cursor en las tarjetas (solo punteros finos).
  if (matchMedia('(pointer: fine)').matches) {
    document.addEventListener('pointermove', (e) => {
      const card = (e.target as HTMLElement)?.closest?.('.pc-card') as HTMLElement | null;
      if (!card) return;
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - r.left}px`);
      card.style.setProperty('--my', `${e.clientY - r.top}px`);
    }, { passive: true });
  }
</script>
