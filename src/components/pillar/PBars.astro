---
/**
 * Gráfico de barras horizontales. Con `before` dibuja dos barras por fila
 * (antes en gris, después en acento) para comparar resultados reales.
 */
import '../../styles/pillar.css';

interface Row { label: string; value: number; display?: string; before?: number; beforeDisplay?: string; href?: string; note?: string; }
interface Props { rows: Row[]; max?: number; caption?: string; title?: string; legend?: [string, string]; }
const { rows, max, caption, title, legend } = Astro.props;
const top = max ?? Math.max(...rows.map((r) => Math.max(r.value, r.before ?? 0)));
const pct = (v: number) => `${Math.max(2, (v / top) * 100).toFixed(1)}%`;
---

<figure class="pd-figure mt-12 reveal bg-white border border-black/5 rounded-3xl p-6 sm:p-8 shadow-[0_20px_60px_rgba(0,0,0,0.05)]">
  {(title || legend) && (
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
      {title && <p class="text-xs font-black uppercase tracking-[0.2em] text-zinc-900">{title}</p>}
      {legend && (
        <div class="flex gap-4 text-[11px] text-zinc-500">
          <span class="inline-flex items-center gap-1.5"><i class="w-3 h-3 rounded-sm bg-zinc-300"></i>{legend[0]}</span>
          <span class="inline-flex items-center gap-1.5"><i class="w-3 h-3 rounded-sm bg-accent"></i>{legend[1]}</span>
        </div>
      )}
    </div>
  )}
  <div class="space-y-5">
    {rows.map((r, i) => (
      <div>
        <div class="flex items-baseline justify-between gap-4 mb-1.5">
          <span class="text-sm font-semibold text-zinc-800">{r.href ? <a href={r.href} class="hover:text-accent transition-colors underline decoration-zinc-300 underline-offset-2">{r.label}</a> : r.label}</span>
          <span class="text-sm font-black text-accent tabular-nums whitespace-nowrap">{r.display ?? r.value}</span>
        </div>
        {r.before !== undefined && (
          <div class="h-2.5 rounded-full bg-zinc-100 overflow-hidden mb-1" title={r.beforeDisplay}>
            <div class="pd-bar h-full rounded-full bg-zinc-300" style={`width:${pct(r.before)};--i:${i}`}></div>
          </div>
        )}
        <div class="h-2.5 rounded-full bg-zinc-100 overflow-hidden">
          <div class="pd-bar h-full rounded-full bg-gradient-to-r from-accent to-blue-400" style={`width:${pct(r.value)};--i:${i}`}></div>
        </div>
        {r.note && <p class="text-[11px] text-zinc-400 font-light mt-1">{r.note}</p>}
      </div>
    ))}
  </div>
  {caption && <figcaption class="pd-caption !text-left" set:html={caption} />}
</figure>
