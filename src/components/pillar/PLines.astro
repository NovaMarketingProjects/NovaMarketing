---
/**
 * Gráfico de líneas sencillo (valores 0-100) con trazo animado.
 * Pensado para esquemas conceptuales: el pie debe decir si es ilustrativo.
 */
import '../../styles/pillar.css';

interface Series { label: string; points: number[]; color?: string; dashed?: boolean; }
interface Props { series: Series[]; /** Una etiqueta por punto; las vacías no se pintan. */ xLabels?: string[]; marker?: { at: number; label: string }; caption?: string; title?: string; }
const { series, xLabels = [], marker, caption, title } = Astro.props;
const W = 600, H = 260, P = { l: 20, r: 20, t: 20, b: 34 };
const n = Math.max(...series.map((s) => s.points.length));
const x = (i: number) => P.l + (i / (n - 1)) * (W - P.l - P.r);
const y = (v: number) => P.t + (1 - v / 100) * (H - P.t - P.b);
const path = (pts: number[]) => pts.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
const len = (pts: number[]) => pts.reduce((a, v, i) => (i ? a + Math.hypot(x(i) - x(i - 1), y(v) - y(pts[i - 1])) : 0), 0);
---

<figure class="pd-figure mt-12 reveal bg-white border border-black/5 rounded-3xl p-5 sm:p-8 shadow-[0_20px_60px_rgba(0,0,0,0.05)]">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    {title && <p class="text-xs font-black uppercase tracking-[0.2em] text-zinc-900">{title}</p>}
    <div class="flex flex-wrap gap-4 text-[11px] text-zinc-500">
      {series.map((s) => <span class="inline-flex items-center gap-1.5"><i class="w-4 h-0.5 rounded" style={`background:${s.color ?? 'var(--color-accent)'}`}></i>{s.label}</span>)}
    </div>
  </div>
  <svg viewBox={`0 0 ${W} ${H}`} class="w-full h-auto" role="img" aria-label={series.map((s) => s.label).join(' / ')}>
    {[0, 25, 50, 75, 100].map((v) => <line x1={P.l} x2={W - P.r} y1={y(v)} y2={y(v)} stroke="#f4f4f5" />)}
    {marker && (
      <g>
        <line x1={x(marker.at)} x2={x(marker.at)} y1={P.t} y2={H - P.b} stroke="#a1a1aa" stroke-dasharray="4 4" />
        <text x={x(marker.at) + 6} y={P.t + 12} font-size="11" fill="#71717a">{marker.label}</text>
      </g>
    )}
    {series.map((s, i) => (
      <path class={s.dashed ? "pd-rise" : "pd-line"} d={path(s.points)} fill="none" stroke={s.color ?? 'var(--color-accent)'} stroke-width="3" stroke-linecap="round" stroke-linejoin="round"
        stroke-dasharray={s.dashed ? '6 6' : undefined} style={`--len:${len(s.points).toFixed(0)};--i:${i}`} />
    ))}
    {xLabels.map((l, i) => l && <text x={x(i)} y={H - 10} text-anchor={i === 0 ? 'start' : i === n - 1 ? 'end' : 'middle'} font-size="11" fill="#a1a1aa">{l}</text>)}
  </svg>
  {caption && <figcaption class="pd-caption" set:html={caption} />}
</figure>
