---
/**
 * Árbol de arquitectura: raíz, ramas y hojas (p. ej. mapa de una web o
 * reparto de búsquedas por página).
 */
import '../../styles/pillar.css';

interface Branch { label: string; leaves?: string[]; href?: string; }
interface Props { root: string; branches: Branch[]; caption?: string; }
const { root, branches, caption } = Astro.props;
---

<figure class="pd-figure reveal">
  <div class="flex flex-col items-center">
    <div class="pd-pop px-5 py-3 rounded-2xl bg-accent text-white text-sm font-black tracking-tight shadow-lg">{root}</div>
    <div class="w-px h-6 bg-accent/40"></div>
    <div class="w-full relative">
      <div class="hidden md:block absolute top-0 h-px bg-accent/40" style={`left:${50 / branches.length}%;right:${50 / branches.length}%`}></div>
      <div class="pt-grid grid grid-cols-2 gap-3" style={`--c:${branches.length}`}>
        {branches.map((b, i) => (
          <div class="pd-rise flex flex-col items-center" style={`--i:${i + 1}`}>
            <div class="hidden md:block w-px h-5 bg-accent/40"></div>
            <div class="w-full rounded-xl border border-accent/20 bg-accent/5 px-3 py-2.5 text-center text-xs sm:text-sm font-black text-zinc-900 leading-tight">
              {b.href ? <a href={b.href} class="hover:text-accent">{b.label}</a> : b.label}
            </div>
            {b.leaves && (
              <ul class="mt-2 w-full space-y-1.5">
                {b.leaves.map((l) => <li class="rounded-lg bg-white border border-black/5 px-2.5 py-1.5 text-[11px] text-zinc-600 font-light text-center leading-snug">{l}</li>)}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
  {caption && <figcaption class="pd-caption" set:html={caption} />}
</figure>

<style>
  @media (min-width: 768px) { .pt-grid { grid-template-columns: repeat(var(--c), minmax(0, 1fr)); } }
</style>
