---
/**
 * Calculadora de viabilidad de Google Ads: del margen por venta al coste por
 * clic asumible. Los valores iniciales son un EJEMPLO y se pueden mover.
 * Sin JS se ve el ejemplo ya calculado.
 */
import '../../styles/pillar.css';

interface Props {
  ticket?: number;  // € por venta
  margin?: number;  // % de margen bruto
  share?: number;   // % del margen que se destina a captar al cliente
  close?: number;   // % de contactos que acaban en venta
  cvr?: number;     // % de visitas que se convierten en contacto
  caption?: string;
}
const { ticket = 1200, margin = 35, share = 40, close = 25, cvr = 5, caption } = Astro.props;

const eur = (v: number, d = 0) => v.toLocaleString('es-ES', { minimumFractionDigits: d, maximumFractionDigits: d, useGrouping: 'always' } as Intl.NumberFormatOptions) + ' €';
const mSale = (ticket * margin) / 100;
const cpaClient = (mSale * share) / 100;
const cpaLead = (cpaClient * close) / 100;
const cpc = (cpaLead * cvr) / 100;

const inputs = [
  { key: 'ticket', label: 'Valor medio de una venta', value: ticket, min: 50, max: 10000, step: 50, unit: '€' },
  { key: 'margin', label: 'Margen bruto', value: margin, min: 5, max: 90, step: 1, unit: '%' },
  { key: 'share', label: 'Parte del margen para captar al cliente', value: share, min: 5, max: 100, step: 5, unit: '%' },
  { key: 'close', label: 'Contactos que acaban en venta', value: close, min: 1, max: 100, step: 1, unit: '%' },
  { key: 'cvr', label: 'Visitas que se convierten en contacto', value: cvr, min: 0.5, max: 30, step: 0.5, unit: '%' },
];
const outputs = [
  { key: 'mSale', label: 'Margen por venta', value: eur(mSale) },
  { key: 'cpaClient', label: 'Coste máximo por cliente', value: eur(cpaClient) },
  { key: 'cpaLead', label: 'Coste máximo por contacto', value: eur(cpaLead) },
  { key: 'cpc', label: 'Coste por clic asumible', value: eur(cpc, 2), main: true },
];
---

<figure class="pd-figure mt-12 reveal" data-sem-calc>
  <div class="grid lg:grid-cols-[1.1fr_1fr] gap-6 items-stretch">
    <div class="bg-white border border-black/5 rounded-3xl p-6 sm:p-8 shadow-[0_20px_60px_rgba(0,0,0,0.05)]">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-zinc-900 mb-6">Datos del negocio <span class="text-accent">· ejemplo</span></p>
      <div class="space-y-5">
        {inputs.map((f) => (
          <label class="block">
            <span class="flex items-baseline justify-between gap-4 text-sm text-zinc-700">
              <span>{f.label}</span>
              <span class="font-black text-zinc-900 tabular-nums whitespace-nowrap"><output data-out={f.key}>{f.value.toLocaleString('es-ES')}</output> {f.unit}</span>
            </span>
            <input type="range" class="w-full mt-2 accent-accent" data-in={f.key} min={f.min} max={f.max} step={f.step} value={f.value} aria-label={f.label} />
          </label>
        ))}
      </div>
    </div>
    <div class="bg-zinc-950 text-white rounded-3xl p-6 sm:p-8 flex flex-col justify-between">
      <ol class="space-y-4">
        {outputs.map((o, i) => (
          <li class:list={['pd-rise flex items-baseline justify-between gap-4', o.main ? 'pt-2' : 'border-b border-white/10 pb-4']} style={`--i:${i}`}>
            <span class:list={['text-sm', o.main ? 'font-black text-white' : 'font-light text-zinc-300']}>{o.label}</span>
            <span class:list={['font-black tabular-nums whitespace-nowrap', o.main ? 'text-3xl sm:text-4xl text-accent' : 'text-lg text-white']} data-res={o.key}>{o.value}</span>
          </li>
        ))}
      </ol>
      <p class="text-xs text-zinc-400 font-light leading-relaxed mt-6">Si en tus búsquedas el clic cuesta bastante más que esta cifra, antes de invertir hay que mejorar la conversión de la página, revisar el margen o cambiar el enfoque de las campañas.</p>
    </div>
  </div>
  {caption && <figcaption class="pd-caption" set:html={caption} />}
</figure>

<script>
  const fmt = (v: number, d = 0) => v.toLocaleString('es-ES', { minimumFractionDigits: d, maximumFractionDigits: d, useGrouping: 'always' } as Intl.NumberFormatOptions) + ' €';
  function initSemCalc() {
    document.querySelectorAll<HTMLElement>('[data-sem-calc]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = '1';
      const get = (k: string) => Number((root.querySelector(`[data-in="${k}"]`) as HTMLInputElement | null)?.value ?? 0);
      const set = (k: string, v: string) => { const el = root.querySelector(`[data-res="${k}"]`); if (el) el.textContent = v; };
      const update = () => {
        root.querySelectorAll<HTMLInputElement>('[data-in]').forEach((i) => {
          const o = root.querySelector(`[data-out="${i.dataset.in}"]`);
          if (o) o.textContent = Number(i.value).toLocaleString('es-ES');
        });
        const mSale = (get('ticket') * get('margin')) / 100;
        const cpaClient = (mSale * get('share')) / 100;
        const cpaLead = (cpaClient * get('close')) / 100;
        const cpc = (cpaLead * get('cvr')) / 100;
        set('mSale', fmt(mSale));
        set('cpaClient', fmt(cpaClient));
        set('cpaLead', fmt(cpaLead));
        set('cpc', fmt(cpc, 2));
      };
      root.addEventListener('input', update);
    });
  }
  initSemCalc();
  document.addEventListener('astro:page-load', initSemCalc);
</script>
