---
/**
 * Diagrama de flujo: etapas encadenadas con flechas (horizontal en escritorio,
 * vertical en móvil). `highlight` marca la última etapa como objetivo.
 */
import '../../styles/pillar.css';

interface Step { label: string; sub?: string; }
interface Props { steps: Step[]; caption?: string; highlight?: boolean; tone?: 'light' | 'dark'; }
const { steps, caption, highlight = true, tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---

<figure class="pd-figure mt-12 reveal">
  <ol class="flex flex-col md:flex-row items-stretch gap-3 md:gap-0">
    {steps.map((s, i) => {
      const last = i === steps.length - 1;
      return (
        <li class="flex flex-col md:flex-row items-center md:flex-1 min-w-0">
          <div
            class:list={[
              'pd-rise w-full md:w-auto md:flex-1 rounded-2xl border px-4 py-5 text-center h-full flex flex-col justify-center',
              last && highlight ? 'bg-accent border-accent text-white pd-live' : dark ? 'bg-white/5 border-white/10 text-white' : 'bg-white border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.05)]',
            ]}
            style={`--i:${i}`}
          >
            <span class:list={['block text-[10px] font-black tracking-[0.25em] mb-1', last && highlight ? 'text-white/70' : 'text-accent']}>{String(i + 1).padStart(2, '0')}</span>
            <span class:list={['block text-sm font-black tracking-tight leading-snug', !(last && highlight) && !dark && 'text-zinc-900']}>{s.label}</span>
            {s.sub && <span class:list={['block text-xs font-light mt-1 leading-snug', last && highlight ? 'text-white/80' : dark ? 'text-zinc-400' : 'text-zinc-500']}>{s.sub}</span>}
          </div>
          {!last && (
            <span class="pd-rise flex-shrink-0 text-accent py-1 md:py-0 md:px-2" style={`--i:${i}`} aria-hidden="true">
              <svg class="w-5 h-5 rotate-90 md:rotate-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-5-5 5 5-5 5"/></svg>
            </span>
          )}
        </li>
      );
    })}
  </ol>
  {caption && <figcaption class="pd-caption" set:html={caption} />}
</figure>
