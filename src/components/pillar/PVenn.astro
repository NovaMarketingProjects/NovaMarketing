---
/**
 * Diagrama de Venn de tres conjuntos con la intersección destacada.
 */
import '../../styles/pillar.css';

interface SetItem { label: string; sub?: string; href?: string; }
interface Props { sets: [SetItem, SetItem, SetItem]; center: string; caption?: string; }
const { sets, center, caption } = Astro.props;
const pos = [
  { cx: 150, cy: 120, tx: 150, ty: 72 },
  { cx: 230, cy: 120, tx: 262, ty: 100 },
  { cx: 190, cy: 190, tx: 190, ty: 244 },
];
---

<figure class="pd-figure reveal">
  <svg viewBox="40 20 300 280" class="w-full max-w-md mx-auto h-auto" role="img" aria-label={`${sets.map((s) => s.label).join(', ')}: ${center}`}>
    {pos.map((p, i) => (
      <circle class="pd-pop" cx={p.cx} cy={p.cy} r="85" fill="var(--color-accent)" fill-opacity={0.1 + i * 0.03} stroke="var(--color-accent)" stroke-opacity="0.45" stroke-width="1.5" style={`--i:${i};transform-origin:${p.cx}px ${p.cy}px`} />
    ))}
    {sets.map((s, i) => (
      <g class="pd-rise" style={`--i:${i + 1}`}>
        <text x={pos[i].tx} y={pos[i].ty} text-anchor="middle" class="fill-zinc-900" font-size="15" font-weight="900">{s.label}</text>
        {s.sub && <text x={pos[i].tx} y={pos[i].ty + 17} text-anchor="middle" class="fill-zinc-500" font-size="10">{s.sub}</text>}
      </g>
    ))}
    <g class="pd-pop" style="--i:4;transform-origin:190px 145px">
      <circle cx="190" cy="145" r="26" fill="var(--color-accent)" />
      <text x="190" y="149" text-anchor="middle" fill="#fff" font-size="10" font-weight="900">{center}</text>
    </g>
  </svg>
  {caption && <figcaption class="pd-caption" set:html={caption} />}
</figure>
