---
/**
 * Simulación de una página de resultados: la búsqueda se escribe y aparecen
 * los resultados, con el de "tu empresa" destacado. Es una ilustración.
 */
import '../../styles/pillar.css';

interface Result { title: string; url: string; desc: string; highlight?: boolean; label?: string; }
interface Props { query: string; results: Result[]; caption?: string; }
const { query, results, caption } = Astro.props;
---

<figure class="pd-figure reveal">
  <div class="ps-card bg-white border border-black/5 rounded-3xl p-5 sm:p-6 shadow-[0_25px_70px_rgba(0,0,0,0.08)] text-left" aria-hidden="true">
    <div class="flex items-center gap-3 rounded-full border border-zinc-200 px-4 py-2.5 mb-5">
      <svg class="w-4 h-4 text-zinc-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      <span class="ps-query text-sm text-zinc-800 whitespace-nowrap overflow-hidden" style={`--chars:${query.length}`}>{query}</span>
    </div>
    <ul class="space-y-3">
      {results.map((r, i) => (
        <li class:list={['pd-rise rounded-2xl p-3.5 border', r.highlight ? 'border-accent/30 bg-accent/5 ring-4 ring-accent/10' : 'border-transparent']} style={`--i:${i + 8}`}>
          <div class="flex items-center gap-2 mb-0.5">
            <span class="text-[11px] text-zinc-500 truncate">{r.url}</span>
            {r.label && <span class="text-[9px] font-black uppercase tracking-widest text-white bg-accent rounded-full px-2 py-0.5">{r.label}</span>}
          </div>
          <p class:list={['text-[15px] leading-snug', r.highlight ? 'text-accent font-semibold' : 'text-[#1a0dab]']}>{r.title}</p>
          <p class="text-xs text-zinc-500 font-light leading-snug mt-0.5">{r.desc}</p>
        </li>
      ))}
    </ul>
  </div>
  {caption && <figcaption class="pd-caption" set:html={caption} />}
</figure>

<style>
  @keyframes ps-type { from { max-width: 0; } to { max-width: calc(var(--chars) * 1ch); } }
  @keyframes ps-caret { 50% { border-color: transparent; } }
  .ps-query { display: inline-block; border-right: 2px solid var(--color-accent); padding-right: 2px; }
  :global(.reveal.active) .ps-query { animation: ps-type 1.4s steps(var(--chars)) .3s both, ps-caret .8s step-end 6; }
  @media (prefers-reduced-motion: reduce) { :global(.reveal.active) .ps-query { animation: none; } }
</style>
