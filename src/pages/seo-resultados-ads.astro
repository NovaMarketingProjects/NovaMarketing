---
/**
 * Variante CRO "Resultados" — hipótesis: en SEO el freno es la desconfianza,
 * no la oferta. La página antepone resultados, casos reales y la cara del
 * consultor, y deja el detalle del servicio para el final.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { strapiClient, getStrapiImageUrl } from '../lib/strapi';
import LogoMarquee from '../components/sections/LogoMarquee.astro';

let caseStudies: any[] = [];
try {
  const res = await strapiClient.getCaseStudies('es', { limit: 50 });
  const allCases = res?.data?.map((i: any) => i.attributes ?? i) ?? [];
  const seoSlugs = ['seo', 'seo-local', 'consultoria-seo', 'posicionamiento-seo'];
  caseStudies = allCases.filter((cs: any) => {
    if (!cs.slug || !cs.isPublic) return false;
    const cats: any[] = cs.categories || [];
    return cats.some((c: any) => {
      const name: string = (c.name || c.attributes?.name || '').toLowerCase();
      const slug: string = (c.slug || c.attributes?.slug || '').toLowerCase();
      return name.includes('seo') || seoSlugs.includes(slug);
    });
  });
} catch (_) {}

const faqs = [
  {
    q: '¿Con quién voy a trabajar exactamente?',
    a: 'Conmigo. Nova Marketing es una agencia pequeña a propósito: quien analiza tu web, define la estrategia y te da explicaciones es la misma persona. No hay un comercial que vende y un becario que ejecuta.',
  },
  {
    q: '¿Qué pasa si no consigo resultados?',
    a: 'Trabajamos sin permanencia, así que si no ves avances puedes irte cuando quieras. Esa es la garantía real: nos obliga a demostrar el valor cada mes en lugar de atarte por contrato.',
  },
  {
    q: '¿Cómo sé que el trabajo está funcionando?',
    a: 'Con un informe mensual de posiciones y leads, no de impresiones. Lo que miramos es cuánta gente te contacta desde Google, porque es lo único que paga facturas.',
  },
  {
    q: '¿Cuánto tiempo hasta ver los primeros movimientos?',
    a: 'En negocios locales y sectores poco competidos, los primeros movimientos suelen verse sobre los 3 meses. En sectores competidos o con webs grandes, el plazo se alarga y te lo digo antes de empezar.',
  },
];
---

<BaseLayout
  title="▷ Consultor SEO con resultados medibles | Casos reales"
  description="Mira los resultados reales de nuestros clientes en Google 💡 Consultor SEO con informes de posiciones y leads, sin permanencia y con trato directo ✅"
  noIndex={true}
  locale="es"
  hideHeader={true}
  hideFooter={true}
>

<!-- ─── Sending overlay ─── -->
<div id="lp-sending" class="fixed inset-0 z-[200] bg-white flex flex-col items-center justify-center hidden">
  <div class="flex flex-col items-center gap-8 px-8 max-w-sm w-full text-center">
    <div class="w-16 h-16 rounded-full border-4 border-zinc-100 border-t-accent animate-spin"></div>
    <div>
      <div class="text-2xl font-black uppercase tracking-tighter text-black mb-2">Enviando...</div>
      <p class="text-zinc-400 font-light text-sm">Procesando tu solicitud, un momento.</p>
    </div>
    <div class="w-full bg-zinc-100 rounded-full h-1 overflow-hidden">
      <div id="lp-progress" class="h-full bg-accent rounded-full"></div>
    </div>
  </div>
</div>

<!-- ═══ NAV ═══════════════════════════════════════════════════════════ -->
<header class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md border-b border-black/5 py-2 sm:py-3 leading-none">
  <div class="relative w-full px-6 sm:px-12 lg:px-24 flex items-center justify-between h-12 md:h-14 gap-6">
    <a href="#top" class="flex items-center h-full flex-shrink-0">
      <div class="text-[2.8rem] sm:text-[3rem] font-heading font-black tracking-tighter leading-none flex items-center -translate-y-0.5">
        <span class="hover-animate-gradient">nova.</span>
      </div>
    </a>
    <nav class="hidden lg:flex items-center gap-8">
      {[
        { href: '#casos', label: 'Casos reales' },
        { href: '#consultor', label: 'Quién lo hace' },
        { href: '#metodo', label: 'Cómo trabajo' },
        { href: '#faq', label: 'FAQ' },
      ].map(l => (
        <a href={l.href} class="text-[11px] font-bold uppercase tracking-[0.15em] text-zinc-700 hover:text-accent transition-colors whitespace-nowrap">{l.label}</a>
      ))}
    </nav>
    <a href="#solicitar" class="btn-mktg-v5 !py-3 !px-6 !text-[11px] font-black flex-shrink-0">HABLAR CONMIGO</a>
  </div>
</header>

<!-- ═══ HERO: RESULTADOS PRIMERO ══════════════════════════════════════ -->
<section id="top" class="min-h-[100dvh] flex items-center px-4 sm:px-6 relative overflow-hidden bg-white border-b border-black/5 pt-24 pb-14">
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_60%_at_50%_40%,#000_70%,transparent_100%)]"></div>
  <div class="absolute -top-10 right-1/4 w-80 h-80 bg-accent/15 rounded-full blur-3xl opacity-30 animate-pulse"></div>

  <div class="w-full relative z-[2] max-w-6xl mx-auto">
    <div class="grid lg:grid-cols-[1fr_auto] gap-10 lg:gap-14 items-center mb-14">
      <div class="reveal">
        <div class="inline-flex items-center gap-2 bg-accent/10 px-4 py-2 border border-accent/25 rounded-full text-accent text-[10px] font-black uppercase tracking-[0.25em] mb-6">
          <span class="w-2 h-2 bg-accent rounded-full animate-ping"></span>
          Resultados medibles
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl uppercase font-black tracking-tighter leading-[0.9] mb-6 text-zinc-900">
          Esto es lo que<br>pasa cuando el<br><span class="text-mktg-gradient">SEO se hace bien</span>.
        </h1>

        <p class="text-zinc-500 font-light text-base sm:text-lg leading-relaxed mb-8 max-w-xl">
          Medias reales de nuestros clientes tras doce meses de trabajo. Sin permanencia, con informes de leads y hablando siempre con el consultor que lo ejecuta.
        </p>

        <a href="#solicitar" class="inline-block btn-mktg-v5 !py-4 !px-8 text-sm shadow-[0_15px_35px_rgba(37,211,102,0.25)]">
          Quiero resultados así →
        </a>
      </div>

      <!-- Consultor -->
      <div class="hidden lg:block relative reveal">
        <img src="/consultor-marketing-digital.webp" alt="Sergio Galo's, consultor SEO de Nova Marketing" title="Sergio Galo's, consultor SEO de Nova Marketing" class="h-[360px] w-auto object-contain" width="473" height="591" />
        <div class="absolute bottom-4 -left-6 bg-white rounded-xl px-5 py-3 shadow-[0_10px_30px_rgba(0,0,0,0.15)]">
          <div class="text-sm font-black text-zinc-900 leading-tight">Sergio Galo's</div>
          <div class="text-[11px] font-bold text-accent leading-tight mt-0.5">Fundador & Consultor SEO</div>
        </div>
      </div>
    </div>

    <!-- Banda de métricas -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 reveal">
      {[
        { value: '+65%', label: 'Tráfico Orgánico' },
        { value: '-40%', label: 'Coste por Lead' },
        { value: 'x3.5', label: 'ROI a 12 Meses' },
        { value: '+55%', label: 'Posiciones Top 3' },
      ].map((stat, i) => (
        <div class="p-6 sm:p-8 bg-zinc-50 border border-zinc-100/60 rounded-3xl text-center hover:border-accent/20 hover:shadow-xl hover:-translate-y-1 transition-all duration-300" style={`transition-delay: ${i * 80}ms`}>
          <div class="text-3xl sm:text-5xl font-black tracking-tighter text-mktg-gradient leading-none mb-2">{stat.value}</div>
          <div class="text-[9px] font-black uppercase tracking-[0.2em] text-zinc-400">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<LogoMarquee />

<!-- ═══ CASOS DE ÉXITO (arriba, no al final) ══════════════════════════ -->
{caseStudies.length > 0 && (
  <section id="casos" class="py-20 sm:py-28 bg-white border-b border-black/5 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-14 reveal">
        <span class="text-[10px] font-black uppercase tracking-[0.3em] text-accent mb-4 block">Casos reales</span>
        <h2 class="text-3xl sm:text-5xl uppercase tracking-tighter font-black">
          Clientes a los que<br class="hidden sm:inline" /> ya les funciona
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {caseStudies.slice(0, 6).map((cs: any, i: number) => {
          const imageUrl = getStrapiImageUrl(cs.coverImage) || '/agencia-marketing-digital.webp';
          return (
            <a href={`/casos-exito/${cs.slug}/`} class="group block bg-white border border-zinc-100/60 rounded-3xl overflow-hidden hover:border-accent/20 hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 reveal" style={`transition-delay: ${i * 80}ms`}>
              <div class="aspect-[16/10] overflow-hidden bg-zinc-100">
                <img src={imageUrl} alt={cs.title} title={cs.title} class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700" loading="lazy" />
              </div>
              <div class="p-6">
                <h3 class="text-sm font-black uppercase tracking-tight text-zinc-900 mb-2 group-hover:text-accent transition-colors leading-tight line-clamp-2">{cs.title}</h3>
                {cs.excerpt && <p class="text-zinc-500 font-light text-xs line-clamp-2 leading-relaxed">{cs.excerpt}</p>}
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
)}

<!-- ═══ TESTIMONIOS ═══════════════════════════════════════════════════ -->
<section class="py-20 sm:py-28 bg-zinc-50 border-y border-black/5 px-4 sm:px-6">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-14 reveal">
      <h2 class="text-3xl sm:text-5xl uppercase tracking-tighter font-black">Lo que dicen<br class="hidden sm:inline" /> nuestros clientes</h2>
    </div>
    <div class="grid md:grid-cols-2 gap-6">
      {[
        {
          text: 'Nuestro negocio industrial pasó de no existir en Google a estar en primera página. Los presupuestos recibidos se multiplicaron por tres en menos de 8 meses.',
          author: 'Empresa de servicios industriales',
        },
        {
          text: 'Con el SEO local de Nova ocupamos el pack de Google Maps de nuestra zona. La tienda recibe llamadas directas desde Google cada día sin pagar por cada clic.',
          author: 'Comercio de proximidad',
        },
      ].map((t, i) => (
        <div class="p-8 bg-white border border-zinc-100/60 rounded-3xl reveal" style={`transition-delay: ${i * 80}ms`}>
          <div class="flex gap-1 mb-4">
            {[1,2,3,4,5].map(() => (
              <svg class="w-4 h-4 text-accent" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118L2.98 10.1c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.518-4.674z"/></svg>
            ))}
          </div>
          <p class="text-zinc-600 font-light text-sm leading-relaxed mb-5">{t.text}</p>
          <div class="text-[10px] font-black uppercase tracking-widest text-zinc-400">{t.author}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ EL CONSULTOR ══════════════════════════════════════════════════ -->
<section id="consultor" class="py-20 sm:py-28 bg-white px-4 sm:px-6">
  <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
    <div class="reveal order-2 lg:order-1">
      <span class="text-[10px] font-black uppercase tracking-[0.3em] text-accent mb-4 block">Quién lo hace</span>
      <h2 class="text-3xl sm:text-5xl uppercase tracking-tighter font-black mb-6 leading-[0.95]">
        Hablas conmigo,<br>no con un comercial
      </h2>
      <p class="text-zinc-500 font-light text-base leading-relaxed mb-6">
        Soy Sergio, consultor SEO y fundador de Nova Marketing. Analizo tu web, decido la estrategia y respondo cuando algo no sale como esperábamos. Esa continuidad es la diferencia entre una agencia pequeña y una grande: aquí nadie te pasa a otro departamento.
      </p>
      <p class="text-zinc-500 font-light text-base leading-relaxed mb-8">
        Trabajo con pymes de sectores muy distintos —comercio, servicios profesionales, industria y ecommerce— y mido el trabajo en contactos conseguidos, no en impresiones.
      </p>
      <div class="grid sm:grid-cols-3 gap-4">
        {[
          { t: 'Sin permanencia', d: 'Te quedas si funciona' },
          { t: 'Informe mensual', d: 'Posiciones y leads' },
          { t: 'Línea directa', d: 'Con quien ejecuta' },
        ].map(b => (
          <div class="p-5 bg-zinc-50 border border-zinc-100/60 rounded-2xl">
            <div class="text-xs font-black uppercase tracking-tight text-zinc-900 mb-1">{b.t}</div>
            <div class="text-[11px] text-zinc-500 font-light">{b.d}</div>
          </div>
        ))}
      </div>
    </div>
    <div class="reveal order-1 lg:order-2 flex justify-center">
      <img src="/consultor-marketing-digital.webp" alt="Sergio Galo's, fundador y consultor SEO de Nova Marketing" title="Sergio Galo's, fundador y consultor SEO de Nova Marketing" class="w-full max-w-sm h-auto" width="473" height="591" loading="lazy" />
    </div>
  </div>
</section>

<!-- ═══ CÓMO TRABAJO ══════════════════════════════════════════════════ -->
<section id="metodo" class="py-20 sm:py-28 bg-accent px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-14 reveal text-white">
      <span class="text-[10px] font-black uppercase tracking-[0.3em] opacity-70 mb-4 block">El método</span>
      <h2 class="text-3xl sm:text-5xl uppercase tracking-tighter font-black">Cuatro pasos,<br class="hidden sm:inline" /> sin humo</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {[
        { num: '01', title: 'Auditoría', desc: 'Reviso tu web, tu competencia y las búsquedas de tu sector para saber dónde está la oportunidad real.' },
        { num: '02', title: 'Prioridades', desc: 'Definimos qué se toca primero según impacto y esfuerzo. Lo que no mueve la aguja, se descarta.' },
        { num: '03', title: 'Ejecución', desc: 'Técnica, contenidos, SEO local y autoridad. Mes a mes, con un plan que puedes ver y entender.' },
        { num: '04', title: 'Medición', desc: 'Informe mensual de posiciones y contactos conseguidos. Si algo no funciona, se cambia.' },
      ].map((s, i) => (
        <div class="p-7 bg-white/10 backdrop-blur-sm border border-white/15 rounded-3xl text-white reveal" style={`transition-delay: ${i * 80}ms`}>
          <div class="text-4xl font-black opacity-30 leading-none mb-4">{s.num}</div>
          <h3 class="text-base font-black uppercase tracking-tight mb-3 leading-tight">{s.title}</h3>
          <p class="text-sm font-light leading-relaxed opacity-90">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ FAQ ═══════════════════════════════════════════════════════════ -->
<section id="faq" class="py-20 sm:py-28 bg-zinc-50 border-y border-black/5 px-4 sm:px-6">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-12 reveal">
      <h2 class="text-3xl sm:text-4xl uppercase tracking-tighter font-black">Lo que suelen preguntarme</h2>
    </div>
    <div class="space-y-3 reveal">
      {faqs.map(faq => (
        <div class="faq-item bg-white border border-zinc-100/60 rounded-3xl overflow-hidden hover:border-accent/20 transition-colors">
          <button class="faq-trigger w-full text-left px-8 py-6 flex items-center justify-between gap-4" aria-expanded="false">
            <span class="text-sm font-black uppercase tracking-tight text-zinc-900">{faq.q}</span>
            <div class="faq-icon-wrap w-8 h-8 rounded-full bg-zinc-50 border border-zinc-100 flex items-center justify-center flex-shrink-0 transition-all duration-300">
              <svg class="faq-icon w-4 h-4 text-zinc-400 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14M5 12h14"/>
              </svg>
            </div>
          </button>
          <div class="faq-answer hidden px-8 pb-6">
            <p class="text-zinc-500 font-light text-sm leading-relaxed">{faq.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ CTA FINAL ═════════════════════════════════════════════════════ -->
<section id="solicitar" class="py-20 sm:py-32 px-4 sm:px-6 bg-white">
  <div class="max-w-5xl mx-auto grid lg:grid-cols-2 gap-12 items-center">
    <div class="reveal">
      <h2 class="text-4xl sm:text-6xl font-black uppercase tracking-tighter leading-[0.85] mb-6">
        ¿Lo vemos<br>con tu web?
      </h2>
      <p class="text-zinc-500 font-light text-base leading-relaxed mb-8">
        Cuéntame qué vendes y a quién. Te digo con franqueza si el SEO es tu mejor canal ahora mismo o si tu dinero rinde más en otro sitio.
      </p>
      <ul class="space-y-3">
        {['Auditoría inicial sin coste', 'Te digo si te conviene o no', 'Sin permanencia si decidimos trabajar'].map(item => (
          <li class="flex items-center gap-3">
            <div class="w-5 h-5 rounded-full bg-accent/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-3 h-3 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
            <span class="text-sm text-zinc-600 font-light">{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="reveal">
      <div class="bg-white p-8 sm:p-10 border border-zinc-100 shadow-[0_40px_100px_rgba(0,0,0,0.12)] rounded-3xl">
        <form id="resultados-form" class="space-y-5">
          <div class="flex flex-col gap-1.5">
            <label class="text-[8px] font-black uppercase tracking-widest opacity-40">Nombre *</label>
            <input type="text" name="name" required class="border-b border-zinc-300 py-2 focus:border-accent outline-none transition-colors bg-transparent text-sm" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label class="text-[8px] font-black uppercase tracking-widest opacity-40">Email *</label>
            <input type="email" name="email" required class="border-b border-zinc-300 py-2 focus:border-accent outline-none transition-colors bg-transparent text-sm" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label class="text-[8px] font-black uppercase tracking-widest opacity-40">Teléfono</label>
            <input type="tel" name="phone" aria-label="Teléfono" class="border-b border-zinc-300 py-2 focus:border-accent outline-none transition-colors bg-transparent text-sm" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label class="text-[8px] font-black uppercase tracking-widest opacity-40">Web de tu empresa</label>
            <input type="text" name="url" placeholder="www.tuempresa.com" class="border-b border-zinc-300 py-2 focus:border-accent outline-none transition-colors bg-transparent text-sm placeholder:text-zinc-300" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label class="text-[8px] font-black uppercase tracking-widest opacity-40">¿Qué vendes y a quién?</label>
            <textarea name="msg" rows="2" class="border-b border-zinc-300 py-2 focus:border-accent outline-none transition-colors bg-transparent text-sm resize-none"></textarea>
          </div>
          <div class="flex items-start gap-2 pt-2">
            <input type="checkbox" id="res-terms" name="terms" required class="mt-0.5 accent-accent flex-shrink-0" />
            <label for="res-terms" class="text-[9px] text-zinc-500 font-light cursor-pointer select-none leading-tight">
              Acepto la <a href="/privacidad/" class="underline hover:text-accent transition-colors">política de privacidad</a>.
            </label>
          </div>
          <button type="submit" id="resultados-submit" class="w-full btn-mktg-v5 !py-4 text-sm shadow-[0_15px_35px_rgba(37,211,102,0.25)]">
            Hablar con Sergio →
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- ─── Minimal footer ─── -->
<footer class="py-8 bg-zinc-50 border-t border-black/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <span class="font-black text-xl tracking-tighter text-black leading-none">nova.</span>
    <div class="flex items-center gap-6 text-[10px] text-zinc-400 font-light">
      <a href="/privacidad/" class="hover:text-accent transition-colors uppercase tracking-widest font-black">Privacidad</a>
      <a href="/aviso-legal/" class="hover:text-accent transition-colors uppercase tracking-widest font-black">Aviso legal</a>
      <a href="/cookies/" class="hover:text-accent transition-colors uppercase tracking-widest font-black">Cookies</a>
    </div>
    <p class="text-[10px] text-zinc-400 font-light">&copy; {new Date().getFullYear()} Nova Marketing</p>
  </div>
</footer>

</BaseLayout>

<script>
  // FAQ accordion
  document.querySelectorAll('.faq-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item')!;
      const answer = item.querySelector('.faq-answer')!;
      const icon = btn.querySelector('.faq-icon') as SVGElement | null;
      const wrap = btn.querySelector('.faq-icon-wrap')!;
      const isOpen = !answer.classList.contains('hidden');

      document.querySelectorAll('.faq-answer').forEach(a => a.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(i => (i as SVGElement).style.transform = '');
      document.querySelectorAll('.faq-icon-wrap').forEach(w => {
        w.classList.remove('bg-accent', 'border-accent');
        w.classList.add('bg-zinc-50', 'border-zinc-100');
      });
      document.querySelectorAll('.faq-trigger').forEach(b => b.setAttribute('aria-expanded', 'false'));

      if (!isOpen) {
        answer.classList.remove('hidden');
        if (icon) { icon.style.transform = 'rotate(45deg)'; icon.style.color = 'white'; }
        wrap.classList.remove('bg-zinc-50', 'border-zinc-100');
        wrap.classList.add('bg-accent', 'border-accent');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Form submission
  async function handleForm(formId: string, btnId: string) {
    const form = document.getElementById(formId) as HTMLFormElement | null;
    const btn = document.getElementById(btnId) as HTMLButtonElement | null;
    const overlay = document.getElementById('lp-sending');
    const bar = document.getElementById('lp-progress');

    form?.querySelector<HTMLInputElement>('[name="url"]')?.addEventListener('input', (e) => {
      (e.target as HTMLInputElement).setCustomValidity('');
    });
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const urlInput = form.querySelector<HTMLInputElement>('[name="url"]');
      if (urlInput && urlInput.value.trim() && !/\.[a-zA-Z]{2,}/.test(urlInput.value.trim())) {
        urlInput.setCustomValidity('Introduce una URL válida, por ejemplo: miempresa.com');
        urlInput.reportValidity();
        return;
      }
      if (urlInput) urlInput.setCustomValidity('');
      if (btn) btn.disabled = true;
      overlay?.classList.remove('hidden');
      if (bar) {
        setTimeout(() => { bar.style.width = '40%'; }, 50);
        setTimeout(() => { bar.style.width = '72%'; }, 700);
        setTimeout(() => { bar.style.width = '88%'; }, 1800);
      }
      const eventId = (window as any).oaiqNewEventId?.() ?? String(Date.now());
      const data = { ...Object.fromEntries(new FormData(form)), source: window.location.href, eventId };
      try {
        const res = await fetch('https://cms.novamarketing.es/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (res.ok) {
          // La página de gracias emite el evento del píxel con este id.
          try { sessionStorage.setItem('oaiq_event_id', eventId); } catch {}
          if (bar) bar.style.width = '100%';
          setTimeout(() => { window.location.href = '/gracias/'; }, 400);
        } else { throw new Error(); }
      } catch {
        overlay?.classList.add('hidden');
        if (bar) bar.style.width = '0%';
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'ERROR — INTÉNTALO DE NUEVO';
          (btn as HTMLElement).style.background = '#ef4444';
        }
      }
    });
  }

  handleForm('resultados-form', 'resultados-submit');
</script>
