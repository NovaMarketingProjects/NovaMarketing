---
/**
 * Variante CRO "Diagnóstico" — hipótesis: lo que frena la conversión es la
 * fricción del formulario y los puntos de fuga.
 * Página corta sin navegación, un único formulario por pasos que empieza
 * pidiendo la web (micro-compromiso) y deja los datos personales para el final.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoMarquee from '../components/sections/LogoMarquee.astro';

const entregables = [
  {
    t: 'Por qué Google no te posiciona',
    d: 'Los errores técnicos concretos de tu web: indexación, velocidad, móvil y estructura. Con nombre y apellidos, no un informe automático de 40 páginas.',
  },
  {
    t: 'Qué busca tu cliente y quién lo tiene',
    d: 'Las búsquedas reales de tu sector, cuántas hay al mes y qué competidor se las está llevando ahora mismo.',
  },
  {
    t: 'Qué haría yo primero',
    d: 'Las tres acciones con las que empezaría si fuese mi web, ordenadas por impacto. Puedes ejecutarlas tú o con quien quieras.',
  },
];

const faqs = [
  {
    q: '¿Es gratis de verdad o acaba en una factura?',
    a: 'Es gratis y sin compromiso. Dedico un rato a analizar tu web porque es la mejor forma de enseñarte cómo trabajo. Si después quieres que lo ejecutemos nosotros, hablamos. Si no, te quedas el diagnóstico igualmente.',
  },
  {
    q: '¿Me vais a llamar insistiendo?',
    a: 'No. Te envío el diagnóstico y, si quieres comentarlo, lo comentamos. Una llamada, la que tú pidas. No hacemos seguimiento comercial a quien no lo pide.',
  },
  {
    q: '¿Cuánto tardáis en enviarlo?',
    a: 'Normalmente en 48 horas laborables. Si tu caso necesita más análisis porque la web es grande o tienes varias sedes, te aviso antes.',
  },
];
---

<BaseLayout
  title="▷ Diagnóstico SEO gratuito | Por qué tu web no posiciona"
  description="Te digo en 48 h por qué tu web no aparece en Google y qué haría para arreglarlo 💡 Diagnóstico SEO gratuito, sin compromiso y sin seguimiento comercial ✅"
  noIndex={true}
  locale="es"
  hideHeader={true}
  hideFooter={true}
>

<!-- ─── Sending overlay ─── -->
<div id="lp-sending" class="fixed inset-0 z-[200] bg-white flex flex-col items-center justify-center hidden">
  <div class="flex flex-col items-center gap-8 px-8 max-w-sm w-full text-center">
    <div class="w-16 h-16 rounded-full border-4 border-zinc-100 border-t-accent animate-spin"></div>
    <div>
      <div class="text-2xl font-black uppercase tracking-tighter text-black mb-2">Enviando...</div>
      <p class="text-zinc-400 font-light text-sm">Preparando tu diagnóstico, un momento.</p>
    </div>
    <div class="w-full bg-zinc-100 rounded-full h-1 overflow-hidden">
      <div id="lp-progress" class="h-full bg-accent rounded-full"></div>
    </div>
  </div>
</div>

<!-- ═══ NAV MÍNIMA (sin enlaces de salida) ════════════════════════════ -->
<header class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md border-b border-black/5 py-2 sm:py-3 leading-none">
  <div class="relative w-full px-6 sm:px-12 lg:px-24 flex items-center justify-between h-12 md:h-14 gap-6">
    <div class="text-[2.8rem] sm:text-[3rem] font-heading font-black tracking-tighter leading-none flex items-center -translate-y-0.5 select-none">
      <span class="hover-animate-gradient">nova.</span>
    </div>
    <div class="hidden sm:flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.15em] text-zinc-500">
      <span class="w-2 h-2 bg-accent rounded-full animate-ping"></span>
      Diagnóstico gratuito en 48 h
    </div>
  </div>
</header>

<!-- ═══ HERO + FORMULARIO POR PASOS ═══════════════════════════════════ -->
<section class="min-h-[100dvh] flex items-center px-4 sm:px-6 relative overflow-hidden bg-white border-b border-black/5 pt-24 pb-16">
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_60%_at_50%_40%,#000_70%,transparent_100%)]"></div>
  <div class="absolute -top-10 left-1/4 w-72 h-72 bg-accent/15 rounded-full blur-3xl opacity-30 animate-pulse"></div>

  <div class="w-full relative z-[2] max-w-6xl mx-auto grid lg:grid-cols-[1.1fr_0.9fr] gap-10 lg:gap-16 items-center">

    <!-- Copy -->
    <div class="reveal">
      <h1 class="text-3xl sm:text-5xl lg:text-6xl uppercase font-black tracking-tighter leading-[0.9] mb-6 text-zinc-900">
        Cada mes que<br>no apareces,<br>tus clientes<br><span class="text-mktg-gradient">llaman a otro</span>.
      </h1>

      <p class="text-zinc-500 font-light text-base sm:text-lg leading-relaxed mb-8 max-w-xl">
        Dime cuál es tu web y te envío un diagnóstico con lo que le impide posicionar y las tres cosas que haría yo primero. Gratis, en 48 horas y sin compromiso.
      </p>

      <div class="flex flex-col gap-3 mb-8">
        {[
          'Sin informes automáticos: lo reviso yo a mano',
          'Te lo quedas aunque no trabajemos juntos',
          'Sin llamadas comerciales que no hayas pedido',
        ].map(item => (
          <div class="flex items-center gap-3">
            <div class="w-5 h-5 rounded-full bg-accent/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-3 h-3 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
            <span class="text-sm text-zinc-600 font-light">{item}</span>
          </div>
        ))}
      </div>

      <div class="inline-flex items-center gap-3 border-l-4 border-accent pl-4 py-1">
        <img src="/sergio-avatar-120.webp" alt="Sergio Galo's, consultor SEO" title="Sergio Galo's, consultor SEO" class="w-11 h-11 rounded-full object-cover" width="120" height="120" loading="lazy" />
        <div>
          <div class="text-sm font-black text-zinc-900 leading-tight">Lo analiza Sergio Galo's</div>
          <div class="text-[11px] font-bold text-accent leading-tight mt-0.5">Fundador & Consultor SEO</div>
        </div>
      </div>
    </div>

    <!-- Formulario por pasos -->
    <div id="solicitar" class="reveal">
      <div class="bg-white rounded-3xl shadow-[0_25px_60px_-10px_rgba(0,0,0,0.18)] border border-black/5 p-7 sm:p-9">

        <!-- Progreso -->
        <div class="flex items-center gap-2 mb-6">
          {[1, 2, 3].map(n => (
            <div class={`step-dot step-dot-${n} h-1 flex-1 rounded-full transition-colors duration-300 ${n === 1 ? 'bg-accent' : 'bg-zinc-200'}`}></div>
          ))}
        </div>

        <form id="diag-form" class="space-y-5">
          <input type="hidden" name="msg" id="diag-objetivo" value="" />

          <!-- Paso 1 -->
          <div class="diag-step" data-step="1">
            <div class="text-[9px] font-black uppercase tracking-[0.3em] text-accent mb-2">Paso 1 de 3</div>
            <div class="text-xl font-black uppercase tracking-tighter mb-5 leading-tight">¿Cuál es tu web?</div>
            <input type="text" name="url" id="diag-url" placeholder="www.tuempresa.com" class="w-full border-b-2 border-zinc-200 py-3 focus:border-accent outline-none transition-colors bg-transparent text-base placeholder:text-zinc-300" />
            <p class="text-[11px] text-zinc-400 font-light mt-2">Si todavía no tienes web, escribe el nombre de tu negocio.</p>
            <button type="button" class="diag-next w-full btn-mktg-v5 !py-3.5 text-sm mt-6" data-next="2">
              Analizar mi web →
            </button>
          </div>

          <!-- Paso 2 -->
          <div class="diag-step hidden" data-step="2">
            <div class="text-[9px] font-black uppercase tracking-[0.3em] text-accent mb-2">Paso 2 de 3</div>
            <div class="text-xl font-black uppercase tracking-tighter mb-5 leading-tight">¿Qué quieres conseguir?</div>
            <div class="space-y-2.5">
              {[
                'Más clientes de mi zona',
                'Vender más en mi tienda online',
                'Conseguir presupuestos de empresas',
                'Todavía no lo tengo claro',
              ].map(op => (
                <button type="button" class="diag-objetivo w-full text-left px-5 py-3.5 rounded-2xl border border-zinc-200 hover:border-accent hover:bg-accent/5 transition-colors text-sm font-medium text-zinc-700" data-value={op}>
                  {op}
                </button>
              ))}
            </div>
            <button type="button" class="diag-back text-[11px] font-black uppercase tracking-widest text-zinc-400 hover:text-accent transition-colors mt-5" data-back="1">
              ← Atrás
            </button>
          </div>

          <!-- Paso 3 -->
          <div class="diag-step hidden" data-step="3">
            <div class="text-[9px] font-black uppercase tracking-[0.3em] text-accent mb-2">Paso 3 de 3</div>
            <div class="text-xl font-black uppercase tracking-tighter mb-5 leading-tight">¿A dónde te lo envío?</div>
            <div class="space-y-4">
              <div class="flex flex-col gap-1.5">
                <label class="text-[8px] font-black uppercase tracking-widest opacity-40">Nombre *</label>
                <input type="text" name="name" required class="border-b border-zinc-300 py-2 focus:border-accent outline-none transition-colors bg-transparent text-sm" />
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[8px] font-black uppercase tracking-widest opacity-40">Email *</label>
                <input type="email" name="email" required class="border-b border-zinc-300 py-2 focus:border-accent outline-none transition-colors bg-transparent text-sm" />
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[8px] font-black uppercase tracking-widest opacity-40">Teléfono (opcional)</label>
                <input type="tel" name="phone" aria-label="Teléfono" class="border-b border-zinc-300 py-2 focus:border-accent outline-none transition-colors bg-transparent text-sm" />
              </div>
            </div>

            <div class="flex items-start gap-2 pt-4">
              <input type="checkbox" id="diag-terms" name="terms" required class="mt-0.5 accent-accent flex-shrink-0" />
              <label for="diag-terms" class="text-[9px] text-zinc-500 font-light cursor-pointer select-none leading-tight">
                Acepto la <a href="/privacidad/" class="underline hover:text-accent transition-colors">política de privacidad</a>.
              </label>
            </div>

            <button type="submit" id="diag-submit" class="w-full btn-mktg-v5 !py-3.5 text-sm mt-5 shadow-[0_15px_35px_rgba(37,211,102,0.25)]">
              Enviadme el diagnóstico →
            </button>
            <button type="button" class="diag-back text-[11px] font-black uppercase tracking-widest text-zinc-400 hover:text-accent transition-colors mt-4 block mx-auto" data-back="2">
              ← Atrás
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>
</section>

<LogoMarquee />

<!-- ═══ QUÉ RECIBES ═══════════════════════════════════════════════════ -->
<section class="py-20 sm:py-28 bg-zinc-50 border-y border-black/5 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-14 reveal">
      <span class="text-[10px] font-black uppercase tracking-[0.3em] text-accent mb-4 block">El diagnóstico</span>
      <h2 class="text-3xl sm:text-5xl uppercase tracking-tighter font-black">
        Tres respuestas concretas,<br class="hidden sm:inline" /> no un PDF genérico
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {entregables.map((e, i) => (
        <div class="p-8 bg-white border border-zinc-100/60 rounded-3xl hover:border-accent/20 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 reveal" style={`transition-delay: ${i * 80}ms`}>
          <div class="text-5xl font-black text-accent/15 leading-none mb-4">{String(i + 1).padStart(2, '0')}</div>
          <h3 class="text-base font-black uppercase tracking-tight text-zinc-900 mb-3 leading-tight">{e.t}</h3>
          <p class="text-sm text-zinc-500 font-light leading-relaxed">{e.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ PRUEBA SOCIAL COMPACTA ════════════════════════════════════════ -->
<section class="py-20 sm:py-28 bg-white px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {[
        { value: '+65%', label: 'Tráfico Orgánico' },
        { value: '-40%', label: 'Coste por Lead' },
        { value: 'x3.5', label: 'ROI a 12 Meses' },
        { value: '+55%', label: 'Posiciones Top 3' },
      ].map((stat, i) => (
        <div class="text-center reveal" style={`transition-delay: ${i * 80}ms`}>
          <div class="text-4xl sm:text-5xl font-black tracking-tighter text-mktg-gradient leading-none mb-2">{stat.value}</div>
          <div class="text-[9px] font-black uppercase tracking-[0.2em] text-zinc-400">{stat.label}</div>
        </div>
      ))}
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {[
        {
          text: 'Nuestro negocio industrial pasó de no existir en Google a estar en primera página. Los presupuestos recibidos se multiplicaron por tres en menos de 8 meses.',
          author: 'Empresa de servicios industriales',
        },
        {
          text: 'Con el SEO local de Nova ocupamos el pack de Google Maps de nuestra zona. La tienda recibe llamadas directas desde Google cada día sin pagar por cada clic.',
          author: 'Comercio de proximidad',
        },
      ].map((t, i) => (
        <div class="p-8 bg-zinc-50 border border-zinc-100/60 rounded-3xl reveal" style={`transition-delay: ${i * 80}ms`}>
          <div class="flex gap-1 mb-4">
            {[1,2,3,4,5].map(() => (
              <svg class="w-4 h-4 text-accent" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118L2.98 10.1c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.518-4.674z"/></svg>
            ))}
          </div>
          <p class="text-zinc-600 font-light text-sm leading-relaxed mb-5">{t.text}</p>
          <div class="text-[10px] font-black uppercase tracking-widest text-zinc-400">{t.author}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ FAQ ═══════════════════════════════════════════════════════════ -->
<section class="py-20 sm:py-28 bg-zinc-50 border-y border-black/5 px-4 sm:px-6">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-12 reveal">
      <h2 class="text-3xl sm:text-4xl uppercase tracking-tighter font-black">Antes de que lo pidas</h2>
    </div>
    <div class="space-y-3 reveal">
      {faqs.map(faq => (
        <div class="faq-item bg-white border border-zinc-100/60 rounded-3xl overflow-hidden hover:border-accent/20 transition-colors">
          <button class="faq-trigger w-full text-left px-8 py-6 flex items-center justify-between gap-4" aria-expanded="false">
            <span class="text-sm font-black uppercase tracking-tight text-zinc-900">{faq.q}</span>
            <div class="faq-icon-wrap w-8 h-8 rounded-full bg-zinc-50 border border-zinc-100 flex items-center justify-center flex-shrink-0 transition-all duration-300">
              <svg class="faq-icon w-4 h-4 text-zinc-400 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14M5 12h14"/>
              </svg>
            </div>
          </button>
          <div class="faq-answer hidden px-8 pb-6">
            <p class="text-zinc-500 font-light text-sm leading-relaxed">{faq.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ CTA FINAL (devuelve al único formulario) ══════════════════════ -->
<section class="py-20 sm:py-32 px-4 sm:px-6 bg-accent">
  <div class="max-w-3xl mx-auto text-center text-white reveal">
    <div class="text-4xl sm:text-6xl font-black uppercase tracking-tighter leading-[0.85] mb-8">
      ¿Vemos qué<br>le pasa a tu web?
    </div>
    <p class="font-light text-base sm:text-lg opacity-90 mb-10 max-w-xl mx-auto">
      Tardas menos de un minuto en pedirlo. Yo tardo 48 horas en contestarte con algo que puedas usar mañana.
    </p>
    <a href="#solicitar" class="inline-block bg-white text-zinc-900 font-black uppercase tracking-widest text-xs px-10 py-5 rounded-full hover:scale-105 transition-transform">
      Pedir mi diagnóstico gratis →
    </a>
  </div>
</section>

<!-- ─── Minimal footer ─── -->
<footer class="py-8 bg-white border-t border-black/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <span class="font-black text-xl tracking-tighter text-black leading-none">nova.</span>
    <div class="flex items-center gap-6 text-[10px] text-zinc-400 font-light">
      <a href="/privacidad/" class="hover:text-accent transition-colors uppercase tracking-widest font-black">Privacidad</a>
      <a href="/aviso-legal/" class="hover:text-accent transition-colors uppercase tracking-widest font-black">Aviso legal</a>
      <a href="/cookies/" class="hover:text-accent transition-colors uppercase tracking-widest font-black">Cookies</a>
    </div>
    <p class="text-[10px] text-zinc-400 font-light">&copy; {new Date().getFullYear()} Nova Marketing</p>
  </div>
</footer>

</BaseLayout>

<script>
  // FAQ accordion
  document.querySelectorAll('.faq-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item')!;
      const answer = item.querySelector('.faq-answer')!;
      const icon = btn.querySelector('.faq-icon') as SVGElement | null;
      const wrap = btn.querySelector('.faq-icon-wrap')!;
      const isOpen = !answer.classList.contains('hidden');

      document.querySelectorAll('.faq-answer').forEach(a => a.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(i => (i as SVGElement).style.transform = '');
      document.querySelectorAll('.faq-icon-wrap').forEach(w => {
        w.classList.remove('bg-accent', 'border-accent');
        w.classList.add('bg-zinc-50', 'border-zinc-100');
      });
      document.querySelectorAll('.faq-trigger').forEach(b => b.setAttribute('aria-expanded', 'false'));

      if (!isOpen) {
        answer.classList.remove('hidden');
        if (icon) { icon.style.transform = 'rotate(45deg)'; icon.style.color = 'white'; }
        wrap.classList.remove('bg-zinc-50', 'border-zinc-100');
        wrap.classList.add('bg-accent', 'border-accent');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Navegación del formulario por pasos
  function showStep(n: number) {
    document.querySelectorAll<HTMLElement>('.diag-step').forEach(s => {
      s.classList.toggle('hidden', s.dataset.step !== String(n));
    });
    for (let i = 1; i <= 3; i++) {
      const dot = document.querySelector(`.step-dot-${i}`);
      if (!dot) continue;
      dot.classList.toggle('bg-accent', i <= n);
      dot.classList.toggle('bg-zinc-200', i > n);
    }
  }

  document.querySelectorAll<HTMLElement>('.diag-next').forEach(btn => {
    btn.addEventListener('click', () => {
      const url = document.getElementById('diag-url') as HTMLInputElement | null;
      if (url && url.value.trim() && !/\.[a-zA-Z]{2,}/.test(url.value.trim()) && url.value.trim().length < 3) {
        url.setCustomValidity('Escribe tu web o el nombre de tu negocio');
        url.reportValidity();
        return;
      }
      url?.setCustomValidity('');
      showStep(Number(btn.dataset.next));
    });
  });

  document.querySelectorAll<HTMLElement>('.diag-back').forEach(btn => {
    btn.addEventListener('click', () => showStep(Number(btn.dataset.back)));
  });

  document.querySelectorAll<HTMLElement>('.diag-objetivo').forEach(btn => {
    btn.addEventListener('click', () => {
      const hidden = document.getElementById('diag-objetivo') as HTMLInputElement | null;
      if (hidden) hidden.value = `Objetivo: ${btn.dataset.value}`;
      document.querySelectorAll('.diag-objetivo').forEach(b => b.classList.remove('border-accent', 'bg-accent/5'));
      btn.classList.add('border-accent', 'bg-accent/5');
      showStep(3);
    });
  });

  // Envío
  async function handleForm(formId: string, btnId: string) {
    const form = document.getElementById(formId) as HTMLFormElement | null;
    const btn = document.getElementById(btnId) as HTMLButtonElement | null;
    const overlay = document.getElementById('lp-sending');
    const bar = document.getElementById('lp-progress');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (btn) btn.disabled = true;
      overlay?.classList.remove('hidden');
      if (bar) {
        setTimeout(() => { bar.style.width = '40%'; }, 50);
        setTimeout(() => { bar.style.width = '72%'; }, 700);
        setTimeout(() => { bar.style.width = '88%'; }, 1800);
      }
      const eventId = (window as any).oaiqNewEventId?.() ?? String(Date.now());
      const data = { ...Object.fromEntries(new FormData(form)), source: window.location.href, eventId };
      try {
        const res = await fetch('https://cms.novamarketing.es/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (res.ok) {
          // La página de gracias emite el evento del píxel con este id.
          try { sessionStorage.setItem('oaiq_event_id', eventId); } catch {}
          if (bar) bar.style.width = '100%';
          setTimeout(() => { window.location.href = '/gracias/'; }, 400);
        } else { throw new Error(); }
      } catch {
        overlay?.classList.add('hidden');
        if (bar) bar.style.width = '0%';
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'ERROR — INTÉNTALO DE NUEVO';
          (btn as HTMLElement).style.background = '#ef4444';
        }
      }
    });
  }

  handleForm('diag-form', 'diag-submit');
</script>
