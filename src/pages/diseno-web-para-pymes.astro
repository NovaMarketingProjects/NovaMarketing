        { title: 'Tienda online', price: 'desde 130 € / mes', note: 'en 12 cuotas · 6 a 8 semanas', items: ['Todo lo de la web a medida', 'Catálogo y fichas de producto', 'Carrito, pago y envíos', 'Emails de pedido', 'Formación para gestionarla'] },
      ].map((p, i) => (
        <div class:list={['pd-rise rounded-3xl p-7 sm:p-8 flex flex-col border', p.featured ? 'bg-zinc-950 text-white border-zinc-950 shadow-2xl' : 'bg-white border-black/5 shadow-[0_15px_40px_rgba(0,0,0,0.06)]']} style={`--i:${i}`}>
