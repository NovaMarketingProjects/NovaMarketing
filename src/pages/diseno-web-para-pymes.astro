---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildAlternates } from '../lib/i18n';
import { localAgencySchema } from '../lib/schema';
import LogoMarquee from '../components/sections/LogoMarquee.astro';
import FaqHome from '../components/sections/FaqHome.astro';
import CityPills from '../components/global/CityPills.astro';
import MoreCases from '../components/casos/MoreCases.astro';
import PageBlocks from '../components/blocks/PageBlocks.astro';
import PSection from '../components/pillar/PSection.astro';
import PCards from '../components/pillar/PCards.astro';
import PFlow from '../components/pillar/PFlow.astro';
import PMatrix from '../components/pillar/PMatrix.astro';
import PStack from '../components/pillar/PStack.astro';
import PFunnel from '../components/pillar/PFunnel.astro';
import PTree from '../components/pillar/PTree.astro';
import PRings from '../components/pillar/PRings.astro';
import PCounter from '../components/pillar/PCounter.astro';
import WebGantt from '../components/pillar/WebGantt.astro';
import WebVersus from '../components/pillar/WebVersus.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://novamarketing.es';
const alternates = buildAlternates('/diseno-web-para-pymes/', '/ca/disseny-web-per-pimes/', SITE_URL);

const ICON = {
  building: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  bolt: 'M13 10V3L4 14h7v7l9-11h-7z',
  bag: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z',
  refresh: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
  chart: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm8 0V5a2 2 0 012-2h0a2 2 0 012 2v14a2 2 0 01-2 2h0a2 2 0 01-2-2zm-8 0a2 2 0 002 2h2a2 2 0 002-2V9a2 2 0 00-2-2h-2a2 2 0 00-2 2v10z',
  doc: 'M9 12h6m-6 4h6M9 8h2m8-3v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2h6l4 4z',
  compass: 'M12 3a9 9 0 100 18 9 9 0 000-18zm3.5 5.5l-2 5-5 2 2-5 5-2z',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  palette: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
  layers: 'M4 6h16M4 12h16M4 18h7',
  device: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
  access: 'M12 4a2 2 0 100 4 2 2 0 000-4zM5 9l7 1 7-1M12 10v4m0 0l-3 6m3-6l3 6',
  wp: 'M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z',
  plug: 'M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5m7.328-1.672a4 4 0 000-5.656 4 4 0 00-5.656 0l-1.5 1.5',
  pencil: 'M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z',
  users: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
};

const faqs = [
  { question: '¿Cuánto tiempo llevará crear mi web?', answer: 'Una landing page suele estar lista en una o dos semanas, una web corporativa en tres a cinco semanas y una tienda online en seis a ocho. El plazo cuenta desde que tenemos los textos, fotos y accesos necesarios, y depende sobre todo de lo rápido que se revisen las propuestas. Antes de empezar recibes un calendario con las fechas de cada entrega y cada revisión.' },
  { question: '¿Quién será propietario del dominio, la web y el alojamiento?', answer: 'Tú. El dominio se registra a nombre de tu empresa, el alojamiento se contrata a tu nombre o se te transfiere al terminar, y la web, los textos y las imágenes que hayamos creado para el proyecto son tuyos. Al entregar te damos todos los accesos de administrador. Si algún día cambias de proveedor, te llevas la web entera sin pedir permiso a nadie.' },
  { question: '¿Podré modificar los contenidos?', answer: 'Sí. Preparamos un panel de edición para que tu equipo pueda cambiar textos, imágenes, precios, entradas del blog o productos sin tocar código, y te formamos para hacerlo. Los cambios que afectan a la estructura o al diseño, como crear un tipo de página nuevo, sí conviene hacerlos con nosotros para no romper nada.' },
  { question: '¿Cómo protegéis el posicionamiento durante un rediseño?', answer: 'Antes de tocar nada exportamos las páginas que reciben visitas y enlaces, y decidimos qué se conserva, qué se fusiona y qué se elimina. Cada URL antigua que cambia tiene su redirección a la nueva. Tras publicar revisamos Search Console y las posiciones de las páginas importantes durante las semanas siguientes para corregir cualquier caída a tiempo.' },
  { question: '¿Qué sucede si necesito ampliar el proyecto?', answer: 'La web se construye para crecer. Puedes añadir páginas, servicios, idiomas, una tienda o integraciones más adelante. Cada ampliación se presupuesta por separado y por escrito antes de hacerla, y si tienes mantenimiento contratado, los cambios pequeños ya entran en él. Así no pagas hoy por funciones que quizá no necesites.' },
];

const pageSchema = localAgencySchema({
  pageUrl: `${SITE_URL}/diseno-web-para-pymes/`,
  lang: 'es',
  cityName: 'Barcelona',
  postalCode: '08035',
  geo: { lat: 41.4114, lng: 2.1526 },
  areaServed: ['España', 'Barcelona', 'Sabadell', 'Sant Cugat del Vallès', 'Terrassa', 'Vallès Occidental'],
  title: '▷ Diseño Web para PYMEs | Páginas rápidas y optimizadas',
  description: 'Diseño web para PYMEs: webs rápidas, optimizadas para SEO ✅ y pensadas para convertir visitas en clientes. Más información sobre nuestro enfoque profesional',
  datePublished: '2026-07-16',
  dateModified: '2026-10-25',
  streetAddress: 'Carrer del General Mendoza, 10',
  hasMap: 'https://maps.app.goo.gl/9fbB12UcK32bgjj89',
  aggregateRating: { ratingValue: '5.0', reviewCount: '12' },
  breadcrumbName: 'Diseño Web para PYMEs',
  mainService: {
    name: 'Diseño de páginas web para pymes',
    serviceType: 'Diseño web',
    description: 'Webs corporativas, landing pages y tiendas online para pymes, con SEO desde la planificación, propiedad del cliente y sin permanencia.',
    offers: [
      { name: 'Landing page', price: 400, from: true },
      { name: 'Web a medida', price: 120, from: true, monthly: true, description: 'En 12 cuotas.' },
      { name: 'Tienda online', price: 130, from: true, monthly: true, description: 'En 12 cuotas.' },
    ],
  },
  faqs,
});
---

<BaseLayout
  title="▷ Diseño Web para PYMEs | Páginas rápidas y optimizadas"
  description="Diseño web para PYMEs: webs rápidas, optimizadas para SEO ✅ y pensadas para convertir visitas en clientes. Más información sobre nuestro enfoque profesional"
  locale="es"
  alternates={alternates}
  schemas={[pageSchema]}
>

  <!-- ═══ HERO / H1 ═══════════════════════════════════════════════════════ -->
  <section class="pt-24 sm:pt-40 pb-20 px-4 sm:px-6 relative overflow-hidden text-center bg-white border-b border-black/5">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_40%,#000_75%,transparent_100%)]"></div>
    <div class="absolute -top-10 left-1/4 w-72 h-72 bg-accent/15 rounded-full blur-3xl opacity-30 animate-pulse"></div>
    <div class="absolute top-20 right-1/4 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl opacity-20"></div>

    <div class="max-w-5xl mx-auto reveal relative">
      <span class="inline-flex items-center gap-2 bg-accent/5 backdrop-blur-sm px-4 py-2 border border-accent/10 rounded-full text-accent text-[8px] sm:text-[10px] font-black uppercase tracking-[0.3em] mb-8 shadow-sm">
        <span class="w-1.5 h-1.5 bg-accent rounded-full animate-ping"></span>
        Diseño web para pymes
      </span>
      <h1 class="text-3xl sm:text-5xl md:text-7xl lg:text-8xl uppercase font-extrabold tracking-tighter leading-[0.88] mb-8 text-gradient flex flex-col items-center text-center">
                <span class="lg:whitespace-nowrap">Diseño Páginas Web </span>
                <span class="lg:whitespace-nowrap text-mktg-gradient">para PYMEs</span>
            </h1>
      <p class="text-lg sm:text-xl text-zinc-500 font-light leading-relaxed mb-8">
        Diseñamos webs corporativas, landing pages y tiendas online que explican en segundos qué hace tu pyme y llevan a la visita a pedir presupuesto, reservar o comprar. Planificamos el SEO antes de diseñar, así la web sale preparada para posicionar en Google.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 mb-10">
        {['La web y el dominio a tu nombre', 'Sin permanencia', 'SEO desde la planificación'].map((item) => (
          <span class="inline-flex items-center gap-2 text-[11px] sm:text-xs font-black uppercase tracking-widest text-zinc-700">
            <svg class="w-4 h-4 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            {item}
          </span>
        ))}
      </div>
      <a href="#contacto" class="contact-modal-trigger btn-mktg-v5 shadow-[0_10px_30px_rgba(0,0,0,0.1)] !py-4 sm:!py-5 !px-6 sm:!px-10 !text-[11px] !tracking-widest font-black">HABLEMOS DE TU WEB</a>
    </div>
  </section>

  <LogoMarquee />

  <!-- ═══ OBJETIVO ═══════════════════════════════════════════════════════ -->
  <PSection kicker="Antes de diseñar" title="Tu próxima web empieza por lo que necesita conseguir tu empresa">
    <Fragment slot="intro">
      <p>Encargas una web para conseguir algo concreto: más peticiones de presupuesto, ventas online, clientes mejor filtrados o menos llamadas para explicar lo mismo. <strong>Ese objetivo decide qué páginas hacen falta, qué cuenta cada una y qué debe hacer el visitante al final.</strong></p>
      <p>Por eso la primera reunión trata de tu negocio, no de plantillas. La web forma parte de tu captación de clientes, junto al <a href="/agencia-seo-para-pymes/">posicionamiento en Google</a> y al resto del <a href="/">marketing digital de tu pyme</a>. El esquema muestra el orden en el que trabajamos.</p>
    </Fragment>
    <PFlow
      steps={[
        { label: 'Objetivo de negocio', sub: 'contactos, ventas, reservas' },
        { label: 'Estructura', sub: 'qué páginas y en qué orden' },
        { label: 'Contenido', sub: 'qué dice cada página' },
        { label: 'Diseño', sub: 'marca, lectura y uso' },
        { label: 'Lanzamiento', sub: 'medido desde el primer día' },
      ]}
      caption="Fíjate en que el diseño visual llega en el cuarto paso, cuando ya sabemos qué tiene que conseguir cada página."
    />
  </PSection>

  <!-- ═══ TIPO DE PROYECTO ═══════════════════════════════════════════════ -->
  <PSection kicker="Tipos de proyecto" title="Elige el tipo de proyecto que encaja contigo" tone="soft">
    <Fragment slot="intro">
      <p>Casi todas las pymes llegan con una de estas cuatro necesidades. Cada tarjeta indica el precio de partida y el plazo habitual.</p>
      <p>Si no sabes cuál es la tuya, lo vemos en la primera llamada. A veces un rediseño completo se resuelve con una buena landing, y al revés.</p>
    </Fragment>
    <PCards
      tone="soft"
      cols={2}
      items={[
        { icon: ICON.building, tag: 'Desde 120 €/mes · 3 a 5 semanas', title: 'Web corporativa para presentar tu empresa', html: 'Para despachos, clínicas, empresas de servicios o fabricantes que deben explicar qué hacen, para quién y por qué son de fiar. Incluye páginas de servicio, equipo, proyectos y contacto. Es el formato habitual en el <a href="/agencia-b2b/diseno-web/">diseño web para empresas B2B</a> y en las <a href="/agencia-industrial/diseno-web/">webs de empresas industriales</a>, donde el comprador compara mucho antes de llamar.' },
        { icon: ICON.bolt, tag: 'Desde 400 € · 1 a 2 semanas', title: 'Landing page para una oferta o campaña', html: 'Una sola página con un solo objetivo, pensada para recibir tráfico de anuncios. No lleva menú que distraiga. Muestra la oferta, las pruebas de confianza y un formulario o botón de llamada siempre a mano. Rinde más cuando la conectas a una <a href="/agencia-sem-para-pymes/">campaña de Google Ads</a> bien segmentada, porque el anuncio y la página dicen lo mismo.' },
        { icon: ICON.bag, tag: 'Desde 130 €/mes · 6 a 8 semanas', title: 'Tienda online para vender productos', html: 'Catálogo, fichas de producto, carrito, pago, envíos y gestión de pedidos, pensados para que el comprador no abandone por el camino. Elegimos la plataforma contigo según el tamaño del catálogo y cómo preparas los pedidos. Si tu caso es una tienda grande o técnica, mira nuestro <a href="/agencia-ecommerce/diseno-web/">diseño de tiendas online</a>.' },
        { icon: ICON.refresh, tag: 'Según alcance', title: 'Rediseño de una web que se ha quedado atrás', html: 'Para webs lentas, difíciles de editar o que ya no representan a tu empresa. Conservamos lo que hoy funciona y protegemos el posicionamiento que ya tienes. ¿No sabes si te hace falta? Repasa antes esta guía para <a href="/blog/como-saber-si-tu-web-esta-bien-hecha/">saber si tu web está bien hecha</a> y apunta qué falla.' },
      ]}
    />
  </PSection>

  <!-- ═══ WEB EXISTENTE ══════════════════════════════════════════════════ -->
  <PSection kicker="Rediseño" title="Si ya tienes web, decidimos qué merece conservarse" layout="split">
    <Fragment slot="intro">
      <p>Rehacer tu web no obliga a tirar lo anterior. Antes de diseñar revisamos Analytics, Search Console, el contenido publicado y la tecnología, y colocamos cada página en la matriz según su valor y el trabajo que pide.</p>
      <p>Esa revisión evita el error más caro de un rediseño: perder en una semana el tráfico que costó años conseguir.</p>
    </Fragment>
    <PMatrix
      slot="aside"
      xLabel="Trabajo necesario"
      yLabel="Valor para el negocio"
      quadrants={['Conservar', 'Mejorar', 'Redirigir o fusionar', 'Eliminar']}
      points={[
        { label: 'Servicio que posiciona', x: 18, y: 86 },
        { label: 'Guía con visitas', x: 32, y: 66 },
        { label: 'Página de contacto', x: 72, y: 80 },
        { label: 'Noticias duplicadas', x: 26, y: 28 },
        { label: 'Promoción caducada', x: 76, y: 18 },
      ]}
      caption="Ejemplo de clasificación: arriba a la izquierda, lo que se conserva casi sin tocar; abajo a la derecha, lo que se elimina."
    />
    <PCards
      variant="rows"
      items={[
        { title: 'Páginas que atraen visitas y contactos', html: 'Buscamos las URLs que reciben tráfico de Google, las que tienen enlaces de otras webs y las que generan formularios y llamadas. Esas páginas conservan su dirección o se redirigen a su equivalente nueva. Si hoy no sabes qué canal te trae las visitas, lee antes <a href="/blog/donde-viene-el-trafico/">de dónde viene el tráfico de tu web</a>.' },
        { title: 'Contenidos y recursos que siguen siendo útiles', html: 'Artículos que todavía resuelven dudas reales, fichas técnicas, preguntas frecuentes o proyectos que demuestran experiencia. Muchos solo necesitan datos al día y un formato más legible. Lo obsoleto o repetido se fusiona con otra página o se elimina, y cada URL que desaparece recibe su redirección para no perder visitas ni enlaces.' },
        { title: 'Problemas de navegación y conversión', html: 'Menús con demasiadas opciones, servicios escondidos, formularios de diez campos o un teléfono que no se puede pulsar en el móvil. Recorremos tu web como lo haría un cliente, desde la portada hasta el contacto, y anotamos cada punto donde se pierde gente. Esa lista es lo primero que resuelve el nuevo diseño.' },
        { title: 'Tecnología que condiciona el nuevo proyecto', html: 'Plataforma, alojamiento, plugins, integraciones y quién tiene los accesos. A veces la web se puede rehacer sobre la misma base y a veces la tecnología es el problema. Con Clustag bastó con optimizar su WordPress. En el <a href="/casos-exito/cts-formacion/">rediseño de CTS Formación</a>, en cambio, hubo que salir de la plataforma de un proveedor externo.' },
      ]}
    />
  </PSection>

  <!-- ═══ MAPA DE LA WEB ═════════════════════════════════════════════════ -->
  <PSection kicker="Arquitectura" title="Del objetivo de negocio al mapa de la web" tone="soft">
    <Fragment slot="intro">
      <p>Con el objetivo claro dibujamos el mapa de la web: qué páginas tendrá, cómo se agrupan y cómo se enlazan. Lo validas antes de que exista una sola pantalla de diseño, y es el documento que más cambios caros evita después.</p>
    </Fragment>
    <PTree
      root="Web de un despacho profesional"
      branches={[
        { label: 'Servicios', leaves: ['Una página por servicio', 'Precios orientativos'] },
        { label: 'Sectores o casos', leaves: ['Proyectos reales', 'Testimonios'] },
        { label: 'Sobre el equipo', leaves: ['Experiencia', 'Colegiaciones'] },
        { label: 'Recursos', leaves: ['Guías y artículos', 'Preguntas frecuentes'] },
        { label: 'Contacto', leaves: ['Formulario', 'Teléfono y ubicación'] },
      ]}
      caption="Esquema ilustrativo del mapa web de un despacho: cada rama es una sección del menú y cada hoja, lo que el visitante encuentra dentro."
    />
    <PCards
      tone="soft"
      cols={2}
      variant="numbered"
      items={[
        { title: 'Qué necesita encontrar cada tipo de cliente', html: 'Un paciente nuevo busca tratamientos, precio y cita. Un responsable de compras busca fichas técnicas y referencias. Antes de dibujar el mapa anotamos quién visita tu web y qué pregunta trae. Lo aplicamos en el <a href="/agencia-dentistas/diseno-web/">diseño web para clínicas dentales</a>, en las <a href="/agencia-psicologos/diseno-web/">webs para psicólogos</a> y en el <a href="/agencia-terapeutas/diseno-web/">diseño web para terapeutas</a>, donde la confianza pesa más que el precio.' },
        { title: 'Cómo organizamos servicios y contenidos', html: 'Cada servicio importante tiene su propia página, agrupada para que el visitante no tenga que adivinar dónde está. En <a href="/casos-exito/villazon-merce-abogados/">Villazón Mercé Abogados</a> creamos una página por cada área penal. En <a href="/casos-exito/voltura-projects/">Voltura Projects</a>, una por cada ciudad donde trabajan. Es la estructura que proponemos en el <a href="/agencia-abogados/diseno-web/">diseño web para abogados</a>.' },
        { title: 'Qué recorrido conduce al contacto o la compra', html: 'Trazamos el camino desde la página de entrada hasta el formulario, la llamada, la reserva o el pedido, y quitamos todos los pasos que sobran. Nuestra regla en las <a href="/agencia-restaurantes/diseno-web/">webs para restaurantes</a> y en el <a href="/agencia-hoteles/diseno-web/">diseño web para hoteles</a> es sencilla: la reserva queda a uno o dos toques desde cualquier página.' },
        { title: 'Qué páginas necesita el lanzamiento', html: 'No todo tiene que estar listo el primer día. Separamos lo imprescindible para publicar, que suele ser portada, servicios, quiénes somos, contacto y textos legales, de lo que puede llegar después, como el blog o nuevas secciones. Así tu web sale antes y las siguientes páginas se deciden con datos reales de uso.' },
      ]}
    />
  </PSection>

  <!-- ═══ TEXTOS ═════════════════════════════════════════════════════════ -->
  <PSection kicker="Contenidos" title="Textos que explican por qué elegir tu empresa">
    <Fragment slot="intro">
      <p>El diseño atrae la mirada, pero el texto es lo que convence. Redactamos o editamos los contenidos contigo, porque tu equipo sabe mejor que nadie qué preguntan los clientes y por qué acaban eligiéndoos.</p>
      <p>Escribimos para quien llega con prisa desde el móvil: frases cortas, respuestas concretas y los datos que suelen faltar en las webs de pymes, como plazos, precios orientativos o cómo trabajáis.</p>
    </Fragment>
    <PCards
      cols={2}
      items={[
        { icon: ICON.compass, title: 'Una propuesta de valor fácil de entender', html: 'En la primera pantalla tu visitante tiene que saber qué haces, para quién y qué debe hacer a continuación. Lo resumimos en un titular, una frase de apoyo y un botón. Fuera quedan expresiones como "soluciones integrales" o "calidad y profesionalidad", que cualquier competidor podría firmar y que no ayudan a nadie a decidir.' },
        { icon: ICON.doc, title: 'Servicios descritos desde la necesidad del cliente', html: 'Cada página de servicio abre con el problema que resuelve y después explica qué incluye, cómo se trabaja, cuánto tarda y qué cuesta aproximadamente. Así responde a la <a href="/blog/que-es-la-intencion-de-busqueda-en-el-seo/">intención de búsqueda</a> de quien llega desde Google, que quiere saber si puedes ayudarle y no leer un catálogo de servicios.' },
        { icon: ICON.chart, title: 'Experiencia y pruebas que generan confianza', html: 'Proyectos con fotos reales, reseñas, años en el sector, certificaciones y cifras medibles. En el <a href="/agencia-constructoras/diseno-web/">diseño web para constructoras</a> y en las <a href="/agencia-inmobiliarias/diseno-web/">webs para inmobiliarias</a> proponemos una ficha por obra o promoción, con fotos y datos, porque un proyecto documentado convence más que cualquier eslogan.' },
        { icon: ICON.bolt, title: 'Llamadas a la acción según cada página', html: 'Cada página pide un paso distinto. Una página de servicio invita a pedir presupuesto. Un artículo, a seguir leyendo o descargar una guía. En las <a href="/agencia-gimnasios/diseno-web/">webs para gimnasios</a>, a reservar una clase de prueba. Adaptamos cada botón al momento del visitante y medimos sus clics para saber cuál funciona.' },
      ]}
    />
  </PSection>

  <!-- ═══ DISEÑO ═════════════════════════════════════════════════════════ -->
  <PSection kicker="Diseño" title="Un diseño que representa tu marca y facilita el uso" tone="soft">
    <Fragment slot="intro">
      <p>Un buen diseño hace que tu empresa parezca lo que es y que cualquiera encuentre lo que busca sin pensar. Partimos de tu identidad y la adaptamos a cómo se lee una web hoy, sobre todo en el móvil.</p>
      <p>El comparador muestra un caso real: la portada antigua de CTS Formación y la nueva, construida alrededor del buscador de cursos.</p>
    </Fragment>
    <div class="mt-12 reveal">
      <PageBlocks blocks={[{
        __component: 'blocks.image-compare',
        before: { url: '/casos/cts-formacion/antes-home-cts-formacion.webp', local: true, alternativeText: 'Home antigua de CTS Formación con cabecera roja, menú en mayúsculas e imágenes de stock' },
        after: { url: '/casos/cts-formacion/cts-formacion-web.webp', local: true, alternativeText: 'Home nueva de CTS Formación con el buscador de cursos como protagonista y las categorías como accesos directos' },
        before_label: 'Antes',
        after_label: 'Después',
        aria_label: 'Comparar la home antigua y la nueva de CTS Formación',
        caption: 'Desliza y fíjate en la primera pantalla: antes la ocupaban imágenes de stock; ahora, el buscador de cursos y las categorías.',
      }]} />
    </div>
    <PCards
      tone="soft"
      cols={2}
      items={[
        { icon: ICON.palette, title: 'Identidad visual aplicada a la web', html: 'Llevamos tu logotipo, colores y tipografías a un sistema pensado para pantalla, con botones, tarjetas, formularios e iconos iguales en todas las páginas. Si tu marca es antigua o no tienes manual de identidad, definimos una base sencilla de colores y tipografías para que tu web no parezca una plantilla más.' },
        { icon: ICON.layers, title: 'Jerarquía para leer y encontrar información', html: 'Titulares que resumen, párrafos cortos, listas, espacio en blanco y un orden que lleva la vista de lo importante a lo secundario. Casi todo el mundo escanea antes de leer. Por eso aplicamos una regla: si alguien solo lee los titulares de una página, debe entender qué ofreces y cuál es el siguiente paso.' },
        { icon: ICON.device, title: 'Experiencia en móvil, tableta y ordenador', html: 'Diseñamos primero para el móvil y después ampliamos a tableta y ordenador. En la web del torneo del <a href="/casos-exito/cb-hospitalet/">CB L\'Hospitalet</a>, el 90 % del público del pabellón consultaba los horarios desde el teléfono. Por eso cuidamos el teléfono que se pulsa, los menús al alcance del pulgar, los formularios cortos y los textos legibles sin zoom.' },
        { icon: ICON.access, title: 'Accesibilidad en los elementos de interacción', html: 'Contraste suficiente, textos de tamaño legible, botones grandes, formularios con etiquetas claras y navegación posible con teclado. Revisamos estos puntos en cada plantilla antes de publicar. Ayudan a las personas con dificultades visuales o motoras y, de paso, hacen tu web más cómoda para cualquier visitante.' },
      ]}
    />
  </PSection>

  <!-- ═══ TECNOLOGÍA ═════════════════════════════════════════════════════ -->
  <PSection kicker="Tecnología" title="La tecnología adecuada para gestionar tu proyecto">
    <Fragment slot="intro">
      <p>Trabajamos con WordPress y con desarrollo a medida. Elegimos según tres preguntas: qué tiene que hacer tu web, quién la va a editar y con qué herramientas debe conectarse.</p>
      <p>La tabla resume en qué destaca cada opción.</p>
    </Fragment>
    <WebVersus
      a={{ label: 'WordPress' }}
      b={{ label: 'Desarrollo a medida' }}
      rows={[
        { label: 'Encaja con', a: 'Webs con mucho contenido, blog activo y equipos que ya conocen el panel.', b: 'Webs donde la velocidad, el SEO o una funcionalidad propia son prioritarios.' },
        { label: 'Edición', a: 'Panel conocido y gran ecosistema de plugins.', b: 'Panel propio, solo con los campos que tu equipo necesita.' },
        { label: 'Rendimiento', a: 'Bueno si se cuida la plantilla y se limitan los plugins.', b: 'Muy alto de partida, sin código que no se usa.' },
        { label: 'Mantenimiento', a: 'Actualizaciones frecuentes de núcleo y plugins.', b: 'Menos piezas de terceros que actualizar.' },
      ]}
      caption="Resumen orientativo. La decisión final depende de cada proyecto y la razonamos por escrito en la propuesta."
    />
    <PCards
      cols={2}
      items={[
        { icon: ICON.wp, title: 'Cuándo tiene sentido trabajar con WordPress', html: 'Cuando vas a publicar contenido a menudo, tu equipo ya conoce el panel o necesitas funciones que existen como plugin probado. Bien configurado, WordPress también es rápido: la <a href="/casos-exito/clustag/">web de Clustag</a> pasó de 53 a 98 en PageSpeed de escritorio sin cambiar de plataforma. Un ejemplo de planteamiento son nuestras <a href="/agencia-inmobiliarias/wordpress/">webs inmobiliarias en WordPress</a>.' },
        { icon: ICON.code, title: 'Cuándo conviene un desarrollo a medida', html: 'Cuando necesitas un buscador, un catálogo con filtros, varios idiomas o el máximo rendimiento sin depender de plugins. Las webs de <a href="/casos-exito/villazon-merce-abogados/">Villazón Mercé</a> y Voltura Projects son desarrollos a medida con 98 y 100 en PageSpeed de escritorio. Explicamos cuándo compensa en el <a href="/agencia-inmobiliarias/desarrollo-propio/">desarrollo propio para inmobiliarias</a>.' },
        { icon: ICON.plug, title: 'Integraciones con las herramientas de tu empresa', html: 'Conectamos los formularios con tu CRM o tu correo, y la web con tu sistema de reservas, tu programa de facturación o tu herramienta de email marketing. Así ningún contacto se queda olvidado en una bandeja de entrada. Si todavía no usas CRM, compara <a href="/blog/los-7-mejores-crm-para-una-pyme/">los mejores CRM para una pyme</a>.' },
        { icon: ICON.pencil, title: 'Edición de contenidos sin depender de un desarrollador', html: 'Textos, imágenes, precios, entradas del blog o productos se cambian desde un panel, sin tocar código. Te enseñamos a hacerlo con tu propia web. En <a href="/casos-exito/restaurante-loremar/">Restaurante Loremar</a> el propio equipo actualiza la carta cada vez que cambia un plato, y la web mantiene un 94 en PageSpeed de escritorio.' },
      ]}
    />
  </PSection>

  <!-- ═══ SEO ════════════════════════════════════════════════════════════ -->
  <PSection kicker="SEO" title="SEO incorporado desde la planificación" tone="soft" layout="split">
    <Fragment slot="intro">
      <p>El SEO se decide en el mapa de la web, en los textos y en cómo se programa, mucho antes de instalar ningún plugin. Una web bien estructurada desde el principio posiciona antes y cuesta menos mejorarla después. El esquema muestra las capas que dejamos resueltas al construirla.</p>
      <p>Si quieres seguir creciendo en buscadores tras el lanzamiento, lo continuamos con nuestro servicio de <a href="/agencia-seo-para-pymes/">agencia SEO para pymes</a>. Para aparecer en las respuestas de ChatGPT o Gemini, con el de <a href="/agencia-geo-para-pymes/">posicionamiento en IA</a>.</p>
      <p data-consultor-link>Cada proyecto lo dirige Sergio Galo's, fundador de Nova, que también trabaja como <a href="https://sergiogalos.es/consultor-seo-tecnico/" class="font-medium text-accent underline decoration-accent/30 underline-offset-4 hover:decoration-accent" target="_blank" rel="noopener">consultor SEO técnico</a>, y revisa la arquitectura de cada web antes de diseñarla.</p>
    </Fragment>
    <PStack
      slot="aside"
      layers={[
        { label: 'Contactos desde Google', sub: 'el objetivo' },
        { label: 'Contenido que responde', sub: 'una búsqueda, una página' },
        { label: 'Encabezados y enlaces', sub: 'Google entiende la web' },
        { label: 'Rendimiento', sub: 'carga rápida en móvil' },
        { label: 'Rastreo e indexación', sub: 'Google puede leerla' },
      ]}
      caption="Esquema ilustrativo. Léelo de abajo arriba: sin rastreo ni velocidad, el contenido no llega a convertirse en contactos."
    />
    <PCards
      tone="soft"
      cols={2}
      variant="check"
      items={[
        { title: 'Estructura de páginas según las búsquedas del cliente', html: 'Antes de cerrar el mapa web estudiamos cómo busca tu cliente. Si busca cada servicio por separado, o con el nombre de su ciudad, cada búsqueda tendrá su propia página. Nosotros lo aplicamos con páginas propias de <a href="/diseno-web-para-pymes/barcelona/">diseño web en Barcelona</a>, <a href="/diseno-web-para-pymes/sabadell/">webs para pymes de Sabadell</a>, <a href="/diseno-web-para-pymes/sant-cugat/">diseño web en Sant Cugat</a> y <a href="/diseno-web-para-pymes/terrassa/">páginas web en Terrassa</a>, en lugar de una sola página genérica.' },
        { title: 'Encabezados, metadatos y enlaces internos', html: 'Un único H1 por página, encabezados que resumen cada sección, títulos y descripciones pensados para el resultado de Google y enlaces entre páginas relacionadas. Añadimos datos estructurados de empresa, servicios, productos o preguntas frecuentes, siempre fieles a lo que se ve en la página. Todo queda revisado en el entorno de pruebas antes de publicar.' },
        { title: 'Control de rastreo e indexación', html: 'Sitemap, robots.txt, etiquetas canónicas y noindex donde corresponde, para que Google dedique su tiempo a las páginas que importan. Comprobamos que ninguna página de pruebas, filtro o duplicado acabe en el índice. Al publicar damos de alta tu web en Search Console y enviamos el sitemap.' },
        { title: 'Redirecciones cuando sustituimos una web existente', html: 'Preparamos un mapa de redirecciones URL a URL antes de publicar, lo probamos en el entorno de pruebas y lo revisamos el día del lanzamiento. Es justo lo que falló antes de que <a href="/casos-exito/clustag/">recuperáramos el tráfico de Clustag</a>, que perdió su visibilidad por un cambio de dominio mal redirigido. Después seguimos tus páginas clave en Search Console.' },
      ]}
    />
  </PSection>

  <!-- ═══ RENDIMIENTO ════════════════════════════════════════════════════ -->
  <PSection kicker="Calidad" title="Rendimiento y calidad antes de publicar">
    <Fragment slot="intro">
      <p>Una web lenta pierde visitas antes de mostrar nada, y un formulario roto pierde contactos sin que nadie se entere. Por eso ninguna web sale sin pasar nuestra lista de comprobaciones de velocidad, funcionamiento y compatibilidad.</p>
      <p>Los anillos muestran resultados reales de PageSpeed Insights en proyectos nuestros, antes y después de trabajar la web.</p>
    </Fragment>
    <PRings
      rings={[
        { value: 46, label: 'CTS Formación', sub: 'antes · móvil', href: '/casos-exito/cts-formacion/' },
        { value: 100, label: 'CTS Formación', sub: 'después · móvil', href: '/casos-exito/cts-formacion/' },
        { value: 53, label: 'Clustag', sub: 'antes · escritorio', href: '/casos-exito/clustag/' },
        { value: 98, label: 'Clustag', sub: 'después · escritorio', href: '/casos-exito/clustag/' },
        { value: 100, label: 'Voltura Projects', sub: 'web nueva · escritorio', href: '/casos-exito/voltura-projects/' },
      ]}
      caption="Puntuación de rendimiento en PageSpeed Insights. Fíjate en si cada dato es de móvil o de escritorio y pulsa un anillo para ver el caso."
    />
    <PCards
      cols={4}
      variant="numbered"
      items={[
        { title: 'Optimización de imágenes y recursos', html: 'Imágenes en formatos modernos como WebP y al tamaño exacto en que se muestran, carga diferida de lo que queda fuera de pantalla, tipografías ligeras y solo el código que cada página necesita. Es la mejora que más se nota en el móvil, donde la conexión suele ser peor.' },
        { title: 'Comprobación de velocidad y Core Web Vitals', html: 'Medimos cada plantilla con PageSpeed Insights en móvil y escritorio. Corregimos lo que retrasa la carga, mueve el contenido o bloquea la interacción antes de dar la web por terminada. Así llevamos el <a href="/casos-exito/cts-formacion/">PageSpeed móvil de CTS Formación</a> de 46 a 100.' },
        { title: 'Pruebas de formularios, enlaces y navegación', html: 'Enviamos cada formulario y comprobamos que el aviso llega a la persona correcta. Revisamos enlaces rotos, menús y botones de llamada y de WhatsApp. También comprobamos que Analytics registra cada conversión, para que desde el primer día sepas cuántos contactos trae la web.' },
        { title: 'Revisión en dispositivos y navegadores', html: 'Probamos tu web en móviles Android e iPhone, tabletas y ordenadores, con Chrome, Safari, Firefox y Edge. Lo que se ve bien en la pantalla del diseñador tiene que verse igual de bien en la de tu cliente, sea cual sea su teléfono.' },
      ]}
    />
  </PSection>

  <!-- ═══ ECOMMERCE ══════════════════════════════════════════════════════ -->
  <PSection kicker="Tiendas online" title="Si vas a vender online, resolvemos todo el recorrido de compra" tone="soft" layout="split">
    <Fragment slot="intro">
      <p>En una tienda online, cada paso decide si el cliente compra o se va, desde que entra en una categoría hasta que recibe la confirmación del pedido. Diseñamos el recorrido completo y lo conectamos con tu forma de preparar y enviar pedidos.</p>
      <p>Es un proyecto de 6 a 8 semanas, desde 130 € al mes en 12 cuotas. Si tu catálogo es amplio o técnico, lo adaptamos como en nuestro <a href="/agencia-ecommerce/diseno-web/">diseño web para ecommerce</a>.</p>
    </Fragment>
    <PFunnel
      slot="aside"
      stages={[
        { label: 'Catálogo', sub: 'categorías y filtros', side: 'El comprador encuentra el producto.' },
        { label: 'Ficha de producto', sub: 'fotos, datos, precio', side: 'Resuelve sus dudas.' },
        { label: 'Carrito', sub: 'costes claros', side: 'Sin sorpresas al final.' },
        { label: 'Pago', sub: 'rápido y seguro', side: 'Pedido confirmado.' },
      ]}
      caption="Esquema ilustrativo: junto a cada etapa, lo que debe quedar resuelto antes de que el comprador pase a la siguiente."
    />
    <PCards
      tone="soft"
      cols={2}
      items={[
        { icon: ICON.layers, title: 'Catálogo y fichas de producto', html: 'Categorías ordenadas como las piensa tu cliente, filtros útiles que no generan páginas duplicadas y fichas con buenas fotos, medidas, materiales, plazo de entrega y preguntas frecuentes. Nuestra regla: la ficha debe responder lo mismo que respondería un vendedor en la tienda física.' },
        { icon: ICON.bag, title: 'Carrito y proceso de pago', html: 'Compra como invitado, pocos campos, gastos de envío visibles desde el principio y pasos claros hasta la confirmación. Antes de abrir la tienda recorremos el proceso completo con pedidos de prueba, para que nada falle el primer día de ventas.' },
        { icon: ICON.chart, title: 'Envíos, impuestos y métodos de cobro', html: 'Configuramos tarifas de envío por zona o por peso, recogida en tienda si la ofreces, IVA según el destino y los métodos de pago que esperan tus clientes, como tarjeta, Bizum, PayPal o transferencia. Lo dejamos todo alineado con cómo trabaja tu contabilidad.' },
        { icon: ICON.plug, title: 'Gestión de pedidos e integraciones', html: 'Emails de confirmación y de envío, estados de pedido y avisos de stock. Si trabajas con un ERP, un programa de facturación, un almacén o un transportista, estudiamos la integración para que no copies pedidos a mano. Para que esos compradores repitan, mira cómo trabajamos el <a href="/agencia-ecommerce/email-marketing/">email marketing para tiendas online</a>.' },
      ]}
    />
  </PSection>

  <!-- ═══ PROCESO ════════════════════════════════════════════════════════ -->
  <PSection kicker="Calendario" title="Así avanzará tu proyecto de principio a fin">
    <Fragment slot="intro">
      <p>Una web corporativa se entrega en 3 a 5 semanas. Trabajamos por fases y cierras cada una con tu validación, así no llegas al final con sorpresas sobre la estructura o el diseño. El calendario muestra cómo se solapan las fases.</p>
    </Fragment>
    <WebGantt
      weeks={5}
      phases={[
        { label: 'Alcance y materiales', sub: 'objetivos, accesos, textos y fotos', start: 1, end: 1 },
        { label: 'Estructura y propuesta visual', sub: 'mapa web y diseño de portada', start: 1, end: 2 },
        { label: 'Desarrollo y revisión', sub: 'maquetación, contenidos y ajustes', start: 2, end: 4 },
        { label: 'Publicación y comprobaciones', sub: 'lanzamiento, redirecciones y medición', start: 4, end: 5 },
      ]}
      caption="Ejemplo de calendario para una web corporativa. Una landing page se resuelve en 1 a 2 semanas y una tienda online en 6 a 8. El plazo depende de que los materiales y las revisiones lleguen a tiempo."
    />
    <PCards
      cols={4}
      variant="numbered"
      items={[
        { title: 'Definición del alcance y recopilación de materiales', html: 'En una reunión concretamos objetivos, páginas y funcionalidades, y lo dejamos por escrito. Después te enviamos la lista de lo que necesitamos: logotipo, textos existentes, fotos y accesos al dominio y a la web actual. Cuanto antes llegue, antes empieza el diseño.' },
        { title: 'Validación de estructura y propuesta visual', html: 'Te presentamos el mapa web y el diseño de la portada y de una página interna. No seguimos hasta que los validas, porque mover la estructura en la semana cuatro cuesta mucho más que hacerlo en la semana dos.' },
        { title: 'Desarrollo y revisión de la web', html: 'Construimos el resto de páginas en un entorno de pruebas al que tienes acceso desde el primer día. Cuando está completa, la revisas entera y recogemos tus comentarios en una ronda ordenada de ajustes, página por página.' },
        { title: 'Publicación y comprobaciones del lanzamiento', html: 'Publicamos en tu dominio, activamos las redirecciones, Analytics y Search Console, y repetimos las pruebas de formularios y velocidad sobre la web real. Durante los días siguientes vigilamos que todo funcione y que los contactos lleguen.' },
      ]}
    />
  </PSection>

  <!-- ═══ COLABORACIÓN ═══════════════════════════════════════════════════ -->
  <PSection kicker="Trabajo en equipo" title="Qué necesitamos de tu equipo y qué resolvemos nosotros" tone="soft">
    <Fragment slot="intro">
      <p>Tú conoces tu negocio y nosotros sabemos hacer webs. El proyecto avanza rápido cuando cada parte sabe qué le toca desde el primer día.</p>
      <p>Casi todos los retrasos vienen de materiales que no llegan o de revisiones que se alargan. Estas tres tarjetas explican cómo lo evitamos.</p>
    </Fragment>
    <PCards
      tone="soft"
      cols={3}
      items={[
        { icon: ICON.doc, title: 'Contenidos y materiales de partida', html: 'Te pedimos lo que solo tú tienes: información de servicios, fotos de proyectos y del equipo, logotipo y datos legales. Nosotros redactamos o adaptamos los textos a partir de una entrevista contigo y te decimos qué imágenes faltan. No tienes que escribir la web desde cero.' },
        { icon: ICON.users, title: 'Responsables de revisión y aprobación', html: 'Pedimos una persona de contacto que pueda aprobar y, como mucho, otra que revise. Cuantas más personas opinan sobre cada pantalla, más se alarga el proyecto y menos coherente queda el resultado. Las decisiones técnicas y de diseño las proponemos nosotros y te explicamos el motivo de cada una.' },
        { icon: ICON.layers, title: 'Organización de entregas y comentarios', html: 'Cada entrega llega con fecha y con una lista de lo que hay que revisar. Los comentarios se recogen en un único documento o sobre la propia web de pruebas, agrupados por página. Así nada se pierde en hilos de correo y cada ronda de ajustes se cierra antes de abrir la siguiente.' },
      ]}
    />
  </PSection>

  <!-- ═══ ENTREGA ════════════════════════════════════════════════════════ -->
  <PSection kicker="Entrega" title="Qué recibirás con la entrega de tu web" layout="split">
    <Fragment slot="intro">
      <p>Al terminar, la web queda en tus manos y no depende de nosotros. Recibes tres cosas: los accesos, una formación práctica y la documentación para que cualquier profesional pueda continuar el trabajo.</p>
    </Fragment>
    <PFlow
      slot="aside"
      highlight={false}
      steps={[
        { label: 'Accesos', sub: 'dominio, web, alojamiento' },
        { label: 'Formación', sub: 'sesión práctica' },
        { label: 'Documentación', sub: 'configuración y guía' },
      ]}
    />
    <PCards
      variant="rows"
      items={[
        { title: 'Accesos y propiedad de los activos acordados', html: 'Dominio registrado a nombre de tu empresa, alojamiento a tu nombre o transferido, acceso de administrador a la web y propiedad de las cuentas de Analytics y Search Console. Los textos, diseños e imágenes creados para el proyecto son tuyos. No hay permanencia: si un día cambias de proveedor, te llevas la web entera.' },
        { title: 'Formación para las tareas habituales', html: 'Una sesión práctica, que puedes grabar, para aprender a cambiar textos e imágenes, publicar una entrada del blog, añadir un producto o revisar los contactos recibidos. Practicas con tu propia web, no con una demo, y te quedas una guía breve para consultarla cuando la necesites.' },
        { title: 'Documentación y configuración del proyecto', html: 'Un documento con la tecnología usada, los plugins o servicios conectados, dónde está alojada la web, cómo se hacen las copias de seguridad, qué redirecciones se crearon y qué eventos se miden en Analytics. Con él, cualquier profesional puede seguir trabajando sobre tu web sin empezar a investigar desde cero.' },
      ]}
    />
  </PSection>

  <!-- ═══ DESPUÉS ════════════════════════════════════════════════════════ -->
  <PSection kicker="Después del lanzamiento" title="Después del lanzamiento, la web sigue evolucionando" tone="soft">
    <Fragment slot="intro">
      <p>Con el lanzamiento llegan las visitas reales y los primeros datos sobre qué funciona. A partir de ahí eliges: mantenimiento mensual, cambios puntuales con presupuesto cerrado o gestión por tu cuenta. En los tres casos, la web sigue siendo tuya.</p>
    </Fragment>
    <PCards
      tone="soft"
      cols={3}
      items={[
        { icon: ICON.refresh, title: 'Mantenimiento y actualizaciones', html: 'Actualizaciones de seguridad, copias de seguridad, revisión del alojamiento y del certificado SSL, y pequeños cambios de contenido cuando los necesites. Una web sin mantenimiento acumula fallos de seguridad y errores que suelen aparecer en el peor momento, como el día que lanzas una campaña.' },
        { icon: ICON.chart, title: 'Seguimiento de contactos y comportamiento', html: 'Medimos formularios, llamadas y clics en WhatsApp, y desde qué canal llega cada contacto. Con esos datos sabes si la web cumple su objetivo y decides dónde invertir el siguiente euro: en posicionamiento orgánico, en <a href="/agencia-sem-para-pymes/">publicidad en Google</a> o en nuevos contenidos para el blog.' },
        { icon: ICON.layers, title: 'Nuevas páginas y mejoras según las necesidades', html: 'Nuevos servicios, páginas para otras ciudades, landing pages para campañas, un segundo idioma o una tienda. Como la estructura se pensó para crecer, cada ampliación encaja sin rehacer lo anterior. Te la presupuestamos por escrito antes de hacerla, y los cambios pequeños entran en el mantenimiento si lo tienes contratado.' },
      ]}
    />
  </PSection>

  <!-- ═══ PRESUPUESTO ════════════════════════════════════════════════════ -->
  <PSection kicker="Precios" title="Cómo calculamos el presupuesto de tu página web" width="wide">
    <Fragment slot="intro">
      <p>Tarifas orientativas, sin IVA y sin permanencia. Antes de empezar recibes un presupuesto cerrado por escrito con todo lo que incluye.</p>
      <p>Para compararlo con otras opciones, consulta nuestra guía de <a href="/blog/cuanto-cuesta-una-web-para-una-pyme-en-2026/">cuánto cuesta una web para una pyme en 2026</a>.</p>
    </Fragment>
    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch reveal">
      {[
        { title: 'Landing page', price: 'desde 400 €', note: 'pago único · 1 a 2 semanas', items: ['Una página con un objetivo', 'Textos orientados a la acción', 'Formulario y llamada en un toque', 'Medición de conversiones', 'Lista para campañas'] },
