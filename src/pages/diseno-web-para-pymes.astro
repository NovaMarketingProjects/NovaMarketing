---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildAlternates } from '../lib/i18n';
import { localAgencySchema } from '../lib/schema';
import LogoMarquee from '../components/sections/LogoMarquee.astro';
import FaqHome from '../components/sections/FaqHome.astro';
import CityPills from '../components/global/CityPills.astro';
import MoreCases from '../components/casos/MoreCases.astro';
import PageBlocks from '../components/blocks/PageBlocks.astro';
import PSection from '../components/pillar/PSection.astro';
import PCards from '../components/pillar/PCards.astro';
import PFlow from '../components/pillar/PFlow.astro';
import PMatrix from '../components/pillar/PMatrix.astro';
import PStack from '../components/pillar/PStack.astro';
import PFunnel from '../components/pillar/PFunnel.astro';
import PTree from '../components/pillar/PTree.astro';
import PRings from '../components/pillar/PRings.astro';
import PCounter from '../components/pillar/PCounter.astro';
import WebGantt from '../components/pillar/WebGantt.astro';
import WebVersus from '../components/pillar/WebVersus.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://novamarketing.es';
const alternates = buildAlternates('/diseno-web-para-pymes/', '/ca/disseny-web-per-pimes/', SITE_URL);

const ICON = {
  building: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  bolt: 'M13 10V3L4 14h7v7l9-11h-7z',
  bag: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z',
  refresh: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
  chart: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm8 0V5a2 2 0 012-2h0a2 2 0 012 2v14a2 2 0 01-2 2h0a2 2 0 01-2-2zm-8 0a2 2 0 002 2h2a2 2 0 002-2V9a2 2 0 00-2-2h-2a2 2 0 00-2 2v10z',
  doc: 'M9 12h6m-6 4h6M9 8h2m8-3v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2h6l4 4z',
  compass: 'M12 3a9 9 0 100 18 9 9 0 000-18zm3.5 5.5l-2 5-5 2 2-5 5-2z',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  palette: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
  layers: 'M4 6h16M4 12h16M4 18h7',
  device: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
  access: 'M12 4a2 2 0 100 4 2 2 0 000-4zM5 9l7 1 7-1M12 10v4m0 0l-3 6m3-6l3 6',
  wp: 'M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z',
  plug: 'M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5m7.328-1.672a4 4 0 000-5.656 4 4 0 00-5.656 0l-1.5 1.5',
  pencil: 'M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z',
  users: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
};

const faqs = [
  { question: '¿Cuánto tiempo llevará crear mi web?', answer: 'Una landing page suele estar lista en una o dos semanas, una web corporativa en tres a cinco semanas y una tienda online en seis a ocho. El plazo cuenta desde que tenemos los textos, fotos y accesos necesarios, y depende sobre todo de lo rápido que se revisen las propuestas. Antes de empezar recibes un calendario con las fechas de cada entrega y cada revisión.' },
  { question: '¿Quién será propietario del dominio, la web y el alojamiento?', answer: 'Tú. El dominio se registra a nombre de tu empresa, el alojamiento se contrata a tu nombre o se te transfiere al terminar, y la web, los textos y las imágenes que hayamos creado para el proyecto son tuyos. Al entregar te damos todos los accesos de administrador. Si algún día cambias de proveedor, te llevas la web entera sin pedir permiso a nadie.' },
  { question: '¿Podré modificar los contenidos?', answer: 'Sí. Preparamos un panel de edición para que tu equipo pueda cambiar textos, imágenes, precios, entradas del blog o productos sin tocar código, y te formamos para hacerlo. Los cambios que afectan a la estructura o al diseño, como crear un tipo de página nuevo, sí conviene hacerlos con nosotros para no romper nada.' },
  { question: '¿Cómo protegéis el posicionamiento durante un rediseño?', answer: 'Antes de tocar nada exportamos las páginas que reciben visitas y enlaces, y decidimos qué se conserva, qué se fusiona y qué se elimina. Cada URL antigua que cambia tiene su redirección a la nueva. Tras publicar revisamos Search Console y las posiciones de las páginas importantes durante las semanas siguientes para corregir cualquier caída a tiempo.' },
  { question: '¿Qué sucede si necesito ampliar el proyecto?', answer: 'La web se construye para crecer. Puedes añadir páginas, servicios, idiomas, una tienda o integraciones más adelante. Cada ampliación se presupuesta por separado y por escrito antes de hacerla, y si tienes mantenimiento contratado, los cambios pequeños ya entran en él. Así no pagas hoy por funciones que quizá no necesites.' },
];

const pageSchema = localAgencySchema({
  pageUrl: `${SITE_URL}/diseno-web-para-pymes/`,
  lang: 'es',
  cityName: 'Barcelona',
  postalCode: '08035',
  geo: { lat: 41.4114, lng: 2.1526 },
  areaServed: ['España', 'Barcelona', 'Sabadell', 'Sant Cugat del Vallès', 'Terrassa', 'Vallès Occidental'],
  title: '▷ Diseño Web para PYMEs | Páginas rápidas y optimizadas',
  description: 'Diseño web para PYMEs: webs rápidas, optimizadas para SEO ✅ y pensadas para convertir visitas en clientes. Más información sobre nuestro enfoque profesional',
  datePublished: '2026-07-16',
  dateModified: '2026-10-25',
  streetAddress: 'Carrer del General Mendoza, 10',
  hasMap: 'https://maps.app.goo.gl/9fbB12UcK32bgjj89',
  aggregateRating: { ratingValue: '5.0', reviewCount: '12' },
  breadcrumbName: 'Diseño Web para PYMEs',
  mainService: {
    name: 'Diseño de páginas web para pymes',
    serviceType: 'Diseño web',
    description: 'Webs corporativas, landing pages y tiendas online para pymes, con SEO desde la planificación, propiedad del cliente y sin permanencia.',
    offers: [
      { name: 'Landing page', price: 400, from: true },
      { name: 'Web a medida', price: 120, from: true, monthly: true, description: 'En 12 cuotas.' },
      { name: 'Tienda online', price: 130, from: true, monthly: true, description: 'En 12 cuotas.' },
    ],
  },
  faqs,
});
---

<BaseLayout
  title="▷ Diseño Web para PYMEs | Páginas rápidas y optimizadas"
  description="Diseño web para PYMEs: webs rápidas, optimizadas para SEO ✅ y pensadas para convertir visitas en clientes. Más información sobre nuestro enfoque profesional"
  locale="es"
  alternates={alternates}
  schemas={[pageSchema]}
>

  <!-- ═══ HERO / H1 ═══════════════════════════════════════════════════════ -->
  <section class="pt-24 sm:pt-40 pb-20 px-4 sm:px-6 relative overflow-hidden text-center bg-white border-b border-black/5">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_40%,#000_75%,transparent_100%)]"></div>
    <div class="absolute -top-10 left-1/4 w-72 h-72 bg-accent/15 rounded-full blur-3xl opacity-30 animate-pulse"></div>
    <div class="absolute top-20 right-1/4 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl opacity-20"></div>

    <div class="max-w-5xl mx-auto reveal relative">
      <span class="inline-flex items-center gap-2 bg-accent/5 backdrop-blur-sm px-4 py-2 border border-accent/10 rounded-full text-accent text-[8px] sm:text-[10px] font-black uppercase tracking-[0.3em] mb-8 shadow-sm">
        <span class="w-1.5 h-1.5 bg-accent rounded-full animate-ping"></span>
        Diseño web para pymes
      </span>
      <h1 class="text-3xl sm:text-5xl md:text-7xl lg:text-8xl uppercase font-extrabold tracking-tighter leading-[0.88] mb-8 text-gradient flex flex-col items-center text-center">
                <span class="lg:whitespace-nowrap">Diseño Páginas Web </span>
                <span class="lg:whitespace-nowrap text-mktg-gradient">para PYMEs</span>
            </h1>
      <p class="text-lg sm:text-xl text-zinc-500 font-light leading-relaxed max-w-3xl mx-auto mb-8">
        Diseñamos y desarrollamos webs corporativas, landing pages y tiendas online que explican bien lo que haces, cargan rápido y llevan a tus visitas a contactar o comprar.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 mb-10">
        {['La web y el dominio a tu nombre', 'Sin permanencia', 'SEO desde la planificación'].map((item) => (
          <span class="inline-flex items-center gap-2 text-[11px] sm:text-xs font-black uppercase tracking-widest text-zinc-700">
            <svg class="w-4 h-4 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            {item}
          </span>
        ))}
      </div>
      <a href="#contacto" class="contact-modal-trigger btn-mktg-v5 shadow-[0_10px_30px_rgba(0,0,0,0.1)] !py-4 sm:!py-5 !px-6 sm:!px-10 !text-[11px] !tracking-widest font-black">HABLEMOS DE TU WEB</a>
    </div>
  </section>

  <LogoMarquee />

  <!-- ═══ OBJETIVO ═══════════════════════════════════════════════════════ -->
  <PSection kicker="Antes de diseñar" title="Tu próxima web empieza por lo que necesita conseguir tu empresa">
    <Fragment slot="intro">
      <p>Una web no se encarga para tener web. Se encarga para que lleguen más peticiones de presupuesto, para vender online, para filtrar mejor a los clientes o para dejar de explicar lo mismo por teléfono cada día. <strong>Ese objetivo decide qué páginas hacen falta, qué se cuenta en cada una y qué tiene que hacer el visitante al final.</strong></p>
      <p>Por eso empezamos por tu negocio y no por la plantilla. Diseñamos la web como parte de tu captación de clientes, conectada con el <a href="/agencia-seo-para-pymes/">posicionamiento en Google</a> y con el resto del <a href="/">marketing digital de tu pyme</a>, para que el trabajo no termine el día del lanzamiento.</p>
    </Fragment>
    <PFlow
      steps={[
        { label: 'Objetivo de negocio', sub: 'contactos, ventas, reservas' },
        { label: 'Estructura', sub: 'qué páginas y en qué orden' },
        { label: 'Contenido', sub: 'qué dice cada página' },
        { label: 'Diseño', sub: 'marca, lectura y uso' },
        { label: 'Lanzamiento', sub: 'medido desde el primer día' },
      ]}
      caption="El orden en el que trabajamos. El diseño visual llega cuando ya sabemos qué tiene que conseguir cada página."
    />
  </PSection>

  <!-- ═══ TIPO DE PROYECTO ═══════════════════════════════════════════════ -->
  <PSection kicker="Tipos de proyecto" title="Elige el tipo de proyecto que encaja contigo" tone="soft">
    <Fragment slot="intro">
      <p>La mayoría de pymes llega con una de estas cuatro necesidades. Si no tienes claro cuál es la tuya, lo vemos juntos en la primera conversación. A veces lo que parece un rediseño completo se resuelve con una buena landing, y al revés.</p>
    </Fragment>
    <PCards
      tone="soft"
      cols={2}
      items={[
        { icon: ICON.building, tag: 'Desde 120 €/mes · 3 a 5 semanas', title: 'Web corporativa para presentar tu empresa', html: 'Para empresas de servicios, despachos, clínicas o fabricantes que necesitan explicar qué hacen, para quién y por qué son de fiar. Incluye páginas de servicio, quiénes sois, casos o proyectos y contacto. Es el formato habitual en <a href="/agencia-b2b/diseno-web/">empresas B2B</a> e <a href="/agencia-industrial/diseno-web/">industriales</a>, donde el comprador compara mucho antes de llamar.' },
        { icon: ICON.bolt, tag: 'Desde 400 € · 1 a 2 semanas', title: 'Landing page para una oferta o campaña', html: 'Una sola página con un único objetivo, pensada para recibir tráfico de anuncios o de una campaña concreta. Sin menú que distraiga, con la oferta clara, pruebas de confianza y un formulario o botón de llamada siempre a mano. Funciona especialmente bien junto a una <a href="/agencia-sem-para-pymes/">campaña de Google Ads</a> bien segmentada.' },
        { icon: ICON.bag, tag: 'Desde 130 €/mes · 6 a 8 semanas', title: 'Tienda online para vender productos', html: 'Catálogo, fichas de producto, carrito, pago, envíos y gestión de pedidos, todo pensado para que el comprador no abandone por el camino. Te ayudamos a decidir la plataforma según tu catálogo y tu forma de trabajar. Tienes más detalle en nuestro <a href="/agencia-ecommerce/diseno-web/">diseño de tiendas online</a>.' },
        { icon: ICON.refresh, tag: 'Según alcance', title: 'Rediseño de una web que se ha quedado atrás', html: 'Para webs lentas, difíciles de editar o que ya no representan a la empresa. Partimos de lo que funciona hoy y protegemos el posicionamiento conseguido. Si dudas de si hace falta, repasa antes <a href="/blog/como-saber-si-tu-web-esta-bien-hecha/">cómo saber si tu web está bien hecha</a>.' },
      ]}
    />
  </PSection>

  <!-- ═══ WEB EXISTENTE ══════════════════════════════════════════════════ -->
  <PSection kicker="Rediseño" title="Si ya tienes web, decidimos qué merece conservarse" layout="split">
    <Fragment slot="intro">
      <p>Rehacer una web no significa tirar todo lo anterior. Antes de diseñar revisamos los datos de Analytics y Search Console, el contenido publicado y la tecnología, y clasificamos cada página según lo que aporta y lo que costaría mejorarla.</p>
      <p>Esa revisión evita el error más caro de un rediseño, perder en una semana el tráfico que costó años conseguir.</p>
    </Fragment>
    <PMatrix
      slot="aside"
      xLabel="Trabajo necesario"
      yLabel="Valor para el negocio"
      quadrants={['Conservar', 'Mejorar', 'Redirigir o fusionar', 'Eliminar']}
      points={[
        { label: 'Servicio que posiciona', x: 18, y: 86 },
        { label: 'Guía con visitas', x: 32, y: 66 },
        { label: 'Página de contacto', x: 72, y: 80 },
        { label: 'Noticias duplicadas', x: 26, y: 28 },
        { label: 'Promoción caducada', x: 76, y: 18 },
      ]}
      caption="Ejemplo de cómo clasificamos las páginas de una web existente antes de un rediseño."
    />
    <PCards
      variant="rows"
      items={[
        { title: 'Páginas que atraen visitas y contactos', html: 'Identificamos qué URLs reciben tráfico desde Google, cuáles tienen enlaces de otras webs y desde cuáles llegan los formularios y las llamadas. Esas páginas se conservan con su dirección o se redirigen a su equivalente nueva. Si no sabes de dónde llega hoy tu tráfico, empieza por <a href="/blog/donde-viene-el-trafico/">de dónde viene el tráfico de tu web</a>.' },
        { title: 'Contenidos y recursos que siguen siendo útiles', html: 'Artículos que todavía responden dudas reales, fichas técnicas, preguntas frecuentes o proyectos que demuestran experiencia. Muchos solo necesitan una actualización de datos y formato. Lo que está obsoleto o repetido se fusiona con otra página o se elimina, siempre con su redirección.' },
        { title: 'Problemas de navegación y conversión', html: 'Menús con demasiadas opciones, servicios escondidos, formularios largos o un teléfono que no se puede pulsar en móvil. Revisamos el recorrido de una visita real hasta el contacto y anotamos cada punto donde se pierde gente, porque eso es lo primero que el nuevo diseño tiene que resolver.' },
        { title: 'Tecnología que condiciona el nuevo proyecto', html: 'Plataforma, alojamiento, plugins, integraciones y quién tiene los accesos. A veces la web puede rehacerse sobre la misma base y otras la tecnología es el problema. En <a href="/casos-exito/clustag/">Clustag</a> mantuvimos su WordPress y lo optimizamos, y en <a href="/casos-exito/cts-formacion/">CTS Formación</a> hubo que salir de la plataforma de un proveedor externo.' },
      ]}
    />
  </PSection>

  <!-- ═══ MAPA DE LA WEB ═════════════════════════════════════════════════ -->
  <PSection kicker="Arquitectura" title="Del objetivo de negocio al mapa de la web" tone="soft">
    <Fragment slot="intro">
      <p>Con el objetivo claro dibujamos el mapa de la web, qué páginas tendrá, cómo se agrupan y cómo se enlazan entre sí. Es un documento sencillo que validas antes de que exista una sola línea de diseño, y el que más problemas evita después.</p>
    </Fragment>
    <PTree
      root="Web de un despacho profesional"
      branches={[
        { label: 'Servicios', leaves: ['Una página por servicio', 'Precios orientativos'] },
        { label: 'Sectores o casos', leaves: ['Proyectos reales', 'Testimonios'] },
        { label: 'Sobre el equipo', leaves: ['Experiencia', 'Colegiaciones'] },
        { label: 'Recursos', leaves: ['Guías y artículos', 'Preguntas frecuentes'] },
        { label: 'Contacto', leaves: ['Formulario', 'Teléfono y ubicación'] },
      ]}
      caption="Esquema ilustrativo de un mapa web. Cada proyecto tiene el suyo, según sus servicios y clientes."
    />
    <PCards
      tone="soft"
      cols={2}
      variant="numbered"
      items={[
        { title: 'Qué necesita encontrar cada tipo de cliente', html: 'Un paciente nuevo busca tratamientos, precio y cita; un responsable de compras busca fichas técnicas y referencias. Definimos quién visita tu web y qué pregunta trae, como hacemos en las webs para <a href="/agencia-dentistas/diseno-web/">clínicas dentales</a>, <a href="/agencia-psicologos/diseno-web/">psicólogos</a> o <a href="/agencia-terapeutas/diseno-web/">terapeutas</a>, donde la confianza pesa más que el precio.' },
        { title: 'Cómo organizamos servicios y contenidos', html: 'Una página propia para cada servicio importante, agrupadas de forma que el visitante no tenga que adivinar. En <a href="/casos-exito/villazon-merce-abogados/">Villazón Mercé Abogados</a> creamos una página por cada área penal, y en <a href="/casos-exito/voltura-projects/">Voltura Projects</a>, páginas para las ciudades donde trabajan. Más ejemplos en nuestras webs para <a href="/agencia-abogados/diseno-web/">abogados</a>.' },
        { title: 'Qué recorrido conduce al contacto o la compra', html: 'Definimos el camino desde la página por la que se entra hasta el formulario, la llamada, la reserva o el pedido, y lo acortamos todo lo posible. En las webs de <a href="/agencia-restaurantes/diseno-web/">restaurantes</a> y <a href="/agencia-hoteles/diseno-web/">hoteles</a>, por ejemplo, la reserva tiene que estar a uno o dos toques desde cualquier página.' },
        { title: 'Qué páginas necesita el lanzamiento', html: 'No todo tiene que estar el primer día. Separamos lo imprescindible para publicar, normalmente portada, servicios, quiénes somos, contacto y textos legales, de lo que puede llegar después, como el blog o nuevas secciones. Así la web sale antes y crece con datos reales de uso.' },
      ]}
    />
  </PSection>

  <!-- ═══ TEXTOS ═════════════════════════════════════════════════════════ -->
  <PSection kicker="Contenidos" title="Textos que explican por qué elegir tu empresa">
    <Fragment slot="intro">
      <p>El diseño atrae la mirada, pero quien decide es el texto. Redactamos o editamos los contenidos contigo, porque nadie conoce mejor que tu equipo lo que preguntan los clientes y por qué acaban eligiéndoos.</p>
      <p>Escribimos para personas que llegan con prisa desde el móvil, con frases cortas, respuestas concretas y la información que suele faltar en las webs de pymes, como plazos, precios orientativos o cómo se trabaja.</p>
    </Fragment>
    <PCards
      cols={2}
      items={[
        { icon: ICON.compass, title: 'Una propuesta de valor fácil de entender', html: 'En la primera pantalla el visitante tiene que saber qué haces, para quién y qué debe hacer a continuación. Lo resumimos en un titular y una frase de apoyo, sin expresiones huecas como "soluciones integrales" o "calidad y profesionalidad", que no ayudan a nadie a decidir.' },
        { icon: ICON.doc, title: 'Servicios descritos desde la necesidad del cliente', html: 'Cada página de servicio empieza por el problema que resuelve y después explica qué incluye, cómo se trabaja, cuánto tarda y qué cuesta aproximadamente. Es la diferencia entre un catálogo de servicios y una página que responde a lo que el cliente está buscando en Google.' },
        { icon: ICON.chart, title: 'Experiencia y pruebas que generan confianza', html: 'Proyectos con fotos reales, reseñas, años en el sector, certificaciones y datos medibles. En webs de <a href="/agencia-constructoras/diseno-web/">constructoras</a> o <a href="/agencia-inmobiliarias/diseno-web/">inmobiliarias</a> los proyectos documentados pesan más que cualquier eslogan. Nosotros hacemos lo mismo con nuestros <a href="/casos-exito/">casos de éxito</a>.' },
        { icon: ICON.bolt, title: 'Llamadas a la acción según cada página', html: 'No todas las páginas piden lo mismo. Un servicio invita a pedir presupuesto, un artículo a seguir leyendo o descargar una guía, y la página de un <a href="/agencia-gimnasios/diseno-web/">gimnasio</a> a probar una clase. Cada llamada se adapta al momento del visitante y se mide para saber cuál funciona.' },
      ]}
    />
  </PSection>

  <!-- ═══ DISEÑO ═════════════════════════════════════════════════════════ -->
  <PSection kicker="Diseño" title="Un diseño que representa tu marca y facilita el uso" tone="soft">
    <Fragment slot="intro">
      <p>Un buen diseño web no es el más llamativo, es el que hace que tu empresa parezca lo que es y que cualquiera encuentre lo que busca sin pensar. Partimos de tu identidad y la adaptamos a cómo se lee y se usa una web hoy, sobre todo en el móvil.</p>
    </Fragment>
    <div class="mt-12 reveal">
      <PageBlocks blocks={[{
        __component: 'blocks.image-compare',
