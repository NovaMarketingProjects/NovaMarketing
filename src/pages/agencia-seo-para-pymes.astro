---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildAlternates } from '../lib/i18n';
import { localAgencySchema } from '../lib/schema';
import LogoMarquee from '../components/sections/LogoMarquee.astro';
import FaqHome from '../components/sections/FaqHome.astro';
import CityPills from '../components/global/CityPills.astro';
import GoogleReviews from '../components/global/GoogleReviews.astro';
import MoreCases from '../components/casos/MoreCases.astro';
import PSection from '../components/pillar/PSection.astro';
import PCards from '../components/pillar/PCards.astro';
import PFlow from '../components/pillar/PFlow.astro';
import PBars from '../components/pillar/PBars.astro';
import PMatrix from '../components/pillar/PMatrix.astro';
import PStack from '../components/pillar/PStack.astro';
import PFunnel from '../components/pillar/PFunnel.astro';
import PTree from '../components/pillar/PTree.astro';
import PLines from '../components/pillar/PLines.astro';
import PCounter from '../components/pillar/PCounter.astro';
import PSerp from '../components/pillar/PSerp.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://novamarketing.es';
const alternates = buildAlternates('/agencia-seo-para-pymes/', '/ca/agencia-seo-per-pimes/', SITE_URL);

const ICON = {
  search: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  target: 'M12 3a9 9 0 100 18 9 9 0 000-18zm0 5a4 4 0 100 8 4 4 0 000-8z',
  doc: 'M9 12h6m-6 4h6M9 8h2m8-3v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2h6l4 4z',
  link: 'M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5m7.328-1.672a4 4 0 000-5.656 4 4 0 00-5.656 0l-1.5 1.5',
  chart: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm8 0V5a2 2 0 012-2h0a2 2 0 012 2v14a2 2 0 01-2 2h0a2 2 0 01-2-2zm-8 0a2 2 0 002 2h2a2 2 0 002-2V9a2 2 0 00-2-2h-2a2 2 0 00-2 2v10z',
  money: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  users: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
};

const faqs = [
  { question: '¿Cuándo puede empezar a notarse el trabajo SEO?', answer: 'Los primeros movimientos de posiciones suelen verse entre el segundo y el tercer mes, y los resultados consolidados entre el sexto y el duodécimo. Depende del punto de partida de tu web, de la competencia del sector y de cuántas mejoras se pueden aplicar al principio. En la auditoría te decimos qué esperar en cada fase, sin plazos inventados.' },
  { question: '¿Qué incluye la cuota mensual?', answer: 'Incluye el trabajo acordado en el plan de cada mes: mejoras técnicas, optimización y creación de contenidos, enlazado interno, SEO local y, en los planes que lo contemplan, captación de enlaces. También la medición y un informe mensual con lo realizado, la evolución de las páginas trabajadas y los contactos que llegan desde Google.' },
  { question: '¿Podéis trabajar sobre mi web actual?', answer: 'Sí. La mayoría de proyectos parten de una web existente, ya sea WordPress, Shopify, PrestaShop o un desarrollo a medida. Solo recomendamos rehacerla cuando la tecnología impide aplicar las mejoras necesarias, y en ese caso planificamos la migración para no perder el posicionamiento conseguido.' },
  { question: '¿Qué necesitáis de mi equipo?', answer: 'Accesos a la web, Google Search Console, Google Analytics y el Perfil de Empresa en Google, y una persona de contacto que conozca el negocio. Al principio te pediremos información sobre tus servicios, clientes y márgenes. Después, sobre todo, revisiones puntuales de los contenidos que publicamos.' },
  { question: '¿Cómo se relacionan el SEO y la visibilidad en IA?', answer: 'Los asistentes de IA y las respuestas generadas de Google se apoyan en contenido que ya está bien posicionado, bien estructurado y citado por otras fuentes. Un buen trabajo SEO es la base del GEO. Si quieres trabajar de forma específica tu presencia en ChatGPT, Gemini o Perplexity, lo hacemos dentro de nuestro servicio de agencia GEO.' },
  { question: '¿Qué condiciones tiene el servicio?', answer: 'Trabajamos mes a mes, sin permanencia. Antes de empezar recibes un presupuesto cerrado por escrito con el alcance de cada mes. Las cuentas, la web y los datos son siempre tuyos, y si decides terminar el servicio te entregamos todo el trabajo y la documentación.' },
];

const pageSchema = localAgencySchema({
  pageUrl: `${SITE_URL}/agencia-seo-para-pymes/`,
  lang: 'es',
  cityName: 'Barcelona',
  postalCode: '08035',
  geo: { lat: 41.4114, lng: 2.1526 },
  areaServed: ['España', 'Barcelona', 'Sabadell', 'Sant Cugat del Vallès', 'Terrassa', 'Vallès Occidental'],
  title: '▷ Agencia SEO para PYMEs | Posicionamiento orgánico efectivo',
  description: 'Agencia SEO especializada en PYMEs con estrategias a medida 💡 sin permanencias y con informes claros ✅. Conoce cómo trabajamos para aparecer en Google.',
  datePublished: '2026-07-15',
  dateModified: '2026-10-25',
  streetAddress: 'Carrer del General Mendoza, 10',
  hasMap: 'https://maps.app.goo.gl/9fbB12UcK32bgjj89',
  aggregateRating: { ratingValue: '5.0', reviewCount: '12' },
  breadcrumbName: 'Agencia SEO para PYMEs',
  mainService: {
    name: 'Posicionamiento SEO para pymes',
    serviceType: 'Posicionamiento SEO',
    description: 'Auditoría, estrategia y acompañamiento SEO mensual para pymes: SEO técnico, contenidos, autoridad y SEO local, medido en contactos y ventas.',
    offers: [
      { name: 'Auditoría y estrategia SEO inicial', price: 1800 },
      { name: 'Acompañamiento SEO mensual', price: 400, from: true, monthly: true },
      { name: 'SEO para proyectos de mayor alcance', price: 900, from: true, monthly: true },
    ],
  },
  faqs,
});
---

<BaseLayout
  title="▷ Agencia SEO para PYMEs | Posicionamiento orgánico efectivo"
  description="Agencia SEO especializada en PYMEs con estrategias a medida 💡 sin permanencias y con informes claros ✅. Conoce cómo trabajamos para aparecer en Google."
  locale="es"
  alternates={alternates}
  schemas={[pageSchema]}
>

  <!-- ═══ HERO / H1 ═══════════════════════════════════════════════════════ -->
  <section class="pt-24 sm:pt-40 pb-20 px-4 sm:px-6 relative overflow-hidden text-center bg-white border-b border-black/5">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_40%,#000_75%,transparent_100%)]"></div>
    <div class="absolute -top-10 left-1/4 w-72 h-72 bg-accent/15 rounded-full blur-3xl opacity-30 animate-pulse"></div>
    <div class="absolute top-20 right-1/4 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl opacity-20"></div>

    <div class="max-w-5xl mx-auto reveal relative">
      <span class="inline-flex items-center gap-2 bg-accent/5 backdrop-blur-sm px-4 py-2 border border-accent/10 rounded-full text-accent text-[8px] sm:text-[10px] font-black uppercase tracking-[0.3em] mb-8 shadow-sm">
        <span class="w-1.5 h-1.5 bg-accent rounded-full animate-ping"></span>
        Posicionamiento web para pymes
      </span>
      <h1 class="text-3xl sm:text-5xl md:text-7xl lg:text-8xl uppercase font-extrabold tracking-tighter leading-[0.88] mb-8 text-gradient flex flex-col items-center text-center">
                <span class="lg:whitespace-nowrap">Agencia SEO </span>
                <span class="lg:whitespace-nowrap text-mktg-gradient">para PYMEs</span>
            </h1>
      <p class="text-lg sm:text-xl text-zinc-500 font-light leading-relaxed mb-8">
        Hacemos que tu empresa aparezca en Google cuando tus clientes buscan lo que vendes, y medimos el trabajo en contactos y ventas. En Superwagen, los leads desde SEO pasaron de 10-15 a más de 50 al mes.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 mb-10">
        {['Sin permanencias', 'Trato directo con el consultor', 'Informes de negocio'].map((item) => (
          <span class="inline-flex items-center gap-2 text-[11px] sm:text-xs font-black uppercase tracking-widest text-zinc-700">
            <svg class="w-4 h-4 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            {item}
          </span>
        ))}
      </div>
      <a href="#contacto" class="contact-modal-trigger btn-mktg-v5 shadow-[0_10px_30px_rgba(0,0,0,0.1)] !py-4 sm:!py-5 !px-6 sm:!px-10 !text-[11px] !tracking-widest font-black">HABLEMOS DE TU NEGOCIO</a>
    </div>
  </section>

  <LogoMarquee />

  <!-- ═══ OPORTUNIDAD ═══════════════════════════════════════════════════ -->
  <PSection kicker="Por qué SEO" title="Convierte las búsquedas de tus clientes en oportunidades de negocio" layout="split">
    <Fragment slot="intro">
      <p>Cada día alguien escribe en Google el servicio que ofreces o el problema que resuelves. <strong>Esa búsqueda es una necesidad con fecha de hoy</strong>, y la empresa que aparece con una respuesta clara suele quedarse con el contacto.</p>
      <p>Nova es una <a href="/">agencia de marketing digital para pymes</a> que trata el posicionamiento SEO como un canal comercial más. Lo coordinamos con tus <a href="/agencia-sem-para-pymes/">campañas de Google Ads</a> y tu <a href="/agencia-geo-para-pymes/">visibilidad en asistentes de IA</a>, y lo medimos con una cifra: cuántos clientes nuevos llegan cada mes desde el buscador. Los esquemas muestran el recorrido que trabajamos, de la búsqueda al contacto.</p>
    </Fragment>
    <PSerp
      slot="aside"
      query="reformas integrales en Sabadell"
      results={[
        { url: 'tuempresa.es › reformas-integrales', title: 'Reformas integrales en Sabadell · Presupuesto en 48 h', desc: 'Pisos, locales y casas. Precios orientativos, plazos y proyectos reales en el Vallès.', highlight: true, label: 'Tu empresa' },
        { url: 'competidor-a.com', title: 'Empresa de reformas | Reformas en Barcelona y alrededores', desc: 'Más de 20 años de experiencia en reformas de todo tipo.' },
        { url: 'directorio-reformas.es › sabadell', title: 'Las 10 mejores empresas de reformas en Sabadell', desc: 'Compara opiniones y pide presupuesto a varias empresas.' },
      ]}
      caption="Ilustración. Fíjate en el primer resultado: servicio y ciudad en el título, y precio, plazo y pruebas en la descripción."
    />
    <PFlow
      steps={[
        { label: 'Búsqueda con intención', sub: '«agencia de reformas en Sabadell»' },
        { label: 'Tu página en Google', sub: 'resultado orgánico o mapa' },
        { label: 'Página que responde', sub: 'servicio, precio, pruebas' },
        { label: 'Contacto o venta', sub: 'llamada, formulario, pedido' },
      ]}
      caption="El recorrido que optimizamos. Si falla un eslabón, las visitas no se convierten en clientes."
    />
  </PSection>

  <!-- ═══ QUÉ FRENA EL POSICIONAMIENTO ═══════════════════════════════════ -->
  <PSection kicker="Diagnóstico" title="Qué está frenando el posicionamiento de tu empresa" tone="soft">
    <Fragment slot="intro">
      <p>Cuando una web no capta clientes desde Google casi nunca hay una sola causa. Estos son los seis bloqueos que más encontramos en webs de pymes. Saber cuál es el tuyo decide por dónde empezamos.</p>
    </Fragment>
    <PCards
      tone="soft"
      items={[
        { icon: ICON.search, title: 'Tus páginas importantes no aparecen en Google', html: 'Páginas de servicio sin indexar, bloqueadas por un error de configuración o tan escondidas en el menú que Google apenas las visita. Si una página no está en el índice, no puede posicionar, por bueno que sea su texto. Es lo primero que revisamos en Search Console, porque a veces una sola línea deja fuera media web.' },
        { icon: ICON.users, title: 'Recibes visitas que no se convierten en contactos', html: 'Llegan visitas desde búsquedas que no tienen relación con lo que vendes, o páginas que posicionan pero no explican por qué elegirte. Si la página no muestra precio orientativo, pruebas y un contacto visible, el problema está en la web. Ahí entra el <a href="/diseno-web-para-pymes/">diseño web orientado a conversión</a>, y te lo decimos antes de que pagues por más tráfico.' },
        { icon: ICON.target, title: 'Tu competencia ocupa las búsquedas más rentables', html: 'Tus competidores tienen una página para cada servicio y zona, y tú una sola página genérica que intenta posicionar por todo. Google elige la respuesta más precisa. Cuando <a href="/casos-exito/villazon-merce-abogados/">Villazón Mercé Abogados</a> pasó de una lista genérica de servicios a una página por delito, su web nueva sumó 191 keywords en dos meses.' },
        { icon: ICON.code, title: 'Tu web arrastra problemas técnicos', html: 'Lentitud en móvil, contenido duplicado, redirecciones en cadena o plantillas que generan cientos de URLs sin valor. Tus clientes no lo ven, pero Google gasta su rastreo en páginas que no venden. Si quieres hacer una primera revisión por tu cuenta, empieza por esta guía para <a href="/blog/como-saber-si-tu-web-esta-bien-hecha/">saber si tu web está bien hecha</a>.' },
        { icon: ICON.doc, title: 'Tus contenidos no responden a lo que busca el cliente', html: 'Textos escritos desde la empresa y no desde la duda del cliente: sin precios orientativos, sin plazos, sin ejemplos. Quien busca «reforma de baño completo» quiere saber cuánto cuesta y cuánto tarda. Entender la <a href="/blog/que-es-la-intencion-de-busqueda-en-el-seo/">intención de búsqueda del cliente</a> marca la diferencia entre una página que posiciona y otra que solo ocupa espacio.' },
        { icon: ICON.money, title: 'Dependencia de la publicidad para conseguir visitas', html: 'Si apagas los anuncios y los contactos desaparecen, tu negocio alquila su visibilidad. El SEO construye un canal propio que sigue trayendo visitas cuando paras la inversión, como ves en el gráfico. A menudo conviene combinar los dos: te explicamos cuándo usar cada uno en <a href="/blog/que-necesita-una-pyme-seo-o-sem/">qué necesita una pyme, SEO o SEM</a>.' },
      ]}
    />
    <PLines
      title="Visitas mensuales según el canal"
      series={[
        { label: 'Solo publicidad', points: [10, 48, 50, 49, 51, 50, 49, 8, 6, 5, 5, 5], color: '#a1a1aa' },
        { label: 'Posicionamiento SEO', points: [8, 10, 14, 19, 25, 31, 38, 44, 50, 56, 61, 66] },
      ]}
      xLabels={['Mes 1', '', '', 'Mes 4', '', '', '', 'Mes 8', '', '', '', 'Mes 12']}
      marker={{ at: 7, label: 'Se pausa la inversión en anuncios' }}
      caption="Esquema ilustrativo, no son datos de un cliente. Fíjate en el mes 8: al pausar los anuncios, sus visitas caen casi a cero, mientras las del SEO siguen subiendo."
    />
  </PSection>

  <!-- ═══ MOMENTO DE LA PYME ════════════════════════════════════════════ -->
  <PSection kicker="Punto de partida" title="Una estrategia SEO adaptada al momento de tu pyme">
    <Fragment slot="intro">
      <p>El orden de las prioridades depende de dónde está tu web hoy. Una web que nunca ha trabajado el SEO necesita cosas distintas que una que ha perdido la mitad del tráfico tras una actualización de Google. Busca tu caso entre estos cinco.</p>
    </Fragment>
    <PCards
      variant="numbered"
      items={[
        { title: 'Empresas que empiezan a trabajar su posicionamiento', html: 'Primero, que Google pueda rastrear e indexar bien la web. Después, una página sólida por cada servicio principal y el <a href="#seo-local">Perfil de Empresa en Google</a> completo, que son las mejoras que antes se notan. Los primeros movimientos suelen verse entre el segundo y el tercer mes, como explicamos en <a href="/blog/cuanto-tarda-el-seo-en-dar-resultados-en-una-pyme/">cuánto tarda el SEO en una pyme</a>.' },
        { title: 'Negocios con tráfico estancado', html: 'Revisamos qué páginas están entre la posición 5 y la 20 sin terminar de subir, qué búsquedas se reparten entre varias URLs y qué páginas de la competencia responden mejor. Casi siempre hay margen sin crear nada desde cero: mejorar títulos, completar contenido y reforzar el enlazado interno hacia las páginas que venden.' },
        { title: 'Webs que han perdido visibilidad', html: 'Cruzamos las fechas de caída con actualizaciones de Google, cambios en la web y migraciones. Hasta saber la causa no tocamos nada, porque una corrección equivocada puede agravar la pérdida. Es lo que le pasó a <a href="/casos-exito/clustag/">Clustag</a>: una migración con las redirecciones mal hechas la dejó sin tráfico orgánico, y hoy recibe 678 visitas orgánicas al mes.' },
        { title: 'Pymes que quieren abrir nuevos mercados', html: 'Nuevas ciudades, nuevos servicios o un segundo idioma. Planificamos la arquitectura antes de publicar para que cada mercado tenga sus propias páginas y no compitan entre sí. Por ejemplo, una versión en catalán con sus propias URLs y etiquetas hreflang, o una página por ciudad solo donde de verdad atiendes clientes.' },
        { title: 'Empresas que necesitan cambiar de agencia SEO', html: 'Hacemos una revisión independiente del trabajo anterior, recuperamos los accesos que falten y mantenemos lo que funciona. Revisamos también los enlaces de baja calidad y los contenidos duplicados que puedan estar lastrando la web. Cambiar de agencia no te obliga a empezar de cero.' },
      ]}
    />
  </PSection>

  <!-- ═══ AUDITORÍA ══════════════════════════════════════════════════════ -->
  <PSection id="auditoria" kicker="Auditoría SEO" title="La auditoría que ordena tus prioridades" tone="soft" layout="split">
    <Fragment slot="intro">
      <p>Antes de proponer nada, auditamos. Medimos tu visibilidad real, revisamos la salud técnica de la web y la comparamos con tus competidores directos. <strong>El resultado es un diagnóstico que entiende cualquier gerente</strong>, con cada tarea colocada según lo que aporta y lo que cuesta, como en la matriz.</p>
      <p>Si ya trabajas con otra agencia, la auditoría sirve también como segunda opinión independiente sobre lo que estás pagando.</p>
    </Fragment>
    <PMatrix
      slot="aside"
      xLabel="Esfuerzo"
      yLabel="Impacto"
      quadrants={['Hacer primero', 'Planificar', 'Si sobra tiempo', 'Descartar']}
      points={[
        { label: 'Desbloquear indexación', x: 14, y: 86 },
        { label: 'Títulos de servicio', x: 30, y: 70 },
        { label: 'Nueva arquitectura', x: 78, y: 82 },
        { label: 'Páginas por zona', x: 64, y: 62 },
        { label: 'Retoques menores', x: 26, y: 24 },
      ]}
      caption="Ejemplo de priorización. Lo que queda arriba a la izquierda, mucho impacto y poco esfuerzo, se hace la primera semana."
    />
    <PCards
      variant="rows"
      tone="soft"
      items={[
        { title: 'Rastreo e indexación de las páginas relevantes', html: 'Comprobamos qué páginas ve Google, cuáles indexa y cuáles se quedan fuera, cruzando Search Console con un rastreo completo de la web. Recibes la lista de páginas de negocio que no están en el índice y el motivo de cada una: un noindex olvidado, una canónica mal puesta o una página sin enlaces internos.' },
        { title: 'Arquitectura y distribución de la autoridad interna', html: 'Medimos a cuántos clics de la portada están tus páginas de negocio y cuántos enlaces internos recibe cada una. Las páginas que más venden deben ser las más fáciles de encontrar, para Google y para tus clientes. Si tu servicio estrella está a cuatro clics y el blog ocupa la portada, lo verás en el informe.' },
        { title: 'Rendimiento de contenidos y palabras clave', html: 'Detectamos qué páginas atraen tráfico, cuáles se quedan cerca del top 10 sin entrar y cuáles compiten entre sí por la misma búsqueda. Trabajamos con Search Console y Semrush, dos de las <a href="/blog/mejores-herramientas-seo-para-pymes/">herramientas SEO para pymes</a> que analizamos en el blog, para que tú también puedas seguir los datos.' },
        { title: 'Comparativa de visibilidad con tus competidores', html: 'Medimos tu visibilidad frente a tres competidores directos y detectamos las búsquedas que ellos captan y tú no. Así sabes qué servicios o zonas les traen clientes y en qué páginas te están ganando. Muchas veces aparecen búsquedas que nadie de tu sector ha trabajado todavía.' },
        { title: 'Plan de acción según impacto y esfuerzo', html: 'Terminamos con un plan ordenado por impacto y esfuerzo, y una videollamada para repasarlo contigo. Sabrás qué hacer la primera semana, qué planificar para los meses siguientes y qué no merece la inversión. El plan es tuyo: puedes ejecutarlo con nosotros, con tu equipo o con otro proveedor.' },
      ]}
    />
  </PSection>

  <!-- ═══ BÚSQUEDAS ══════════════════════════════════════════════════════ -->
  <PSection kicker="Investigación de palabras clave" title="Encontramos las búsquedas que acercan clientes a tu negocio">
    <Fragment slot="intro">
      <p>Priorizamos las búsquedas de quien está cerca de contratar, aunque tengan menos volumen. Una búsqueda con 50 consultas al mes y clara intención de compra puede aportar más clientes que otra con 5.000 visitas curiosas. Los dos esquemas muestran cómo ordenamos esas búsquedas y cómo las repartimos entre tus páginas.</p>
    </Fragment>
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start">
      <PCards
        cols={2}
        variant="check"
        class="lg:grid-cols-1 !mt-12"
        items={[
          { title: 'Palabras clave con intención de contratación', html: 'Búsquedas que incluyen el servicio, la ubicación, el precio o una comparativa, como «reformas integrales en Sabadell» o «precio reforma piso». Son las que antes se convierten en llamadas y presupuestos, y las que trabajamos primero aunque tengan menos volumen.' },
          { title: 'Consultas que intervienen en la decisión de compra', html: 'Dudas sobre plazos, costes o alternativas que el cliente resuelve antes de pedir presupuesto, del tipo «agencia SEO o consultor freelance». Si tu web las responde con claridad y honestidad, entras en su lista corta antes de que hable con nadie.' },
          { title: 'Oportunidades que tu competencia todavía no cubre', html: 'Búsquedas con demanda real en las que nadie de tu sector tiene una página específica. Suelen ser las victorias más rápidas, porque compites contra páginas genéricas. Las detectamos cruzando lo que te preguntan tus clientes por teléfono y por correo con los datos de búsqueda.' },
          { title: 'Asignación de búsquedas a cada página', html: 'Cada búsqueda importante tiene una única página responsable, y lo dejamos documentado en un mapa de palabras clave. Así evitamos que dos URLs de tu web se quiten posiciones entre sí, algo muy habitual en blogs que repiten temas. El árbol muestra un ejemplo con una empresa de reformas.' },
        ]}
      />
      <div class="mt-12 space-y-10">
