---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildAlternates } from '../lib/i18n';
import { localAgencySchema } from '../lib/schema';
import LogoMarquee from '../components/sections/LogoMarquee.astro';
import FaqHome from '../components/sections/FaqHome.astro';
import CityPills from '../components/global/CityPills.astro';
import GoogleReviews from '../components/global/GoogleReviews.astro';
import MoreCases from '../components/casos/MoreCases.astro';
import PSection from '../components/pillar/PSection.astro';
import PCards from '../components/pillar/PCards.astro';
import PFlow from '../components/pillar/PFlow.astro';
import PBars from '../components/pillar/PBars.astro';
import PMatrix from '../components/pillar/PMatrix.astro';
import PStack from '../components/pillar/PStack.astro';
import PFunnel from '../components/pillar/PFunnel.astro';
import PTree from '../components/pillar/PTree.astro';
import PLines from '../components/pillar/PLines.astro';
import PCounter from '../components/pillar/PCounter.astro';
import PSerp from '../components/pillar/PSerp.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://novamarketing.es';
const alternates = buildAlternates('/agencia-seo-para-pymes/', '/ca/agencia-seo-per-pimes/', SITE_URL);

const ICON = {
  search: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  target: 'M12 3a9 9 0 100 18 9 9 0 000-18zm0 5a4 4 0 100 8 4 4 0 000-8z',
  doc: 'M9 12h6m-6 4h6M9 8h2m8-3v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2h6l4 4z',
  link: 'M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5m7.328-1.672a4 4 0 000-5.656 4 4 0 00-5.656 0l-1.5 1.5',
  chart: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm8 0V5a2 2 0 012-2h0a2 2 0 012 2v14a2 2 0 01-2 2h0a2 2 0 01-2-2zm-8 0a2 2 0 002 2h2a2 2 0 002-2V9a2 2 0 00-2-2h-2a2 2 0 00-2 2v10z',
  money: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  users: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
};

const faqs = [
  { question: '¿Cuándo puede empezar a notarse el trabajo SEO?', answer: 'Los primeros movimientos de posiciones suelen verse entre el segundo y el tercer mes, y los resultados consolidados entre el sexto y el duodécimo. Depende del punto de partida de tu web, de la competencia del sector y de cuántas mejoras se pueden aplicar al principio. En la auditoría te decimos qué esperar en cada fase, sin plazos inventados.' },
  { question: '¿Qué incluye la cuota mensual?', answer: 'Incluye el trabajo acordado en el plan de cada mes: mejoras técnicas, optimización y creación de contenidos, enlazado interno, SEO local y, en los planes que lo contemplan, captación de enlaces. También la medición y un informe mensual con lo realizado, la evolución de las páginas trabajadas y los contactos que llegan desde Google.' },
  { question: '¿Podéis trabajar sobre mi web actual?', answer: 'Sí. La mayoría de proyectos parten de una web existente, ya sea WordPress, Shopify, PrestaShop o un desarrollo a medida. Solo recomendamos rehacerla cuando la tecnología impide aplicar las mejoras necesarias, y en ese caso planificamos la migración para no perder el posicionamiento conseguido.' },
  { question: '¿Qué necesitáis de mi equipo?', answer: 'Accesos a la web, Google Search Console, Google Analytics y el Perfil de Empresa en Google, y una persona de contacto que conozca el negocio. Al principio te pediremos información sobre tus servicios, clientes y márgenes. Después, sobre todo, revisiones puntuales de los contenidos que publicamos.' },
  { question: '¿Cómo se relacionan el SEO y la visibilidad en IA?', answer: 'Los asistentes de IA y las respuestas generadas de Google se apoyan en contenido que ya está bien posicionado, bien estructurado y citado por otras fuentes. Un buen trabajo SEO es la base del GEO. Si quieres trabajar de forma específica tu presencia en ChatGPT, Gemini o Perplexity, lo hacemos dentro de nuestro servicio de agencia GEO.' },
  { question: '¿Qué condiciones tiene el servicio?', answer: 'Trabajamos mes a mes, sin permanencia. Antes de empezar recibes un presupuesto cerrado por escrito con el alcance de cada mes. Las cuentas, la web y los datos son siempre tuyos, y si decides terminar el servicio te entregamos todo el trabajo y la documentación.' },
];

const pageSchema = localAgencySchema({
  pageUrl: `${SITE_URL}/agencia-seo-para-pymes/`,
  lang: 'es',
  cityName: 'Barcelona',
  postalCode: '08035',
  geo: { lat: 41.4114, lng: 2.1526 },
  areaServed: ['España', 'Barcelona', 'Sabadell', 'Sant Cugat del Vallès', 'Terrassa', 'Vallès Occidental'],
  title: '▷ Agencia SEO para PYMEs | Posicionamiento orgánico efectivo',
  description: 'Agencia SEO especializada en PYMEs con estrategias a medida 💡 sin permanencias y con informes claros ✅. Conoce cómo trabajamos para aparecer en Google.',
  datePublished: '2026-07-15',
  dateModified: '2026-10-25',
  streetAddress: 'Carrer del General Mendoza, 10',
  hasMap: 'https://maps.app.goo.gl/9fbB12UcK32bgjj89',
  aggregateRating: { ratingValue: '5.0', reviewCount: '12' },
  breadcrumbName: 'Agencia SEO para PYMEs',
  faqs,
});
---

<BaseLayout
  title="▷ Agencia SEO para PYMEs | Posicionamiento orgánico efectivo"
  description="Agencia SEO especializada en PYMEs con estrategias a medida 💡 sin permanencias y con informes claros ✅. Conoce cómo trabajamos para aparecer en Google."
  locale="es"
  alternates={alternates}
  schemas={[pageSchema]}
>

  <!-- ═══ HERO / H1 ═══════════════════════════════════════════════════════ -->
  <section class="pt-24 sm:pt-40 pb-20 px-4 sm:px-6 relative overflow-hidden text-center bg-white border-b border-black/5">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_40%,#000_75%,transparent_100%)]"></div>
    <div class="absolute -top-10 left-1/4 w-72 h-72 bg-accent/15 rounded-full blur-3xl opacity-30 animate-pulse"></div>
    <div class="absolute top-20 right-1/4 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl opacity-20"></div>

    <div class="max-w-5xl mx-auto reveal relative">
      <span class="inline-flex items-center gap-2 bg-accent/5 backdrop-blur-sm px-4 py-2 border border-accent/10 rounded-full text-accent text-[8px] sm:text-[10px] font-black uppercase tracking-[0.3em] mb-8 shadow-sm">
        <span class="w-1.5 h-1.5 bg-accent rounded-full animate-ping"></span>
        Posicionamiento web para pymes
      </span>
      <h1 class="uppercase font-extrabold tracking-tighter leading-[0.9] mb-8 text-gradient flex flex-col items-center text-center">
        <span class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl">Agencia SEO para pymes</span>
        <span class="text-xl sm:text-3xl md:text-4xl mt-3 text-mktg-gradient">que quieren crecer en Google</span>
      </h1>
      <p class="text-lg sm:text-xl text-zinc-500 font-light leading-relaxed max-w-3xl mx-auto mb-8">
        Hacemos que tu empresa aparezca cuando tus clientes buscan lo que vendes, y medimos el trabajo en contactos y ventas, no en informes de posiciones.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 mb-10">
        {['Sin permanencias', 'Trato directo con el consultor', 'Informes de negocio'].map((item) => (
          <span class="inline-flex items-center gap-2 text-[11px] sm:text-xs font-black uppercase tracking-widest text-zinc-700">
            <svg class="w-4 h-4 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            {item}
          </span>
        ))}
      </div>
      <a href="#contacto" class="contact-modal-trigger btn-mktg-v5 shadow-[0_10px_30px_rgba(0,0,0,0.1)] !py-4 sm:!py-5 !px-6 sm:!px-10 !text-[11px] !tracking-widest font-black">HABLEMOS DE TU NEGOCIO</a>
    </div>
  </section>

  <LogoMarquee />

  <!-- ═══ OPORTUNIDAD ═══════════════════════════════════════════════════ -->
  <PSection kicker="Por qué SEO" title="Convierte las búsquedas de tus clientes en oportunidades de negocio" layout="split">
    <Fragment slot="intro">
      <p>Cada día alguien escribe en Google el servicio que ofreces, el problema que resuelves o el nombre de tu categoría de producto. <strong>Esa búsqueda es una necesidad expresada en el momento exacto en que existe</strong>, y la empresa que aparece con una respuesta clara suele quedarse con el contacto.</p>
      <p>Nova es una agencia SEO especializada en pymes. Trabajamos el posicionamiento orgánico como un canal comercial más, conectado con tu web, tu <a href="/agencia-sem-para-pymes/">publicidad en Google</a> y tu <a href="/agencia-geo-para-pymes/">presencia en las respuestas de la IA</a>, con un objetivo que se puede medir. Cuántos clientes nuevos llegan cada mes desde el buscador.</p>
    </Fragment>
    <PSerp
      slot="aside"
      query="reformas integrales en Sabadell"
      results={[
        { url: 'tuempresa.es › reformas-integrales', title: 'Reformas integrales en Sabadell · Presupuesto en 48 h', desc: 'Pisos, locales y casas. Precios orientativos, plazos y proyectos reales en el Vallès.', highlight: true, label: 'Tu empresa' },
        { url: 'competidor-a.com', title: 'Empresa de reformas | Reformas en Barcelona y alrededores', desc: 'Más de 20 años de experiencia en reformas de todo tipo.' },
        { url: 'directorio-reformas.es › sabadell', title: 'Las 10 mejores empresas de reformas en Sabadell', desc: 'Compara opiniones y pide presupuesto a varias empresas.' },
      ]}
      caption="Ilustración. El objetivo es que tu página sea la respuesta más clara a la búsqueda de tu cliente."
    />
    <PFlow
      steps={[
        { label: 'Búsqueda con intención', sub: '«agencia de reformas en Sabadell»' },
        { label: 'Tu página en Google', sub: 'resultado orgánico o mapa' },
        { label: 'Página que responde', sub: 'servicio, precio, pruebas' },
        { label: 'Contacto o venta', sub: 'llamada, formulario, pedido' },
      ]}
      caption="El recorrido que optimizamos. Si falla un eslabón, el tráfico no se convierte en negocio."
    />
  </PSection>

  <!-- ═══ QUÉ FRENA EL POSICIONAMIENTO ═══════════════════════════════════ -->
  <PSection kicker="Diagnóstico" title="Qué está frenando el posicionamiento de tu empresa" tone="soft">
    <Fragment slot="intro">
      <p>Cuando una web no capta clientes desde Google casi nunca hay una sola causa. Estos son los seis bloqueos que encontramos con más frecuencia en webs de pymes, y cada uno se corrige de forma distinta.</p>
    </Fragment>
    <PCards
      tone="soft"
      items={[
        { icon: ICON.search, title: 'Tus páginas importantes no aparecen en Google', html: 'Páginas de servicio sin indexar, bloqueadas por error o tan escondidas en la navegación que Google apenas las visita. Si una página no está en el índice, no puede posicionar por bueno que sea su contenido.' },
        { icon: ICON.users, title: 'Recibes visitas que no se convierten en contactos', html: 'Tráfico de búsquedas informativas que no tienen relación con lo que vendes, o páginas que posicionan pero no explican por qué elegirte. Aquí el problema suele estar en la <a href="/diseno-web-para-pymes/">web y su conversión</a>, no en el SEO.' },
        { icon: ICON.target, title: 'Tu competencia ocupa las búsquedas más rentables', html: 'Tus competidores tienen una página específica para cada servicio y zona, y tú una sola página genérica que intenta posicionar por todo. Google prefiere la respuesta más precisa.' },
        { icon: ICON.code, title: 'Tu web arrastra problemas técnicos', html: 'Lentitud en móvil, contenido duplicado, redirecciones en cadena o plantillas que generan cientos de URLs sin valor. Problemas invisibles para el usuario que gastan el rastreo de Google. Si no sabes por dónde empezar, revisa <a href="/blog/como-saber-si-tu-web-esta-bien-hecha/">cómo saber si tu web está bien hecha</a>.' },
        { icon: ICON.doc, title: 'Tus contenidos no responden a lo que busca el cliente', html: 'Textos escritos desde la empresa y no desde la duda del cliente. Sin precios orientativos, sin plazos, sin ejemplos. Entender la <a href="/blog/que-es-la-intencion-de-busqueda-en-el-seo/">intención de búsqueda</a> es lo que separa una página que posiciona de una que solo existe.' },
        { icon: ICON.money, title: 'Dependencia de la publicidad para conseguir visitas', html: 'Si apagas los anuncios y los contactos desaparecen, tu negocio alquila su visibilidad. El SEO construye un canal propio que reduce esa dependencia. Te explicamos cuándo conviene cada canal en <a href="/blog/que-necesita-una-pyme-seo-o-sem/">qué necesita una pyme, SEO o SEM</a>.' },
      ]}
    />
    <PLines
      title="Visitas mensuales según el canal"
      series={[
        { label: 'Solo publicidad', points: [10, 48, 50, 49, 51, 50, 49, 8, 6, 5, 5, 5], color: '#a1a1aa' },
        { label: 'Posicionamiento SEO', points: [8, 10, 14, 19, 25, 31, 38, 44, 50, 56, 61, 66] },
      ]}
      xLabels={['Mes 1', '', '', 'Mes 4', '', '', '', 'Mes 8', '', '', '', 'Mes 12']}
      marker={{ at: 7, label: 'Se pausa la inversión en anuncios' }}
      caption="Esquema ilustrativo, no son datos de un cliente. La publicidad da visitas inmediatas que se detienen al dejar de pagar; el SEO tarda más en arrancar y se acumula."
    />
  </PSection>

  <!-- ═══ MOMENTO DE LA PYME ════════════════════════════════════════════ -->
  <PSection kicker="Punto de partida" title="Una estrategia SEO adaptada al momento de tu pyme">
    <Fragment slot="intro">
      <p>No es lo mismo una web que nunca ha trabajado el SEO que una que ha perdido la mitad del tráfico tras una actualización de Google. El orden de las prioridades cambia según el momento de tu empresa.</p>
    </Fragment>
    <PCards
      variant="numbered"
      items={[
        { title: 'Empresas que empiezan a trabajar su posicionamiento', html: 'Primero, que Google pueda rastrear e indexar bien la web. Después, una página sólida por cada servicio principal y el <a href="#seo-local">Perfil de Empresa</a> completo. Son las mejoras que antes se notan.' },
        { title: 'Negocios con tráfico estancado', html: 'Revisamos qué páginas tienen potencial y no terminan de subir, qué búsquedas se reparten entre varias URLs y qué contenidos de la competencia responden mejor. Suele haber margen sin crear nada desde cero.' },
        { title: 'Webs que han perdido visibilidad', html: 'Cruzamos fechas de caída con actualizaciones de Google, cambios en la web y migraciones. Hasta no saber la causa no tocamos nada, porque una corrección equivocada puede agravar la pérdida.' },
        { title: 'Pymes que quieren abrir nuevos mercados', html: 'Nuevas ciudades, nuevos servicios o un segundo idioma. Planificamos la arquitectura antes de publicar para que cada mercado tenga sus páginas propias y no compitan entre sí.' },
        { title: 'Empresas que necesitan cambiar de agencia SEO', html: 'Hacemos una revisión independiente del trabajo anterior, recuperamos los accesos que falten y mantenemos lo que funciona. El cambio no tiene por qué suponer empezar de cero.' },
      ]}
    />
  </PSection>

  <!-- ═══ AUDITORÍA ══════════════════════════════════════════════════════ -->
  <PSection id="auditoria" kicker="Auditoría SEO" title="La auditoría que ordena tus prioridades" tone="soft" layout="split">
    <Fragment slot="intro">
      <p>Antes de proponer nada, auditamos. La auditoría mide tu visibilidad real, revisa la salud técnica de la web y la compara con tus competidores directos. <strong>No entregamos un listado de cien errores automáticos</strong>, sino un diagnóstico que entiende cualquier gerente, con las tareas ordenadas por lo que aportan y lo que cuestan.</p>
      <p>Si ya trabajas con otra agencia, también sirve como segunda opinión independiente sobre tu inversión actual.</p>
    </Fragment>
    <PMatrix
      slot="aside"
      xLabel="Esfuerzo"
      yLabel="Impacto"
      quadrants={['Hacer primero', 'Planificar', 'Si sobra tiempo', 'Descartar']}
      points={[
        { label: 'Desbloquear indexación', x: 14, y: 86 },
        { label: 'Títulos de servicio', x: 30, y: 70 },
        { label: 'Nueva arquitectura', x: 78, y: 82 },
        { label: 'Páginas por zona', x: 64, y: 62 },
        { label: 'Retoques menores', x: 26, y: 24 },
      ]}
      caption="Ejemplo de cómo priorizamos las tareas de una auditoría según impacto y esfuerzo."
    />
    <PCards
      variant="rows"
      tone="soft"
      items={[
        { title: 'Rastreo e indexación de las páginas relevantes', html: 'Comprobamos qué páginas ve Google, cuáles indexa y cuáles se quedan fuera, con datos de Search Console y un rastreo completo de la web.' },
        { title: 'Arquitectura y distribución de la autoridad interna', html: 'Analizamos a cuántos clics de la portada están tus páginas de negocio y cuántos enlaces internos reciben. Las páginas que más venden deben ser las más fáciles de encontrar.' },
        { title: 'Rendimiento de contenidos y palabras clave', html: 'Qué páginas atraen tráfico, cuáles posicionan cerca del top 10 sin entrar y cuáles compiten entre sí por la misma búsqueda.' },
        { title: 'Comparativa de visibilidad con tus competidores', html: 'Medimos tu visibilidad frente a tres competidores directos y detectamos las búsquedas que ellos captan y tú no.' },
        { title: 'Plan de acción según impacto y esfuerzo', html: 'Terminamos con un plan ordenado y una videollamada para repasarlo. Sabrás qué hacer la primera semana y qué no merece la inversión.' },
      ]}
    />
  </PSection>

  <!-- ═══ BÚSQUEDAS ══════════════════════════════════════════════════════ -->
  <PSection kicker="Investigación de palabras clave" title="Encontramos las búsquedas que acercan clientes a tu negocio">
    <Fragment slot="intro">
      <p>No perseguimos las palabras con más volumen, sino las que hace alguien que está cerca de contratar. Una búsqueda con 50 consultas al mes y clara intención de compra puede aportar más clientes que otra con 5.000 visitas curiosas.</p>
    </Fragment>
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start">
      <PCards
        cols={2}
        variant="check"
        class="lg:grid-cols-1 !mt-12"
        items={[
          { title: 'Palabras clave con intención de contratación', html: 'Búsquedas con servicio, ubicación, precio o comparativa. Son las que antes se convierten en llamadas y presupuestos.' },
          { title: 'Consultas que intervienen en la decisión de compra', html: 'Dudas sobre plazos, costes o alternativas que el cliente resuelve antes de pedir presupuesto. Responderlas te pone en su lista.' },
          { title: 'Oportunidades que tu competencia todavía no cubre', html: 'Búsquedas con demanda real en las que nadie de tu sector tiene una página específica. Suelen ser las victorias más rápidas.' },
          { title: 'Asignación de búsquedas a cada página', html: 'Cada búsqueda importante tiene una única página responsable. Así evitamos que dos URLs de tu web se quiten posiciones entre sí.' },
        ]}
      />
      <div class="mt-12 space-y-10">
        <PFunnel
          stages={[
            { label: 'Informativa', sub: '«cómo saber si mi web está bien hecha»', side: 'Atrae visitas y confianza.' },
            { label: 'Comparativa', sub: '«agencia SEO o consultor freelance»', side: 'Te coloca en la lista corta.' },
            { label: 'Contratación', sub: '«agencia SEO para pymes en Barcelona»', side: 'Genera contactos.' },
          ]}
          caption="Las tres intenciones que cubrimos, de la más amplia a la más cercana a la compra."
        />
        <PTree
          root="Web de una reformista"
          branches={[
            { label: 'Reformas integrales', leaves: ['reformas integrales Sabadell', 'precio reforma piso'] },
            { label: 'Reforma de baños', leaves: ['reforma baño completo', 'cambiar bañera por plato'] },
          ]}
          caption="Cada grupo de búsquedas tiene su propia página."
        />
      </div>
    </div>
  </PSection>

  <!-- ═══ BASE TÉCNICA ═══════════════════════════════════════════════════ -->
  <PSection kicker="SEO técnico" title="Una base técnica que permite crecer" tone="soft" layout="split">
    <Fragment slot="intro">
      <p>El contenido y los enlaces solo rinden si la web es técnicamente sólida. Es la parte menos visible del SEO y la que más se nota cuando falla.</p>
    </Fragment>
    <PStack
      slot="aside"
      layers={[
        { label: 'Clientes desde Google', sub: 'contactos y ventas' },
        { label: 'Autoridad', sub: 'enlaces y menciones' },
        { label: 'Contenido', sub: 'páginas que responden' },
        { label: 'Rendimiento', sub: 'velocidad y experiencia' },
        { label: 'Rastreo e indexación', sub: 'Google encuentra y entiende' },
      ]}
      caption="Cada capa se apoya en la anterior."
    />
    <PCards
      tone="soft"
      items={[
        { icon: ICON.search, title: 'Control de indexación y contenido duplicado', html: 'Canónicas, etiquetas noindex, parámetros de URL y sitemaps coherentes, para que Google dedique su tiempo a las páginas que importan.' },
        { icon: ICON.link, title: 'Enlazado interno y profundidad de navegación', html: 'Enlaces contextuales entre páginas relacionadas y ninguna página de negocio a más de tres clics de la portada.' },
        { icon: ICON.chart, title: 'Velocidad y experiencia de página', html: 'Optimizamos imágenes, código y servidor para cumplir las Core Web Vitals en móvil. En <a href="/casos-exito/clustag/">Clustag</a> pasamos de 53 a 98 en PageSpeed de escritorio.' },
        { icon: ICON.code, title: 'Datos estructurados según el contenido', html: 'Marcado de organización, servicios, productos, artículos y preguntas frecuentes, siempre fiel a lo que se ve en la página.' },
        { icon: ICON.target, title: 'Migraciones y redirecciones sin perder el rumbo', html: 'Mapa de redirecciones URL a URL, control antes y después del lanzamiento y seguimiento de posiciones. Si vas a rehacer la web, lo coordinamos con el <a href="/diseno-web-para-pymes/">diseño web</a> desde el principio.' },
      ]}
    />
  </PSection>

  <!-- ═══ CONTENIDOS ═════════════════════════════════════════════════════ -->
  <PSection kicker="Contenidos SEO" title="Contenidos que explican, posicionan y ayudan a decidir">
    <Fragment slot="intro">
