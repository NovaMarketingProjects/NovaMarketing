---
/**
 * Variante CRO "Precio" — hipótesis: lo que frena a la pyme es la opacidad del
 * sector (nadie publica precios y todos atan con permanencia). La página pone
 * el precio y los entregables en el hero para filtrar y convertir más rápido.
 * Los planes son los mismos que en /agencia-seo-para-pymes/.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoMarquee from '../components/sections/LogoMarquee.astro';

const planes = [
  {
    name: 'SEO PYME',
    price: 'desde 400€',
    period: '/ mes',
    meta: ['Primeros movimientos en unos 3 meses', 'Para negocios locales y pequeñas empresas'],
    items: [
      'Auditoría SEO inicial',
      'Optimización técnica continua',
      'Contenidos que posicionan',
      'SEO local y ficha de Google',
      'Enlazado interno optimizado',
      'Reseñas y señales de confianza',
      'Informe mensual de posiciones y leads',
      'Línea directa con el consultor',
      'Sin permanencia',
    ],
    destacado: false,
  },
  {
    name: 'SEO Big Pyme',
    price: 'desde 900€',
    period: '/ mes',
    meta: ['Primeros movimientos en unos 2 meses', 'Para empresas medianas y sectores competidos'],
    items: [
      'Todo el plan SEO PYME',
      'Estrategia SEO y GEO conjunta',
      'Redacción profesional ampliada',
      'Link building en medios',
      'Optimización de más de 100 URL',
      'Cobertura multisede o internacional',
      'Reunión mensual de negocio',
      'Objetivo, primeras posiciones',
    ],
    destacado: true,
  },
];

const noHacemos = [
  {
    t: 'Permanencias de 12 meses',
    d: 'Si el trabajo no te convence, te vas cuando quieras. Preferimos ganarnos el mes siguiente a tenerte atado por contrato.',
  },
  {
    t: 'Informes de impresiones',
    d: 'Las impresiones no pagan facturas. Nuestro informe habla de posiciones conseguidas y de cuánta gente te ha contactado.',
  },
  {
    t: 'Prometer el número uno',
    d: 'Nadie puede garantizar una posición en Google, y quien lo haga te está vendiendo humo. Te damos un objetivo realista según tu competencia.',
  },
];

const faqs = [
  {
    q: '¿Por qué 400€ y no 150€ como otras agencias?',
    a: 'Porque por 150€ al mes no se puede hacer SEO, se puede simular. A ese precio salen dos horas de trabajo mensuales, que no dan ni para los contenidos. Preferimos decirte el precio real que cobrarte poco y no mover tus posiciones.',
  },
  {
    q: '¿De verdad no hay permanencia?',
    a: 'No la hay. Avisas y el mes siguiente ya no se factura. Lo que sí te pedimos es paciencia los primeros meses, porque el SEO no da resultados en cuatro semanas y marcharse en el mes dos es tirar el dinero invertido.',
  },
  {
    q: '¿Qué pasa con el trabajo hecho si dejo de trabajar con vosotros?',
    a: 'Se queda contigo. Los contenidos, las optimizaciones de tu web y tu ficha de Google son tuyos, y las posiciones ganadas no desaparecen de un día para otro. Eso es lo que diferencia al SEO de los anuncios.',
  },
  {
    q: '¿Cuál de los dos planes me conviene?',
    a: 'Depende de tu competencia, no de tu tamaño. Si vendes en una ciudad y tu sector está poco trabajado, el plan PYME sobra. Si compites en toda España o en un sector saturado, el presupuesto pequeño no llega. En la auditoría gratuita te decimos cuál y por qué.',
  },
  {
    q: '¿Incluye la publicidad de Google Ads?',
    a: 'No, son servicios distintos. El SEO trabaja los resultados orgánicos y Google Ads los de pago. Muchos clientes combinan los dos al principio para tener resultados desde el primer día mientras el SEO coge velocidad.',
  },
];
---

<BaseLayout
  title="▷ Precio del SEO para pymes | Desde 400€ al mes sin permanencia"
  description="Cuánto cuesta el SEO para una pyme, sin letra pequeña 💡 Planes desde 400€/mes con todo incluido, informes de leads y sin permanencia ✅"
  noIndex={true}
  locale="es"
  hideHeader={true}
  hideFooter={true}
>

<!-- ─── Sending overlay ─── -->
<div id="lp-sending" class="fixed inset-0 z-[200] bg-white flex flex-col items-center justify-center hidden">
  <div class="flex flex-col items-center gap-8 px-8 max-w-sm w-full text-center">
    <div class="w-16 h-16 rounded-full border-4 border-zinc-100 border-t-accent animate-spin"></div>
    <div>
      <div class="text-2xl font-black uppercase tracking-tighter text-black mb-2">Enviando...</div>
      <p class="text-zinc-400 font-light text-sm">Procesando tu solicitud, un momento.</p>
    </div>
    <div class="w-full bg-zinc-100 rounded-full h-1 overflow-hidden">
      <div id="lp-progress" class="h-full bg-accent rounded-full"></div>
    </div>
  </div>
</div>

<!-- ═══ NAV ═══════════════════════════════════════════════════════════ -->
<header class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md border-b border-black/5 py-2 sm:py-3 leading-none">
  <div class="relative w-full px-6 sm:px-12 lg:px-24 flex items-center justify-between h-12 md:h-14 gap-6">
    <a href="#top" class="flex items-center h-full flex-shrink-0">
      <div class="text-[2.8rem] sm:text-[3rem] font-heading font-black tracking-tighter leading-none flex items-center -translate-y-0.5">
        <span class="hover-animate-gradient">nova.</span>
      </div>
    </a>
    <nav class="hidden lg:flex items-center gap-8">
      {[
        { href: '#planes', label: 'Planes y precios' },
        { href: '#incluye', label: 'Qué incluye' },
        { href: '#faq', label: 'Dudas sobre el precio' },
      ].map(l => (
        <a href={l.href} class="text-[11px] font-bold uppercase tracking-[0.15em] text-zinc-700 hover:text-accent transition-colors whitespace-nowrap">{l.label}</a>
      ))}
    </nav>
    <a href="#solicitar" class="btn-mktg-v5 !py-3 !px-6 !text-[11px] font-black flex-shrink-0">PEDIR PRESUPUESTO</a>
  </div>
</header>

<!-- ═══ HERO CON PRECIO ═══════════════════════════════════════════════ -->
<section id="top" class="min-h-[88dvh] flex items-center px-4 sm:px-6 relative overflow-hidden bg-white border-b border-black/5 pt-24 pb-16">
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_60%_at_50%_40%,#000_70%,transparent_100%)]"></div>
  <div class="absolute -top-10 left-1/3 w-80 h-80 bg-accent/15 rounded-full blur-3xl opacity-30 animate-pulse"></div>

  <div class="w-full relative z-[2] max-w-5xl mx-auto text-center">
    <div class="inline-flex items-center gap-2 bg-accent/10 px-4 py-2 border border-accent/25 rounded-full text-accent text-[10px] font-black uppercase tracking-[0.25em] mb-8 reveal">
      <span class="w-2 h-2 bg-accent rounded-full animate-ping"></span>
      Precios públicos, sin letra pequeña
    </div>

    <h1 class="text-4xl sm:text-6xl lg:text-7xl uppercase font-black tracking-tighter leading-[0.88] mb-8 text-zinc-900 reveal">
      SEO desde<br><span class="text-mktg-gradient">400€ al mes</span>.<br>Sin permanencia.
    </h1>

    <p class="text-zinc-500 font-light text-base sm:text-xl leading-relaxed mb-10 max-w-2xl mx-auto reveal">
      En este sector nadie publica precios, y por eso pedir presupuesto da pereza. Aquí los tienes antes de dejarnos ni un dato: mira si encaja con lo que puedes invertir y, si encaja, hablamos.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center reveal">
      <a href="#planes" class="btn-mktg-v5 !py-4 !px-10 text-sm shadow-[0_15px_35px_rgba(37,211,102,0.25)]">
        Ver qué incluye cada plan →
      </a>
      <a href="#solicitar" class="text-xs font-black uppercase tracking-widest text-zinc-500 hover:text-accent transition-colors underline underline-offset-4">
        O pide la auditoría gratuita
      </a>
    </div>
  </div>
</section>

<LogoMarquee />

<!-- ═══ PLANES ════════════════════════════════════════════════════════ -->
<section id="planes" class="py-20 sm:py-28 bg-zinc-50 border-y border-black/5 px-4 sm:px-6">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-14 reveal">
      <span class="text-[10px] font-black uppercase tracking-[0.3em] text-accent mb-4 block">Planes</span>
      <h2 class="text-3xl sm:text-5xl uppercase tracking-tighter font-black">Dos formas de trabajar<br class="hidden sm:inline" /> contigo</h2>
      <p class="text-zinc-500 font-light text-sm mt-5 max-w-xl mx-auto">
        El plan no depende de tu tamaño, sino de lo competido que esté tu sector. Si no lo tienes claro, te lo decimos en la auditoría.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {planes.map((p, i) => (
        <div class={`relative p-8 sm:p-10 rounded-3xl border reveal flex flex-col ${p.destacado ? 'bg-zinc-900 border-zinc-900 text-white' : 'bg-white border-zinc-100/60'}`} style={`transition-delay: ${i * 80}ms`}>
          {p.destacado && (
            <span class="absolute -top-3 left-8 bg-accent text-white text-[9px] font-black uppercase tracking-[0.2em] px-4 py-1.5 rounded-full">
              Sectores competidos
            </span>
          )}
          <h3 class={`text-xs font-black uppercase tracking-[0.25em] mb-4 ${p.destacado ? 'text-accent' : 'text-accent'}`}>{p.name}</h3>
          <div class="flex items-baseline gap-2 mb-5">
            <span class="text-4xl sm:text-5xl font-black tracking-tighter leading-none">{p.price}</span>
            <span class={`text-sm font-light ${p.destacado ? 'text-zinc-400' : 'text-zinc-400'}`}>{p.period}</span>
          </div>
          <div class="space-y-1.5 mb-7">
            {p.meta.map(m => (
              <div class={`text-xs font-light ${p.destacado ? 'text-zinc-300' : 'text-zinc-500'}`}>{m}</div>
            ))}
          </div>
          <ul class="space-y-3 mb-8 flex-1">
            {p.items.map(item => (
              <li class="flex items-start gap-3">
                <div class="w-4 h-4 rounded-full bg-accent/15 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-2.5 h-2.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class={`text-sm font-light leading-snug ${p.destacado ? 'text-zinc-200' : 'text-zinc-600'}`}>{item}</span>
              </li>
            ))}
          </ul>
          <a href="#solicitar" class={`block text-center font-black uppercase tracking-widest text-[11px] py-4 rounded-full transition-colors ${p.destacado ? 'bg-accent text-white hover:opacity-90' : 'bg-zinc-900 text-white hover:bg-accent'}`}>
            Quiero este plan →
          </a>
        </div>
      ))}
    </div>

    <p class="text-center text-xs text-zinc-400 font-light mt-8 reveal">
      Precios sin IVA. El presupuesto final depende del número de páginas y de la competencia de tu sector: te lo cerramos tras la auditoría, nunca antes.
    </p>
  </div>
</section>

<!-- ═══ QUÉ NO HACEMOS ════════════════════════════════════════════════ -->
<section id="incluye" class="py-20 sm:py-28 bg-white px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-14 reveal">
      <span class="text-[10px] font-black uppercase tracking-[0.3em] text-accent mb-4 block">Transparencia</span>
      <h2 class="text-3xl sm:text-5xl uppercase tracking-tighter font-black">Lo que no vas<br class="hidden sm:inline" /> a encontrar aquí</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {noHacemos.map((n, i) => (
        <div class="p-8 bg-zinc-50 border border-zinc-100/60 rounded-3xl reveal" style={`transition-delay: ${i * 80}ms`}>
          <div class="w-10 h-10 rounded-full bg-red-50 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </div>
          <h3 class="text-base font-black uppercase tracking-tight text-zinc-900 mb-3 leading-tight">{n.t}</h3>
          <p class="text-sm text-zinc-500 font-light leading-relaxed">{n.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ CONSULTOR + RESULTADOS ════════════════════════════════════════ -->
<section class="py-20 sm:py-28 bg-zinc-50 border-y border-black/5 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-12 items-center">
    <div class="reveal flex justify-center order-2 lg:order-1">
      <img src="/consultor-marketing-digital.webp" alt="Sergio Galo's, consultor SEO de Nova Marketing" title="Sergio Galo's, consultor SEO de Nova Marketing" class="w-full max-w-xs h-auto" width="473" height="591" loading="lazy" />
    </div>
    <div class="reveal order-1 lg:order-2">
      <h2 class="text-3xl sm:text-4xl uppercase tracking-tighter font-black mb-6 leading-[0.95]">
        Lo que compras<br>por ese precio
      </h2>
      <p class="text-zinc-500 font-light text-base leading-relaxed mb-8">
        Horas de un consultor que trabaja tu cuenta, no una licencia de software que genera informes solo. Estas son las medias de nuestros clientes tras doce meses:
      </p>
      <div class="grid grid-cols-2 gap-4">
        {[
          { value: '+65%', label: 'Tráfico Orgánico' },
          { value: '-40%', label: 'Coste por Lead' },
          { value: 'x3.5', label: 'ROI a 12 Meses' },
          { value: '+55%', label: 'Posiciones Top 3' },
        ].map(stat => (
          <div class="p-6 bg-white border border-zinc-100/60 rounded-2xl text-center">
            <div class="text-3xl font-black tracking-tighter text-mktg-gradient leading-none mb-1">{stat.value}</div>
            <div class="text-[9px] font-black uppercase tracking-[0.2em] text-zinc-400">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ═══ FAQ (objeciones de precio) ════════════════════════════════════ -->
<section id="faq" class="py-20 sm:py-28 bg-white px-4 sm:px-6">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-12 reveal">
      <span class="text-[10px] font-black uppercase tracking-[0.3em] text-accent mb-4 block">FAQ</span>
      <h2 class="text-3xl sm:text-4xl uppercase tracking-tighter font-black">Dudas sobre el precio</h2>
    </div>
    <div class="space-y-3 reveal">
      {faqs.map(faq => (
        <div class="faq-item bg-zinc-50 border border-zinc-100/60 rounded-3xl overflow-hidden hover:border-accent/20 transition-colors">
          <button class="faq-trigger w-full text-left px-8 py-6 flex items-center justify-between gap-4" aria-expanded="false">
            <span class="text-sm font-black uppercase tracking-tight text-zinc-900">{faq.q}</span>
            <div class="faq-icon-wrap w-8 h-8 rounded-full bg-white border border-zinc-100 flex items-center justify-center flex-shrink-0 transition-all duration-300">
              <svg class="faq-icon w-4 h-4 text-zinc-400 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14M5 12h14"/>
              </svg>
            </div>
          </button>
          <div class="faq-answer hidden px-8 pb-6">
            <p class="text-zinc-500 font-light text-sm leading-relaxed">{faq.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ CTA FINAL ═════════════════════════════════════════════════════ -->
<section id="solicitar" class="py-20 sm:py-32 px-4 sm:px-6 bg-accent">
  <div class="max-w-5xl mx-auto grid lg:grid-cols-2 gap-12 sm:gap-16 items-center">
    <div class="reveal text-white">
      <span class="text-[10px] font-black uppercase tracking-[0.5em] mb-8 block opacity-70">Sin compromiso</span>
      <div class="text-4xl sm:text-6xl font-black uppercase tracking-tighter leading-[0.85] mb-8">
        ¿Cuánto<br>costaría<br>lo tuyo?
      </div>
      <p class="font-light text-base opacity-90 mb-8">
        Revisamos tu web y tu competencia y te decimos el precio exacto, el plazo realista y si de verdad te conviene empezar ahora.
      </p>
      <ul class="text-[9px] sm:text-xs font-black tracking-widest space-y-3 uppercase opacity-90">
        <li>→ AUDITORÍA TÉCNICA GRATIS</li>
        <li>→ PRESUPUESTO CERRADO</li>
        <li>→ SIN PERMANENCIA</li>
      </ul>
    </div>

    <div class="reveal">
      <div class="bg-white p-8 sm:p-12 shadow-[0_40px_100px_rgba(0,0,0,0.15)] rounded-3xl">
        <form id="precio-form" class="space-y-6">
          <div class="grid sm:grid-cols-2 gap-6 text-[10px] font-black tracking-widest uppercase">
            <div class="flex flex-col gap-3">
              <label class="opacity-30">Nombre *</label>
              <input type="text" name="name" required class="border-b border-black/10 py-2 focus:border-accent outline-none transition-colors" />
            </div>
            <div class="flex flex-col gap-3">
              <label class="opacity-30">Teléfono</label>
              <input type="tel" name="phone" aria-label="Teléfono" class="border-b border-black/10 py-2 focus:border-accent outline-none transition-colors" />
            </div>
          </div>
          <div class="flex flex-col gap-3 text-[10px] font-black tracking-widest uppercase">
            <label class="opacity-30">Email profesional *</label>
            <input type="email" name="email" required class="border-b border-black/10 py-2 focus:border-accent outline-none transition-colors" />
          </div>
          <div class="flex flex-col gap-3 text-[10px] font-black tracking-widest uppercase">
            <label class="opacity-30">Web (URL)</label>
            <input type="text" name="url" class="border-b border-black/10 py-2 focus:border-accent outline-none transition-colors" />
          </div>
          <div class="flex flex-col gap-3 text-[10px] font-black tracking-widest uppercase">
            <label class="opacity-30">¿Qué plan te encaja?</label>
            <select name="msg" class="border-b border-black/10 py-2 focus:border-accent outline-none transition-colors bg-transparent text-xs font-light normal-case tracking-normal">
              <option value="Plan de interés: todavía no lo sé">Todavía no lo sé</option>
              <option value="Plan de interés: SEO PYME (desde 400€)">SEO PYME — desde 400€/mes</option>
              <option value="Plan de interés: SEO Big Pyme (desde 900€)">SEO Big Pyme — desde 900€/mes</option>
            </select>
          </div>
          <div class="flex items-start gap-2">
            <input type="checkbox" id="precio-terms" name="terms" required class="mt-1 accent-accent" />
            <label for="precio-terms" class="text-xs text-zinc-500 font-light cursor-pointer select-none">
              Acepto la <a href="/privacidad/" class="underline hover:text-accent transition-colors">política de privacidad</a>.
            </label>
          </div>
          <button type="submit" id="precio-submit" class="w-full btn-mktg-v5 !py-5 sm:!py-6">
            QUIERO MI PRESUPUESTO
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- ─── Minimal footer ─── -->
<footer class="py-8 bg-white border-t border-black/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <span class="font-black text-xl tracking-tighter text-black leading-none">nova.</span>
    <div class="flex items-center gap-6 text-[10px] text-zinc-400 font-light">
      <a href="/privacidad/" class="hover:text-accent transition-colors uppercase tracking-widest font-black">Privacidad</a>
      <a href="/aviso-legal/" class="hover:text-accent transition-colors uppercase tracking-widest font-black">Aviso legal</a>
      <a href="/cookies/" class="hover:text-accent transition-colors uppercase tracking-widest font-black">Cookies</a>
    </div>
    <p class="text-[10px] text-zinc-400 font-light">&copy; {new Date().getFullYear()} Nova Marketing</p>
  </div>
</footer>

</BaseLayout>

<script>
  // FAQ accordion
  document.querySelectorAll('.faq-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item')!;
      const answer = item.querySelector('.faq-answer')!;
      const icon = btn.querySelector('.faq-icon') as SVGElement | null;
      const wrap = btn.querySelector('.faq-icon-wrap')!;
      const isOpen = !answer.classList.contains('hidden');

      document.querySelectorAll('.faq-answer').forEach(a => a.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(i => (i as SVGElement).style.transform = '');
      document.querySelectorAll('.faq-icon-wrap').forEach(w => {
        w.classList.remove('bg-accent', 'border-accent');
        w.classList.add('bg-white', 'border-zinc-100');
      });
      document.querySelectorAll('.faq-trigger').forEach(b => b.setAttribute('aria-expanded', 'false'));

      if (!isOpen) {
        answer.classList.remove('hidden');
        if (icon) { icon.style.transform = 'rotate(45deg)'; icon.style.color = 'white'; }
        wrap.classList.remove('bg-white', 'border-zinc-100');
        wrap.classList.add('bg-accent', 'border-accent');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Form submission
  async function handleForm(formId: string, btnId: string) {
    const form = document.getElementById(formId) as HTMLFormElement | null;
    const btn = document.getElementById(btnId) as HTMLButtonElement | null;
    const overlay = document.getElementById('lp-sending');
    const bar = document.getElementById('lp-progress');

    form?.querySelector<HTMLInputElement>('[name="url"]')?.addEventListener('input', (e) => {
      (e.target as HTMLInputElement).setCustomValidity('');
    });
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const urlInput = form.querySelector<HTMLInputElement>('[name="url"]');
      if (urlInput && urlInput.value.trim() && !/\.[a-zA-Z]{2,}/.test(urlInput.value.trim())) {
        urlInput.setCustomValidity('Introduce una URL válida, por ejemplo: miempresa.com');
        urlInput.reportValidity();
        return;
      }
      if (urlInput) urlInput.setCustomValidity('');
      if (btn) btn.disabled = true;
      overlay?.classList.remove('hidden');
      if (bar) {
        setTimeout(() => { bar.style.width = '40%'; }, 50);
        setTimeout(() => { bar.style.width = '72%'; }, 700);
        setTimeout(() => { bar.style.width = '88%'; }, 1800);
      }
      const eventId = (window as any).oaiqNewEventId?.() ?? String(Date.now());
      const data = { ...Object.fromEntries(new FormData(form)), source: window.location.href, eventId };
      try {
        const res = await fetch('https://cms.novamarketing.es/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (res.ok) {
          // La página de gracias emite el evento del píxel con este id.
          try { sessionStorage.setItem('oaiq_event_id', eventId); } catch {}
          if (bar) bar.style.width = '100%';
          setTimeout(() => { window.location.href = '/gracias/'; }, 400);
        } else { throw new Error(); }
      } catch {
        overlay?.classList.add('hidden');
        if (bar) bar.style.width = '0%';
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'ERROR — INTÉNTALO DE NUEVO';
          (btn as HTMLElement).style.background = '#ef4444';
        }
      }
    });
  }

  handleForm('precio-form', 'precio-submit');
</script>
