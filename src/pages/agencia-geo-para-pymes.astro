---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildAlternates } from '../lib/i18n';
import { localAgencySchema } from '../lib/schema';
import LogoMarquee from '../components/sections/LogoMarquee.astro';
import FaqHome from '../components/sections/FaqHome.astro';
import CityPills from '../components/global/CityPills.astro';
import MoreCases from '../components/casos/MoreCases.astro';
import PSection from '../components/pillar/PSection.astro';
import PCards from '../components/pillar/PCards.astro';
import PFlow from '../components/pillar/PFlow.astro';
import PBars from '../components/pillar/PBars.astro';
import PMatrix from '../components/pillar/PMatrix.astro';
import PStack from '../components/pillar/PStack.astro';
import PFunnel from '../components/pillar/PFunnel.astro';
import PTree from '../components/pillar/PTree.astro';
import PLines from '../components/pillar/PLines.astro';
import PCounter from '../components/pillar/PCounter.astro';
import PVenn from '../components/pillar/PVenn.astro';
import GeoChat from '../components/pillar/GeoChat.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://novamarketing.es';
const alternates = buildAlternates('/agencia-geo-para-pymes/', '/ca/agencia-geo-per-pimes/', SITE_URL);

const ICON = {
  search: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  target: 'M12 3a9 9 0 100 18 9 9 0 000-18zm0 5a4 4 0 100 8 4 4 0 000-8z',
  doc: 'M9 12h6m-6 4h6M9 8h2m8-3v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2h6l4 4z',
  link: 'M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5m7.328-1.672a4 4 0 000-5.656 4 4 0 00-5.656 0l-1.5 1.5',
  chart: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm8 0V5a2 2 0 012-2h0a2 2 0 012 2v14a2 2 0 01-2 2h0a2 2 0 01-2-2zm-8 0a2 2 0 002 2h2a2 2 0 002-2V9a2 2 0 00-2-2h-2a2 2 0 00-2 2v10z',
  money: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  users: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  pin: 'M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z',
  star: 'M12 3l2.6 5.3 5.9.9-4.2 4.1 1 5.8L12 16.3 6.7 19l1-5.8L3.5 9.2l5.9-.9L12 3z',
  alert: 'M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z',
};

const faqs = [
  { question: '¿Se puede garantizar una aparición en ChatGPT?', answer: 'No. Nadie controla lo que responde un modelo de lenguaje, y las respuestas cambian según la pregunta, el momento y el asistente. Lo que sí podemos asegurar es el método. Revisar qué se dice hoy de tu empresa, corregir la información que falla, mejorar las páginas y fuentes que los asistentes consultan y medir con la misma muestra de preguntas si tu presencia mejora. Desconfía de quien te prometa salir siempre.' },
  { question: '¿Necesito trabajar el SEO para contratar GEO?', answer: 'No es obligatorio, pero ayuda mucho. Los buscadores con IA y muchos asistentes se apoyan en páginas que ya están indexadas, bien posicionadas y citadas por otras webs. Si tu web tiene problemas de rastreo o contenidos pobres, el GEO tendrá menos con qué trabajar. En la auditoría te decimos si hace falta reforzar antes el posicionamiento orgánico o si podemos empezar directamente por las respuestas generadas.' },
  { question: '¿En qué asistentes y buscadores tiene sentido centrarse?', answer: 'Normalmente revisamos ChatGPT, Gemini, Claude, Perplexity, Copilot y las respuestas generadas de Google, porque son los que más usan hoy los clientes de una pyme en España. La prioridad depende de tu público. Un comprador industrial no usa las mismas herramientas que un paciente que busca dentista. Elegimos los asistentes de la muestra contigo y los mantenemos estables para poder comparar.' },
  { question: '¿Cuándo conviene repetir las mediciones?', answer: 'Solemos repetir la muestra completa cada mes en los planes de seguimiento, y una revisión puntual después de cambios importantes en la web o en fuentes externas. Repetir con más frecuencia no aporta mucho, porque las variaciones del día a día pueden confundirse con avances. Lo útil es comparar rondas hechas con las mismas preguntas, los mismos asistentes y condiciones parecidas.' },
  { question: '¿Cómo se distingue una mención de una visita o una venta?', answer: 'Una mención es que el asistente nombre tu empresa en su respuesta. Una visita llega cuando el usuario pulsa una cita o busca tu marca después, y una venta cuando ese contacto se convierte en cliente. Medimos las tres cosas por separado. Las menciones, en la muestra de consultas; las visitas, en la analítica de tu web; y los contactos, preguntando el origen en formularios y llamadas.' },
  { question: '¿Qué necesita aportar mi empresa al proyecto?', answer: 'Una persona que conozca bien el negocio, los servicios que quieres potenciar y el tipo de cliente que te interesa. También accesos a la web, a Google Search Console, a la analítica y al Perfil de Empresa en Google. Más adelante te pediremos datos, casos y opiniones de tus profesionales, porque el contenido con experiencia propia es el que más fácilmente se convierte en fuente.' },
];

const pageSchema = localAgencySchema({
  pageUrl: `${SITE_URL}/agencia-geo-para-pymes/`,
  lang: 'es',
  cityName: 'Barcelona',
  postalCode: '08035',
  geo: { lat: 41.4114, lng: 2.1526 },
  areaServed: ["España", "Barcelona", "Sabadell", "Sant Cugat del Vallès", "Terrassa", "Vallès Occidental"],
  title: "▷ Posicionamiento GEO en IA para PYMEs | Estrategias y Soluciones",
  description: "Conoce métodos avanzados de posicionamiento GEO en IA para PYMEs 💡 con recomendaciones de ChatGPT, Gemini y Google AI para mejorar tu presencia digital.",
  datePublished: '2026-07-15',
  dateModified: '2026-10-25',
  streetAddress: 'Carrer del General Mendoza, 10',
  hasMap: 'https://maps.app.goo.gl/9fbB12UcK32bgjj89',
  aggregateRating: { ratingValue: '5.0', reviewCount: '12' },
  breadcrumbName: 'Agencia GEO para PYMEs',
  mainService: {
    name: 'Posicionamiento GEO para pymes',
    serviceType: 'GEO / AEO',
    description: 'Diagnóstico y mejora de la presencia de tu marca en las respuestas de ChatGPT, Gemini, Perplexity y Google, con mediciones periódicas.',
    offers: [
      { name: 'Diagnóstico inicial de visibilidad en IA', price: 1800 },
      { name: 'Optimización de marca y contenidos para IA', price: 400, from: true, monthly: true },
      { name: 'Seguimiento GEO para proyectos de mayor alcance', price: 900, from: true, monthly: true },
    ],
  },
  faqs,
});
---

<BaseLayout
  title="▷ Posicionamiento GEO en IA para PYMEs | Estrategias y Soluciones"
  description="Conoce métodos avanzados de posicionamiento GEO en IA para PYMEs 💡 con recomendaciones de ChatGPT, Gemini y Google AI para mejorar tu presencia digital."
  locale="es"
  alternates={alternates}
  schemas={[pageSchema]}
>

  <!-- ═══ HERO / H1 ═══════════════════════════════════════════════════════ -->
  <section class="pt-24 sm:pt-40 pb-20 px-4 sm:px-6 relative overflow-hidden text-center bg-white border-b border-black/5">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_40%,#000_75%,transparent_100%)]"></div>
    <div class="absolute -top-10 left-1/4 w-72 h-72 bg-accent/15 rounded-full blur-3xl opacity-30 animate-pulse"></div>
    <div class="absolute top-20 right-1/4 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl opacity-20"></div>

    <div class="max-w-5xl mx-auto reveal relative">
      <span class="inline-flex items-center gap-2 bg-accent/5 backdrop-blur-sm px-4 py-2 border border-accent/10 rounded-full text-accent text-[8px] sm:text-[10px] font-black uppercase tracking-[0.3em] mb-8 shadow-sm">
        <span class="w-1.5 h-1.5 bg-accent rounded-full animate-ping"></span>
        Optimización para motores generativos
      </span>
      <h1 class="text-3xl sm:text-5xl md:text-7xl lg:text-8xl uppercase font-extrabold tracking-tighter leading-[0.88] mb-8 text-gradient flex flex-col items-center text-center">
                <span class="lg:whitespace-nowrap">Agencia GEO </span>
                <span class="lg:whitespace-nowrap">Posicionamiento </span>
                <span class="lg:whitespace-nowrap text-mktg-gradient">en IA</span>
            </h1>
      <p class="text-lg sm:text-xl text-zinc-500 font-light leading-relaxed max-w-3xl mx-auto mb-8">
        Revisamos qué responden ChatGPT, Gemini, Claude, Perplexity y Google cuando tus clientes preguntan por lo que vendes, y trabajamos la información y las fuentes que hacen que tu empresa aparezca bien descrita.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 mb-10">
        {['Sin permanencias', 'Trato directo con el consultor', 'Mediciones documentadas'].map((item) => (
          <span class="inline-flex items-center gap-2 text-[11px] sm:text-xs font-black uppercase tracking-widest text-zinc-700">
            <svg class="w-4 h-4 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            {item}
          </span>
        ))}
      </div>
      <a href="#contacto" class="contact-modal-trigger btn-mktg-v5 shadow-[0_10px_30px_rgba(0,0,0,0.1)] !py-4 sm:!py-5 !px-6 sm:!px-10 !text-[11px] !tracking-widest font-black">REVISAR MI PRESENCIA EN IA</a>
    </div>
  </section>

  <LogoMarquee />

  <!-- ═══ QUÉ ENCUENTRA EL CLIENTE ══════════════════════════════════════ -->
  <PSection kicker="Por qué GEO" title="¿Qué encuentra un cliente cuando pregunta por tu empresa a una IA?" layout="split">
    <Fragment slot="intro">
      <p>Cada vez más clientes empiezan su búsqueda con una pregunta a un asistente. «¿Qué empresa me recomiendas para…?», «¿Es fiable este proveedor?», «¿Qué diferencia hay entre estas dos opciones?». <strong>La respuesta llega redactada, con una lista corta de nombres y algunas fuentes</strong>, y muchas veces el usuario no pasa de ahí.</p>
      <p>Si tu empresa no aparece, aparece mal descrita o se confunde con otra, pierdes la oportunidad antes de que el cliente visite tu web. El GEO, la optimización para motores generativos, consiste en revisar esas respuestas y trabajar la información de la que dependen.</p>
      <p>En Nova lo hacemos como parte de una <a href="/">agencia de marketing digital para pymes</a>, conectado con tu <a href="/agencia-seo-para-pymes/">posicionamiento en Google</a>, porque los asistentes beben en buena parte de lo que ya es visible en el buscador.</p>
    </Fragment>
    <GeoChat
      slot="aside"
      question="¿Qué empresa de mantenimiento industrial me recomiendas en el Vallès?"
      intro="Estas son algunas opciones con buena reputación en la zona:"
      items={[
        { name: 'Competidor A', desc: 'Mantenimiento preventivo para naves y maquinaria. Muchas opiniones positivas.' },
        { name: 'Tu empresa', desc: 'Especializada en líneas de producción, con servicio de urgencias 24 h.', highlight: true, label: 'Objetivo' },
        { name: 'Competidor B', desc: 'Empresa con más de 30 años, aunque su web no detalla los servicios.' },
      ]}
      sources={['web del proveedor', 'directorio sectorial', 'reseñas en Google']}
      caption="Ilustración de una respuesta generada. El objetivo es que tu empresa aparezca y lo haga con datos correctos."
    />
  </PSection>

  <!-- ═══ CÓMO INFLUYEN LAS RESPUESTAS ══════════════════════════════════ -->
  <PSection kicker="Decisión de compra" title="Cómo intervienen las respuestas generadas en la elección de una marca" tone="soft">
    <Fragment slot="intro">
      <p>Un asistente no sustituye todo el proceso de compra, pero sí filtra. Reduce el mercado a tres o cuatro nombres, resume sus diferencias y propone criterios. La empresa que no entra en esa lista corta tiene que esforzarse mucho más para que el cliente la considere.</p>
      <p>Estas son las cinco situaciones en las que más pesa la respuesta generada. Cada una pide un trabajo distinto.</p>
    </Fragment>
    <PFunnel
      stages={[
        { label: 'Pregunta al asistente', sub: '«qué gestoría trabaja con autónomos en Terrassa»', side: 'El cliente aún no conoce marcas.' },
        { label: 'Lista corta en la respuesta', sub: 'tres o cuatro empresas con un resumen', side: 'Aquí se gana o se pierde la consideración.' },
        { label: 'Comprobación en la web', sub: 'servicios, precios, opiniones', side: 'Tu web confirma o contradice lo leído.' },
        { label: 'Contacto', sub: 'llamada, formulario, visita', side: 'Solo llegan quienes pasaron los filtros.' },
      ]}
      caption="Esquema ilustrativo del recorrido. El asistente actúa como primer filtro, no como último paso."
    />
    <PCards
      tone="soft"
      items={[
        { icon: ICON.search, title: 'Preguntas para descubrir proveedores', html: 'El cliente no sabe a quién llamar y pide nombres. Es la consulta más directa y también la más disputada, porque el asistente suele mencionar pocas empresas. Para entrar hace falta que tu actividad, tu especialidad y tu zona estén descritas con claridad en tu web y en fuentes que el modelo pueda contrastar.' },
        { icon: ICON.chart, title: 'Comparaciones entre empresas y soluciones', html: 'Preguntas del tipo «X o Y, ¿cuál es mejor para mi caso?». El asistente compara con lo que encuentra publicado. Si tus ventajas no están explicadas en ningún sitio, la comparación se hará con los datos de tu competencia o con información antigua.' },
        { icon: ICON.alert, title: 'Consultas sobre problemas concretos', html: 'Muchas compras empiezan con un problema, no con un servicio. «Mi web no recibe visitas», «la máquina pierde presión». Las páginas que explican causas y soluciones con detalle son las que el asistente cita. Entender la <a href="/blog/que-es-la-intencion-de-busqueda-en-el-seo/">intención detrás de cada búsqueda</a> ayuda a cubrirlas.' },
        { icon: ICON.star, title: 'Búsquedas de referencias y confianza', html: '«¿Es fiable esta empresa?», «¿qué opinan sus clientes?». El asistente recoge reseñas, menciones en prensa y casos publicados. Una pyme con buenos trabajos pero sin rastro público de ellos parece, para el modelo, una empresa sin experiencia demostrable.' },
        { icon: ICON.pin, title: 'Preguntas sobre servicios en una ubicación', html: 'Consultas con ciudad o comarca, muy frecuentes en servicios locales. Aquí cuentan el Perfil de Empresa en Google, la coherencia de dirección y teléfono y las páginas que explican qué zonas atiendes realmente. Un dato distinto en cada sitio hace dudar al asistente.' },
      ]}
    />
  </PSection>

  <!-- ═══ MUESTRA DE VISIBILIDAD ════════════════════════════════════════ -->
  <PSection id="diagnostico" kicker="Diagnóstico" title="El punto de partida: una muestra de tu visibilidad actual" layout="split">
    <Fragment slot="intro">
      <p>Antes de cambiar nada medimos. Preparamos una muestra de preguntas reales de tus clientes, la lanzamos en varios asistentes y registramos cada respuesta. <strong>No es un informe automático de una herramienta</strong>, sino un análisis revisado a mano que explica qué se dice de tu empresa y por qué.</p>
      <p>Esa muestra es la referencia con la que compararemos cada revisión posterior. Por eso la documentamos con tanto cuidado.</p>
    </Fragment>
    <PBars
      slot="aside"
      title="Menciones en una muestra de 40 consultas"
      max={40}
      rows={[
        { label: 'Competidor A', value: 22, display: '22 de 40' },
        { label: 'Competidor B', value: 15, display: '15 de 40' },
        { label: 'Tu empresa', value: 6, display: '6 de 40', note: 'dos de ellas con datos desactualizados' },
        { label: 'Competidor C', value: 4, display: '4 de 40' },
      ]}
      caption="Esquema ilustrativo, no son datos de un cliente. Así resumimos la presencia de cada marca en la muestra inicial."
    />
    <PCards
      variant="rows"
      items={[
        { title: 'Consultas representativas de tus clientes', html: 'Definimos contigo entre 30 y 60 preguntas que haría un cliente real. Preguntas para encontrar proveedor, comparativas, dudas sobre problemas y búsquedas con ubicación. Partimos de tus servicios prioritarios, de lo que te preguntan en las reuniones comerciales y de los datos de búsqueda de tu web.' },
        { title: 'Modelos y buscadores incluidos en la revisión', html: 'Normalmente ChatGPT, Gemini, Claude, Perplexity, Copilot y las respuestas generadas de Google. Ajustamos la lista a lo que usa tu público y la mantenemos fija para poder comparar. Para el resto de la medición usamos las mismas <a href="/blog/mejores-herramientas-seo-para-pymes/">herramientas SEO que recomendamos a las pymes</a>.' },
        { title: 'Menciones de tu marca y de tus competidores', html: 'En cada respuesta anotamos si apareces, en qué lugar de la lista, con qué descripción y qué competidores se nombran. Así vemos con qué empresas te compara el asistente, que no siempre coinciden con las que tú consideras competencia.' },
        { title: 'Fuentes citadas en las respuestas', html: 'Cuando el asistente enlaza fuentes, las registramos. Webs de competidores, directorios, medios, foros, plataformas de opiniones. Esa lista indica dónde conviene estar presente y qué páginas de tu web ya se están usando como referencia.' },
        { title: 'Registro de fechas y condiciones de cada prueba', html: 'Guardamos la fecha, el asistente, el modo de uso y si la consulta se hizo con o sin búsqueda web activada, junto a una captura de la respuesta. Las respuestas cambian con el tiempo, y sin este registro no se puede saber si una mejora es real o casual.' },
      ]}
    />
  </PSection>

  <!-- ═══ QUÉ DICEN LOS ASISTENTES ══════════════════════════════════════ -->
  <PSection kicker="Percepción de marca" title="Qué dicen los asistentes sobre tu negocio" tone="soft" layout="split">
    <Fragment slot="intro">
      <p>Aparecer es solo la mitad. La otra mitad es cómo te describen. Un asistente puede nombrar tu empresa y atribuirle un servicio que ya no ofreces, una dirección antigua o una especialidad que no es la tuya.</p>
      <p>Por eso analizamos el contenido de cada respuesta, no solo si sales o no.</p>
    </Fragment>
    <PTree
      slot="aside"
      root="Tu empresa"
      branches={[
        { label: 'Servicios', leaves: ['los que vendes', 'los que te atribuyen'] },
        { label: 'Personas', leaves: ['fundadores', 'expertos que firman'] },
        { label: 'Sector y zona', leaves: ['categoría', 'ámbito geográfico'] },
      ]}
      caption="Las relaciones que revisamos en cada respuesta."
    />
    <PCards
      tone="soft"
      cols={2}
      items={[
        { icon: ICON.doc, title: 'Servicios que asocian con tu marca', html: 'Comparamos los servicios que mencionan los asistentes con los que realmente quieres vender. Es habitual que una pyme sea conocida por una línea de negocio antigua y que la nueva, la más rentable, no aparezca en ninguna respuesta.' },
        { icon: ICON.alert, title: 'Datos incompletos o contradictorios', html: 'Horarios distintos, direcciones de una sede anterior, precios de hace años o un nombre comercial que se confunde con otra empresa. Localizamos de dónde sale cada error, porque el asistente no lo inventa sin más, normalmente lo toma de alguna fuente.' },
        { icon: ICON.star, title: 'Atributos que te diferencian de otras empresas', html: 'Rapidez, especialización, garantía, trato cercano. Revisamos si los asistentes recogen las razones por las que tus clientes te eligen o si te describen con frases genéricas que valdrían para cualquiera de tu sector.' },
        { icon: ICON.users, title: 'Relación entre tu marca, tus expertos y tu sector', html: 'Comprobamos si los modelos conectan tu empresa con las personas que la dirigen y con la categoría correcta. En servicios profesionales, que el asistente sepa quién es tu abogado o tu doctora y qué experiencia tiene pesa tanto como el nombre de la empresa.' },
      ]}
    />
  </PSection>

  <!-- ═══ IDENTIDAD ═════════════════════════════════════════════════════ -->
  <PSection kicker="Identidad de marca" title="Una identidad de empresa comprensible en toda la web" layout="split">
    <Fragment slot="intro">
      <p>Los modelos construyen una idea de tu empresa juntando piezas de muchos sitios. Si cada pieza dice algo distinto, la idea resultante es borrosa. El primer trabajo es que tu web y tus perfiles cuenten la misma historia, con las mismas palabras.</p>
      <p>Es una base sobre la que se apoya todo lo demás, como muestra el esquema.</p>
    </Fragment>
    <PStack
      slot="aside"
      layers={[
        { label: 'Fuentes externas', sub: 'medios, directorios, opiniones' },
        { label: 'Web técnica y estructurada', sub: 'acceso, marcado, enlaces' },
        { label: 'Contenido que sirve de fuente', sub: 'respuestas y evidencias' },
        { label: 'Identidad clara', sub: 'quién eres, qué haces, dónde' },
      ]}
      caption="Esquema de trabajo. Cada capa se apoya en la anterior."
    />
    <PCards
      cols={2}
      items={[
        { icon: ICON.target, title: 'Información corporativa clara y consistente', html: 'Nombre comercial, razón social, dirección, teléfono, año de fundación y ámbito de trabajo, iguales en la web, el aviso legal, el Perfil de Empresa y los directorios. Parece básico, pero en casi todas las auditorías encontramos al menos una versión distinta de alguno de estos datos.' },
        { icon: ICON.doc, title: 'Servicios y especialidades bien definidos', html: 'Una página por servicio importante, con un nombre que el cliente entiende, para quién es, qué incluye y qué no. Las descripciones vagas como «soluciones integrales» no dan al asistente nada concreto que repetir cuando alguien pregunta por ese servicio.' },
        { icon: ICON.users, title: 'Autores y profesionales identificables', html: 'Páginas de equipo con nombre, cargo, formación y experiencia real, y artículos firmados por quien sabe del tema. Los asistentes valoran saber quién respalda una afirmación, y a tu cliente le ocurre lo mismo antes de confiar en una empresa que no conoce.' },
        { icon: ICON.link, title: 'Perfiles externos alineados con tu actividad', html: 'LinkedIn, Perfil de Empresa en Google, asociaciones y plataformas del sector con la misma descripción y enlazando a tu web. Si otra persona gestiona tu ficha de Google, te explicamos cómo <a href="/blog/dar-acceso-a-tu-perfil-de-empresa-en-google/">darle acceso a tu Perfil de Empresa</a> sin compartir contraseñas.' },
      ]}
    />
  </PSection>

  <!-- ═══ CONTENIDO FUENTE ══════════════════════════════════════════════ -->
  <PSection kicker="Contenido" title="Contenido que puede servir como fuente" tone="soft">
    <Fragment slot="intro">
      <p>Un asistente cita lo que le permite responder bien. Eso significa contenido concreto, verificable y escrito por alguien que conoce el tema. Los textos genéricos que repiten lo que dicen otras cien webs rara vez se convierten en fuente.</p>
      <p>Trabajamos cuatro tipos de contenido, empezando por las páginas que tienen más relación con la venta.</p>
    </Fragment>
    <PCards
      tone="soft"
      cols={2}
      variant="check"
      items={[
        { title: 'Respuestas directas a preguntas de compra', html: 'Cuánto cuesta, cuánto tarda, qué incluye, en qué casos no conviene. Respondemos en el primer párrafo y ampliamos después. Este formato facilita que el asistente extraiga la respuesta y la atribuya a tu empresa, y también ayuda al cliente que llega a la página con prisa.' },
        { title: 'Explicaciones respaldadas por experiencia', html: 'Casos, ejemplos, errores habituales y criterios que solo conoce quien trabaja en el sector. Entrevistamos a tus profesionales y convertimos ese conocimiento en contenido. Es lo que distingue tu página de un texto genérico y lo que la hace merecedora de una cita.' },
        { title: 'Datos propios con contexto y metodología', html: 'Plazos medios de tus proyectos, rangos de precio, resultados de encuestas a clientes. Publicados con la fecha, la muestra y el método, para que cualquiera pueda entender de dónde salen. Un dato sin contexto genera desconfianza, tanto en el lector como en el modelo.' },
        { title: 'Información actualizada y fácil de verificar', html: 'Fecha de revisión visible, precios vigentes, normativa al día y enlaces a fuentes cuando corresponde. Retiramos o corregimos las páginas antiguas que contradicen la información actual, porque también pueden acabar citadas en una respuesta.' },
      ]}
    />
  </PSection>

  <!-- ═══ PAPEL DE LA WEB ═══════════════════════════════════════════════ -->
  <PSection kicker="Base técnica" title="El papel de tu web en la estrategia GEO">
    <Fragment slot="intro">
      <p>Tu web es la única fuente sobre tu empresa que controlas por completo. Si los rastreadores de los asistentes no pueden leerla bien, o si la información está desordenada, pierdes la oportunidad de que sea la referencia principal.</p>
      <p>Revisamos cinco aspectos técnicos. Cuando la web necesita cambios de fondo, lo coordinamos con nuestro equipo de <a href="/diseno-web-para-pymes/">diseño web para pymes</a> o con tu desarrollador.</p>
    </Fragment>
    <PCards
      variant="numbered"
      cols={2}
      items={[
        { title: 'Acceso al contenido que quieres hacer visible', html: 'Comprobamos el archivo robots.txt, el cortafuegos y la configuración del servidor para saber qué rastreadores de buscadores y asistentes pueden entrar. Decides qué partes abrir y cuáles no, pero con conocimiento de causa y no por una configuración heredada que nadie revisó.' },
        { title: 'Estructura semántica de las páginas', html: 'Un único título principal, encabezados que siguen un orden lógico, listas y tablas cuando la información lo pide. Una página bien estructurada se entiende por partes, y eso facilita que un asistente extraiga justo el fragmento que responde a la pregunta.' },
        { title: 'Datos estructurados coherentes con la información publicada', html: 'Marcado de organización, negocio local, servicios, personas y preguntas frecuentes, siempre fiel a lo que se ve en la página. Un marcado que dice algo distinto del texto visible resta credibilidad en lugar de sumarla.' },
        { title: 'Enlaces internos que conectan conceptos y servicios', html: 'Enlazamos cada servicio con sus casos, sus autores y los artículos que lo explican. Esa red ayuda a buscadores y asistentes a entender de qué sabe tu empresa, igual que en el <a href="/agencia-seo-para-pymes/">SEO para pymes</a> ayuda a repartir la autoridad entre páginas.' },
        { title: 'Revisión del contenido que depende de JavaScript', html: 'Algunos rastreadores no ejecutan JavaScript o lo hacen de forma limitada. Si tus precios, servicios u opiniones solo aparecen después de cargar un script, puede que no los vean. Comparamos el HTML que se sirve con lo que ve el usuario y proponemos soluciones.' },
      ]}
    />
  </PSection>

  <!-- ═══ FUENTES EXTERNAS ══════════════════════════════════════════════ -->
  <PSection kicker="Autoridad" title="Las fuentes externas que hablan de tu empresa" tone="dark">
    <Fragment slot="intro">
      <p>Los asistentes dan más peso a lo que confirman varias fuentes independientes. Lo que dices de ti en tu web cuenta, pero cuenta más cuando un medio, una asociación o tus clientes dicen lo mismo.</p>
    </Fragment>
    <PFlow
