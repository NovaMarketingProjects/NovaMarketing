---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildAlternates } from '../lib/i18n';
import { localAgencySchema } from '../lib/schema';
import LogoMarquee from '../components/sections/LogoMarquee.astro';
import FaqHome from '../components/sections/FaqHome.astro';
import CityPills from '../components/global/CityPills.astro';
import MoreCases from '../components/casos/MoreCases.astro';
import PSection from '../components/pillar/PSection.astro';
import PCards from '../components/pillar/PCards.astro';
import PFlow from '../components/pillar/PFlow.astro';
import PBars from '../components/pillar/PBars.astro';
import PMatrix from '../components/pillar/PMatrix.astro';
import PStack from '../components/pillar/PStack.astro';
import PFunnel from '../components/pillar/PFunnel.astro';
import PTree from '../components/pillar/PTree.astro';
import PLines from '../components/pillar/PLines.astro';
import PCounter from '../components/pillar/PCounter.astro';
import PVenn from '../components/pillar/PVenn.astro';
import GeoChat from '../components/pillar/GeoChat.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://novamarketing.es';
const alternates = buildAlternates('/agencia-geo-para-pymes/', '/ca/agencia-geo-per-pimes/', SITE_URL);

const ICON = {
  search: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  target: 'M12 3a9 9 0 100 18 9 9 0 000-18zm0 5a4 4 0 100 8 4 4 0 000-8z',
  doc: 'M9 12h6m-6 4h6M9 8h2m8-3v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2h6l4 4z',
  link: 'M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5m7.328-1.672a4 4 0 000-5.656 4 4 0 00-5.656 0l-1.5 1.5',
  chart: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm8 0V5a2 2 0 012-2h0a2 2 0 012 2v14a2 2 0 01-2 2h0a2 2 0 01-2-2zm-8 0a2 2 0 002 2h2a2 2 0 002-2V9a2 2 0 00-2-2h-2a2 2 0 00-2 2v10z',
  money: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  users: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  pin: 'M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z',
  star: 'M12 3l2.6 5.3 5.9.9-4.2 4.1 1 5.8L12 16.3 6.7 19l1-5.8L3.5 9.2l5.9-.9L12 3z',
  alert: 'M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z',
};

const faqs = [
  { question: '¿Se puede garantizar una aparición en ChatGPT?', answer: 'No. Nadie controla lo que responde un modelo de lenguaje, y las respuestas cambian según la pregunta, el momento y el asistente. Lo que sí podemos asegurar es el método: revisar qué se dice hoy de tu empresa, corregir la información que falla, mejorar las páginas y fuentes que consultan los asistentes y medir con la misma muestra de preguntas si tu presencia mejora. Desconfía de quien te prometa salir siempre.' },
  { question: '¿Necesito trabajar el SEO para contratar GEO?', answer: 'No es obligatorio, pero ayuda mucho. Los buscadores con IA y muchos asistentes se apoyan en páginas que ya están indexadas, bien posicionadas y citadas por otras webs. Si tu web tiene problemas de rastreo o contenidos pobres, el GEO tendrá menos con qué trabajar. En la auditoría te decimos si hace falta reforzar antes el posicionamiento orgánico o si podemos empezar directamente por las respuestas generadas.' },
  { question: '¿En qué asistentes y buscadores tiene sentido centrarse?', answer: 'Normalmente revisamos ChatGPT, Gemini, Claude, Perplexity, Copilot y las respuestas generadas de Google, porque son los que más usan hoy los clientes de una pyme en España. La prioridad depende de tu público. Un comprador industrial no usa las mismas herramientas que un paciente que busca dentista. Elegimos los asistentes de la muestra contigo y los mantenemos estables para poder comparar.' },
  { question: '¿Cuándo conviene repetir las mediciones?', answer: 'Solemos repetir la muestra completa cada mes en los planes de seguimiento, y una revisión puntual después de cambios importantes en la web o en fuentes externas. Repetir con más frecuencia no aporta mucho, porque las variaciones del día a día pueden confundirse con avances. Lo útil es comparar rondas hechas con las mismas preguntas, los mismos asistentes y condiciones parecidas.' },
  { question: '¿Cómo se distingue una mención de una visita o una venta?', answer: 'Una mención es que el asistente nombre tu empresa en su respuesta. Una visita llega cuando el usuario pulsa una cita o busca tu marca después, y una venta cuando ese contacto se convierte en cliente. Medimos las tres por separado: las menciones, en la muestra de consultas; las visitas, en la analítica de tu web; y los contactos, preguntando el origen en formularios y llamadas.' },
  { question: '¿Qué necesita aportar mi empresa al proyecto?', answer: 'Una persona que conozca bien el negocio, los servicios que quieres potenciar y el tipo de cliente que te interesa. También accesos a la web, a Google Search Console, a la analítica y al Perfil de Empresa en Google. Más adelante te pediremos datos, casos y opiniones de tus profesionales, porque el contenido con experiencia propia es el que más fácilmente se convierte en fuente.' },
];

const pageSchema = localAgencySchema({
  pageUrl: `${SITE_URL}/agencia-geo-para-pymes/`,
  lang: 'es',
  cityName: 'Barcelona',
  postalCode: '08035',
  geo: { lat: 41.4114, lng: 2.1526 },
  areaServed: ["España", "Barcelona", "Sabadell", "Sant Cugat del Vallès", "Terrassa", "Vallès Occidental"],
  title: "▷ Posicionamiento GEO en IA para PYMEs | Estrategias y Soluciones",
  description: "Conoce métodos avanzados de posicionamiento GEO en IA para PYMEs 💡 con recomendaciones de ChatGPT, Gemini y Google AI para mejorar tu presencia digital.",
  datePublished: '2026-07-15',
  dateModified: '2026-10-25',
  streetAddress: 'Carrer del General Mendoza, 10',
  hasMap: 'https://maps.app.goo.gl/9fbB12UcK32bgjj89',
  aggregateRating: { ratingValue: '5.0', reviewCount: '12' },
  breadcrumbName: 'Agencia GEO para PYMEs',
  mainService: {
    name: 'Posicionamiento GEO para pymes',
    serviceType: 'GEO / AEO',
    description: 'Diagnóstico y mejora de la presencia de tu marca en las respuestas de ChatGPT, Gemini, Perplexity y Google, con mediciones periódicas.',
    offers: [
      { name: 'Diagnóstico inicial de visibilidad en IA', price: 1800 },
      { name: 'Optimización de marca y contenidos para IA', price: 400, from: true, monthly: true },
      { name: 'Seguimiento GEO para proyectos de mayor alcance', price: 900, from: true, monthly: true },
    ],
  },
  faqs,
});
---

<BaseLayout
  title="▷ Posicionamiento GEO en IA para PYMEs | Estrategias y Soluciones"
  description="Conoce métodos avanzados de posicionamiento GEO en IA para PYMEs 💡 con recomendaciones de ChatGPT, Gemini y Google AI para mejorar tu presencia digital."
  locale="es"
  alternates={alternates}
  schemas={[pageSchema]}
>

  <!-- ═══ HERO / H1 ═══════════════════════════════════════════════════════ -->
  <section class="pt-24 sm:pt-40 pb-20 px-4 sm:px-6 relative overflow-hidden text-center bg-white border-b border-black/5">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_40%,#000_75%,transparent_100%)]"></div>
    <div class="absolute -top-10 left-1/4 w-72 h-72 bg-accent/15 rounded-full blur-3xl opacity-30 animate-pulse"></div>
    <div class="absolute top-20 right-1/4 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl opacity-20"></div>

    <div class="max-w-5xl mx-auto reveal relative">
      <span class="inline-flex items-center gap-2 bg-accent/5 backdrop-blur-sm px-4 py-2 border border-accent/10 rounded-full text-accent text-[8px] sm:text-[10px] font-black uppercase tracking-[0.3em] mb-8 shadow-sm">
        <span class="w-1.5 h-1.5 bg-accent rounded-full animate-ping"></span>
        Optimización para motores generativos
      </span>
      <h1 class="text-3xl sm:text-5xl md:text-7xl lg:text-8xl uppercase font-extrabold tracking-tighter leading-[0.88] mb-8 text-gradient flex flex-col items-center text-center">
                <span class="lg:whitespace-nowrap">Agencia GEO </span>
                <span class="lg:whitespace-nowrap">Posicionamiento </span>
                <span class="lg:whitespace-nowrap text-mktg-gradient">en IA</span>
            </h1>
      <p class="text-lg sm:text-xl text-zinc-500 font-light leading-relaxed mb-8">
        Comprobamos qué responden ChatGPT, Gemini, Perplexity y Google cuando tus clientes preguntan por lo que vendes, y corregimos la información de la que sacan esas respuestas. Cada respuesta la revisa a mano el mismo consultor, que te enseña el antes y el después.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 mb-10">
        {['Sin permanencias', 'Trato directo con el consultor', 'Mediciones documentadas'].map((item) => (
          <span class="inline-flex items-center gap-2 text-[11px] sm:text-xs font-black uppercase tracking-widest text-zinc-700">
            <svg class="w-4 h-4 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            {item}
          </span>
        ))}
      </div>
      <a href="#contacto" class="contact-modal-trigger btn-mktg-v5 shadow-[0_10px_30px_rgba(0,0,0,0.1)] !py-4 sm:!py-5 !px-6 sm:!px-10 !text-[11px] !tracking-widest font-black">REVISAR MI PRESENCIA EN IA</a>
    </div>
  </section>

  <LogoMarquee />

  <!-- ═══ QUÉ ENCUENTRA EL CLIENTE ══════════════════════════════════════ -->
  <PSection kicker="Por qué GEO" title="¿Qué encuentra un cliente cuando pregunta por tu empresa a una IA?" layout="split">
    <Fragment slot="intro">
      <p>Cada vez más clientes empiezan con una pregunta a un asistente de IA como ChatGPT. «¿Qué empresa me recomiendas para…?», «¿Es fiable este proveedor?». <strong>El asistente contesta con un texto ya redactado, una lista corta de nombres y, a veces, los enlaces de donde ha sacado la información</strong>. Esos enlaces son las fuentes citadas. Muchas veces el cliente no pasa de ahí.</p>
      <p>Si tu empresa no sale, sale con datos viejos o se confunde con otra, pierdes al cliente antes de que vea tu web. El GEO (optimización para motores generativos) consiste en revisar esas respuestas y mejorar la información de la que dependen. Al lado tienes un ejemplo de lo que lee tu cliente.</p>
      <p>Lo hacemos como <a href="/">agencia de marketing digital para pymes</a> y siempre junto a tu <a href="/agencia-seo-para-pymes/">posicionamiento en Google</a>, porque los asistentes se apoyan en gran parte en lo que ya encuentra el buscador.</p>
    </Fragment>
    <GeoChat
      slot="aside"
      question="¿Qué empresa de mantenimiento industrial me recomiendas en el Vallès?"
      intro="Estas son algunas opciones con buena reputación en la zona:"
      items={[
        { name: 'Competidor A', desc: 'Mantenimiento preventivo para naves y maquinaria. Muchas opiniones positivas.' },
        { name: 'Tu empresa', desc: 'Especializada en líneas de producción, con servicio de urgencias 24 h.', highlight: true, label: 'Objetivo' },
        { name: 'Competidor B', desc: 'Empresa con más de 30 años, aunque su web no detalla los servicios.' },
      ]}
      sources={['web del proveedor', 'directorio sectorial', 'reseñas en Google']}
      caption="Ilustración de una respuesta generada: solo caben tres empresas, y debajo aparecen las fuentes de las que sale cada dato."
    />
  </PSection>

  <!-- ═══ CÓMO INFLUYEN LAS RESPUESTAS ══════════════════════════════════ -->
  <PSection kicker="Decisión de compra" title="Cómo intervienen las respuestas generadas en la elección de una marca" tone="soft">
    <Fragment slot="intro">
      <p>Un asistente no cierra la venta por ti, pero filtra. Reduce el mercado a tres o cuatro nombres y explica en qué se diferencian. Si tu empresa queda fuera de esa lista corta, es difícil que el cliente llegue a tu web.</p>
      <p>El esquema muestra en qué punto actúa ese filtro. Debajo tienes los cinco tipos de pregunta que más pesan y lo que necesita cada uno.</p>
    </Fragment>
    <PFunnel
      stages={[
        { label: 'Pregunta al asistente', sub: '«qué gestoría trabaja con autónomos en Terrassa»', side: 'El cliente aún no conoce marcas.' },
        { label: 'Lista corta en la respuesta', sub: 'tres o cuatro empresas con un resumen', side: 'Aquí se gana o se pierde la consideración.' },
        { label: 'Comprobación en la web', sub: 'servicios, precios, opiniones', side: 'Tu web confirma o contradice lo leído.' },
        { label: 'Contacto', sub: 'llamada, formulario, visita', side: 'Solo llegan quienes pasaron los filtros.' },
      ]}
      caption="Esquema ilustrativo del recorrido: la lista corta del segundo paso decide quién llega a recibir la llamada."
    />
    <PCards
      tone="soft"
      items={[
        { icon: ICON.search, title: 'Preguntas para descubrir proveedores', html: 'El cliente no sabe a quién llamar y pide nombres: «¿qué empresa de climatización me recomiendas en Barcelona?». Es la pregunta más disputada, porque el asistente nombra pocas empresas. Para entrar, tu actividad, tu especialidad y tu zona tienen que estar explicadas con claridad en tu web y repetidas en otras fuentes que el asistente pueda contrastar.' },
        { icon: ICON.chart, title: 'Comparaciones entre empresas y soluciones', html: '«¿Me conviene más la empresa X o la Y para una reforma de oficina?». El asistente compara con lo que encuentra publicado. Si tus ventajas no están escritas en ningún sitio, la comparación se hará con los datos de tu competencia o con información antigua. Revisamos qué se dice de ti en esas comparaciones y qué falta.' },
        { icon: ICON.alert, title: 'Consultas sobre problemas concretos', html: 'Muchas compras empiezan por un problema: «mi web no recibe visitas», «la máquina pierde presión». El asistente cita las páginas que explican causas y soluciones con detalle. Entender la <a href="/blog/que-es-la-intencion-de-busqueda-en-el-seo/">intención de búsqueda detrás de cada consulta</a> nos ayuda a decidir qué páginas escribir y qué pregunta debe resolver cada una.' },
        { icon: ICON.star, title: 'Búsquedas de referencias y confianza', html: '«¿Es fiable esta empresa?», «¿qué opinan sus clientes?». El asistente reúne reseñas, menciones en prensa y casos publicados. Si tus buenos trabajos no dejan rastro público, para el asistente eres una empresa sin experiencia demostrable. Comprobamos qué pruebas de tu trabajo encuentra y cuáles le faltan.' },
        { icon: ICON.pin, title: 'Preguntas sobre servicios en una ubicación', html: 'Preguntas con ciudad o comarca, muy habituales en servicios locales. Aquí cuentan el Perfil de Empresa en Google, la misma dirección y el mismo teléfono en todas partes y páginas que expliquen qué zonas atiendes de verdad. Lo trabajamos zona a zona, como en el <a href="/agencia-geo-para-pymes/barcelona/">posicionamiento GEO en Barcelona</a> o el <a href="/agencia-geo-para-pymes/sant-cugat/">posicionamiento en IA en Sant Cugat</a>.' },
      ]}
    />
  </PSection>

  <!-- ═══ MUESTRA DE VISIBILIDAD ════════════════════════════════════════ -->
  <PSection id="diagnostico" kicker="Diagnóstico" title="El punto de partida: una muestra de tu visibilidad actual" layout="split">
    <Fragment slot="intro">
      <p>Antes de cambiar nada, medimos. Preparamos una lista de preguntas reales de tus clientes, se la hacemos a varios asistentes y guardamos cada respuesta. <strong>Las revisa una persona, una por una</strong>, y el resultado explica qué se dice de tu empresa y de dónde sale.</p>
      <p>Esa muestra es la foto de partida. Todas las revisiones posteriores se comparan con ella.</p>
    </Fragment>
    <PBars
      slot="aside"
      title="Menciones en una muestra de 40 consultas"
      max={40}
      rows={[
        { label: 'Competidor A', value: 22, display: '22 de 40' },
        { label: 'Competidor B', value: 15, display: '15 de 40' },
        { label: 'Tu empresa', value: 6, display: '6 de 40', note: 'dos de ellas con datos desactualizados' },
        { label: 'Competidor C', value: 4, display: '4 de 40' },
      ]}
      caption="Esquema ilustrativo, no son datos de un cliente: cada barra indica en cuántas de las 40 preguntas aparece cada marca."
    />
    <PCards
      variant="rows"
      items={[
        { title: 'Consultas representativas de tus clientes', html: 'Definimos contigo entre 30 y 60 preguntas como las que haría un cliente real, por ejemplo «¿qué asesoría laboral trabaja con restaurantes en Sabadell?». Salen de tus servicios prioritarios, de lo que te preguntan en las reuniones comerciales, de las búsquedas que ya llegan a tu web y, si tienes campañas, de los términos que mejor funcionan en tus <a href="/agencia-sem-para-pymes/">anuncios de Google Ads</a>.' },
        { title: 'Modelos y buscadores incluidos en la revisión', html: 'Normalmente ChatGPT, Gemini, Claude, Perplexity, Copilot y las respuestas generadas de Google, que son los resúmenes con IA que aparecen encima de los resultados. Ajustamos la lista a lo que usa tu público y no la cambiamos entre rondas, para poder comparar. Para medir tu web usamos las <a href="/blog/mejores-herramientas-seo-para-pymes/">herramientas SEO que recomendamos a las pymes</a>.' },
        { title: 'Menciones de tu marca y de tus competidores', html: 'En cada respuesta anotamos si apareces, en qué puesto de la lista, cómo te describen y qué competidores salen. Recibes una tabla con tus competidores reales en los asistentes de IA, que a menudo no son los que tú tienes en mente. Una empresa pequeña del polígono de al lado puede estar ocupando tu sitio.' },
        { title: 'Fuentes citadas en las respuestas', html: 'Las fuentes citadas son las páginas que el asistente enlaza para respaldar su respuesta. Las apuntamos todas: webs de competidores, directorios, medios, foros y portales de opiniones. Esa lista te dice dónde te conviene estar presente y qué páginas de tu web ya se están usando como referencia.' },
        { title: 'Registro de fechas y condiciones de cada prueba', html: 'De cada prueba guardamos la fecha, el asistente, el modo de uso, si tenía la búsqueda web activada y una captura de la respuesta. Las respuestas cambian con el tiempo. Sin este registro no sabríamos si una mejora es real o fruto del azar, y tú no podrías comprobarlo.' },
      ]}
    />
  </PSection>

  <!-- ═══ QUÉ DICEN LOS ASISTENTES ══════════════════════════════════════ -->
  <PSection kicker="Percepción de marca" title="Qué dicen los asistentes sobre tu negocio" tone="soft" layout="split">
    <Fragment slot="intro">
      <p>Salir no basta. También importa cómo te describen. Un asistente puede nombrar tu empresa y atribuirle un servicio que dejaste de ofrecer, una dirección antigua o una especialidad que no es la tuya.</p>
      <p>Por eso leemos cada respuesta frase a frase y la comparamos con la realidad de tu negocio.</p>
    </Fragment>
    <PTree
      slot="aside"
      root="Tu empresa"
      branches={[
        { label: 'Servicios', leaves: ['los que vendes', 'los que te atribuyen'] },
        { label: 'Personas', leaves: ['fundadores', 'expertos que firman'] },
        { label: 'Sector y zona', leaves: ['categoría', 'ámbito geográfico'] },
      ]}
      caption="En cada rama comparamos lo que dice el asistente con lo que tu empresa es y hace hoy."
    />
    <PCards
      tone="soft"
      cols={2}
      items={[
        { icon: ICON.doc, title: 'Servicios que asocian con tu marca', html: 'Comparamos los servicios que te atribuyen los asistentes con los que quieres vender. Es habitual que una pyme siga asociada a una línea antigua y que la nueva, la más rentable, no salga en ninguna respuesta. Por ejemplo, una imprenta que hoy vive del gran formato y a la que siguen recomendando para tarjetas de visita.' },
        { icon: ICON.alert, title: 'Datos incompletos o contradictorios', html: 'Horarios distintos, la dirección de una sede anterior, precios de hace años o un nombre comercial que se confunde con otra empresa. Para cada error buscamos de dónde sale, porque el asistente casi nunca lo inventa: lo toma de alguna fuente. Recibes la lista de errores con el origen de cada uno.' },
        { icon: ICON.star, title: 'Atributos que te diferencian de otras empresas', html: 'Rapidez, especialización, garantía, trato cercano. Revisamos si los asistentes recogen las razones por las que tus clientes te eligen o si te describen con frases que valdrían para cualquier empresa de tu sector. Si tus clientes valoran que respondes en 24 horas, eso debería aparecer en la respuesta.' },
        { icon: ICON.users, title: 'Relación entre tu marca, tus expertos y tu sector', html: 'Comprobamos si los asistentes relacionan tu empresa con las personas que la dirigen y con la categoría correcta. En servicios profesionales pesa mucho. Si alguien pregunta «¿qué abogada laboralista de Terrassa tiene experiencia en despidos?», el asistente necesita saber quién trabaja en tu despacho y qué casos ha llevado.' },
      ]}
    />
  </PSection>

  <!-- ═══ IDENTIDAD ═════════════════════════════════════════════════════ -->
  <PSection kicker="Identidad de marca" title="Una identidad de empresa comprensible en toda la web" layout="split">
    <Fragment slot="intro">
      <p>Los asistentes forman una idea de tu empresa juntando piezas de muchos sitios. Si cada pieza dice algo distinto, la idea sale borrosa. Lo primero es que tu web y tus perfiles cuenten lo mismo, con las mismas palabras.</p>
      <p>En el esquema, esa identidad es la base. Si falla, todo lo que se construye encima pierde valor.</p>
    </Fragment>
    <PStack
      slot="aside"
      layers={[
        { label: 'Fuentes externas', sub: 'medios, directorios, opiniones' },
        { label: 'Web técnica y estructurada', sub: 'acceso, marcado, enlaces' },
        { label: 'Contenido que sirve de fuente', sub: 'respuestas y evidencias' },
        { label: 'Identidad clara', sub: 'quién eres, qué haces, dónde' },
      ]}
      caption="Esquema de trabajo: la identidad clara es la base y cada capa se apoya en la que tiene debajo."
    />
    <PCards
      cols={2}
      items={[
        { icon: ICON.target, title: 'Información corporativa clara y consistente', html: 'Nombre comercial, razón social, dirección, teléfono, año de fundación y zona de trabajo, idénticos en la web, el aviso legal, el Perfil de Empresa y los directorios. Parece básico, pero en casi todas las auditorías encontramos alguno de estos datos con dos versiones. Te entregamos la versión correcta y la lista de sitios donde corregirla.' },
        { icon: ICON.doc, title: 'Servicios y especialidades bien definidos', html: 'Una página por cada servicio importante, con un nombre que tu cliente entienda, para quién es, qué incluye y qué no. Frases como «soluciones integrales» no le dan al asistente nada concreto que repetir. «Mantenimiento de calderas industriales con visita en 48 horas» sí se puede repetir cuando alguien pregunta por ese servicio.' },
        { icon: ICON.users, title: 'Autores y profesionales identificables', html: 'Páginas de equipo con nombre, cargo, formación y experiencia real, y artículos firmados por quien sabe del tema. Los asistentes tienen en cuenta quién respalda una afirmación, y tu cliente también, antes de confiar en una empresa que no conoce. Te decimos qué profesionales de tu equipo deberían tener un perfil propio.' },
        { icon: ICON.link, title: 'Perfiles externos alineados con tu actividad', html: 'LinkedIn, Perfil de Empresa en Google, asociaciones y plataformas del sector, todos con la misma descripción y un enlace a tu web. Revisamos cada perfil y te pasamos el texto que debe llevar. Si otra persona gestiona tu ficha de Google, te explicamos cómo <a href="/blog/dar-acceso-a-tu-perfil-de-empresa-en-google/">dar acceso a tu Perfil de Empresa</a> sin compartir contraseñas.' },
      ]}
    />
  </PSection>

  <!-- ═══ CONTENIDO FUENTE ══════════════════════════════════════════════ -->
  <PSection kicker="Contenido" title="Contenido que puede servir como fuente" tone="soft">
    <Fragment slot="intro">
      <p>Un asistente cita lo que le permite responder bien: contenido concreto, que se puede comprobar y escrito por alguien que conoce el tema. Los textos genéricos que repiten lo que dicen otras cien webs casi nunca se citan.</p>
      <p>Trabajamos cuatro tipos de contenido y empezamos por las páginas más cercanas a la venta.</p>
    </Fragment>
    <PCards
      tone="soft"
      cols={2}
      variant="check"
      items={[
        { title: 'Respuestas directas a preguntas de compra', html: 'Cuánto cuesta, cuánto tarda, qué incluye, cuándo no conviene. Damos la respuesta en el primer párrafo y ampliamos después, una técnica que también se llama AEO (optimización para respuestas). Con respuestas directas, preguntas frecuentes y datos verificables, las páginas de <a href="/casos-exito/tattoox/">la escuela online Tattoox</a> aparecen hoy en las respuestas con IA de Google para las búsquedas principales de su sector.' },
        { title: 'Explicaciones respaldadas por experiencia', html: 'Casos, ejemplos, errores habituales y criterios que solo conoce quien trabaja en el sector. Entrevistamos a tus profesionales, por ejemplo a tu jefe de obra sobre los fallos más comunes en una reforma, y convertimos ese conocimiento en contenido. Eso distingue tu página de un texto genérico y le da motivos para ser citada.' },
        { title: 'Datos propios con contexto y metodología', html: 'Plazos medios de tus proyectos, rangos de precio, resultados de encuestas a clientes. Los publicamos con la fecha, el número de casos y el método, para que se entienda de dónde salen. Una frase como «casi todas nuestras reformas de baño terminan en tres semanas» solo resulta creíble si dices sobre cuántas obras y de qué periodo.' },
        { title: 'Información actualizada y fácil de verificar', html: 'Fecha de revisión visible, precios vigentes, normativa al día y enlaces a fuentes cuando hace falta. También retiramos o corregimos las páginas antiguas que contradicen la información actual, porque un asistente puede citar una tarifa de hace cuatro años si sigue publicada en tu web.' },
      ]}
    />
  </PSection>

  <!-- ═══ PAPEL DE LA WEB ═══════════════════════════════════════════════ -->
  <PSection kicker="Base técnica" title="El papel de tu web en la estrategia GEO">
    <Fragment slot="intro">
      <p>Tu web es la única fuente sobre tu empresa que controlas del todo. Si los rastreadores de los asistentes, los programas que leen las webs por ellos, no pueden entrar o encuentran la información desordenada, otras fuentes ocupan su lugar.</p>
      <p>Revisamos cinco puntos técnicos. Si la web necesita cambios de fondo, lo coordinamos con nuestro equipo de <a href="/diseno-web-para-pymes/">diseño web para pymes</a> o con tu desarrollador.</p>
    </Fragment>
    <PCards
      variant="numbered"
      cols={2}
      items={[
        { title: 'Acceso al contenido que quieres hacer visible', html: 'Revisamos el archivo robots.txt, el cortafuegos y la configuración del servidor para ver qué rastreadores de buscadores y asistentes pueden entrar. A veces encontramos el rastreador de ChatGPT bloqueado sin que nadie lo decidiera, por una configuración heredada. Tú decides qué abrir y qué no, pero sabiendo lo que eliges.' },
        { title: 'Estructura semántica de las páginas', html: 'Un único título principal, encabezados en orden lógico y listas o tablas cuando la información lo pide. Una página bien ordenada se entiende por partes. Si alguien pregunta «¿cuánto tarda una reforma de baño?», el asistente puede tomar justo el fragmento que responde sin tener que interpretar toda la página.' },
        { title: 'Datos estructurados coherentes con la información publicada', html: 'Los datos estructurados son un código que no ve el visitante y que resume quién eres, qué ofreces y dónde estás. Marcamos organización, negocio local, servicios, personas y preguntas frecuentes, siempre fiel a lo que se ve en la página. Si el marcado dice algo distinto del texto visible, resta credibilidad en lugar de sumarla.' },
        { title: 'Enlaces internos que conectan conceptos y servicios', html: 'Enlazamos cada servicio con sus casos, sus autores y los artículos que lo explican. Esa red ayuda a buscadores y asistentes a entender de qué sabe tu empresa y qué páginas son las importantes. Esta misma página es un ejemplo: desde aquí enlazamos los sectores, las ciudades y los casos en los que aplicamos el GEO.' },
        { title: 'Revisión del contenido que depende de JavaScript', html: 'Algunos rastreadores no ejecutan JavaScript o lo hacen a medias. Si tus precios, servicios u opiniones solo aparecen después de cargar un script, puede que no los vean. Comparamos el HTML que entrega tu servidor con lo que ve el usuario y te decimos qué conviene cambiar y con qué prioridad.' },
      ]}
    />
  </PSection>

  <!-- ═══ FUENTES EXTERNAS ══════════════════════════════════════════════ -->
  <PSection kicker="Autoridad" title="Las fuentes externas que hablan de tu empresa" tone="dark">
    <Fragment slot="intro">
      <p>Los asistentes se fían más de lo que confirman varias fuentes independientes. Lo que dices en tu web cuenta, pero cuenta más cuando un medio, una asociación o tus clientes dicen lo mismo. El esquema muestra cómo se encadena esa confirmación.</p>
    </Fragment>
    <PFlow
      tone="dark"
      steps={[
        { label: 'Fuente externa', sub: 'medio, directorio, reseñas' },
        { label: 'Coincide con tu web', sub: 'mismos datos y servicios' },
        { label: 'El modelo lo confirma', sub: 'más confianza en el dato' },
        { label: 'Mención correcta', sub: 'en la respuesta generada' },
      ]}
      caption="Esquema ilustrativo: fíjate en el segundo paso, porque un dato que no coincide con tu web pierde fuerza."
    />
    <PCards
      tone="dark"
      cols={2}
      variant="numbered"
      items={[
        { title: 'Medios y publicaciones de tu sector', html: 'Revistas especializadas, diarios locales y blogs de referencia en tu actividad. Buscamos oportunidades con sentido, como una entrevista, un artículo con datos propios o una colaboración. Una nota de prensa genérica rara vez se cita. Un artículo con datos de tu sector en tu comarca sí puede convertirse en fuente.' },
        { title: 'Directorios y asociaciones profesionales', html: 'Colegios profesionales, cámaras de comercio, asociaciones sectoriales y directorios de calidad. Los asistentes los consultan a menudo para confirmar que una empresa existe y a qué se dedica. Revisamos en cuáles estás, en cuáles deberías estar y si tus datos son correctos en cada uno.' },
        { title: 'Plataformas de opiniones y referencias', html: 'Google, plataformas del sector y portales de comparación. La cantidad, la fecha y el texto de las reseñas influyen en cómo te describen. Una reseña que dice «arreglaron la avería en el día» aporta más que cinco estrellas sin comentario. Te ayudamos a montar un sistema para <a href="/blog/como-conseguir-mas-resenas-en-google-para-tu-pyme/">conseguir más reseñas en Google</a> y responderlas.' },
        { title: 'Menciones que necesitan corregirse o completarse', html: 'Artículos con un teléfono antiguo, fichas duplicadas, directorios con la actividad equivocada. Hacemos la lista, la ordenamos según la importancia de cada fuente y gestionamos las correcciones. Un error repetido en varios sitios suele acabar en las respuestas, así que empezamos por los que más se repiten.' },
      ]}
    />
  </PSection>

  <!-- ═══ PREGUNTAS CLAVE ═══════════════════════════════════════════════ -->
  <PSection kicker="Consultas prioritarias" title="Preguntas donde tu pyme necesita estar presente">
    <Fragment slot="intro">
      <p>No todas las preguntas valen lo mismo. Damos prioridad a las que hace alguien que está decidiendo a quién contratar, porque son las que acaban en una llamada. Estas cuatro familias entran siempre en la muestra.</p>
    </Fragment>
    <PCards
      cols={2}
      items={[
        { icon: ICON.search, tag: 'Descubrimiento', title: 'Quién puede resolver el problema del cliente', html: '«¿Quién instala placas solares en naves industriales?», «¿qué abogado lleva divorcios en Sabadell?». Son las preguntas con más intención de compra y las que llevan más directamente a una llamada. Necesitan páginas de servicio claras y fuentes externas que confirmen tu especialidad, como trabajamos en el <a href="/agencia-abogados/posicionamiento-geo/">posicionamiento en IA para abogados</a>.' },
        { icon: ICON.chart, tag: 'Comparación', title: 'Qué alternativas existen y cómo se comparan', html: '«¿Qué es mejor para una clínica pequeña, un programa de gestión en la nube o uno instalado?». El cliente ya tiene opciones y pide al asistente que las compare. Publicamos comparativas honestas que explican cuándo encaja tu solución y cuándo no. Así la comparación se hace con tus datos y no con información ajena.' },
        { icon: ICON.doc, tag: 'Criterios', title: 'Qué criterios conviene revisar antes de contratar', html: '«¿Qué debo pedir a una empresa de reformas antes de firmar?». Quien responde bien esta pregunta marca las reglas del juego, y de paso destaca tus puntos fuertes. Es el enfoque de nuestro <a href="/agencia-constructoras/posicionamiento-geo/">GEO para constructoras y reformistas</a>. Con guías y páginas de servicio escritas así, <a href="/casos-exito/voltura-projects/">la web de reformas de Voltura Projects</a> ya aparecía citada en 6 respuestas de IA de Google a los siete meses de su lanzamiento.' },
        { icon: ICON.target, tag: 'Encaje', title: 'Qué proveedor encaja en cada situación', html: '«Tengo un presupuesto ajustado», «lo necesito para la semana que viene», «somos una empresa de cinco personas». El asistente recomienda según cada situación. Si tu contenido explica para quién es cada servicio y para quién no, tu empresa aparece en los casos donde de verdad encaja y deja de competir donde no tiene opciones.' },
      ]}
    />
  </PSection>

  <!-- ═══ MODELO DE NEGOCIO ═════════════════════════════════════════════ -->
  <PSection kicker="Experiencia sectorial" title="GEO según tu modelo de negocio" tone="soft">
    <Fragment slot="intro">
      <p>Cada tipo de empresa recibe preguntas distintas y depende de fuentes distintas. Un despacho necesita que se conozca a sus profesionales y una tienda online, que sus fichas de producto estén completas.</p>
      <p>Ajustamos la muestra a cómo compran tus clientes. Para los sectores en los que más trabajamos tienes una página específica con ejemplos de preguntas y fuentes.</p>
    </Fragment>
    <PCards
      tone="soft"
      cols={2}
      items={[
        { icon: ICON.chart, title: 'Empresas B2B con procesos de compra largos', html: 'Deciden varias personas y comparan durante semanas. El ingeniero pregunta por especificaciones y el gerente por plazos y precio. Trabajamos fichas técnicas, casos y contenido para cada perfil del comité de compra. Lo explicamos en detalle en <a href="/agencia-b2b/posicionamiento-geo/">GEO para empresas B2B</a> y en <a href="/agencia-industrial/posicionamiento-geo/">posicionamiento en IA para la industria</a>.' },
        { icon: ICON.users, title: 'Servicios profesionales basados en la confianza', html: 'Tu cliente quiere saber quién le atenderá y qué experiencia tiene, y pregunta cosas como «¿qué dentista de confianza hace implantes cerca de mí?». Trabajamos perfiles de profesionales, contenido firmado y reseñas para <a href="/agencia-abogados/posicionamiento-geo/">despachos de abogados</a>, <a href="/agencia-dentistas/posicionamiento-geo/">clínicas dentales</a>, <a href="/agencia-psicologos/posicionamiento-geo/">consultas de psicología</a> y <a href="/agencia-terapeutas/posicionamiento-geo/">centros de terapia</a>.' },
        { icon: ICON.money, title: 'Ecommerce con productos que se comparan', html: 'Los asistentes recomiendan productos según características, precio y opiniones: «¿qué cafetera de menos de 300 euros me recomiendas?». Trabajamos fichas completas, guías de compra y datos de producto iguales en la tienda y en los comparadores. Lo detallamos en nuestro servicio de <a href="/agencia-ecommerce/posicionamiento-geo/">GEO para tiendas online</a>.' },
        { icon: ICON.pin, title: 'Negocios locales con una zona de atención', html: 'Aquí la pregunta casi siempre incluye una ciudad: «gimnasio con clases de pilates en Terrassa». Cuentan el Perfil de Empresa, las reseñas y una página por cada zona que atiendes de verdad. Tenemos páginas de <a href="/agencia-restaurantes/posicionamiento-geo/">posicionamiento en IA para restaurantes</a>, <a href="/agencia-hoteles/posicionamiento-geo/">hoteles y alojamientos</a>, <a href="/agencia-gimnasios/posicionamiento-geo/">gimnasios y centros deportivos</a> y <a href="/agencia-inmobiliarias/posicionamiento-geo/">agencias inmobiliarias</a>.' },
      ]}
    />
    <div class="mt-12 text-center reveal">
      <p class="text-xs font-black uppercase tracking-[0.25em] text-zinc-400 mb-4">Agencia GEO en tu zona</p>
      <CityPills base="/agencia-geo-para-pymes/" lang="es" itemPrefix="Agencia GEO en" homeLabel="Toda España" />
    </div>
  </PSection>

  <!-- ═══ SEO, GEO Y AEO ════════════════════════════════════════════════ -->
  <PSection kicker="Estrategia conjunta" title="SEO, GEO y AEO dentro de una misma estrategia" layout="split">
    <Fragment slot="intro">
      <p>El SEO trabaja tu posición en los resultados de Google. El GEO, tu presencia en las respuestas que redactan los asistentes. El AEO, que tu contenido sea la respuesta directa a una pregunta concreta. Se solapan tanto que tratarlos por separado suele llevar a pagar dos veces o a hacer cambios que se contradicen.</p>
      <p>Por eso los planificamos juntos. Si aún dudas entre invertir en buscadores o en anuncios, esta guía te ayuda a <a href="/blog/que-necesita-una-pyme-seo-o-sem/">elegir entre SEO y SEM</a>.</p>
    </Fragment>
    <PVenn
      slot="aside"
      sets={[
        { label: 'SEO', sub: 'resultados de Google' },
        { label: 'GEO', sub: 'respuestas generadas' },
        { label: 'AEO', sub: 'respuesta directa' },
      ]}
      center="Tu marca"
      caption="Fíjate en la zona central: las tres disciplinas comparten web sólida, contenido útil y autoridad."
    />
    <PCards
      variant="rows"
      items={[
        { title: 'Qué aporta el posicionamiento orgánico', html: 'Indexación, arquitectura, contenidos que posicionan y enlaces. Muchos asistentes buscan en la web antes de responder y tienden a usar páginas que ya están bien situadas en Google. Por eso, en la mayoría de proyectos, el trabajo de nuestra <a href="/agencia-seo-para-pymes/">agencia SEO para pymes</a> es el punto de partida del GEO.' },
        { title: 'Qué trabajamos para las respuestas generadas', html: 'La identidad de la empresa, la exactitud de los datos, las fuentes externas y la medición en los asistentes. Es la parte que el SEO tradicional no cubre. En Google compites por un puesto en una lista. En un asistente cuenta cómo te describe un texto que redacta él, y estar cuarto en Google no asegura ni una mención.' },
        { title: 'Dónde encaja la optimización de respuestas', html: 'El AEO busca que tu contenido sea la respuesta directa: el fragmento destacado de Google, lo que lee un altavoz inteligente o la primera frase de un asistente. Lo aplicamos sobre todo en preguntas frecuentes y páginas de servicio. Si alguien pregunta «¿cuánto cuesta un diagnóstico GEO?», la cifra va en la primera línea.' },
        { title: 'Cómo evitamos duplicar esfuerzos', html: 'Un único plan de trabajo, una sola persona responsable y un calendario compartido. Si también inviertes en <a href="/agencia-sem-para-pymes/">publicidad en Google Ads</a>, usamos los datos de las campañas para ver qué preguntas y servicios convierten mejor y empezar por ellos. Así cada tarea se hace una vez y en el canal donde más rinde.' },
      ]}
    />
  </PSection>

  <!-- ═══ HALLAZGOS A ACCIONES ══════════════════════════════════════════ -->
  <PSection kicker="Plan de trabajo" title="De los hallazgos a las acciones" tone="soft" layout="split">
    <Fragment slot="intro">
      <p>El diagnóstico termina con una lista de tareas ordenada por el efecto que esperamos en las respuestas y el esfuerzo que exige cada una. Empezamos por lo que corrige errores en las preguntas con más valor comercial.</p>
      <p>Después repetimos la muestra para ver qué ha cambiado y decidir el siguiente paso.</p>
    </Fragment>
    <PMatrix
      slot="aside"
      xLabel="Esfuerzo"
      yLabel="Impacto en las respuestas"
      quadrants={['Hacer primero', 'Planificar', 'Si sobra tiempo', 'Descartar']}
      points={[
        { label: 'Corregir datos de contacto', x: 14, y: 84 },
        { label: 'Reescribir página de servicio', x: 34, y: 72 },
        { label: 'Estudio con datos propios', x: 76, y: 78 },
        { label: 'Aparecer en medios del sector', x: 66, y: 60 },
        { label: 'Directorios poco relevantes', x: 30, y: 22 },
      ]}
      caption="Ejemplo de priorización: arriba a la izquierda queda lo que más mejora las respuestas con menos esfuerzo."
    />
    <PCards
      tone="soft"
      cols={2}
      variant="numbered"
      items={[
        { title: 'Corregir información esencial sobre tu empresa', html: 'Datos de contacto, servicios, sedes y descripciones contradictorias en la web y en las fuentes externas más consultadas. Suele ser la tarea más rápida y la primera que se nota, porque elimina errores que los asistentes estaban repitiendo. Cambiar un teléfono antiguo en cinco directorios, por ejemplo, puede quedar resuelto en una mañana.' },
        { title: 'Mejorar las páginas con mayor valor comercial', html: 'Reescribimos las páginas de los servicios que más te interesa vender para que respondan a las preguntas de la muestra. Añadimos precios orientativos, plazos, casos y preguntas frecuentes, y revisamos su estructura y su marcado. Si una pregunta importante no tiene respuesta en ninguna página de tu web, la creamos.' },
        { title: 'Desarrollar contenidos y evidencias que faltan', html: 'Comparativas, guías de criterios, casos documentados o datos propios que el diagnóstico ha detectado como ausentes. También acciones fuera de tu web, como colaboraciones con medios o el alta en asociaciones, que confirman lo que dices en ella. Cada pieza nace de una pregunta concreta de la muestra.' },
        { title: 'Revisar de nuevo la muestra de consultas', html: 'Repetimos las mismas preguntas en los mismos asistentes y comparamos con la ronda anterior. Lo que ha mejorado se mantiene, lo que no se mueve se revisa, y las preguntas nuevas se añaden con su fecha para no mezclar resultados. Recibes la comparación pregunta a pregunta.' },
      ]}
    />
  </PSection>

  <!-- ═══ EVOLUCIÓN ═════════════════════════════════════════════════════ -->
  <PSection kicker="Medición" title="Cómo interpretamos la evolución de tu presencia en IA">
    <Fragment slot="intro">
      <p>En cada ronda medimos tres indicadores y los leemos juntos. Más menciones con datos erróneos no es una buena noticia, y una cita que no trae visitas tampoco dice mucho. Para interpretar las visitas conviene saber <a href="/blog/donde-viene-el-trafico/">de dónde viene el tráfico de tu web</a> y cómo lo registra la analítica.</p>
    </Fragment>
    <div class="grid lg:grid-cols-[1fr_1.1fr] gap-10 items-start">
      <PCards
        variant="numbered"
        cols={2}
        class="lg:grid-cols-1"
        items={[
          { title: 'Frecuencia de menciones en las consultas analizadas', html: 'Qué parte de las preguntas de la muestra incluye tu empresa en la respuesta, separada por asistente y por familia de preguntas. Por ejemplo, 12 de 40 en ChatGPT y 6 de 40 en Gemini. Es el indicador más directo y también el que más varía de una ronda a otra.' },
          { title: 'Citas y enlaces hacia tus contenidos', html: 'Cuántas veces un asistente enlaza una página de tu web como fuente, y cuáles. Además, revisamos en la analítica las visitas que llegan desde ChatGPT, Perplexity y otros asistentes, cuando la herramienta permite identificarlas. Así sabes qué páginas de tu web trabajan para ti en las respuestas.' },
          { title: 'Exactitud de la información sobre tu marca', html: 'Porcentaje de respuestas en las que los datos sobre tu empresa son correctos: servicios, ubicación, atributos y personas. Lo medimos aparte porque una presencia mal descrita puede perjudicar más que no aparecer. Un asistente que te sitúa en otra ciudad te envía clientes que no puedes atender.' },
        ]}
      />
      <PLines
        title="Evolución de los tres indicadores por ronda"
        series={[
          { label: 'Menciones', points: [15, 18, 26, 31, 38, 42] },
          { label: 'Citas a tu web', points: [5, 6, 10, 15, 19, 24], color: '#8b5cf6' },
          { label: 'Exactitud', points: [55, 70, 82, 86, 90, 92], color: '#16a34a', dashed: true },
        ]}
        xLabels={['Ronda 1', 'Ronda 2', 'Ronda 3', 'Ronda 4', 'Ronda 5', 'Ronda 6']}
        caption="Esquema ilustrativo, no son datos de un cliente: la exactitud suele subir primero, al corregir errores, y menciones y citas avanzan más despacio."
      />
    </div>
  </PSection>

  <!-- ═══ EVIDENCIAS Y LÍMITES ══════════════════════════════════════════ -->
  <PSection kicker="Casos y transparencia" title="Evidencias y límites de los resultados" tone="soft" width="wide">
    <Fragment slot="intro">
      <p>El GEO es una disciplina joven y los asistentes cambian a menudo. Preferimos separar con claridad lo que podemos demostrar de lo que todavía es una tendencia.</p>
      <p>Lo que sí podemos enseñar son resultados publicados. Cuando se pregunta a ChatGPT, Gemini o Claude por una agencia SEO para pymes, Nova aparece entre las recomendaciones, como ves en la captura. Google cita a Dipole RFID en sus respuestas con IA para búsquedas como «trazabilidad por RFID», y <a href="/casos-exito/tattoox/">el caso de Tattoox</a> suma presencia en más de 2.300 respuestas de IA, según Semrush.</p>
    </Fragment>
    <div class="grid lg:grid-cols-2 gap-8 items-start mt-12">
      <figure class="pd-figure reveal">
        <img src="/agencia-seo-para-pymes.webp" alt="Nova Marketing, agencia SEO para PYMEs recomendada por la IA" title="Nova Marketing, agencia SEO para PYMEs recomendada por la IA" class="w-full h-auto rounded-3xl border border-black/5 shadow-[0_25px_70px_rgba(0,0,0,0.08)]" loading="lazy" width="1000" height="667" />
        <figcaption class="pd-caption">Respuesta de un asistente al preguntar por una agencia SEO para pymes: Nova aparece entre las opciones recomendadas.</figcaption>
      </figure>
      <PCounter
