  <!-- ═══ PRECIOS ════════════════════════════════════════════════════════ -->
  <PSection kicker="Precios" title="Cuánto cuesta trabajar Google Ads con Nova" width="wide">
    <Fragment slot="intro">
      <p>Tres conceptos separados, sin IVA y sin permanencia. Antes de empezar recibes un presupuesto cerrado por escrito. Si quieres ver cómo encaja la publicidad en el conjunto de tu marketing, lee <a href="/blog/cuanto-tiene-que-invertir-una-pyme-en-marketing/">cuánto tiene que invertir una pyme en marketing</a>.</p>
    </Fragment>
    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch reveal">
      {[
        { title: 'Configuración o revisión inicial de la cuenta', price: '900 €', note: 'pago único · revisión de una cuenta existente', text: 'Si ya inviertes, revisamos campañas, búsquedas, conversiones y páginas de destino, y te entregamos un plan priorizado en una videollamada. Si empiezas desde cero, la configuración de la cuenta y de la medición está incluida en la gestión mensual.', items: ['Revisión de estructura y búsquedas', 'Comprobación de conversiones', 'Análisis de páginas de destino', 'Plan ordenado por impacto'] },
        { title: 'Honorarios de gestión y optimización', price: 'desde 150 € / mes', note: 'desde 400 € / mes en cuentas mayores', text: 'Una cuota fija según el número de campañas, servicios y formatos, no un porcentaje de lo que inviertes. Incluye la gestión continua de la cuenta, los anuncios, la revisión de búsquedas, el informe mensual y la línea directa con el consultor.', items: ['Optimización continua', 'Anuncios y recursos', 'Informe mensual de contactos y costes', 'Sin permanencia, mes a mes'], featured: true },
        { title: 'Presupuesto destinado a los anuncios', price: 'lo decides tú', note: 'orientativo: desde 300-500 € / mes', text: 'Es lo que pagas a Google por los clics, y Google lo factura directamente a tu empresa. Va íntegro a los anuncios. La cifra adecuada depende del coste del clic en tu sector y de tu margen; la calculamos contigo antes de empezar.', items: ['Facturado por Google', 'Ajustable cada mes', 'Sin comisiones sobre la inversión'] },
      ].map((p, i) => (
        <div class:list={['pd-rise rounded-3xl p-7 sm:p-8 flex flex-col border', p.featured ? 'bg-zinc-950 text-white border-zinc-950 shadow-2xl' : 'bg-white border-black/5 shadow-[0_15px_40px_rgba(0,0,0,0.06)]']} style={`--i:${i}`}>
          <h3 class:list={['text-lg font-black tracking-tight leading-snug mb-3', p.featured ? 'text-white' : 'text-zinc-900']}>{p.title}</h3>
          <div class="text-2xl font-black text-accent">{p.price}</div>
          <div class="text-[11px] font-light mt-1 mb-4 text-zinc-400">{p.note}</div>
          <p class:list={['text-sm font-light leading-relaxed mb-6', p.featured ? 'text-zinc-300' : 'text-zinc-500']}>{p.text}</p>
          <ul class="space-y-2.5 flex-1">
            {p.items.map((it) => (
              <li class:list={['flex items-start gap-2.5 text-sm font-light', p.featured ? 'text-zinc-300' : 'text-zinc-600']}>
                <svg class="w-4 h-4 text-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>{it}
              </li>
            ))}
          </ul>
          <a href="#contacto" class="contact-modal-trigger btn-mktg-v5 !py-4 !text-[11px] !tracking-widest font-black mt-8 text-center">PEDIR PRESUPUESTO</a>
        </div>
      ))}
    </div>
    <SemBudget
      title="Cómo se reparte la inversión mensual"
      rows={[
        { label: 'Negocio local con un servicio', fee: 150, ads: 400 },
        { label: 'Pyme con varios servicios', fee: 250, ads: 1000 },
        { label: 'Cuenta con Shopping o varias zonas', fee: 400, ads: 2500 },
      ]}
      caption="Ejemplo con cifras ilustrativas, sin IVA. Los honorarios son fijos; a medida que crece el presupuesto en anuncios, la gestión pesa proporcionalmente menos. Tu presupuesto real lo calculamos contigo."
    />
  </PSection>

  <!-- ═══ RESEÑAS ════════════════════════════════════════════════════════ -->
  <GoogleReviews locale="es" title="La experiencia de las empresas que nos confían sus campañas" />

  <!-- ═══ FAQS ═══════════════════════════════════════════════════════════ -->
  <FaqHome title="Dudas habituales antes de activar la inversión" items={faqs} emitSchema={false} />

  <!-- ═══ CONTACTO ═══════════════════════════════════════════════════════ -->
  <section id="contacto" class="py-20 sm:py-32 px-4 sm:px-6 relative bg-accent">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-12 sm:gap-20 items-center">
      <div class="reveal text-white">
        <span class="text-[10px] font-black uppercase tracking-[0.5em] mb-6 block opacity-70">Primer paso</span>
        <h2 class="text-4xl sm:text-6xl font-black uppercase tracking-tighter leading-[0.85] mb-10">Revisemos si Google Ads encaja en tu negocio</h2>
        <ol class="space-y-5">
          {[
            ['Qué vendes y en qué zonas', 'Tus servicios o productos principales y dónde están tus clientes.'],
            ['Qué resultados necesitas conseguir', 'Presupuestos, ventas, llamadas u oportunidades para tu equipo comercial.'],
            ['Qué inversión estás valorando', 'Hacemos los números con tu margen para ver si encajan.'],
            ['Qué propuesta de campañas tiene sentido para tu empresa', 'Por escrito, con campañas, presupuesto recomendado y honorarios cerrados.'],
          ].map(([t, d], i) => (
            <li class="flex gap-4">
              <span class="w-8 h-8 rounded-full bg-white/15 border border-white/30 flex items-center justify-center text-xs font-black flex-shrink-0">{i + 1}</span>
              <div>
                <h3 class="text-base sm:text-lg font-black tracking-tight">{t}</h3>
                <p class="text-sm font-light text-white/80">{d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="reveal">
        <div class="bg-white p-8 sm:p-16 shadow-[0_40px_100px_rgba(0,0,0,0.1)] rounded-sm">
          <form class="space-y-8" id="contact-form">
            <div class="grid sm:grid-cols-2 gap-6 text-[10px] font-black tracking-widest uppercase">
              <div class="flex flex-col gap-3">
                <label class="opacity-30">NOMBRE *</label>
                <input type="text" name="name" aria-label="Nombre" required class="border-b border-black/10 py-2 focus:border-accent outline-none">
              </div>
              <div class="flex flex-col gap-3">
                <label class="opacity-30">TELÉFONO *</label>
                <input type="tel" name="phone" required autocomplete="tel" inputmode="tel" minlength="9" pattern="[0-9+\s.\(\)\-]{9,20}" title="Introduce un teléfono válido (mínimo 9 cifras)" aria-label="Teléfono" class="border-b border-black/10 py-2 focus:border-accent outline-none">
              </div>
            </div>
            <div class="flex flex-col gap-3 text-[10px] font-black tracking-widest uppercase">
              <label class="opacity-30">EMAIL PROFESIONAL *</label>
              <input type="email" name="email" aria-label="Correo electrónico" required class="border-b border-black/10 py-2 focus:border-accent outline-none">
            </div>
            <div class="flex flex-col gap-3 text-[10px] font-black tracking-widest uppercase">
              <label class="opacity-30">WEB *</label>
              <input type="text" name="url" aria-label="Sitio web" placeholder="www.tuempresa.com" class="border-b border-black/10 py-2 focus:border-accent outline-none">
            </div>
            <div class="flex flex-col gap-3 text-[10px] font-black tracking-widest uppercase">
              <label class="opacity-30">CONSULTA</label>
              <textarea name="msg" aria-label="Mensaje" rows="3" class="border-b border-black/10 py-2 focus:border-accent outline-none resize-none" placeholder="¿Qué quieres anunciar en Google?"></textarea>
            </div>
            <div class="flex items-start gap-2">
              <input type="checkbox" id="contact-form-terms" name="terms" required class="mt-1 accent-accent">
              <label for="contact-form-terms" class="text-xs text-zinc-500 font-light cursor-pointer select-none normal-case tracking-normal">He leído y acepto la <a href="/privacidad/" class="underline hover:text-accent transition-colors">política de privacidad</a>.</label>
            </div>
            <button type="submit" class="w-full btn-mktg-v5 !py-6">QUIERO LANZAR MIS CAMPAÑAS</button>
          </form>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button');
    if (btn) { btn.innerHTML = 'ENVIANDO...'; btn.disabled = true; }
    const data = Object.fromEntries(new FormData(form));
    try {
      const res = await fetch('https://cms.novamarketing.es/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        window.location.href = '/gracias/';
      } else { throw new Error(); }
    } catch {
      if (btn) { btn.innerHTML = 'ERROR — INTÉNTALO DE NUEVO'; btn.disabled = false; btn.style.background = '#ef4444'; }
    }
  });
</script>
