---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildAlternates } from '../lib/i18n';
import { localAgencySchema } from '../lib/schema';
import LogoMarquee from '../components/sections/LogoMarquee.astro';
import FaqHome from '../components/sections/FaqHome.astro';
import CityPills from '../components/global/CityPills.astro';
import GoogleReviews from '../components/global/GoogleReviews.astro';
import MoreCases from '../components/casos/MoreCases.astro';
import PSection from '../components/pillar/PSection.astro';
import PCards from '../components/pillar/PCards.astro';
import PFlow from '../components/pillar/PFlow.astro';
import PBars from '../components/pillar/PBars.astro';
import PMatrix from '../components/pillar/PMatrix.astro';
import PStack from '../components/pillar/PStack.astro';
import PVenn from '../components/pillar/PVenn.astro';
import PFunnel from '../components/pillar/PFunnel.astro';
import PTree from '../components/pillar/PTree.astro';
import PLines from '../components/pillar/PLines.astro';
import PCounter from '../components/pillar/PCounter.astro';
import PSerp from '../components/pillar/PSerp.astro';
import SemCalc from '../components/pillar/SemCalc.astro';
import SemBudget from '../components/pillar/SemBudget.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://novamarketing.es';
const alternates = buildAlternates('/agencia-sem-para-pymes/', '/ca/agencia-sem-per-pimes/', SITE_URL);

const ICON = {
  search: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
  cart: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z',
  phone: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z',
  target: 'M12 3a9 9 0 100 18 9 9 0 000-18zm0 5a4 4 0 100 8 4 4 0 000-8z',
  doc: 'M9 12h6m-6 4h6M9 8h2m8-3v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2h6l4 4z',
  chart: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm8 0V5a2 2 0 012-2h0a2 2 0 012 2v14a2 2 0 01-2 2h0a2 2 0 01-2-2zm-8 0a2 2 0 002 2h2a2 2 0 002-2V9a2 2 0 00-2-2h-2a2 2 0 00-2 2v10z',
  money: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  users: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  video: 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z',
  eye: 'M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z',
  repeat: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
  shield: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  key: 'M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z',
  chat: 'M8 12h.01M12 12h.01M16 12h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
};

const faqs = [
  { question: '¿Qué presupuesto necesita mi pyme para empezar?', answer: 'Como orientación, recomendamos empezar con entre 300 y 500 euros al mes de presupuesto en anuncios, que va íntegro a Google, más los honorarios de gestión, desde 150 euros al mes sin IVA. La cifra real depende de lo que cuesta cada clic en tus búsquedas y de tu margen. Antes de empezar hacemos los números contigo y, si no salen, te lo decimos.' },
  { question: '¿Cuándo habrá datos suficientes para evaluar las campañas?', answer: 'Los anuncios pueden empezar a mostrarse en pocos días y los primeros contactos suelen llegar en las primeras semanas. Para valorar con criterio el coste por contacto y la calidad de los leads hacen falta, por lo general, entre uno y dos meses de datos, más si el presupuesto es bajo o tu ciclo de venta es largo.' },
  { question: '¿Podéis continuar con una cuenta que ya existe?', answer: 'Sí, y suele ser lo más recomendable, porque el historial de la cuenta tiene valor. Empezamos con una revisión de la configuración, las conversiones, las campañas y las búsquedas reales que han activado tus anuncios. Mantenemos lo que funciona y corregimos lo demás por orden de impacto, sin borrar la cuenta ni empezar de cero.' },
  { question: '¿Cómo se pausa o se finaliza el servicio?', answer: 'Trabajamos mes a mes, sin permanencia. Si quieres pausar las campañas por temporada o terminar el servicio, nos lo dices y lo dejamos ordenado. La cuenta de Google Ads siempre está a tu nombre, así que conservas el historial, las conversiones y las audiencias, y puedes retomarla tú o con quien decidas.' },
];

const pageSchema = localAgencySchema({
  pageUrl: `${SITE_URL}/agencia-sem-para-pymes/`,
  lang: 'es',
  cityName: 'Barcelona',
  postalCode: '08035',
  geo: { lat: 41.4114, lng: 2.1526 },
  areaServed: ['España', 'Barcelona', 'Sabadell', 'Sant Cugat del Vallès', 'Terrassa', 'Vallès Occidental'],
  title: '▷ Agencia Google Ads para PYMEs | Campañas SEM con resultados claros',
  description: 'Campañas Google Ads para PYMEs con fee fijo ✅ cuenta propia y seguimiento detallado de leads y ventas. Conoce cómo trabajamos en SEM',
  datePublished: '2026-07-15',
  dateModified: '2026-10-25',
  streetAddress: 'Carrer del General Mendoza, 10',
  hasMap: 'https://maps.app.goo.gl/9fbB12UcK32bgjj89',
  aggregateRating: { ratingValue: '5.0', reviewCount: '12' },
  breadcrumbName: 'Agencia de Google Ads para PYMEs',
  mainService: {
    name: 'Gestión de Google Ads para pymes',
    serviceType: 'SEM / Google Ads',
    description: 'Campañas de Google Ads para pymes orientadas a contactos y ventas, con la cuenta a nombre del cliente, honorarios fijos y sin permanencia.',
    offers: [
      { name: 'Revisión inicial de la cuenta de Google Ads', price: 900 },
      { name: 'Gestión y optimización de Google Ads', price: 150, from: true, monthly: true, description: 'Honorarios de gestión; el presupuesto de anuncios se paga aparte a Google.' },
      { name: 'Gestión de cuentas con más inversión', price: 400, from: true, monthly: true },
    ],
  },
  faqs,
});
---

<BaseLayout
  title="▷ Agencia Google Ads para PYMEs | Campañas SEM con resultados claros"
  description="Campañas Google Ads para PYMEs con fee fijo ✅ cuenta propia y seguimiento detallado de leads y ventas. Conoce cómo trabajamos en SEM"
  locale="es"
  alternates={alternates}
  schemas={[pageSchema]}
>

  <!-- ═══ HERO / H1 ═══════════════════════════════════════════════════════ -->
  <section class="pt-24 sm:pt-40 pb-20 px-4 sm:px-6 relative overflow-hidden text-center bg-white border-b border-black/5">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_40%,#000_75%,transparent_100%)]"></div>
    <div class="absolute -top-10 left-1/4 w-72 h-72 bg-accent/15 rounded-full blur-3xl opacity-30 animate-pulse"></div>
    <div class="absolute top-20 right-1/4 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl opacity-20"></div>

    <div class="max-w-5xl mx-auto reveal relative">
      <span class="inline-flex items-center gap-2 bg-accent/5 backdrop-blur-sm px-4 py-2 border border-accent/10 rounded-full text-accent text-[8px] sm:text-[10px] font-black uppercase tracking-[0.3em] mb-8 shadow-sm">
        <span class="w-1.5 h-1.5 bg-accent rounded-full animate-ping"></span>
        Publicidad en Google para pymes
      </span>
      <h1 class="text-3xl sm:text-5xl md:text-7xl lg:text-8xl uppercase font-extrabold tracking-tighter leading-[0.88] mb-8 text-gradient flex flex-col items-center text-center">
                <span class="lg:whitespace-nowrap">Agencia SEM </span>
                <span class="lg:whitespace-nowrap text-mktg-gradient">para PYMEs</span>
            </h1>
      <p class="text-lg sm:text-xl text-zinc-500 font-light leading-relaxed max-w-3xl mx-auto mb-8">
        Campañas en Google pensadas para conseguir presupuestos, ventas y llamadas que tu empresa pueda atender, con la cuenta a tu nombre y honorarios fijos que no dependen de cuánto gastes.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 mb-10">
        {['Sin permanencias', 'Honorarios fijos', 'La cuenta es tuya'].map((item) => (
          <span class="inline-flex items-center gap-2 text-[11px] sm:text-xs font-black uppercase tracking-widest text-zinc-700">
            <svg class="w-4 h-4 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            {item}
          </span>
        ))}
      </div>
      <a href="#contacto" class="contact-modal-trigger btn-mktg-v5 shadow-[0_10px_30px_rgba(0,0,0,0.1)] !py-4 sm:!py-5 !px-6 sm:!px-10 !text-[11px] !tracking-widest font-black">HABLEMOS DE TU NEGOCIO</a>
    </div>
  </section>

  <LogoMarquee />

  <!-- ═══ OBJETIVO ═══════════════════════════════════════════════════════ -->
  <PSection kicker="Por qué Google Ads" title="Tu inversión publicitaria debe responder a un objetivo claro">
    <Fragment slot="intro">
      <p>Google Ads permite aparecer hoy mismo delante de quien busca lo que vendes. Esa rapidez es su ventaja y también su riesgo: <strong>una campaña sin objetivo concreto gasta igual de rápido que una bien planteada</strong>, solo que sin devolver clientes.</p>
      <p>En Nova empezamos por lo que tu empresa necesita conseguir y construimos las campañas hacia atrás. Qué búsquedas merecen inversión, qué mensaje necesita cada anuncio y qué debe pasar en la página para que el clic acabe en contacto. Si dudas entre pagar por anuncios o trabajar el posicionamiento, te lo explicamos en <a href="/blog/que-necesita-una-pyme-seo-o-sem/">qué necesita una pyme, SEO o SEM</a>. Muchas veces la respuesta es combinar la publicidad con el <a href="/agencia-seo-para-pymes/">posicionamiento SEO</a>.</p>
    </Fragment>
    <PFlow
      steps={[
        { label: 'Objetivo de negocio', sub: 'presupuestos, ventas, llamadas' },
        { label: 'Campaña adecuada', sub: 'búsqueda, Shopping, vídeo' },
        { label: 'Página de destino', sub: 'responde a la búsqueda' },
        { label: 'Conversión medida', sub: 'contacto, venta, oportunidad' },
      ]}
      caption="El orden en el que planteamos una cuenta. Primero el objetivo; la campaña es la herramienta para llegar a él."
    />
  </PSection>

  <!-- ═══ OBJETIVOS ══════════════════════════════════════════════════════ -->
  <PSection kicker="Objetivos" title="Qué quieres conseguir con tus campañas" tone="soft">
    <Fragment slot="intro">
      <p>Cada objetivo pide una configuración distinta: tipo de campaña, forma de pujar, página de destino y lo que contamos como conversión. Por eso lo acordamos antes de tocar la cuenta.</p>
    </Fragment>
    <PCards
      tone="soft"
      cols={2}
      items={[
        { icon: ICON.doc, title: 'Solicitudes de presupuesto', html: 'Para empresas de servicios con un ticket alto, como reformas, instalaciones o asesorías. Buscamos personas que ya saben lo que necesitan y quieren precio. Medimos formularios completos, no clics, y filtramos las búsquedas de bricolaje o empleo. Lo aplicamos en sectores como <a href="/agencia-constructoras/google-ads/">constructoras</a> o <a href="/agencia-inmobiliarias/google-ads/">inmobiliarias</a>, donde un solo contrato puede justificar meses de inversión.' },
        { icon: ICON.cart, title: 'Ventas en tu tienda online', html: 'Si vendes online, el objetivo es facturar con rentabilidad, no acumular visitas. Trabajamos el catálogo, las campañas de Shopping y la medición de ingresos para saber qué productos devuelven lo invertido. Lo detallamos en nuestro servicio de <a href="/agencia-ecommerce/google-ads/">Google Ads para ecommerce</a>, con la vista puesta en el margen de cada producto.' },
        { icon: ICON.phone, title: 'Llamadas y contactos para tu negocio', html: 'Clínicas, despachos, restaurantes o centros deportivos suelen recibir clientes por teléfono. Activamos anuncios con llamada, horarios ajustados a cuándo puedes atender y zonas reales de servicio. Tenemos enfoques específicos para <a href="/agencia-dentistas/google-ads/">dentistas</a>, <a href="/agencia-abogados/google-ads/">abogados</a>, <a href="/agencia-restaurantes/google-ads/">restaurantes</a> y <a href="/agencia-gimnasios/google-ads/">gimnasios</a>.' },
        { icon: ICON.users, title: 'Oportunidades comerciales para tu equipo de ventas', html: 'En empresas B2B o industriales, el anuncio no cierra la venta; abre una conversación. Priorizamos búsquedas técnicas, formularios con datos útiles para el comercial y el seguimiento de qué contactos acaban en oferta. Más detalle en <a href="/agencia-b2b/google-ads/">Google Ads B2B</a> y <a href="/agencia-industrial/google-ads/">Google Ads para empresas industriales</a>.' },
      ]}
    />
  </PSection>

  <!-- ═══ NÚMEROS ════════════════════════════════════════════════════════ -->
  <PSection id="numeros" kicker="Viabilidad" title="Antes de invertir, comprobamos si los números encajan">
    <Fragment slot="intro">
      <p>Hay negocios donde Google Ads funciona muy bien y otros donde el clic cuesta más de lo que el cliente deja. <strong>Preferimos saberlo antes de que gastes</strong> que descubrirlo tres meses después. Hacemos este cálculo con tus datos reales en la primera conversación.</p>
      <p>Prueba a mover los valores. El resultado es el coste por clic a partir del cual las campañas dejan de compensar con ese planteamiento.</p>
    </Fragment>
    <SemCalc caption="Ejemplo con valores ilustrativos de una empresa de servicios, no son datos de un cliente. Cambia cada valor para aproximarlo a tu negocio." />
    <PCards
      cols={2}
      variant="numbered"
      items={[
        { title: 'Margen de tus productos o servicios', html: 'Lo que importa no es el precio de venta, sino lo que queda después de costes. Con un margen alto puedes pagar clics caros y seguir ganando; con uno estrecho, cada euro de publicidad tiene que estar muy bien dirigido. Por eso te preguntamos por el margen aproximado de cada línea antes de proponer campañas o presupuesto.' },
        { title: 'Coste de adquisición que puede asumir tu empresa', html: 'A partir del margen y de cuántos contactos acaban en venta calculamos cuánto puedes pagar como máximo por un cliente nuevo. Si además ese cliente repite o contrata otros servicios, el límite sube. Esa cifra es la referencia con la que juzgamos cada campaña, no el número de clics.' },
        { title: 'Demanda y competencia en las búsquedas', html: 'Revisamos cuánta gente busca tu servicio en tu zona, cuánto cuesta aproximadamente el clic y quién más se anuncia. Una búsqueda con poca demanda pero muy precisa puede ser rentable; otra con mucho volumen y competidores con más presupuesto puede no serlo para una pyme. Entender la <a href="/blog/que-es-la-intencion-de-busqueda-en-el-seo/">intención de búsqueda</a> ayuda a separar ambas.' },
        { title: 'Capacidad para atender los contactos recibidos', html: 'Más contactos solo son buena noticia si alguien los atiende a tiempo. Si tu equipo tarda dos días en devolver una llamada o no puede asumir más trabajo en temporada alta, lo tenemos en cuenta al fijar el presupuesto y los horarios. Una campaña no debe generar más demanda de la que puedes convertir en clientes.' },
      ]}
    />
  </PSection>

  <!-- ═══ CUENTA ACTUAL ══════════════════════════════════════════════════ -->
  <PSection id="auditoria" kicker="Revisión de cuenta" title="¿Tu cuenta de Google Ads está aprovechando el presupuesto?" tone="soft" layout="split">
    <Fragment slot="intro">
      <p>Si ya inviertes en Google Ads, el primer paso es mirar dónde va cada euro. Nuestra revisión de cuenta recorre campañas, búsquedas reales, conversiones y páginas de destino, y termina con un plan ordenado por ahorro e impacto.</p>
      <p>También sirve como <strong>segunda opinión independiente</strong> si trabajas con otra agencia y no tienes claro qué estás pagando.</p>
    </Fragment>
    <PBars
      slot="aside"
      title="Dónde suele perderse el presupuesto"
      rows={[
        { label: 'Búsquedas sin relación con lo que vendes', value: 34, display: 'Alto' },
        { label: 'Conversiones que no miden negocio', value: 26, display: 'Alto' },
        { label: 'Landing genérica o lenta', value: 20, display: 'Medio' },
        { label: 'Campañas solapadas', value: 12, display: 'Medio' },
        { label: 'Horarios y zonas sin ajustar', value: 8, display: 'Bajo' },
      ]}
      caption="Esquema ilustrativo de los problemas que más revisamos, ordenados por el peso que suelen tener. No son porcentajes de una cuenta real."
    />
    <PCards
      variant="rows"
      tone="soft"
      items={[
        { title: 'Inversión destinada a búsquedas poco relevantes', html: 'El informe de términos de búsqueda muestra lo que la gente escribió realmente antes de pulsar tu anuncio. Es habitual encontrar búsquedas de empleo, de formación, de productos que no vendes o de otras ciudades. Cada una de ellas resta presupuesto a las que sí traen clientes, y se corrige con palabras clave mejor elegidas y negativas.' },
        { title: 'Campañas que compiten entre sí', html: 'Cuando varias campañas o grupos de anuncios pujan por la misma búsqueda, Google elige cuál muestra y los datos se reparten. El resultado es que no sabes qué funciona y a veces pagas más por el clic. Reordenamos la estructura para que cada búsqueda importante tenga una única campaña responsable.' },
        { title: 'Conversiones mal configuradas o incompletas', html: 'Si la cuenta cuenta como conversión una visita a la página de contacto, un clic en el teléfono o un mismo formulario dos veces, las pujas automáticas optimizan hacia algo que no es negocio. Comprobamos qué se mide, cómo se mide y si los números de la cuenta cuadran con los contactos que recibe tu empresa.' },
        { title: 'Páginas de destino que frenan los resultados', html: 'Muchos anuncios llevan a la portada o a una página que no habla de lo buscado, carga lenta en el móvil o esconde el formulario. El clic está pagado, pero el contacto no llega. Revisamos cada página que recibe tráfico de pago y marcamos qué cambiar primero.' },
      ]}
    />
  </PSection>

  <!-- ═══ BÚSQUEDA ═══════════════════════════════════════════════════════ -->
  <PSection kicker="Campañas de búsqueda" title="Captar la demanda que ya existe" layout="split">
    <Fragment slot="intro">
      <p>Las campañas de búsqueda son la base de casi cualquier cuenta de pyme. Aparecen cuando alguien escribe en Google exactamente lo que ofreces, es decir, cuando la necesidad ya existe. <strong>No hay que convencer a nadie de que te necesita</strong>, solo de que eres la mejor opción.</p>
    </Fragment>
    <PSerp
      slot="aside"
      query="reforma de baño en Sabadell precio"
      results={[
        { url: 'tuempresa.es › reforma-banos', title: 'Reforma de baño en Sabadell · Presupuesto en 48 h', desc: 'Plato de ducha, alicatado y fontanería. Precio cerrado y visita sin compromiso en el Vallès.', highlight: true, label: 'Anuncio' },
        { url: 'competidor-a.com', title: 'Reformas integrales | Pide presupuesto', desc: 'Reformamos tu casa completa. Más de 20 años de experiencia.', label: 'Anuncio' },
        { url: 'directorio-reformas.es › sabadell', title: 'Precios de reforma de baño en Sabadell', desc: 'Compara presupuestos de varias empresas de la zona.' },
      ]}
      caption="Ilustración. Un anuncio específico para el servicio y la zona responde mejor que uno genérico de la misma empresa."
    />
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start">
      <PCards
        cols={2}
        variant="check"
        class="lg:grid-cols-1 !mt-12"
        items={[
          { title: 'Campañas de búsqueda por servicio', html: 'Separamos cada servicio importante en su propia campaña o grupo de anuncios, con su presupuesto, sus palabras clave y su página. Así puedes decidir cuánto invertir en cada línea y comparar qué servicio trae clientes a mejor coste, en lugar de mezclarlo todo en una sola campaña.' },
          { title: 'Separación entre búsquedas de marca y genéricas', html: 'Quien busca el nombre de tu empresa ya te conoce; quien busca el servicio, todavía no. Mezclar ambas inflaría los resultados de forma engañosa. Las separamos para ver cuánto aporta de verdad la publicidad y para proteger tu marca cuando otros pujan por ella, algo habitual en <a href="/agencia-hoteles/google-ads/">hoteles</a> frente a las plataformas de reservas.' },
          { title: 'Palabras clave según la intención del usuario', html: 'No es lo mismo «cuánto cuesta reformar un baño» que «empresa reforma baño Sabadell». Priorizamos las búsquedas con intención de contratar, controlamos las coincidencias para no abrir la puerta a variaciones sin sentido y reservamos las más informativas para el SEO.' },
          { title: 'Términos negativos para filtrar tráfico', html: 'Mantenemos listas de palabras negativas por campaña y por cuenta: empleo, gratis, cursos, segunda mano, ciudades donde no trabajas o servicios que no ofreces. Las revisamos de forma continua con los términos reales, porque cada semana aparecen búsquedas nuevas.' },
        ]}
      />
      <div class="mt-12">
        <PTree
          root="Cuenta de una empresa de reformas"
          branches={[
            { label: 'Campaña · Reforma de baños', leaves: ['reforma baño completo', 'cambiar bañera por plato'] },
            { label: 'Campaña · Reformas integrales', leaves: ['reforma integral piso', 'reforma vivienda precio'] },
            { label: 'Campaña · Marca', leaves: ['nombre de la empresa'] },
          ]}
          caption="Ejemplo de estructura. Cada servicio tiene su campaña, sus grupos de anuncios y sus palabras clave; la marca va aparte."
        />
      </div>
    </div>
  </PSection>

  <!-- ═══ ECOMMERCE ══════════════════════════════════════════════════════ -->
  <PSection kicker="Shopping y Performance Max" title="Publicidad para vender productos online" tone="soft" layout="split">
    <Fragment slot="intro">
      <p>En una tienda online el anuncio muestra el producto con foto y precio antes del clic. Eso hace que <strong>la calidad del catálogo pese tanto como la campaña</strong>. Trabajamos ambos a la vez y medimos ingresos y margen, no solo pedidos.</p>
      <p>Si tu tienda también vende a través de redes sociales, lo coordinamos con <a href="/agencia-ecommerce/meta-ads/">Meta Ads para ecommerce</a>.</p>
    </Fragment>
    <PStack
      slot="aside"
      layers={[
        { label: 'Ventas con margen', sub: 'ingresos medidos por producto' },
        { label: 'Shopping y Performance Max', sub: 'campañas según objetivo' },
        { label: 'Merchant Center', sub: 'catálogo aprobado y sin errores' },
        { label: 'Datos de producto', sub: 'títulos, precios, stock, imágenes' },
      ]}
      caption="Cada capa depende de la anterior. Un catálogo con errores limita cualquier campaña."
    />
    <PCards
      tone="soft"
      cols={2}
      items={[
        { icon: ICON.doc, title: 'Preparación del catálogo en Merchant Center', html: 'Revisamos el feed de productos: títulos que incluyen lo que la gente busca, categorías correctas, precios y stock sincronizados, imágenes válidas y productos sin rechazos. Google decide en qué búsquedas mostrar cada producto a partir de esos datos, así que un buen catálogo es la mitad del trabajo.' },
        { icon: ICON.cart, title: 'Campañas de Google Shopping', html: 'Organizamos los productos en grupos según categoría, margen o rendimiento para pujar más por los que compensan y menos por los que no. Revisamos las búsquedas que activan cada producto y añadimos negativas, igual que en las campañas de texto. Es la forma más controlada de vender un catálogo en Google.' },
        { icon: ICON.chart, title: 'Performance Max según los objetivos del negocio', html: 'Performance Max reparte la inversión entre búsqueda, Shopping, YouTube y otros espacios de forma automática. Funciona bien cuando tiene buenas señales: conversiones correctas, valor de cada venta y un catálogo limpio. Sin ellas puede gastar en tráfico de poca calidad, así que la usamos cuando los datos lo justifican.' },
        { icon: ICON.money, title: 'Decisiones de inversión por producto y margen', html: 'No todos los productos merecen la misma inversión. Separamos los que dejan más margen, los más vendidos y los que solo consumen presupuesto, y ajustamos el objetivo de retorno de cada grupo. Así la cuenta se alinea con lo que realmente deja dinero a tu tienda.' },
      ]}
    />
  </PSection>

  <!-- ═══ AUDIENCIAS ═════════════════════════════════════════════════════ -->
  <PSection kicker="YouTube, Display y remarketing" title="Llegar a nuevas audiencias y recuperar su atención" layout="split">
    <Fragment slot="intro">
      <p>La búsqueda capta a quien ya te busca. Para llegar antes a quien todavía no conoce tu propuesta, o para recuperar a quien visitó tu web y no contactó, existen otros formatos. <strong>Los activamos solo cuando el presupuesto y el objetivo lo justifican</strong>; para muchas pymes, la búsqueda bien trabajada es suficiente al principio.</p>
      <p>Cuando el objetivo es generar demanda en redes sociales, trabajamos también con Meta Ads, por ejemplo para <a href="/agencia-gimnasios/meta-ads/">gimnasios</a> o <a href="/agencia-restaurantes/meta-ads/">restaurantes</a>.</p>
    </Fragment>
    <PVenn
      slot="aside"
      sets={[
        { label: 'Búsqueda', sub: 'demanda que ya existe' },
        { label: 'Shopping y PMax', sub: 'producto y catálogo' },
        { label: 'YouTube y Display', sub: 'descubrimiento' },
      ]}
      center="Tu cliente"
      caption="Cada formato cubre un momento distinto. Combinamos solo los que encajan con tu objetivo y tu presupuesto."
    />
    <PCards
      cols={2}
      items={[
        { icon: ICON.video, title: 'YouTube para presentar tu propuesta', html: 'Un vídeo corto puede explicar en segundos lo que un anuncio de texto no cuenta: cómo trabajas, cómo es tu producto o qué te diferencia. Lo usamos para segmentos concretos, como personas interesadas en temas relacionados con tu servicio o visitantes de tu web, y medimos si después aumentan las búsquedas de tu marca y los contactos.' },
        { icon: ICON.eye, title: 'Display dentro de una estrategia de cobertura', html: 'Los anuncios gráficos en webs y aplicaciones son baratos por impresión, pero fáciles de desperdiciar. Los activamos con audiencias bien definidas y objetivos de cobertura claros, como reforzar el recuerdo de marca en una zona o en un sector, nunca como sustituto de las campañas que generan contactos.' },
        { icon: ICON.repeat, title: 'Remarketing cuando sea viable y pertinente', html: 'Volver a mostrar anuncios a quien ya visitó tu web funciona bien cuando la decisión de compra tarda días o semanas. Requiere un volumen mínimo de visitas y el consentimiento de cookies bien configurado. Si tu web todavía no tiene ese tráfico, te lo decimos y no lo activamos.' },
        { icon: ICON.shield, title: 'Control de ubicaciones y calidad del tráfico', html: 'Revisamos en qué webs, aplicaciones y canales aparecen tus anuncios y excluimos los que traen clics accidentales o sin interés, como juegos infantiles o páginas de baja calidad. Así el presupuesto de cobertura llega a personas que pueden convertirse en clientes.' },
      ]}
    />
  </PSection>

  <!-- ═══ ANUNCIOS ═══════════════════════════════════════════════════════ -->
  <PSection kicker="Redacción de anuncios" title="Anuncios que conectan con lo que busca tu cliente" tone="dark">
    <Fragment slot="intro">
      <p>En la página de resultados tu anuncio compite con otros tres o cuatro en un par de líneas. Gana el que mejor responde a la búsqueda y da motivos para elegirle. Escribimos los anuncios a partir de las dudas reales de tus clientes, no de frases hechas del sector.</p>
    </Fragment>
    <PCards
      tone="dark"
      cols={2}
      variant="numbered"
      items={[
        { title: 'Mensajes según servicio y necesidad', html: 'Cada grupo de anuncios tiene textos que repiten lo que la persona buscó y responden a lo que le preocupa: urgencia, precio, zona o especialidad. Un anuncio para «abogado de herencias» no puede ser el mismo que para «abogado laboral». Lo vemos a menudo en servicios de salud como <a href="/agencia-psicologos/google-ads/">psicólogos</a> o <a href="/agencia-terapeutas/google-ads/">terapeutas</a>, donde el tono importa tanto como la oferta.' },
        { title: 'Propuestas de valor que se pueden acreditar', html: '«Líderes del sector» o «la mejor calidad» no convencen a nadie. Usamos argumentos que puedes demostrar: años de experiencia, plazo de respuesta, garantía, precio cerrado, valoraciones de clientes. Si un anuncio promete algo, la página de destino tiene que confirmarlo.' },
        { title: 'Recursos de anuncio útiles para decidir', html: 'Enlaces a servicios concretos, textos destacados, extractos de servicios, llamada, ubicación o formulario. Los recursos amplían el anuncio y dan información antes del clic, lo que filtra a quien no encaja. Elegimos solo los que aportan algo a tu cliente y los mantenemos actualizados.' },
        { title: 'Pruebas de mensajes y llamadas a la acción', html: 'Probamos variantes de titulares y llamadas a la acción, como «pide presupuesto» frente a «consulta precios», y dejamos las que consiguen más contactos de calidad, no solo más clics. Cambiamos una cosa cada vez para saber qué ha funcionado y aplicarlo en el resto de la cuenta.' },
      ]}
    />
  </PSection>

  <!-- ═══ LANDING ════════════════════════════════════════════════════════ -->
  <PSection kicker="Página de destino" title="Del clic al contacto: la página de destino" layout="split">
    <Fragment slot="intro">
      <p>El anuncio trae la visita; la página decide si se convierte en contacto. Una mejora en la conversión de la página reduce el coste de cada cliente sin tocar el presupuesto, por eso la revisamos con la misma atención que las campañas.</p>
      <p>Si la web necesita cambios de fondo, lo coordinamos con nuestro servicio de <a href="/diseno-web-para-pymes/">diseño web para pymes</a>. Y si quieres hacer una primera revisión por tu cuenta, empieza por <a href="/blog/como-saber-si-tu-web-esta-bien-hecha/">cómo saber si tu web está bien hecha</a>.</p>
    </Fragment>
    <PFlow
      slot="aside"
      steps={[
        { label: 'Búsqueda', sub: '«dentista urgencias Terrassa»' },
        { label: 'Anuncio', sub: 'urgencias hoy en Terrassa' },
        { label: 'Página', sub: 'urgencias, horario, teléfono' },
        { label: 'Llamada', sub: 'cita el mismo día' },
      ]}
      caption="Ejemplo de coherencia. Cada paso repite y confirma lo que la persona buscaba."
    />
    <PCards
      cols={2}
      items={[
        { icon: ICON.target, title: 'Coherencia entre búsqueda, anuncio y página', html: 'Si alguien busca un servicio concreto y llega a la portada, tiene que buscar de nuevo. La página de destino debe hablar exactamente de lo que prometía el anuncio, con el mismo vocabulario y la misma oferta. Esa coherencia también mejora el nivel de calidad que Google asigna y, con él, el coste del clic.' },
        { icon: ICON.doc, title: 'Formularios y vías de contacto sencillas', html: 'Pedimos solo los datos necesarios para responder, colocamos el teléfono y el botón de contacto a la vista en el móvil y ofrecemos alternativas como WhatsApp cuando tu equipo puede atenderlo. Cada campo de más es una razón para abandonar, sobre todo en móvil.' },
        { icon: ICON.shield, title: 'Pruebas de confianza cerca de la decisión', html: 'Reseñas, casos, años de experiencia, certificaciones, fotos reales del equipo o del trabajo. Las colocamos junto al formulario o al botón de llamada, que es donde aparece la duda. Una persona que no te conoce necesita motivos para darte su teléfono.' },
        { icon: ICON.chart, title: 'Mejoras de conversión basadas en el comportamiento', html: 'Analizamos hasta dónde baja la gente, dónde abandona el formulario y qué diferencia hay entre móvil y ordenador. Con esos datos proponemos cambios concretos y comprobamos su efecto sobre los contactos, en lugar de rediseñar por intuición.' },
      ]}
    />
  </PSection>

  <!-- ═══ MEDICIÓN ═══════════════════════════════════════════════════════ -->
  <PSection kicker="Medición" title="Medición para saber qué campañas aportan negocio" tone="soft">
    <Fragment slot="intro">
      <p>Las pujas automáticas de Google aprenden de lo que les dices que es una conversión. Si les das datos pobres, optimizan hacia contactos pobres. <strong>Medir bien es la condición para que todo lo demás funcione.</strong> Para entender de dónde llega hoy tu tráfico, revisa <a href="/blog/donde-viene-el-trafico/">de dónde viene el tráfico de tu web</a>.</p>
    </Fragment>
    <div class="grid lg:grid-cols-[1.1fr_1fr] gap-10 items-start">
      <PCards
        tone="soft"
        variant="rows"
        class="!mt-12"
        items={[
          { title: 'Configuración de conversiones relevantes', html: 'Definimos qué cuenta como conversión: formulario enviado, llamada de más de cierta duración, compra con su importe, reserva. Lo configuramos con Google Tag Manager y GA4, eliminamos duplicados y comprobamos que cada acción se registra una sola vez y en la campaña correcta.' },
          { title: 'Diferencia entre contactos y oportunidades cualificadas', html: 'No todos los contactos valen lo mismo. Un formulario de alguien fuera de tu zona o que pide algo que no haces cuenta igual en la cuenta si no lo distinguimos. Te pedimos una valoración sencilla de los contactos recibidos para saber qué campañas traen los buenos.' },
          { title: 'Conexión con los resultados comerciales cuando sea posible', html: 'Si usas un CRM o puedes marcar qué contactos se convierten en clientes, importamos esa información a Google Ads. Así las pujas se orientan a ventas reales y no a formularios. Cuando no es posible, buscamos una alternativa manual que dé una referencia fiable.' },
          { title: 'Revisión de atribución y calidad de los datos', html: 'Comparamos lo que dice Google Ads con GA4 y con lo que recibe tu empresa. Las diferencias son normales, pero deben poder explicarse. Revisamos el consentimiento de cookies, los modelos de atribución y las conversiones de marca para no atribuir a la publicidad lo que habría llegado igualmente. Si además quieres saber cómo te mencionan los asistentes de IA, lo trabajamos como <a href="/agencia-geo-para-pymes/">agencia GEO</a>.' },
        ]}
      />
      <div class="mt-12">
        <PFunnel
          stages={[
            { label: 'Clics', sub: 'visitas desde los anuncios', side: 'Lo que mide la plataforma.' },
            { label: 'Contactos', sub: 'formularios y llamadas', side: 'Lo que suele medir una cuenta.' },
            { label: 'Oportunidades', sub: 'contactos que encajan', side: 'Lo que valora tu equipo.' },
            { label: 'Clientes', sub: 'ventas cerradas', side: 'Lo que paga la inversión.' },
          ]}
          caption="Esquema ilustrativo. Cuanto más abajo llega la medición, mejores decisiones toman las campañas."
        />
      </div>
    </div>
  </PSection>

  <!-- ═══ ESCALAR ════════════════════════════════════════════════════════ -->
  <PSection kicker="Optimización" title="Cómo decidimos dónde invertir más" layout="split">
    <Fragment slot="intro">
      <p>Optimizar no es cambiar cosas cada día. Es leer los datos con perspectiva y mover el presupuesto hacia lo que funciona. Cruzamos dos preguntas: <strong>¿esta campaña es rentable?</strong> y <strong>¿tiene recorrido para crecer?</strong></p>
    </Fragment>
    <PMatrix
      slot="aside"
      xLabel="Volumen disponible"
      yLabel="Rentabilidad"
      quadrants={['Mantener y vigilar', 'Ampliar inversión', 'Revisar o pausar', 'Mejorar antes de crecer']}
      points={[
        { label: 'Servicio de nicho', x: 22, y: 80 },
        { label: 'Servicio principal', x: 74, y: 78 },
        { label: 'Búsqueda genérica', x: 76, y: 28 },
        { label: 'Zona secundaria', x: 22, y: 22 },
      ]}
      caption="Ejemplo de cómo clasificamos las campañas de una cuenta según rentabilidad y volumen."
    />
    <PCards
      cols={3}
      variant="numbered"
      items={[
        { title: 'Ajustes de pujas según los resultados', html: 'Elegimos la estrategia de puja según los datos disponibles: más control al principio y objetivos de coste o de retorno cuando hay volumen suficiente. Ajustamos también por dispositivo, horario y zona cuando los datos muestran diferencias claras, no por suposiciones.' },
        { title: 'Redistribución del presupuesto entre campañas', html: 'Cada mes revisamos qué campañas consiguen clientes a un coste aceptable y cuáles no. Movemos presupuesto de las segundas a las primeras antes de pedir más inversión. A menudo hay margen de mejora sin aumentar el gasto total.' },
        { title: 'Condiciones para ampliar la inversión', html: 'Proponemos invertir más solo cuando se cumplen tres condiciones: el coste por cliente está dentro del límite, la campaña se queda sin presupuesto en búsquedas buenas y tu equipo puede atender más contactos. Si falta alguna, primero la resolvemos.' },
      ]}
    />
  </PSection>

  <!-- ═══ ARRANQUE ═══════════════════════════════════════════════════════ -->
  <PSection kicker="Primeras semanas" title="Qué ocurre durante el arranque de tus campañas" tone="soft">
    <Fragment slot="intro">
      <p>Las primeras semanas de una cuenta nueva o reestructurada son de aprendizaje. Los costes pueden moverse más de lo normal y conviene no sacar conclusiones demasiado pronto. Te explicamos en cada momento qué es esperable y qué no.</p>
    </Fragment>
    <div class="grid lg:grid-cols-[1fr_1.1fr] gap-10 items-start">
      <PCards
