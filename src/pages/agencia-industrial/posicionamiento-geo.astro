---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildAlternates } from '../../lib/i18n';
import { localAgencySchema } from '../../lib/schema';
import { strapiClient } from '../../lib/strapi';
import LogoMarquee from '../../components/sections/LogoMarquee.astro';
import FaqHome from '../../components/sections/FaqHome.astro';
import GoogleReviews from '../../components/global/GoogleReviews.astro';
import SectorLinks from '../../components/sections/SectorLinks.astro';
import SiblingServices from '../../components/sections/SiblingServices.astro';
import WhereWeWork from '../../components/sections/WhereWeWork.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://novamarketing.es';
const alternates = buildAlternates('/agencia-industrial/posicionamiento-geo/', '/agencia-industrial/posicionamiento-geo/', SITE_URL);

let allCases: any[] = [];
try {
  const casesRes = await strapiClient.getCaseStudies('es');
  allCases = casesRes.data.map((i: any) => i.attributes ?? i).filter((c: any) => {
    const cats = (c.categories || []).map((cat: any) => (cat.slug || cat.attributes?.slug || '').toLowerCase());
    return cats.some((s: string) => s.includes('industrial') || s.includes('posicionamiento-geo'));
  });
} catch {}

const heroChecks = [
  "Sin permanencias",
  "Trato directo con el consultor",
  "Resultados medidos en leads cualificados"
];

const tiles = [
  {
    "t": "Auditoría de tu visibilidad en IA",
    "d": "Comprobamos qué dicen ChatGPT, Gemini y Claude de tu empresa hoy, y qué dicen de tu competencia."
