const criteria = [
  {
    "title": "Pide casos de GEO Industrial verificables",
    "desc": "Qué preguntas probaron y qué cambió. Si no pueden enseñarte un caso del sector industrial, sigue buscando."
  },
  {
    "title": "Pregunta quién trabajará tu visibilidad en IA",
    "desc": "Exige conocer a la persona que ejecutará la estrategia antes de firmar. En nova hablas siempre con el consultor que la ejecuta."
  },
  {
    "title": "Exige propiedad de tu contenido",
    "desc": "El contenido técnico y las fichas que se crean deben quedarse en tu web, a tu nombre. Lo contrario es una dependencia, no un servicio."
  },
  {
    "title": "Desconfía de quien promete apariciones garantizadas",
    "desc": "Nadie controla el algoritmo de una IA externa. Lo serio es garantizar método, señales trabajadas y seguimiento constante."
  },
  {
    "title": "Revisa qué mide el informe mensual",
    "desc": "Si habla de menciones puntuales pero no de leads cualificados, la agencia mide su actividad y no tu negocio."
