---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/blog/PageHeader.astro';
import SuccessCard from '../../../components/blog/SuccessCard.astro';
import CategoryTabs from '../../../components/blog/CategoryTabs.astro';
import { strapiClient } from '../../../lib/strapi';
import { buildAlternates } from '../../../lib/i18n';
import { TATTOOX_CASE } from '../../../data/casos/tattoox';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://novamarketing.es';
const alternates = buildAlternates('/casos-exito/', '/ca/casos-exit/', SITE_URL);

// Fetch data
let cases = [];
let categoriesWithCases = [];

try {
  const casesRes = await strapiClient.getCaseStudies('ca');
  cases = casesRes.data
    .map(i => i.attributes ?? i)
    .filter(c => c.isPublic);
  
  const categoriesRes = await strapiClient.getCaseStudyCategories('ca');
  const allCategories = categoriesRes.data.map(i => i.attributes ?? i);

  categoriesWithCases = allCategories.filter(cat => !!cat.slug);
} catch (e) {
  console.error("DEBUG: Casos CA index error:", e);
}
// Caso de éxito hardcodeado (Tattoox): no está en Strapi, se añade a mano al
// principio del listado con la misma forma que una entrada del CMS.
cases = [
  {
    slug: TATTOOX_CASE.slug,
    title: TATTOOX_CASE.ca.cardTitle,
    description: TATTOOX_CASE.ca.cardDescription,
    company: 'Tattoox',
    isPublic: true,
    categories: [{ name: 'SEO', slug: TATTOOX_CASE.categorySlug }],
    cover_image: { url: SITE_URL + TATTOOX_CASE.cover, alternativeText: TATTOOX_CASE.ca.cardTitle },
  },
  ...cases,
];
---

<BaseLayout
  title="▷ Casos d'èxit per a pimes: creixement i resultats reals"
  description="Casos d'èxit per a pimes amb resultats reals ⭐ Estratègies de SEO i creixement empresarial que milloren la visibilitat i els leads qualificats."
  locale="ca"
  alternates={alternates}
>
  <PageHeader
    badge="RESULTATS"
    title="Casos d'<span class='text-mktg-gradient'>Èxit</span>"
  />

  <section class="pt-8 pb-16 px-6 sm:px-12 bg-white">
    <div class="max-w-7xl mx-auto">
      
      <CategoryTabs
        categories={categoriesWithCases}
        locale="ca"
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6">
        {cases.map(cs => (
          <div data-item data-cats={((cs.categories as any) ?? []).map((c: any) => c?.attributes?.slug || c?.slug).filter(Boolean).join(' ')}>
            <SuccessCard caseStudy={cs} locale="ca" />
          </div>
        ))}
      </div>

      {cases.length === 0 && (
        <div class="text-center py-40 border-2 border-dashed border-zinc-100 rounded-3xl">
          <p class="text-zinc-400 font-light">Encara no hi ha casos d'èxit en aquesta secció.</p>
        </div>
      )}
    </div>
  </section>

</BaseLayout>
