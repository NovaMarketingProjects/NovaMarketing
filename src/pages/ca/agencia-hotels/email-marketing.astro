    "color": "text-purple-600"
  },
  {
    "t": "Auditoria d'automatitzacions",
    "d": "Revisem si les teves seqüències actuals estan fent la feina o estan abandonades.",
    "bg": "bg-amber-100",
    "color": "text-amber-600"
  },
  {
    "t": "Benchmark del teu sector",
    "d": "Comparem les teves taxes d'obertura i clic amb estàndards del sector hoteler.",
    "bg": "bg-blue-100",
    "color": "text-blue-600"
  }
];
const journey = [
  {
    "t": "Radiografia de la teva llista actual",
    "d": "Analitzem segmentació, salut i automatitzacions existents de la teva base d'hostes."
  },
  {
    "t": "Diagnòstic de reserves sense recuperar",
    "d": "Creuem les dades per explicar quantes reserves abandonades porten mesos sense seguiment."
  },
  {
    "t": "Full de ruta per reactivar",
    "d": "Tanques l'auditoria amb un document d'accions ordenades per impacte i una videotrucada on repassem cada punt."
  }
];
const pricing = [
  {
    "small": "Preu",
    "name": "Auditoria Email Màrqueting per a Hotels",
    "price": "1.200€",
    "meta": [
      "Entrega en 2 a 3 setmanes",
      "Per a qualsevol hotel amb llista d'hostes"
    ],
    "items": [
      "Sessió inicial d'objectius",
