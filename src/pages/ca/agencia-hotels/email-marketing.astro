    ],
    "cta": "Vull auditar la meva llista"
  },
  {
    "small": "Preu",
    "name": "Email Màrqueting per a Hotels",
    "price": "des de 300€ / mes",
    "meta": [
      "Primers enviaments en 2 setmanes",
      "Per a negocis que arrenquen amb un canal"
    ],
    "items": [
      "Auditoria inicial de llista",
      "Recuperació de reserves abandonades",
      "Fidelització post-estada",
      "Newsletter mensual de temporada",
      "Disseny de plantilles de marca",
      "Informe mensual de resultats",
      "Línia directa amb el consultor",
      "Sense permanència"
    ],
    "cta": "Vull activar les meves automatitzacions"
  },
  {
    "small": "Preu",
    "name": "Email Màrqueting Avançat per a Hotels",
    "price": "des de 600€ / mes",
    "meta": [
      "Segmentació avançada activa",
      "Per a hotels amb diverses tipologies d'habitació"
    ],
    "items": [
      "Tot el pla Email Màrqueting",
      "Segmentació per tipus d'hoste",
      "Automatitzacions múltiples avançades",
      "Newsletter quinzenal",
      "Campanyes de reactivació puntuals",
      "Reunió mensual de negoci",
      "Suport prioritari",
      "Objectiu, més reserves recurrents"
    ],
    "cta": "Vull escalar les meves campanyes"
  }
];
const comparison = [
  {
    "c": "Qui serà el teu contacte",
    "o": "Gestor júnior amb 20-30 comptes",
    "n": "Sergio Galo's"
  },
  {
    "c": "Origen de les reserves",
    "o": "Portals OTA amb comissió del 15-20%",
    "n": "Reserves directes pròpies de la teva web"
  },
  {
    "c": "Què es mesura",
    "o": "Clics i impressions",
    "n": "Reserves directes i cost per reserva"
  },
  {
    "c": "Propietat dels teus actius",
    "o": "Web i comptes a nom de l'agència",
    "n": "Tot al teu nom des del dia u"
  },
  {
    "c": "Permanència",
    "o": "6-12 mesos habituals",
    "n": "Mes a mes, sense permanència"
  },
  {
    "c": "Visibilitat a la IA (GEO)",
    "o": "Només canals tradicionals",
    "n": "SEO + GEO integrats amb mètode propi"
  },
  {
    "c": "Transparència de preus",
    "o": "Pressupostos opacs amb extres sorpresa",
    "n": "Preu tancat per escrit abans de començar"
  }
];
const criteria = [
  {
    "title": "Demana casos d'Email Màrqueting Hoteler verificables",
    "desc": "Quina taxa d'obertura va aconseguir i quantes reserves va recuperar. Si no et poden ensenyar un cas del sector hoteler, segueix buscant."
  },
  {
    "title": "Pregunta qui gestionarà les teves automatitzacions",
    "desc": "Exigeix conèixer la persona que dissenyarà les teves seqüències abans de signar. A nova parles sempre amb el consultor que executa la teva estratègia."
  },
  {
    "title": "Exigeix propietat de la teva llista i el teu compte",
    "desc": "La teva base d'hostes i el teu compte d'enviament han d'estar al teu nom des del primer dia. El contrari és una dependència, no un servei."
  },
  {
    "title": "Desconfia de qui compra llistes externes",
    "desc": "Comprar contactes malmet la teva reputació d'enviament i viola el RGPD. El seriós és treballar i fer créixer la teva pròpia llista."
  },
  {
    "title": "Revisa què mesura l'informe mensual",
    "desc": "Si parla d'emails enviats però no de reserves recuperades, l'agència mesura la seva activitat i no el teu negoci."
  },
  {
    "title": "Fuig de les permanències llargues",
    "desc": "Les automatitzacions es poden ajustar en qualsevol moment. A nova treballem mes a mes des del primer dia."
  },
  {
    "title": "Que entengui l'estacionalitat hotelera",
    "desc": "L'email màrqueting d'un hotel no és el mateix en temporada alta que en baixa. Una agència que no entén la teva estacionalitat dissenyarà campanyes que no encaixen amb el teu negoci."
  }
];
const tips = [
  {
    "lead": "Configura un recordatori de reserva abandonada.",
    "text": "Un simple email a les poques hores recupera decisions que es van quedar a mitges."
  },
  {
    "lead": "Segmenta la teva llista per tipus d'hoste.",
    "text": "Un mateix email per a tots els teus contactes redueix molt la rellevància i l'obertura."
  },
  {
    "lead": "Revisa la teva taxa d'obertura cada mes.",
    "text": "Una caiguda sostinguda sol avisar de problemes de lliurabilitat abans que sigui greu."
  },
  {
    "lead": "Demana ressenya just després del check-out.",
    "text": "És el moment de més satisfacció, i la ressenya que més pesa en la propera reserva d'un altre hoste."
  }
];
const faqs = [
  {
    "question": "Què inclou l'Email Màrqueting per a hotels?",
    "answer": "Inclou auditoria inicial, estratègia documentada i execució mensual. Recuperació de reserves abandonades, fidelització post-estada, newsletter de temporada, disseny de plantilles i un informe mensual de resultats."
  },
  {
    "question": "Quant costa l'Email Màrqueting?",
    "answer": "L'auditoria costa 1.200 euros i els plans mensuals van des de 300 euros al mes. Pressupost tancat per escrit i sense permanències."
  },
  {
    "question": "Quant triga a donar resultats?",
    "answer": "Les automatitzacions bàsiques s'activen en dues setmanes, i les primeres reserves recuperades solen veure's en el primer mes."
  },
  {
    "question": "Puc fer servir la meva llista d'hostes actual?",
    "answer": "Sí, sempre que compleixi amb el RGPD. A l'auditoria revisem el seu estat i et diem si necessita alguna neteja prèvia."
  },
  {
    "question": "Com mesureu els resultats?",
    "answer": "En reserves directes recuperades i repetides, no només en obertures o clics. A l'informe mensual veus quina campanya et porta resultats."
  },
  {
    "question": "Treballeu amb permanència?",
    "answer": "No, treballem mes a mes. La nostra permanència real és el resultat que veus en els informes cada mes."
