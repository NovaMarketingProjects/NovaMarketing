];

const pageSchema = localAgencySchema({
  pageUrl: `${SITE_URL}/ca/agencia-hotels/email-marketing/`,
  lang: 'ca',
  cityName: 'Barcelona',
  postalCode: '08035',
  geo: { lat: 41.4114, lng: 2.1526 },
  areaServed: ["España", "Barcelona", "Sabadell", "Sant Cugat del Vallès", "Terrassa", "Vallès Occidental"],
  title: "▷ Email Màrqueting per a Hotels | Resultats mesurables",
  description: "Email Màrqueting per a hotels: automatitzacions de temporada i resultats que es mesuren en reserves recuperades ✅ Més informació",
  datePublished: '2026-08-17',
  dateModified: '2026-08-17',
  streetAddress: 'Carrer del General Mendoza, 10',
  hasMap: 'https://maps.app.goo.gl/9fbB12UcK32bgjj89',
  aggregateRating: { ratingValue: '5.0', reviewCount: '12' },
  breadcrumbName: "Email Màrqueting per a Hotels",
