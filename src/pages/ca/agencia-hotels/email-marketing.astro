---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { buildAlternates } from '../../../lib/i18n';
import { localAgencySchema } from '../../../lib/schema';
import { strapiClient } from '../../../lib/strapi';
import LogoMarquee from '../../../components/sections/LogoMarquee.astro';
import FaqHome from '../../../components/sections/FaqHome.astro';
import GoogleReviews from '../../../components/global/GoogleReviews.astro';
import SectorLinks from '../../../components/sections/SectorLinks.astro';
import SiblingServices from '../../../components/sections/SiblingServices.astro';
import WhereWeWork from '../../../components/sections/WhereWeWork.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://novamarketing.es';
const alternates = buildAlternates('/agencia-hoteles/email-marketing/', '/agencia-hotels/email-marketing/', SITE_URL);

let allCases: any[] = [];
try {
  // Casos de éxito: primero los etiquetados con el sector de esta página
  // (relación `sectors` de Strapi, con las categorías legacy como
  // compatibilidad); si el sector no tiene ninguno, se muestran todos.
  const casesRes = await strapiClient.getCaseStudies('ca');
  const cases = casesRes.data.map((i: any) => i.attributes ?? i);
  const SECTOR_SLUGS = ["hoteles","hotels"];
  const bySector = cases.filter((c: any) => {
    const tags = [...(c.sectors || []), ...(c.categories || [])]
      .map((t: any) => (t.slug || t.attributes?.slug || '').toLowerCase().replace(/[^a-z0-9]/g, ''));
    return tags.some((s: string) => SECTOR_SLUGS.includes(s));
  });
  allCases = bySector.length > 0 ? bySector : cases;
} catch {}

const heroChecks = [
  "Sense permanències",
  "Tracte directe amb el consultor",
  "Resultats mesurats en reserves directes"
];

const tiles = [
  {
    "t": "Auditoria de la teva base d'hostes",
    "d": "Revisem la teva llista, la teva taxa d'obertura i les teves automatitzacions actuals abans de tocar res."
  },
  {
    "t": "Segmentació per tipus d'hoste",
    "d": "Hostes recurrents, reserves abandonades i subscriptors freds reben missatges diferents, no el mateix email per a tothom."
  },
  {
    "t": "Recuperació de reserves abandonades",
    "d": "L'automatisme que recupera qui va començar a reservar al teu motor i no va acabar el procés."
  },
  {
    "t": "Email post-estada i fidelització",
    "d": "Automatitzacions que demanen ressenya, agraeixen l'estada i ofereixen la propera reserva amb avantatge."
  },
  {
    "t": "Newsletter de temporada i ofertes",
    "d": "Contingut d'ofertes i novetats que manté el teu hotel present entre estada i estada."
  },
  {
    "t": "Emails de reactivació de contactes freds",
    "d": "Campanyes per recuperar subscriptors que fa temps que no obren els teus correus."
  },
  {
    "t": "Disseny de plantilles de marca",
    "d": "Emails amb la teva identitat visual que es llegeixen bé en qualsevol dispositiu."
  },
  {
    "t": "Analítica d'obertures i clics",
    "d": "Cada enviament mesurat, per saber quin contingut mou la teva llista i quin no."
  },
  {
    "t": "Compliment RGPD de la teva llista",
    "d": "Gestió de baixes i consentiments conforme a normativa, sense arriscar la teva reputació d'enviament."
  }
];
const timeline = [
  {
    "title": "Auditoria de la teva base d'hostes",
    "desc": "Analitzem la teva llista actual, taxa d'obertura i automatitzacions existents. Detectem on es perden reserves directes per manca de seguiment."
  },
  {
    "title": "Estratègia de Segmentació i Contingut",
    "desc": "Reps un pla per escrit. Quins segments crear, quines automatitzacions activar i quin resultat és raonable esperar."
  },
  {
    "title": "Configuració d'Automatitzacions",
    "desc": "Muntem la recuperació de reserves abandonades i la fidelització post-estada que treballen per tu tot l'any."
  },
  {
    "title": "Producció de Newsletter i Campanyes",
    "desc": "Redactem i dissenyem els enviaments de temporada amb ofertes rellevants per a la teva llista."
  },
  {
    "title": "Mesura de Reserves Recuperades",
    "desc": "Mesurem reserves directes recuperades, no només obertures. A l'informe mensual veus quin email mou la teva llista."
  }
];
const auditChecklist = [
  "Salut i segmentació de la teva base d'hostes",
  "Automatitzacions actives i el seu rendiment",
  "Taxa d'obertura i clics dels teus últims enviaments",
  "Recuperació de reserves abandonades configurada",
  "Compliment RGPD de la teva llista",
  "Pla d'acció prioritzat per impacte en reserves"
];
const auditCards = [
  {
    "t": "Revisió completa de la teva llista",
    "d": "Segmentació, salut i automatitzacions revisades amb dades reals. On es perden reserves.",
    "bg": "bg-purple-100",
    "color": "text-purple-600"
  },
  {
    "t": "Pla d'acció prioritzat",
    "d": "Un pla ordenat per impacte i esforç. Sabràs què arreglar la primera setmana.",
    "bg": "bg-green-100",
    "color": "text-green-600"
  },
  {
    "t": "Enfocament en reserves recuperades",
    "d": "Cada recomanació es tradueix a reserves directes que es completen, no només obertures.",
