---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildAlternates } from '../../lib/i18n';
import { localAgencySchema } from '../../lib/schema';
import { strapiClient } from '../../lib/strapi';
import LogoMarquee from '../../components/sections/LogoMarquee.astro';
import FaqHome from '../../components/sections/FaqHome.astro';
import GoogleReviews from '../../components/global/GoogleReviews.astro';
import SectorLinks from '../../components/sections/SectorLinks.astro';
import WhereWeWork from '../../components/sections/WhereWeWork.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://novamarketing.es';
const alternates = buildAlternates('/agencia-hoteles/', '/agencia-hotels/', SITE_URL);

let allCases: any[] = [];
try {
  // Casos de éxito: primero los etiquetados con la categoría de este sector;
  // si el sector no tiene ninguno, se muestran todos los casos.
  const casesRes = await strapiClient.getCaseStudies('ca');
  const cases = casesRes.data.map((i: any) => i.attributes ?? i);
  const SECTOR_CATEGORY_SLUGS = ["hoteles","hotels"];
  const bySector = cases.filter((c: any) => {
    const cats = (c.categories || []).map((cat: any) => (cat.slug || cat.attributes?.slug || '').toLowerCase().replace(/[^a-z0-9]/g, ''));
    return cats.some((s: string) => SECTOR_CATEGORY_SLUGS.includes(s));
  });
  allCases = bySector.length > 0 ? bySector : cases;
} catch {}

const heroChecks = [
  "Sense permanències",
  "Tracte directe amb el consultor",
  "Resultats mesurats en reserves directes"
];

const services = [
  {
    "href": "/ca/agencia-hotels/seo/",
    "t": "SEO per a Hotels",
    "d": "Contingut de destinació i fitxa de Google optimitzada perquè aparegui quan algú busca allotjament a la teva zona sense passar per una OTA."
  },
  {
    "href": "/ca/agencia-hotels/google-ads/",
    "t": "Google Ads per a Hotels",
    "d": "Campanyes de cerca i Google Hotel Ads que posen el teu hotel davant de qui ja et busca, pagant només per reserves directes reals."
  },
  {
    "href": "/ca/agencia-hotels/meta-ads/",
    "t": "Meta Ads per a Hotels",
    "d": "Campanyes a Instagram i Facebook que mostren les teves habitacions i experiències, i recuperen qui va mirar preus i no va reservar."
  },
  {
    "href": "/ca/agencia-hotels/email-marketing/",
    "t": "Email Màrqueting per a Hotels",
    "d": "Automatitzacions i campanyes que recuperen reserves abandonades i fidelitzen hostes anteriors amb la teva llista de contactes."
  },
  {
    "href": "/ca/agencia-hotels/diseno-web/",
    "t": "Disseny Web per a Hotels",
    "d": "Una web ràpida amb motor de reserves integrat, pensada per convertir la visita en reserva directa sense comissió."
  },
  {
    "href": "/ca/agencia-hotels/posicionamiento-geo/",
    "t": "GEO i Visibilitat en IA per a Hotels",
    "d": "Quan algú pregunta a ChatGPT quin hotel triar a la teva zona, treballem els teus senyals perquè la IA recomani el teu."
  }
];
const steps = [
  {
    "title": "Diagnòstic de Reserves i Canals",
    "desc": "Analitzem la teva web, la teva fitxa de Google i la teva dependència actual de les OTAs. Detectem on es perden les reserves directes que ja et busquen i on hi ha l'oportunitat que la teva competència ja explota."
  },
  {
    "title": "Estratègia per Temporada",
    "desc": "Reps un pla per escrit. Quins canals activar en temporada alta i baixa, quin pressupost necessita cadascun i quin resultat és raonable esperar en 3, 6 i 12 mesos."
  },
  {
    "title": "Execució Multicanal per a Reserva Directa",
    "desc": "SEO local per captar la cerca, Ads per escalar reserves directes, email per no perdre el vincle amb hostes anteriors i una web pensada per convertir la visita. Cada canal amb la seva funció."
  },
  {
    "title": "Mesura de Reserves i Ocupació",
    "desc": "Mesurem reserves directes de veritat, no likes ni impressions. A l'informe mensual veus quant has invertit i quantes reserves ha generat cada canal."
  },
  {
    "title": "Optimització del Cost per Reserva",
    "desc": "Revisem cada setmana campanyes i conversió, tallem el que no rendeix i reinvertim en el que funciona."
  }
];
const auditCards = [
  {
    "bg": "bg-purple-100",
    "color": "text-purple-600",
    "icon": "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z",
    "t": "Anàlisi completa del teu hotel",
    "d": "Velocitat, confiança i facilitat de reserva revisades amb dades reals. On i per què es perden reserves directes."
  },
  {
    "bg": "bg-green-100",
    "color": "text-green-600",
    "icon": "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6",
    "t": "Pla d'acció prioritzat per reserves",
    "d": "No una llista infinita de tasques, sinó un pla ordenat per impacte i esforç. Sabràs què arreglar la primera setmana."
  },
  {
    "bg": "bg-purple-100",
    "color": "text-purple-600",
    "icon": "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    "t": "Enfocament en reserves directes, no en trànsit",
    "d": "Cada recomanació es tradueix a reserves directes. Quin canal escalar i quina campanya tallar perquè genera clics sense generar resultat."
  },
  {
    "bg": "bg-amber-100",
    "color": "text-amber-600",
    "icon": "M9 12h6m-6 4h6M9 8h2m8-3v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2h6l4 4z",
    "t": "Auditoria de les teves campanyes de captació",
    "d": "Revisem els teus comptes de Google i Meta campanya a campanya. Quina part de la teva inversió porta resultats i quina part es perd en clics que mai reserven."
  },
  {
    "bg": "bg-blue-100",
    "color": "text-blue-600",
    "icon": "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm8 0V5a2 2 0 012-2h0a2 2 0 012 2v14a2 2 0 01-2 2h0a2 2 0 01-2-2zm-8 0a2 2 0 002 2h2a2 2 0 002-2V9a2 2 0 00-2-2h-2a2 2 0 00-2 2v10z",
    "t": "Comparativa amb altres hotels de la teva zona",
    "d": "Comparem la teva presència amb els teus tres competidors directes més propers. Quina visibilitat i quins canals treballen que tu encara no."
  }
];
const comparison = [
  {
    "c": "Qui serà el teu contacte",
    "o": "Gestor júnior amb 20-30 comptes",
    "n": "Sergio Galo's"
  },
  {
    "c": "Origen de les reserves",
    "o": "Portals OTA amb comissió del 15-20%",
    "n": "Reserves directes pròpies de la teva web"
  },
  {
    "c": "Què es mesura",
    "o": "Clics i impressions",
    "n": "Reserves directes i cost per reserva"
  },
  {
    "c": "Propietat dels teus actius",
    "o": "Web i comptes a nom de l'agència",
    "n": "Tot al teu nom des del dia u"
  },
  {
    "c": "Permanència",
    "o": "6-12 mesos habituals",
    "n": "Mes a mes, sense permanència"
  },
  {
    "c": "Visibilitat a la IA (GEO)",
    "o": "Només canals tradicionals",
    "n": "SEO + GEO integrats amb mètode propi"
  },
  {
    "c": "Transparència de preus",
    "o": "Pressupostos opacs amb extres sorpresa",
    "n": "Preu tancat per escrit abans de començar"
  }
];
const criteria = [
  {
    "title": "Demana casos verificables del sector hoteler",
    "desc": "Un mur de logos no demostra res. Demana casos amb dades concretes: quantes reserves directes, amb quina inversió i en quant de temps. Si no et poden ensenyar ni un, segueix buscant."
  },
  {
    "title": "Pregunta qui portarà el teu compte",
    "desc": "Exigeix conèixer la persona que treballarà el teu projecte abans de signar. A nova parles sempre amb el consultor que executa la teva estratègia."
  },
  {
    "title": "Exigeix reserves pròpies, no dependència d'OTAs",
    "desc": "Fuig de qui només sap optimitzar la teva fitxa a Booking. La teva inversió ha de generar reserves directes al teu propi motor de reserves."
  },
  {
    "title": "Exigeix propietat dels teus actius",
    "desc": "La teva web, el teu domini i els teus comptes publicitaris han d'estar al teu nom. El contrari és una dependència, no un servei."
  },
  {
    "title": "Revisa què mesura l'informe mensual",
    "desc": "L'informe ha de parlar de reserves directes, no només de clics. Tota la resta és decoració."
  },
  {
    "title": "Fuig de les permanències llargues",
    "desc": "Una permanència de 12 mesos protegeix l'agència, no tu. Per això a nova treballem mes a mes."
  },
  {
    "title": "Que sàpiga vendre l'experiència, no només l'habitació",
    "desc": "A l'hostaleria es ven amb fotos, vídeo i experiències reals. Una agència que no sap convertir el teu hotel en contingut està malbaratant el teu millor argument de venda."
  }
];
const faqs = [
  {
    "question": "Quant costa una agència de màrqueting per a hotels?",
    "answer": "Depèn dels canals que activis. Els plans mensuals parteixen de 400 euros al mes per a hotels que arrenquen amb un o dos canals. Abans de començar reps un pressupost tancat per escrit."
  },
  {
    "question": "Què inclou el servei de màrqueting per a hotels?",
    "answer": "Inclou un diagnòstic inicial, una estratègia documentada i l'execució mensual de cada canal activat. SEO local, Google Ads, Meta Ads, email màrqueting, disseny web i visibilitat a la IA."
  },
  {
    "question": "Qui portarà el meu compte?",
    "answer": "Sempre la mateixa persona, el consultor fundador. Res de gestors júnior que canvien cada trimestre."
  },
  {
    "question": "Reduireu la meva dependència de les OTAs?",
    "answer": "Aquest és l'objectiu. Treballem la teva web, la teva fitxa i les teves campanyes perquè la reserva es faci directe amb tu, sense pagar comissió a un intermediari."
  },
  {
    "question": "Quant trigaré a veure resultats?",
    "answer": "Les campanyes de pagament poden generar reserves directes la primera setmana, i el SEO local consolida resultats entre el tercer i el sisè mes."
  },
  {
    "question": "Treballeu amb permanència?",
    "answer": "No, treballem mes a mes. La nostra permanència real és el resultat que veus en les teves reserves cada mes."
  }
];

const pageSchema = localAgencySchema({
  pageUrl: `${SITE_URL}/ca/agencia-hotels/`,
  lang: 'ca',
  cityName: 'Barcelona',
  postalCode: '08035',
  geo: { lat: 41.4114, lng: 2.1526 },
  areaServed: ["España", "Barcelona", "Sabadell", "Sant Cugat del Vallès", "Terrassa", "Vallès Occidental"],
  title: "▷ Màrqueting per a hotels | Estratègies i resultats mesurables",
  description: "Especialistes en màrqueting per a hotels amb serveis en SEO, Google Ads, Meta Ads i disseny web ✅ estratègies que generen reserves directes",
  datePublished: '2026-08-17',
  dateModified: '2026-08-17',
  streetAddress: 'Carrer del General Mendoza, 10',
  hasMap: 'https://maps.app.goo.gl/9fbB12UcK32bgjj89',
  aggregateRating: { ratingValue: '5.0', reviewCount: '12' },
  breadcrumbName: "Agència per a Hotels",
  faqs,
});
---

<BaseLayout title="▷ Màrqueting per a hotels | Estratègies i resultats mesurables" description="Especialistes en màrqueting per a hotels amb serveis en SEO, Google Ads, Meta Ads i disseny web ✅ estratègies que generen reserves directes" locale="ca" alternates={alternates} schemas={[pageSchema]}>

    <!-- ═══ HERO / H1 ═══════════════════════════════════════════════════════ -->
    <section class="pt-24 sm:pt-40 pb-20 px-4 sm:px-6 relative overflow-hidden text-center bg-white border-b border-black/5">
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_40%,#000_75%,transparent_100%)]"></div>
        <div class="absolute -top-10 left-1/4 w-72 h-72 bg-accent/15 rounded-full blur-3xl opacity-30 animate-pulse"></div>
        <div class="absolute top-20 right-1/4 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl opacity-20"></div>
        <div class="max-w-5xl mx-auto reveal">
            <span class="inline-flex items-center gap-2 bg-accent/5 backdrop-blur-sm px-4 py-2 border border-accent/10 rounded-full text-accent text-[8px] sm:text-[10px] font-black uppercase tracking-[0.3em] mb-8 shadow-sm">
                <span class="w-1.5 h-1.5 bg-accent rounded-full animate-ping"></span>
                Màrqueting Digital per a Hotels
            </span>
            <h1 class="text-3xl sm:text-5xl md:text-7xl lg:text-8xl uppercase font-extrabold tracking-tighter leading-[0.88] mb-8 text-gradient flex flex-col items-center text-center">
                <span class="lg:whitespace-nowrap">Agència de màrqueting digital </span>
                <span class="lg:whitespace-nowrap text-mktg-gradient">per a Hotels</span>
            </h1>
            <p class="text-lg sm:text-xl text-zinc-500 font-light leading-relaxed w-[75%] mx-auto mb-8">
                El teu hotel pot rebre reserves directes cada mes, no només a través d'OTAs amb comissió. Màrqueting digital per a hotels amb campanyes de temporada i resultats que es mesuren en reserves directes, no en visites.
            </p>
            <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 mb-10">
                {heroChecks.map(item => (
                    <span class="inline-flex items-center gap-2 text-[11px] sm:text-xs font-black uppercase tracking-widest text-zinc-700">
                        <svg class="w-4 h-4 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                        {item}
                    </span>
                ))}
            </div>
            <div class="flex justify-center mt-4">
                <a href="#contacto" class="contact-modal-trigger btn-mktg-v5 shadow-[0_10px_30px_rgba(0,0,0,0.1)] !py-4 sm:!py-5 !px-6 sm:!px-10 !text-[11px] !tracking-widest font-black">
                    PARLEM DEL TEU HOTEL
                </a>
            </div>
        </div>
    </section>

    <LogoMarquee />

    <!-- ═══ INTRO ═══════════════════════════════════════════════════════ -->
    <section class="py-16 sm:py-24 bg-white px-4 sm:px-6 border-b border-black/5">
        <div class="max-w-6xl mx-auto reveal grid md:grid-cols-[1.3fr_1fr] gap-10 md:gap-16 items-center">
            <div>
                <p class="text-[10px] sm:text-xs font-black uppercase tracking-[0.3em] text-accent mb-4">Per què una agència per a hotels?</p>
                <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tighter uppercase mb-8 text-zinc-900 leading-[0.9]">
                    L'agència de màrqueting digital per al teu hotel
                </h2>
                <div class="space-y-6 text-zinc-600 font-light text-base sm:text-lg leading-relaxed">
                    <p>
                        Qui busca allotjament compara preus a Booking, Expedia i la teva pròpia web abans de reservar. Si la teva fitxa de Google no està optimitzada o la teva web no convida a reservar directe, la comissió del 15-20% se la queda l'OTA en lloc de quedar-se al teu compte.
                    </p>
                    <p set:html={`Nova és una <strong class="font-semibold text-zinc-900">agència de màrqueting especialitzada en hotels i allotjaments</strong>. Treballem reserves de temporada alta i baixa amb la mateixa estratègia, orientada a una sola mètrica que importa. <strong class="font-semibold text-zinc-900">Quantes reserves directes genera el teu hotel cada mes</strong>.`} />
                </div>
            </div>
            <div class="hidden md:block">
                <img src="/sergio-galos-agencia-hoteles.webp" alt="Sergio Galo's, consultor de màrqueting per a hotels" title="Sergio Galo's, consultor de màrqueting per a hotels" class="w-full h-auto" loading="lazy" width="473" height="591" />
            </div>
        </div>
    </section>

    <!-- ═══ SERVICIOS ══════════════════════════════════════════════════ -->
    <section class="py-20 sm:py-32 bg-zinc-50 border-b border-black/5 px-4 sm:px-6">
        <div class="max-w-7xl mx-auto text-center reveal">
            <span class="text-[10px] sm:text-xs font-black uppercase tracking-[0.3em] text-accent mb-4 block">Què fem</span>
            <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tighter uppercase mb-6 text-zinc-900 leading-[0.9]">
                Serveis de Màrqueting Online per a Hotels
            </h2>
            <div class="text-zinc-500 font-light text-sm sm:text-base leading-relaxed max-w-3xl mx-auto mb-16 space-y-4">
                <p>
                    El teu hotel que creix no depèn d'un sol canal, depèn d'un <strong class='font-semibold text-zinc-700'>sistema on cada canal fa la seva feina</strong>. Aquestes són les sis peces que combinem segons el que necessiti el teu hotel.
                </p>
                <p>
                    No pagues per un paquet tancat d'accions, pagues per les que el teu negoci necessita.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 text-left">
                {services.map(s => (
                    <div class="service-card p-8 bg-white rounded-2xl border border-zinc-100/80 shadow-sm hover:shadow-2xl hover:-translate-y-2 hover:border-accent/10 transition-all duration-500 relative overflow-hidden flex flex-col justify-between">
                        <h3 class="text-xl font-black uppercase tracking-tighter mb-4 text-zinc-900">
                            <a href={s.href} class="hover:text-accent transition-colors">{s.t}</a>
                        </h3>
                        <p class="text-sm text-zinc-500 font-light leading-relaxed mb-4">{s.d}</p>
                        <a href={s.href} class="text-[11px] font-black tracking-widest text-accent hover:underline">SABER-NE MÉS →</a>
                    </div>
                ))}
            </div>
            <div class="mt-12 text-center reveal">
                <a href="#contacto" class="contact-modal-trigger btn-mktg-v5 shadow-[0_10px_30px_rgba(37,211,102,0.3)] !py-4 sm:!py-5 !px-6 sm:!px-10 !text-[11px] !tracking-widest font-black">
                    PARLEM DEL TEU HOTEL
                </a>
            </div>
        </div>
    </section>

    <!-- ═══ ESTRATEGIA ════════════════════════════════════════ -->
    <section class="py-20 sm:py-32 bg-white px-4 sm:px-6 relative overflow-hidden">
        <div class="max-w-5xl mx-auto">
            <div class="text-center mb-16 sm:mb-24 reveal">
                <span class="text-[10px] sm:text-xs font-black uppercase tracking-[0.3em] text-accent mb-4 block">Com treballem</span>
                <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tighter uppercase mb-6 text-zinc-900 leading-[0.9]">
                    Estratègies de màrqueting digital per a hotels
                </h2>
                <p class="text-zinc-500 font-light text-sm sm:text-base leading-relaxed max-w-2xl mx-auto">
                    Una metodologia documentada perquè el teu negoci creixi cada mes, pas a pas i sense fum.
                </p>
            </div>
            <div id="timeline-container" class="relative">
                <div class="hidden md:block absolute left-1/2 top-4 bottom-4 w-px bg-zinc-200 -translate-x-1/2"></div>
                <div id="progress-bar" class="hidden md:block absolute left-1/2 top-4 w-px bg-accent -translate-x-1/2 transition-all duration-100"></div>
                <div class="space-y-16 md:space-y-24 flex flex-col items-center">
                    {steps.map((step, index) => (
                        <div class="flex flex-col md:flex-row items-center gap-6 md:gap-12 w-full relative reveal">
                            <div class:list={["flex-1 w-full", index % 2 === 0 ? "md:order-1 md:text-right" : "md:order-3 md:text-left"]}>
                                <div class="p-8 sm:p-10 bg-zinc-50 border border-black/5 rounded-3xl hover:border-accent/10 hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 relative overflow-hidden group">
                                    <h3 class="text-xl font-black uppercase tracking-tighter mb-2 text-zinc-900">{index + 1}. {step.title}</h3>
                                    <div class:list={["h-0.5 bg-accent w-full mb-4 opacity-80", index % 2 === 0 ? "md:ml-auto" : ""]}></div>
                                    <p class:list={["text-sm text-zinc-500 font-light max-w-md", index % 2 === 0 ? "md:ml-auto" : ""]}>{step.desc}</p>
                                    <div class="absolute -bottom-6 -right-5 text-8xl font-black text-black/[0.02] select-none z-0 group-hover:scale-105 transition-transform duration-500">0{index+1}</div>
                                </div>
                            </div>
                            <div class="md:order-2 w-12 h-12 rounded-full border-2 border-zinc-200 bg-white flex items-center justify-center font-black text-lg z-10 shrink-0 shadow-sm node-circle transition-all">0{index + 1}</div>
                            <div class:list={["hidden md:block md:flex-1", index % 2 === 0 ? "md:order-3" : "md:order-1"]}></div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <!-- ═══ AUDITORÍA ═════════════════════════════════════════ -->
    <section class="py-20 sm:py-32 bg-zinc-50/50 px-4 sm:px-6 border-t border-black/5 overflow-hidden">
        <div class="max-w-7xl mx-auto grid lg:grid-cols-[6fr_4fr] gap-12 lg:gap-16 items-start">
            <div class="reveal lg:col-span-2">
                <span class="text-[10px] sm:text-xs font-black uppercase tracking-[0.3em] text-accent mb-4 block">Punt de partida</span>
                <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tighter uppercase text-zinc-900 leading-[0.9]">
                    Auditoria de màrqueting digital per al teu hotel
                </h2>
            </div>
            <div class="reveal">
