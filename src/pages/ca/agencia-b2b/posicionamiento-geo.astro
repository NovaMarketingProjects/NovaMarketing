];
const timeline = [
  {
    "title": "Auditoria de la teva visibilitat en IA",
    "desc": "Comprovem què recomanen avui ChatGPT, Gemini i Claude al teu sector, i si la teva empresa apareix o no."
  },
  {
    "title": "Estratègia de Senyals i Contingut",
