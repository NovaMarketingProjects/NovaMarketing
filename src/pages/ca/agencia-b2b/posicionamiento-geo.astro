];
const auditChecklist = [
  "Què diuen ChatGPT, Gemini i Claude de la teva empresa",
  "Comparativa amb el que diuen de la teva competència",
  "Contingut d'autoritat citable a la teva web actual",
  "Dades estructurades implementades avui",
  "Presència en directoris de referència del sector",
  "Pla d'acció prioritzat per impacte en reunions"
];
const auditCards = [
  {
    "t": "Anàlisi completa de la teva visibilitat en IA",
    "d": "Provem preguntes reals en diverses IA i documentem què recomanen avui.",
    "bg": "bg-purple-100",
    "color": "text-purple-600"
  },
  {
