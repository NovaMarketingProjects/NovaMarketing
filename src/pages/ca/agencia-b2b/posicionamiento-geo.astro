const pageSchema = localAgencySchema({
  pageUrl: `${SITE_URL}/ca/agencia-b2b/posicionamiento-geo/`,
  lang: 'ca',
  cityName: 'Barcelona',
  postalCode: '08035',
  geo: { lat: 41.4114, lng: 2.1526 },
  areaServed: ["España", "Barcelona", "Sabadell", "Sant Cugat del Vallès", "Terrassa", "Vallès Occidental"],
  title: "▷ GEO B2B | Visibilitat en IA",
  description: "GEO per a empreses B2B: visibilitat a ChatGPT, Gemini i Claude amb resultats que es mesuren en reunions comercials ✅ Més informació",
  datePublished: '2026-08-17',
  dateModified: '2026-08-17',
