    ],
    "items": [
      "Auditoria GEO inicial",
      "Contingut d'autoritat citable mensual",
      "Dades estructurades bàsiques",
      "Presència en 2 directoris de referència",
      "Informe mensual de mencions en IA",
      "Línia directa amb el consultor",
