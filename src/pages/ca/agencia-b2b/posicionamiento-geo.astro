    ],
    "cta": "Vull treballar la meva visibilitat en IA"
  },
  {
    "small": "Preu",
    "name": "GEO Avançat B2B",
    "price": "des de 700€ / mes",
    "meta": [
      "Estratègia GEO i SEO conjunta",
      "Per a diversos segments de client o mercats"
    ],
    "items": [
      "Tot el pla GEO",
      "Estratègia GEO i SEO integrada",
      "Casos d'èxit publicats periòdicament",
      "Presència ampliada en directoris",
      "Cobertura de diversos mercats",
      "Reunió mensual de negoci",
      "Suport prioritari",
      "Objectiu, ser l'opció recomanada"
    ],
    "cta": "Vull escalar la meva visibilitat"
  }
];
const comparison = [
  {
    "c": "Qui serà el teu contacte",
    "o": "Gestor júnior amb 20-30 comptes",
    "n": "Sergio Galo's"
  },
  {
    "c": "Origen de les reunions",
    "o": "Leads genèrics sense qualificar",
    "n": "Reunions comercials qualificades pròpies"
  },
  {
    "c": "Què es mesura",
    "o": "Clics i impressions",
    "n": "Reunions comercials i cost per reunió"
  },
  {
    "c": "Propietat dels teus actius",
    "o": "Web i comptes a nom de l'agència",
    "n": "Tot al teu nom des del dia u"
  },
  {
    "c": "Permanència",
    "o": "6-12 mesos habituals",
    "n": "Mes a mes, sense permanència"
  },
  {
    "c": "Visibilitat a la IA (GEO)",
    "o": "Només canals tradicionals",
    "n": "SEO + GEO integrats amb mètode propi"
  },
  {
    "c": "Transparència de preus",
    "o": "Pressupostos opacs amb extres sorpresa",
    "n": "Preu tancat per escrit abans de començar"
  }
];
const criteria = [
  {
    "title": "Demana casos de GEO B2B verificables",
    "desc": "Quines preguntes van provar i què va canviar. Si no et poden ensenyar un cas del sector B2B, segueix buscant."
  },
  {
    "title": "Pregunta qui treballarà la teva visibilitat en IA",
    "desc": "Exigeix conèixer la persona que executarà l'estratègia abans de signar. A nova parles sempre amb el consultor que l'executa."
  },
  {
    "title": "Exigeix propietat del teu contingut",
    "desc": "El contingut i els casos d'èxit que es creen s'han de quedar a la teva web, al teu nom. El contrari és una dependència, no un servei."
  },
  {
    "title": "Desconfia de qui promet aparicions garantides",
    "desc": "Ningú controla l'algoritme d'una IA externa. El seriós és garantir mètode, senyals treballats i seguiment constant."
  },
  {
    "title": "Revisa què mesura l'informe mensual",
    "desc": "Si parla de mencions puntuals però no de reunions comercials, l'agència mesura la seva activitat i no el teu negoci."
  },
  {
    "title": "Fuig de les permanències llargues en GEO",
    "desc": "És una disciplina nova i en evolució constant. A nova treballem mes a mes des del primer dia."
  },
  {
    "title": "Que integri també el SEO tradicional",
    "desc": "El GEO funciona millor combinat amb SEO. Una agència que separa ambdues disciplines duplica esforç i redueix resultat."
  }
];
const tips = [
  {
    "lead": "Pregunta tu mateix a ChatGPT sobre el teu sector.",
    "text": "Comprova si la teva empresa apareix quan preguntes quin proveïdor triar. És el diagnòstic més ràpid que existeix."
  },
  {
    "lead": "Publica casos d'èxit amb dades concretes.",
    "text": "Les IA prioritzen contingut amb xifres i resultats verificables sobre les descripcions genèriques."
  },
  {
    "lead": "Redacta FAQs amb preguntes reals de decisors.",
    "text": "Com més s'assembli al que algú preguntaria a una IA, més fàcil és que et citin."
  },
