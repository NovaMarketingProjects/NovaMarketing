    "d": "Creuem les dades per explicar què et falta davant la competència que sí recomanen les IA."
  },
  {
    "t": "Full de ruta per ser recomanat",
    "d": "Tanques l'auditoria amb un document d'accions ordenades per impacte i una videotrucada on repassem cada punt."
  }
];
const pricing = [
  {
    "small": "Preu",
    "name": "Auditoria GEO B2B",
    "price": "1.200€",
    "meta": [
      "Entrega en 2 a 3 setmanes",
      "Per a qualsevol empresa que vulgui saber què diu la IA d'ella"
    ],
    "items": [
      "Sessió inicial d'objectius",
