    <section id="contacto" class="py-20 sm:py-40 px-4 sm:px-6 relative bg-accent">
        <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-12 sm:gap-20 items-center">
            <div class="reveal text-white">
                <span class="text-[10px] font-black uppercase tracking-[0.5em] mb-6 block opacity-70">CREIXEMENT GARANTIT</span>
                <h2 class="text-5xl sm:text-7xl font-black uppercase tracking-tighter leading-[0.8] mb-8">
                   MÉS ALTES <br>CADA MES
                </h2>
                <p class="font-light max-w-md text-base sm:text-xl">Consulta’m i et diré per què el teu gimnàs no capta més altes online, i com solucionar-ho.</p>
            </div>

            <div class="reveal">
                <div class="bg-white p-8 sm:p-16 shadow-[0_40px_100px_rgba(0,0,0,0.1)] rounded-sm">
                    <form class="space-y-8" id="contact-form">
                        <div class="grid sm:grid-cols-2 gap-6 text-[10px] font-black tracking-widest uppercase">
                            <div class="flex flex-col gap-3">
                                <label class="opacity-30">NOM</label>
                                <input type="text" name="name" aria-label="Nom" required class="border-b border-black/10 py-2 focus:border-accent outline-none">
                            </div>
                            <div class="flex flex-col gap-3">
                                <label class="opacity-30">TELÈFON</label>
                                <input type="tel" name="phone" aria-label="Telèfon" class="border-b border-black/10 py-2 focus:border-accent outline-none">
                            </div>
                        </div>
                        <div class="flex flex-col gap-3 text-[10px] font-black tracking-widest uppercase">
                            <label class="opacity-30">EMAIL PROFESIONAL</label>
                            <input type="email" name="email" aria-label="Correu electrònic" required class="border-b border-black/10 py-2 focus:border-accent outline-none">
                        </div>
                        <div class="flex flex-col gap-3 text-[10px] font-black tracking-widest uppercase">
                            <label class="opacity-30">CONSULTA</label>
                            <textarea name="msg" aria-label="Missatge" rows="3" class="border-b border-black/10 py-2 focus:border-accent outline-none resize-none" placeholder="Què necessita el teu gimnàs?"></textarea>
                        </div>
                        <button type="submit" class="w-full btn-mktg-v5 !py-6">VULL MÉS ALTES</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

</BaseLayout>

<script>
    document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target;
        const btn = form.querySelector('button');
        if (btn) { btn.innerHTML = 'ENVIANT...'; btn.disabled = true; }
        const data = Object.fromEntries(new FormData(form));
        try {
            const res = await fetch('https://cms.novamarketing.es/api/contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data),
            });
            if (res.ok) {
                window.location.href = '/ca/gracies/';
            } else { throw new Error(); }
        } catch {
            if (btn) { btn.innerHTML = 'ERROR — TORNA-HO A PROVAR'; btn.disabled = false; btn.style.background = '#ef4444'; }
        }
    });
function initTimeline() {
        const progressBar = document.getElementById('progress-bar');
        const timeline = document.getElementById('timeline-container');
        if (!progressBar || !timeline) return;

        function updateProgress() {
            const rect = timeline.getBoundingClientRect();
            const winHeight = window.innerHeight;
            const nodes = timeline.querySelectorAll('.node-circle');
            const nodeTops = Array.from(nodes, (node) => node.getBoundingClientRect().top);
            const topPassed = (winHeight / 2) - rect.top;
            let percentage = (topPassed / rect.height) * 100;
            percentage = Math.max(0, Math.min(100, percentage));
            progressBar.style.height = `${percentage}%`;
            nodes.forEach((node, i) => {
                if (nodeTops[i] < winHeight / 2) {
                    node.classList.add('!border-accent', '!bg-accent', '!text-white');
                } else {
                    node.classList.remove('!border-accent', '!bg-accent', '!text-white');
                }
            });
        }

        let progressTick = false;
        function onProgressScroll() {
            if (progressTick) return;
            progressTick = true;
            requestAnimationFrame(() => { updateProgress(); progressTick = false; });
        }
        window.addEventListener('scroll', onProgressScroll, { passive: true });
        document.addEventListener('astro:page-load', updateProgress);
        updateProgress();
    }
    document.addEventListener('DOMContentLoaded', initTimeline);
    document.addEventListener('astro:page-load', initTimeline);
</script>
