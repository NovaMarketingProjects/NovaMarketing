  // Casos de éxito: primero los etiquetados con el sector de esta página
  // (relación `sectors` de Strapi, con las categorías legacy como
  // compatibilidad); si el sector no tiene ninguno, se muestran todos.
  const casesRes = await strapiClient.getCaseStudies('ca');
  const cases = casesRes.data.map((i: any) => i.attributes ?? i);
  const SECTOR_SLUGS = ["gimnasios","gimnasos"];
  const bySector = cases.filter((c: any) => {
    const tags = [...(c.sectors || []), ...(c.categories || [])]
      .map((t: any) => (t.slug || t.attributes?.slug || '').toLowerCase().replace(/[^a-z0-9]/g, ''));
    return tags.some((s: string) => SECTOR_SLUGS.includes(s));
  });
  allCases = bySector.length > 0 ? bySector : cases;
} catch {}

