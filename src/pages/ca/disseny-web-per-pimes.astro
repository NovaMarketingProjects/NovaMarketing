---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildAlternates } from '../../lib/i18n';
import { localAgencySchema } from '../../lib/schema';
import LogoMarquee from '../../components/sections/LogoMarquee.astro';
import FaqHome from '../../components/sections/FaqHome.astro';
import CityPills from '../../components/global/CityPills.astro';
import MoreCases from '../../components/casos/MoreCases.astro';
import PageBlocks from '../../components/blocks/PageBlocks.astro';
import PSection from '../../components/pillar/PSection.astro';
import PCards from '../../components/pillar/PCards.astro';
import PFlow from '../../components/pillar/PFlow.astro';
import PMatrix from '../../components/pillar/PMatrix.astro';
import PStack from '../../components/pillar/PStack.astro';
import PFunnel from '../../components/pillar/PFunnel.astro';
import PTree from '../../components/pillar/PTree.astro';
import PRings from '../../components/pillar/PRings.astro';
import PCounter from '../../components/pillar/PCounter.astro';
import WebGantt from '../../components/pillar/WebGantt.astro';
import WebVersus from '../../components/pillar/WebVersus.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://novamarketing.es';
const alternates = buildAlternates('/diseno-web-para-pymes/', '/ca/disseny-web-per-pimes/', SITE_URL);

const ICON = {
  building: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  bolt: 'M13 10V3L4 14h7v7l9-11h-7z',
  bag: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z',
  refresh: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
  chart: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm8 0V5a2 2 0 012-2h0a2 2 0 012 2v14a2 2 0 01-2 2h0a2 2 0 01-2-2zm-8 0a2 2 0 002 2h2a2 2 0 002-2V9a2 2 0 00-2-2h-2a2 2 0 00-2 2v10z',
  doc: 'M9 12h6m-6 4h6M9 8h2m8-3v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2h6l4 4z',
  compass: 'M12 3a9 9 0 100 18 9 9 0 000-18zm3.5 5.5l-2 5-5 2 2-5 5-2z',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  palette: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
  layers: 'M4 6h16M4 12h16M4 18h7',
  device: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
  access: 'M12 4a2 2 0 100 4 2 2 0 000-4zM5 9l7 1 7-1M12 10v4m0 0l-3 6m3-6l3 6',
  wp: 'M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z',
  plug: 'M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5m7.328-1.672a4 4 0 000-5.656 4 4 0 00-5.656 0l-1.5 1.5',
  pencil: 'M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z',
  users: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
};

const faqs = [
  { question: 'Quant de temps es trigarà a crear la meva web?', answer: "Una landing page sol estar llesta en una o dues setmanes, una web corporativa en tres a cinc setmanes i una botiga online en sis a vuit. El termini compta des que tenim els textos, les fotos i els accessos necessaris, i depèn sobretot de la rapidesa amb què es revisin les propostes. Abans de començar reps un calendari amb les dates de cada lliurament i de cada revisió." },
  { question: "Qui serà propietari del domini, la web i l'allotjament?", answer: "Tu. El domini es registra a nom de la teva empresa, l'allotjament es contracta al teu nom o se't transfereix en acabar, i la web, els textos i les imatges que hàgim creat per al projecte són teus. En el lliurament et donem tots els accessos d'administrador. Si algun dia canvies de proveïdor, t'emportes la web sencera sense demanar permís a ningú." },
  { question: 'Podré modificar els continguts?', answer: "Sí. Preparem un panell d'edició perquè el teu equip pugui canviar textos, imatges, preus, entrades del blog o productes sense tocar codi, i et formem per fer-ho. Els canvis que afecten l'estructura o el disseny, com crear un tipus de pàgina nou, val més fer-los amb nosaltres per no espatllar res." },
  { question: 'Com protegiu el posicionament durant un redisseny?', answer: "Abans de tocar res exportem les pàgines que reben visites i enllaços, i decidim què es conserva, què es fusiona i què s'elimina. Cada URL antiga que canvia té la seva redirecció a la nova. Després de publicar revisem Search Console i les posicions de les pàgines importants durant les setmanes següents per corregir a temps qualsevol caiguda." },
  { question: 'Què passa si necessito ampliar el projecte?', answer: "La web es construeix per créixer. Pots afegir pàgines, serveis, idiomes, una botiga o integracions més endavant. Cada ampliació es pressuposta per separat i per escrit abans de fer-la, i si tens el manteniment contractat, els canvis petits ja hi entren. Així no pagues avui per funcions que potser no necessitaràs." },
];

const pageSchema = localAgencySchema({
  pageUrl: `${SITE_URL}/ca/disseny-web-per-pimes/`,
  lang: 'ca',
  cityName: 'Barcelona',
  postalCode: '08035',
  geo: { lat: 41.4114, lng: 2.1526 },
  areaServed: ["España", "Barcelona", "Sabadell", "Sant Cugat del Vallès", "Terrassa", "Vallès Occidental"],
  title: "▷ Disseny Web per a Pimes | Webs Corporatives i Botigues Optimitzades",
  description: "Disseny web per a pimes: webs i botigues online ràpides, optimitzades per a Google ✅ i enfocades a convertir visites en clients💡",
  datePublished: '2026-07-16',
  dateModified: '2026-10-25',
  streetAddress: 'Carrer del General Mendoza, 10',
  hasMap: 'https://maps.app.goo.gl/9fbB12UcK32bgjj89',
  aggregateRating: { ratingValue: '5.0', reviewCount: '12' },
  breadcrumbName: 'Disseny Web per a pimes',
  mainService: {
    name: 'Disseny de pàgines web per a pimes',
    serviceType: 'Disseny web',
    description: 'Webs corporatives, landing pages i botigues en línia per a pimes, amb SEO des de la planificació, propietat del client i sense permanència.',
    offers: [
      { name: 'Landing page', price: 400, from: true },
      { name: 'Web a mida', price: 120, from: true, monthly: true, description: 'En 12 quotes.' },
      { name: 'Botiga en línia', price: 130, from: true, monthly: true, description: 'En 12 quotes.' },
    ],
  },
  faqs,
});
---

<BaseLayout
  title="▷ Disseny Web per a Pimes | Webs Corporatives i Botigues Optimitzades"
  description="Disseny web per a pimes: webs i botigues online ràpides, optimitzades per a Google ✅ i enfocades a convertir visites en clients💡"
  locale="ca"
  alternates={alternates}
  schemas={[pageSchema]}
>

  <!-- ═══ HERO / H1 ═══════════════════════════════════════════════════════ -->
  <section class="pt-24 sm:pt-40 pb-20 px-4 sm:px-6 relative overflow-hidden text-center bg-white border-b border-black/5">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_40%,#000_75%,transparent_100%)]"></div>
    <div class="absolute -top-10 left-1/4 w-72 h-72 bg-accent/15 rounded-full blur-3xl opacity-30 animate-pulse"></div>
    <div class="absolute top-20 right-1/4 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl opacity-20"></div>

    <div class="max-w-5xl mx-auto reveal relative">
      <span class="inline-flex items-center gap-2 bg-accent/5 backdrop-blur-sm px-4 py-2 border border-accent/10 rounded-full text-accent text-[8px] sm:text-[10px] font-black uppercase tracking-[0.3em] mb-8 shadow-sm">
        <span class="w-1.5 h-1.5 bg-accent rounded-full animate-ping"></span>
        Disseny web per a pimes
      </span>
            <h1 class="text-3xl sm:text-5xl md:text-7xl lg:text-8xl uppercase font-extrabold tracking-tighter leading-[0.88] mb-8 text-gradient flex flex-col items-center text-center">
                <span class="lg:whitespace-nowrap">Disseny Pàgines Web </span>
                <span class="lg:whitespace-nowrap text-mktg-gradient">per a Pimes</span>
            </h1>
      <p class="text-lg sm:text-xl text-zinc-500 font-light leading-relaxed max-w-3xl mx-auto mb-8">
        Dissenyem webs corporatives, landing pages i botigues online que expliquen en segons què fa la teva pime i porten la visita a demanar pressupost, reservar o comprar. Planifiquem el SEO abans de dissenyar, així la web surt preparada per posicionar a Google.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 mb-10">
        {['La web i el domini al teu nom', 'Sense permanència', 'SEO des de la planificació'].map((item) => (
          <span class="inline-flex items-center gap-2 text-[11px] sm:text-xs font-black uppercase tracking-widest text-zinc-700">
            <svg class="w-4 h-4 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            {item}
          </span>
        ))}
      </div>
      <a href="#contacto" class="contact-modal-trigger btn-mktg-v5 shadow-[0_10px_30px_rgba(0,0,0,0.1)] !py-4 sm:!py-5 !px-6 sm:!px-10 !text-[11px] !tracking-widest font-black">PARLEM DE LA TEVA WEB</a>
    </div>
  </section>

  <LogoMarquee />

  <!-- ═══ OBJECTIU ═══════════════════════════════════════════════════════ -->
  <PSection kicker="Abans de dissenyar" title="La teva propera web comença pel que ha d'aconseguir la teva empresa">
    <Fragment slot="intro">
      <p>Encarregues una web per aconseguir una cosa concreta: més peticions de pressupost, vendes online, clients més ben filtrats o menys trucades per explicar el mateix. <strong>Aquest objectiu decideix quines pàgines calen, què explica cadascuna i què ha de fer el visitant al final.</strong></p>
      <p>Per això la primera reunió parla del teu negoci, no de plantilles. La web forma part de la teva captació de clients, al costat del <a href="/ca/agencia-seo-per-pimes/">posicionament a Google</a> i de la resta del <a href="/ca/">màrqueting digital de la teva pime</a>. L'esquema mostra l'ordre en què treballem.</p>
    </Fragment>
    <PFlow
      steps={[
        { label: 'Objectiu de negoci', sub: 'contactes, vendes, reserves' },
        { label: 'Estructura', sub: 'quines pàgines i en quin ordre' },
        { label: 'Contingut', sub: 'què diu cada pàgina' },
        { label: 'Disseny', sub: 'marca, lectura i ús' },
        { label: 'Llançament', sub: 'mesurat des del primer dia' },
      ]}
      caption="Fixa't que el disseny visual arriba al quart pas, quan ja sabem què ha d'aconseguir cada pàgina."
    />
  </PSection>

  <!-- ═══ TIPUS DE PROJECTE ══════════════════════════════════════════════ -->
  <PSection kicker="Tipus de projecte" title="Tria el tipus de projecte que encaixa amb tu" tone="soft">
    <Fragment slot="intro">
      <p>Gairebé totes les pimes arriben amb una d'aquestes quatre necessitats. Cada targeta indica el preu de partida i el termini habitual.</p>
      <p>Si no saps quina és la teva, ho mirem a la primera trucada. De vegades un redisseny complet es resol amb una bona landing, i a l'inrevés.</p>
    </Fragment>
    <PCards
      tone="soft"
      cols={2}
      items={[
        { icon: ICON.building, tag: 'Des de 120 €/mes · 3 a 5 setmanes', title: 'Web corporativa per presentar la teva empresa', html: 'Per a despatxos, clíniques, empreses de serveis o fabricants que han d\'explicar què fan, per a qui i per què són de fiar. Inclou pàgines de servei, equip, projectes i contacte. És el format habitual en el <a href="/ca/agencia-b2b/diseno-web/">disseny web per a empreses B2B</a> i en les <a href="/ca/agencia-industrial/diseno-web/">webs d\'empreses industrials</a>, on el comprador compara molt abans de trucar.' },
        { icon: ICON.bolt, tag: 'Des de 400 € · 1 a 2 setmanes', title: 'Landing page per a una oferta o campanya', html: 'Una sola pàgina amb un sol objectiu, pensada per rebre trànsit d\'anuncis. No porta menú que distregui. Mostra l\'oferta, les proves de confiança i un formulari o botó de trucada sempre a mà. Rendeix més quan la connectes a una <a href="/ca/agencia-sem-per-pimes/">campanya de Google Ads</a> ben segmentada, perquè l\'anunci i la pàgina diuen el mateix.' },
        { icon: ICON.bag, tag: 'Des de 130 €/mes · 6 a 8 setmanes', title: 'Botiga online per vendre productes', html: 'Catàleg, fitxes de producte, carretó, pagament, enviaments i gestió de comandes, pensats perquè el comprador no abandoni pel camí. Triem la plataforma amb tu segons la mida del catàleg i com prepares les comandes. Si el teu cas és una botiga gran o tècnica, mira el nostre <a href="/ca/agencia-ecommerce/diseno-web/">disseny de botigues online</a>.' },
        { icon: ICON.refresh, tag: 'Segons l\'abast', title: 'Redisseny d\'una web que s\'ha quedat enrere', html: 'Per a webs lentes, difícils d\'editar o que ja no representen la teva empresa. Conservem el que avui funciona i protegim el posicionament que ja tens. No saps si et cal? Repassa abans aquesta guia per <a href="/ca/blog/com-saber-si-la-teva-web-esta-ben-feta/">saber si la teva web està ben feta</a> i apunta què falla.' },
      ]}
    />
  </PSection>

  <!-- ═══ WEB EXISTENT ═══════════════════════════════════════════════════ -->
  <PSection kicker="Redisseny" title="Si ja tens web, decidim què val la pena conservar" layout="split">
    <Fragment slot="intro">
      <p>Refer la teva web no obliga a llençar el que ja hi havia. Abans de dissenyar revisem Analytics, Search Console, el contingut publicat i la tecnologia, i col·loquem cada pàgina a la matriu segons el seu valor i la feina que demana.</p>
      <p>Aquesta revisió evita l'error més car d'un redisseny: perdre en una setmana el trànsit que va costar anys aconseguir.</p>
    </Fragment>
    <PMatrix
      slot="aside"
      xLabel="Feina necessària"
      yLabel="Valor per al negoci"
      quadrants={['Conservar', 'Millorar', 'Redirigir o fusionar', 'Eliminar']}
      points={[
        { label: 'Servei que posiciona', x: 18, y: 86 },
        { label: 'Guia amb visites', x: 32, y: 66 },
        { label: 'Pàgina de contacte', x: 72, y: 80 },
        { label: 'Notícies duplicades', x: 26, y: 28 },
        { label: 'Promoció caducada', x: 76, y: 18 },
      ]}
      caption="Exemple de classificació: a dalt a l'esquerra, el que es conserva gairebé sense tocar; a baix a la dreta, el que s'elimina."
    />
    <PCards
      variant="rows"
      items={[
        { title: 'Pàgines que atrauen visites i contactes', html: 'Busquem les URL que reben trànsit de Google, les que tenen enllaços d\'altres webs i les que generen formularis i trucades. Aquestes pàgines conserven la seva adreça o es redirigeixen a la nova equivalent. Si avui no saps quin canal et porta les visites, llegeix abans <a href="/ca/blog/don-ve-el-trafic-web/">d\'on ve el trànsit de la teva web</a>.' },
        { title: 'Continguts i recursos que continuen sent útils', html: 'Articles que encara resolen dubtes reals, fitxes tècniques, preguntes freqüents o projectes que demostren experiència. Molts només necessiten dades al dia i un format més llegible. El que és obsolet o repetit es fusiona amb una altra pàgina o s\'elimina, i cada URL que desapareix rep la seva redirecció per no perdre visites ni enllaços.' },
        { title: 'Problemes de navegació i conversió', html: 'Menús amb massa opcions, serveis amagats, formularis de deu camps o un telèfon que no es pot prémer al mòbil. Recorrem la teva web com ho faria un client, des de la portada fins al contacte, i anotem cada punt on es perd gent. Aquesta llista és el primer que resol el nou disseny.' },
        { title: 'Tecnologia que condiciona el nou projecte', html: 'Plataforma, allotjament, plugins, integracions i qui té els accessos. De vegades la web es pot refer sobre la mateixa base i de vegades la tecnologia és el problema. Amb Clustag n\'hi va haver prou d\'optimitzar el seu WordPress. En el <a href="/ca/casos-exit/cts-formacion/">redisseny de CTS Formación</a>, en canvi, va caldre sortir de la plataforma d\'un proveïdor extern.' },
      ]}
    />
  </PSection>

  <!-- ═══ MAPA DE LA WEB ═════════════════════════════════════════════════ -->
  <PSection kicker="Arquitectura" title="De l'objectiu de negoci al mapa de la web" tone="soft">
    <Fragment slot="intro">
      <p>Amb l'objectiu clar dibuixem el mapa de la web: quines pàgines tindrà, com s'agrupen i com s'enllacen. El valides abans que existeixi una sola pantalla de disseny, i és el document que més canvis cars evita després.</p>
    </Fragment>
    <PTree
      root="Web d'un despatx professional"
      branches={[
        { label: 'Serveis', leaves: ['Una pàgina per servei', 'Preus orientatius'] },
        { label: 'Sectors o casos', leaves: ['Projectes reals', 'Testimonis'] },
        { label: "Sobre l'equip", leaves: ['Experiència', 'Col·legiacions'] },
        { label: 'Recursos', leaves: ['Guies i articles', 'Preguntes freqüents'] },
        { label: 'Contacte', leaves: ['Formulari', 'Telèfon i ubicació'] },
      ]}
      caption="Esquema il·lustratiu del mapa web d'un despatx: cada branca és una secció del menú i cada fulla, el que el visitant hi troba."
    />
    <PCards
      tone="soft"
      cols={2}
      variant="numbered"
      items={[
        { title: 'Què necessita trobar cada tipus de client', html: 'Un pacient nou busca tractaments, preu i cita. Un responsable de compres busca fitxes tècniques i referències. Abans de dibuixar el mapa anotem qui visita la teva web i quina pregunta porta. Ho apliquem en el <a href="/ca/agencia-dentistes/diseno-web/">disseny web per a clíniques dentals</a>, en les <a href="/ca/agencia-psicolegs/diseno-web/">webs per a psicòlegs</a> i en el <a href="/ca/agencia-terapeutes/diseno-web/">disseny web per a terapeutes</a>, on la confiança pesa més que el preu.' },
        { title: 'Com organitzem serveis i continguts', html: 'Cada servei important té la seva pròpia pàgina, agrupada perquè el visitant no hagi d\'endevinar on és. A <a href="/ca/casos-exit/villazon-merce-abogados/">Villazón Mercé Abogados</a> vam crear una pàgina per a cada àrea penal. A <a href="/ca/casos-exit/voltura-projects/">Voltura Projects</a>, una per a cada ciutat on treballen. És l\'estructura que proposem en el <a href="/ca/agencia-advocats/diseno-web/">disseny web per a advocats</a>.' },
        { title: 'Quin recorregut porta al contacte o a la compra', html: 'Tracem el camí des de la pàgina d\'entrada fins al formulari, la trucada, la reserva o la comanda, i traiem tots els passos que sobren. La nostra regla en les <a href="/ca/agencia-restaurantes/diseno-web/">webs per a restaurants</a> i en el <a href="/ca/agencia-hotels/diseno-web/">disseny web per a hotels</a> és senzilla: la reserva queda a un o dos tocs des de qualsevol pàgina.' },
        { title: 'Quines pàgines necessita el llançament', html: 'No tot ha d\'estar a punt el primer dia. Separem l\'imprescindible per publicar, que sol ser portada, serveis, qui som, contacte i textos legals, del que pot arribar després, com el blog o noves seccions. Així la teva web surt abans i les pàgines següents es decideixen amb dades reals d\'ús.' },
      ]}
    />
  </PSection>

  <!-- ═══ TEXTOS ═════════════════════════════════════════════════════════ -->
  <PSection kicker="Continguts" title="Textos que expliquen per què triar la teva empresa">
    <Fragment slot="intro">
      <p>El disseny atrau la mirada, però el text és el que convenç. Redactem o editem els continguts amb tu, perquè el teu equip sap millor que ningú què pregunten els clients i per què us acaben triant.</p>
      <p>Escrivim per a qui arriba amb pressa des del mòbil: frases curtes, respostes concretes i les dades que solen faltar a les webs de pimes, com terminis, preus orientatius o com treballeu.</p>
    </Fragment>
    <PCards
      cols={2}
      items={[
        { icon: ICON.compass, title: 'Una proposta de valor fàcil d\'entendre', html: 'A la primera pantalla el teu visitant ha de saber què fas, per a qui i què ha de fer a continuació. Ho resumim en un titular, una frase de suport i un botó. Queden fora expressions com "solucions integrals" o "qualitat i professionalitat", que qualsevol competidor podria signar i que no ajuden ningú a decidir.' },
        { icon: ICON.doc, title: 'Serveis descrits des de la necessitat del client', html: 'Cada pàgina de servei obre amb el problema que resol i després explica què inclou, com es treballa, quant triga i què costa aproximadament. Així respon a la <a href="/ca/blog/que-es-la-intencio-de-cerca-en-el-seo/">intenció de cerca</a> de qui arriba des de Google, que vol saber si el pots ajudar i no llegir un catàleg de serveis.' },
        { icon: ICON.chart, title: 'Experiència i proves que generen confiança', html: 'Projectes amb fotos reals, ressenyes, anys al sector, certificacions i xifres mesurables. En el <a href="/ca/agencia-constructores/diseno-web/">disseny web per a constructores</a> i en les <a href="/ca/agencia-inmobiliarias/diseno-web/">webs per a immobiliàries</a> proposem una fitxa per obra o promoció, amb fotos i dades, perquè un projecte documentat convenç més que qualsevol eslògan.' },
        { icon: ICON.bolt, title: 'Crides a l\'acció segons cada pàgina', html: 'Cada pàgina demana un pas diferent. Una pàgina de servei convida a demanar pressupost. Un article, a continuar llegint o a descarregar una guia. En les <a href="/ca/agencia-gimnasos/diseno-web/">webs per a gimnasos</a>, a reservar una classe de prova. Adaptem cada botó al moment del visitant i en mesurem els clics per saber quin funciona.' },
      ]}
    />
  </PSection>

  <!-- ═══ DISSENY ════════════════════════════════════════════════════════ -->
  <PSection kicker="Disseny" title="Un disseny que representa la teva marca i en facilita l'ús" tone="soft">
    <Fragment slot="intro">
      <p>Un bon disseny fa que la teva empresa sembli el que és i que qualsevol trobi el que busca sense pensar-hi. Partim de la teva identitat i l'adaptem a com es llegeix una web avui, sobretot al mòbil.</p>
      <p>El comparador mostra un cas real: la portada antiga de CTS Formación i la nova, construïda al voltant del cercador de cursos.</p>
    </Fragment>
    <div class="mt-12 reveal">
      <PageBlocks blocks={[{
        __component: 'blocks.image-compare',
        before: { url: '/casos/cts-formacion/antes-home-cts-formacion.webp', local: true, alternativeText: "Home antiga de CTS Formación amb capçalera vermella, menú en majúscules i imatges d'estoc" },
        after: { url: '/casos/cts-formacion/cts-formacion-web.webp', local: true, alternativeText: 'Home nova de CTS Formación amb el cercador de cursos com a protagonista i les categories com a accessos directes' },
        before_label: 'Abans',
        after_label: 'Després',
        aria_label: "Comparar la home antiga i la nova de CTS Formación",
        caption: "Llisca i fixa't en la primera pantalla: abans l'ocupaven imatges d'estoc; ara, el cercador de cursos i les categories.",
      }]} />
    </div>
    <PCards
      tone="soft"
      cols={2}
      items={[
        { icon: ICON.palette, title: 'Identitat visual aplicada a la web', html: 'Portem el teu logotip, colors i tipografies a un sistema pensat per a pantalla, amb botons, targetes, formularis i icones iguals a totes les pàgines. Si la teva marca és antiga o no tens manual d\'identitat, definim una base senzilla de colors i tipografies perquè la teva web no sembli una plantilla més.' },
        { icon: ICON.layers, title: 'Jerarquia per llegir i trobar informació', html: 'Titulars que resumeixen, paràgrafs curts, llistes, espai en blanc i un ordre que porta la vista de l\'important al secundari. Gairebé tothom escaneja abans de llegir. Per això apliquem una regla: si algú només llegeix els titulars d\'una pàgina, ha d\'entendre què ofereixes i quin és el pas següent.' },
        { icon: ICON.device, title: 'Experiència al mòbil, la tauleta i l\'ordinador', html: 'Dissenyem primer per al mòbil i després ho ampliem a tauleta i ordinador. A la web del torneig del <a href="/ca/casos-exit/cb-hospitalet/">CB L\'Hospitalet</a>, el 90 % del públic del pavelló consultava els horaris des del telèfon. Per això cuidem el telèfon que es prem, els menús a l\'abast del polze, els formularis curts i els textos llegibles sense zoom.' },
        { icon: ICON.access, title: 'Accessibilitat en els elements d\'interacció', html: 'Contrast suficient, textos de mida llegible, botons grans, formularis amb etiquetes clares i navegació possible amb teclat. Revisem aquests punts a cada plantilla abans de publicar. Ajuden les persones amb dificultats visuals o motrius i, de passada, fan la teva web més còmoda per a qualsevol visitant.' },
      ]}
    />
  </PSection>

  <!-- ═══ TECNOLOGIA ═════════════════════════════════════════════════════ -->
  <PSection kicker="Tecnologia" title="La tecnologia adequada per gestionar el teu projecte">
    <Fragment slot="intro">
      <p>Treballem amb WordPress i amb desenvolupament a mida. Triem segons tres preguntes: què ha de fer la teva web, qui l'editarà i amb quines eines s'ha de connectar.</p>
      <p>La taula resumeix en què destaca cada opció.</p>
    </Fragment>
    <WebVersus
      locale="ca"
      a={{ label: 'WordPress' }}
      b={{ label: 'Desenvolupament a mida' }}
      rows={[
        { label: 'Encaixa amb', a: 'Webs amb molt contingut, blog actiu i equips que ja coneixen el panell.', b: 'Webs on la velocitat, el SEO o una funcionalitat pròpia són prioritaris.' },
        { label: 'Edició', a: 'Panell conegut i un gran ecosistema de plugins.', b: 'Panell propi, només amb els camps que necessita el teu equip.' },
        { label: 'Rendiment', a: 'Bo si es cuida la plantilla i es limiten els plugins.', b: 'Molt alt d\'entrada, sense codi que no es fa servir.' },
        { label: 'Manteniment', a: 'Actualitzacions freqüents del nucli i dels plugins.', b: 'Menys peces de tercers per actualitzar.' },
      ]}
      caption="Resum orientatiu. La decisió final depèn de cada projecte i la raonem per escrit a la proposta."
    />
    <PCards
      cols={2}
      items={[
        { icon: ICON.wp, title: 'Quan té sentit treballar amb WordPress', html: 'Quan publicaràs contingut sovint, el teu equip ja coneix el panell o necessites funcions que existeixen com a plugin provat. Ben configurat, WordPress també és ràpid: la <a href="/ca/casos-exit/clustag/">web de Clustag</a> va passar de 53 a 98 al PageSpeed d\'escriptori sense canviar de plataforma. Només cal cuidar la plantilla i limitar els plugins al que fa falta de debò.' },
        { icon: ICON.code, title: 'Quan convé un desenvolupament a mida', html: 'Quan necessites un cercador, un catàleg amb filtres, diversos idiomes o el màxim rendiment sense dependre de plugins. Les webs de <a href="/ca/casos-exit/villazon-merce-abogados/">Villazón Mercé</a> i Voltura Projects són desenvolupaments a mida amb 98 i 100 al PageSpeed d\'escriptori. Ho decidim projecte a projecte i ho raonem per escrit a la proposta.' },
        { icon: ICON.plug, title: 'Integracions amb les eines de la teva empresa', html: 'Connectem els formularis amb el teu CRM o el teu correu, i la web amb el teu sistema de reserves, el teu programa de facturació o la teva eina d\'email màrqueting. Així cap contacte no es queda oblidat en una safata d\'entrada. Si encara no fas servir cap CRM, compara <a href="/ca/blog/els-7-millors-crm-per-la-teva-pime/">els millors CRM per a una pime</a>.' },
        { icon: ICON.pencil, title: 'Edició de continguts sense dependre d\'un desenvolupador', html: 'Textos, imatges, preus, entrades del blog o productes es canvien des d\'un panell, sense tocar codi. T\'ensenyem a fer-ho amb la teva pròpia web. Al <a href="/ca/casos-exit/restaurant-loremar/">Restaurant Loremar</a> el mateix equip actualitza la carta cada vegada que canvia un plat, i la web manté un 94 al PageSpeed d\'escriptori.' },
      ]}
    />
  </PSection>

  <!-- ═══ SEO ════════════════════════════════════════════════════════════ -->
  <PSection kicker="SEO" title="SEO incorporat des de la planificació" tone="soft" layout="split">
    <Fragment slot="intro">
      <p>El SEO es decideix al mapa de la web, als textos i en com es programa, molt abans d'instal·lar cap plugin. Una web ben estructurada des del principi posiciona abans i costa menys millorar-la després. L'esquema mostra les capes que deixem resoltes en construir-la.</p>
      <p>Si vols continuar creixent als cercadors després del llançament, ho continuem amb el nostre servei d'<a href="/ca/agencia-seo-per-pimes/">agència SEO per a pimes</a>. Per aparèixer a les respostes de ChatGPT o Gemini, amb el de <a href="/ca/agencia-geo-per-pimes/">posicionament en IA</a>.</p>
      <p data-consultor-link>Cada projecte el dirigeix Sergio Galo's, fundador de Nova, que també treballa com a <a href="https://sergiogalos.es/consultor-seo-tecnico/" class="font-medium text-accent underline decoration-accent/30 underline-offset-4 hover:decoration-accent" target="_blank" rel="noopener">consultor SEO tècnic</a>, i revisa l’arquitectura de cada web abans de dissenyar-la.</p>
    </Fragment>
    <PStack
      slot="aside"
      layers={[
        { label: 'Contactes des de Google', sub: "l'objectiu" },
        { label: 'Contingut que respon', sub: 'una cerca, una pàgina' },
        { label: 'Encapçalaments i enllaços', sub: 'Google entén la web' },
        { label: 'Rendiment', sub: 'càrrega ràpida al mòbil' },
        { label: 'Rastreig i indexació', sub: 'Google la pot llegir' },
      ]}
      caption="Esquema il·lustratiu. Llegeix-lo de baix a dalt: sense rastreig ni velocitat, el contingut no arriba a convertir-se en contactes."
    />
    <PCards
      tone="soft"
      cols={2}
      variant="check"
      items={[
        { title: 'Estructura de pàgines segons les cerques del client', html: 'Abans de tancar el mapa web estudiem com busca el teu client. Si busca cada servei per separat, o amb el nom de la seva ciutat, cada cerca tindrà la seva pròpia pàgina. Nosaltres ho apliquem amb pàgines pròpies de <a href="/ca/disseny-web-per-pimes/barcelona/">disseny web a Barcelona</a>, <a href="/ca/disseny-web-per-pimes/sabadell/">webs per a pimes de Sabadell</a>, <a href="/ca/disseny-web-per-pimes/sant-cugat/">disseny web a Sant Cugat</a> i <a href="/ca/disseny-web-per-pimes/terrassa/">pàgines web a Terrassa</a>, en lloc d\'una sola pàgina genèrica.' },
        { title: 'Encapçalaments, metadades i enllaços interns', html: 'Un únic H1 per pàgina, encapçalaments que resumeixen cada secció, títols i descripcions pensats per al resultat de Google i enllaços entre pàgines relacionades. Afegim dades estructurades d\'empresa, serveis, productes o preguntes freqüents, sempre fidels al que es veu a la pàgina. Tot queda revisat a l\'entorn de proves abans de publicar.' },
        { title: 'Control del rastreig i la indexació', html: 'Sitemap, robots.txt, etiquetes canòniques i noindex on correspon, perquè Google dediqui el seu temps a les pàgines que importen. Comprovem que cap pàgina de proves, filtre o duplicat no acabi a l\'índex. En publicar donem d\'alta la teva web a Search Console i enviem el sitemap.' },
        { title: 'Redireccions quan substituïm una web existent', html: 'Preparem un mapa de redireccions URL a URL abans de publicar, el provem a l\'entorn de proves i el revisem el dia del llançament. És just el que va fallar abans que <a href="/ca/casos-exit/clustag/">recuperéssim el trànsit de Clustag</a>, que va perdre la visibilitat per un canvi de domini mal redirigit. Després seguim les teves pàgines clau a Search Console.' },
      ]}
    />
  </PSection>

  <!-- ═══ RENDIMENT ══════════════════════════════════════════════════════ -->
  <PSection kicker="Qualitat" title="Rendiment i qualitat abans de publicar">
    <Fragment slot="intro">
      <p>Una web lenta perd visites abans de mostrar res, i un formulari trencat perd contactes sense que ningú se n'adoni. Per això cap web no surt sense passar la nostra llista de comprovacions de velocitat, funcionament i compatibilitat.</p>
      <p>Els anells mostren resultats reals de PageSpeed Insights en projectes nostres, abans i després de treballar la web.</p>
    </Fragment>
    <PRings
      rings={[
        { value: 46, label: 'CTS Formación', sub: 'abans · mòbil', href: '/ca/casos-exit/cts-formacion/' },
        { value: 100, label: 'CTS Formación', sub: 'després · mòbil', href: '/ca/casos-exit/cts-formacion/' },
        { value: 53, label: 'Clustag', sub: 'abans · escriptori', href: '/ca/casos-exit/clustag/' },
        { value: 98, label: 'Clustag', sub: 'després · escriptori', href: '/ca/casos-exit/clustag/' },
        { value: 100, label: 'Voltura Projects', sub: 'web nova · escriptori', href: '/ca/casos-exit/voltura-projects/' },
      ]}
      caption="Puntuació de rendiment a PageSpeed Insights. Fixa't si cada dada és de mòbil o d'escriptori i prem un anell per veure el cas."
    />
    <PCards
      cols={4}
      variant="numbered"
      items={[
        { title: 'Optimització d\'imatges i recursos', html: 'Imatges en formats moderns com WebP i a la mida exacta en què es mostren, càrrega diferida del que queda fora de pantalla, tipografies lleugeres i només el codi que necessita cada pàgina. És la millora que més es nota al mòbil, on la connexió sol ser pitjor.' },
        { title: 'Comprovació de velocitat i Core Web Vitals', html: 'Mesurem cada plantilla amb PageSpeed Insights al mòbil i a l\'escriptori. Corregim el que endarrereix la càrrega, mou el contingut o bloqueja la interacció abans de donar la web per acabada. Així vam portar el <a href="/ca/casos-exit/cts-formacion/">PageSpeed mòbil de CTS Formación</a> de 46 a 100.' },
        { title: 'Proves de formularis, enllaços i navegació', html: 'Enviem cada formulari i comprovem que l\'avís arriba a la persona correcta. Revisem enllaços trencats, menús i botons de trucada i de WhatsApp. També comprovem que Analytics registra cada conversió, perquè des del primer dia sàpigues quants contactes porta la web.' },
        { title: 'Revisió en dispositius i navegadors', html: 'Provem la teva web en mòbils Android i iPhone, tauletes i ordinadors, amb Chrome, Safari, Firefox i Edge. El que es veu bé a la pantalla del dissenyador s\'ha de veure igual de bé a la del teu client, sigui quin sigui el seu telèfon.' },
      ]}
    />
  </PSection>

  <!-- ═══ ECOMMERCE ══════════════════════════════════════════════════════ -->
  <PSection kicker="Botigues online" title="Si vendràs online, resolem tot el recorregut de compra" tone="soft" layout="split">
    <Fragment slot="intro">
      <p>En una botiga online, cada pas decideix si el client compra o marxa, des que entra en una categoria fins que rep la confirmació de la comanda. Dissenyem el recorregut complet i el connectem amb la teva manera de preparar i enviar comandes.</p>
      <p>És un projecte de 6 a 8 setmanes, des de 130 € al mes en 12 quotes. Si el teu catàleg és ampli o tècnic, l'adaptem com al nostre <a href="/ca/agencia-ecommerce/diseno-web/">disseny web per a ecommerce</a>.</p>
    </Fragment>
    <PFunnel
      slot="aside"
      stages={[
        { label: 'Catàleg', sub: 'categories i filtres', side: 'El comprador troba el producte.' },
        { label: 'Fitxa de producte', sub: 'fotos, dades, preu', side: 'Resol els seus dubtes.' },
        { label: 'Carretó', sub: 'costos clars', side: 'Sense sorpreses al final.' },
        { label: 'Pagament', sub: 'ràpid i segur', side: 'Comanda confirmada.' },
      ]}
      caption="Esquema il·lustratiu: al costat de cada etapa, el que ha de quedar resolt abans que el comprador passi a la següent."
    />
    <PCards
      tone="soft"
      cols={2}
      items={[
        { icon: ICON.layers, title: 'Catàleg i fitxes de producte', html: 'Categories ordenades com les pensa el teu client, filtres útils que no generen pàgines duplicades i fitxes amb bones fotos, mides, materials, termini de lliurament i preguntes freqüents. La nostra regla: la fitxa ha de respondre el mateix que respondria un venedor a la botiga física.' },
        { icon: ICON.bag, title: 'Carretó i procés de pagament', html: 'Compra com a convidat, pocs camps, despeses d\'enviament visibles des del principi i passos clars fins a la confirmació. Abans d\'obrir la botiga recorrem el procés complet amb comandes de prova, perquè res no falli el primer dia de vendes.' },
        { icon: ICON.chart, title: 'Enviaments, impostos i mètodes de cobrament', html: 'Configurem tarifes d\'enviament per zona o per pes, recollida a la botiga si l\'ofereixes, IVA segons la destinació i els mètodes de pagament que esperen els teus clients, com targeta, Bizum, PayPal o transferència. Ho deixem tot alineat amb com treballa la teva comptabilitat.' },
        { icon: ICON.plug, title: 'Gestió de comandes i integracions', html: 'Correus de confirmació i d\'enviament, estats de comanda i avisos d\'estoc. Si treballes amb un ERP, un programa de facturació, un magatzem o un transportista, estudiem la integració perquè no hagis de copiar comandes a mà. Perquè aquests compradors repeteixin, mira com treballem l\'<a href="/ca/agencia-ecommerce/email-marketing/">email màrqueting per a botigues online</a>.' },
      ]}
    />
  </PSection>

  <!-- ═══ PROCÉS ═════════════════════════════════════════════════════════ -->
  <PSection kicker="Calendari" title="Així avançarà el teu projecte de principi a fi">
    <Fragment slot="intro">
      <p>Una web corporativa es lliura en 3 a 5 setmanes. Treballem per fases i tanques cadascuna amb la teva validació, així no arribes al final amb sorpreses sobre l'estructura o el disseny. El calendari mostra com s'encavalquen les fases.</p>
    </Fragment>
    <WebGantt
      weeks={5}
      unit="Setm."
      phases={[
        { label: 'Abast i materials', sub: 'objectius, accessos, textos i fotos', start: 1, end: 1 },
        { label: 'Estructura i proposta visual', sub: 'mapa web i disseny de portada', start: 1, end: 2 },
        { label: 'Desenvolupament i revisió', sub: 'maquetació, continguts i ajustos', start: 2, end: 4 },
        { label: 'Publicació i comprovacions', sub: 'llançament, redireccions i mesura', start: 4, end: 5 },
      ]}
      caption="Exemple de calendari per a una web corporativa. Una landing page es resol en 1 a 2 setmanes i una botiga online en 6 a 8. El termini depèn que els materials i les revisions arribin a temps."
    />
    <PCards
      cols={4}
      variant="numbered"
      items={[
        { title: 'Definició de l\'abast i recollida de materials', html: 'En una reunió concretem objectius, pàgines i funcionalitats, i ho deixem per escrit. Després t\'enviem la llista del que necessitem: logotip, textos existents, fotos i accessos al domini i a la web actual. Com més aviat arribi, abans comença el disseny.' },
        { title: 'Validació de l\'estructura i la proposta visual', html: 'Et presentem el mapa web i el disseny de la portada i d\'una pàgina interna. No seguim fins que no els valides, perquè moure l\'estructura la setmana quatre costa molt més que fer-ho la setmana dos.' },
        { title: 'Desenvolupament i revisió de la web', html: 'Construïm la resta de pàgines en un entorn de proves al qual tens accés des del primer dia. Quan està completa, la revises sencera i recollim els teus comentaris en una ronda ordenada d\'ajustos, pàgina per pàgina.' },
        { title: 'Publicació i comprovacions del llançament', html: 'Publiquem al teu domini, activem les redireccions, Analytics i Search Console, i repetim les proves de formularis i velocitat sobre la web real. Durant els dies següents vigilem que tot funcioni i que els contactes arribin.' },
      ]}
    />
  </PSection>

  <!-- ═══ COL·LABORACIÓ ══════════════════════════════════════════════════ -->
  <PSection kicker="Treball en equip" title="Què necessitem del teu equip i què resolem nosaltres" tone="soft">
    <Fragment slot="intro">
      <p>Tu coneixes el teu negoci i nosaltres sabem fer webs. El projecte avança ràpid quan cada part sap què li toca des del primer dia.</p>
      <p>Gairebé tots els retards vénen de materials que no arriben o de revisions que s'allarguen. Aquestes tres targetes expliquen com ho evitem.</p>
    </Fragment>
    <PCards
      tone="soft"
      cols={3}
      items={[
        { icon: ICON.doc, title: 'Continguts i materials de partida', html: 'Et demanem el que només tens tu: informació dels serveis, fotos de projectes i de l\'equip, logotip i dades legals. Nosaltres redactem o adaptem els textos a partir d\'una entrevista amb tu i et diem quines imatges falten. No has d\'escriure la web des de zero.' },
        { icon: ICON.users, title: 'Responsables de revisió i aprovació', html: 'Demanem una persona de contacte que pugui aprovar i, com a molt, una altra que revisi. Com més persones opinen sobre cada pantalla, més s\'allarga el projecte i menys coherent queda el resultat. Les decisions tècniques i de disseny les proposem nosaltres i t\'expliquem el motiu de cadascuna.' },
        { icon: ICON.layers, title: 'Organització de lliuraments i comentaris', html: 'Cada lliurament arriba amb data i amb una llista del que cal revisar. Els comentaris es recullen en un únic document o sobre la mateixa web de proves, agrupats per pàgina. Així res no es perd en fils de correu i cada ronda d\'ajustos es tanca abans d\'obrir la següent.' },
      ]}
    />
  </PSection>

  <!-- ═══ LLIURAMENT ═════════════════════════════════════════════════════ -->
  <PSection kicker="Lliurament" title="Què rebràs amb el lliurament de la teva web" layout="split">
    <Fragment slot="intro">
      <p>En acabar, la web queda a les teves mans i no depèn de nosaltres. Reps tres coses: els accessos, una formació pràctica i la documentació perquè qualsevol professional pugui continuar la feina.</p>
    </Fragment>
    <PFlow
      slot="aside"
      highlight={false}
      steps={[
        { label: 'Accessos', sub: 'domini, web, allotjament' },
        { label: 'Formació', sub: 'sessió pràctica' },
        { label: 'Documentació', sub: 'configuració i guia' },
      ]}
    />
    <PCards
      variant="rows"
      items={[
        { title: 'Accessos i propietat dels actius acordats', html: 'Domini registrat a nom de la teva empresa, allotjament al teu nom o transferit, accés d\'administrador a la web i propietat dels comptes d\'Analytics i Search Console. Els textos, dissenys i imatges creats per al projecte són teus. No hi ha permanència: si un dia canvies de proveïdor, t\'emportes la web sencera.' },
        { title: 'Formació per a les tasques habituals', html: 'Una sessió pràctica, que pots gravar, per aprendre a canviar textos i imatges, publicar una entrada del blog, afegir un producte o revisar els contactes rebuts. Practiques amb la teva pròpia web, no amb una demo, i et quedes una guia breu per consultar-la quan la necessitis.' },
        { title: 'Documentació i configuració del projecte', html: 'Un document amb la tecnologia utilitzada, els plugins o serveis connectats, on està allotjada la web, com es fan les còpies de seguretat, quines redireccions es van crear i quins esdeveniments es mesuren a Analytics. Amb aquest document, qualsevol professional pot continuar treballant sobre la teva web sense començar a investigar des de zero.' },
