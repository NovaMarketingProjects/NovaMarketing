  <!-- ═══ CONTACTE ═══════════════════════════════════════════════════════ -->
  <section id="contacto" class="py-20 sm:py-32 px-4 sm:px-6 relative bg-accent">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-12 sm:gap-20 items-center">
