---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildAlternates } from '../../lib/i18n';
import { localAgencySchema } from '../../lib/schema';
import LogoMarquee from '../../components/sections/LogoMarquee.astro';
import FaqHome from '../../components/sections/FaqHome.astro';
import CityPills from '../../components/global/CityPills.astro';
import GoogleReviews from '../../components/global/GoogleReviews.astro';
import MoreCases from '../../components/casos/MoreCases.astro';
import PSection from '../../components/pillar/PSection.astro';
import PCards from '../../components/pillar/PCards.astro';
import PFlow from '../../components/pillar/PFlow.astro';
import PBars from '../../components/pillar/PBars.astro';
import PMatrix from '../../components/pillar/PMatrix.astro';
import PStack from '../../components/pillar/PStack.astro';
import PVenn from '../../components/pillar/PVenn.astro';
import PFunnel from '../../components/pillar/PFunnel.astro';
import PTree from '../../components/pillar/PTree.astro';
import PLines from '../../components/pillar/PLines.astro';
import PCounter from '../../components/pillar/PCounter.astro';
import PSerp from '../../components/pillar/PSerp.astro';
import SemCalc from '../../components/pillar/SemCalc.astro';
import SemBudget from '../../components/pillar/SemBudget.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://novamarketing.es';
const alternates = buildAlternates('/agencia-sem-para-pymes/', '/ca/agencia-sem-per-pimes/', SITE_URL);

const ICON = {
  search: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
  cart: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z',
  phone: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z',
  target: 'M12 3a9 9 0 100 18 9 9 0 000-18zm0 5a4 4 0 100 8 4 4 0 000-8z',
  doc: 'M9 12h6m-6 4h6M9 8h2m8-3v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2h6l4 4z',
  chart: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm8 0V5a2 2 0 012-2h0a2 2 0 012 2v14a2 2 0 01-2 2h0a2 2 0 01-2-2zm-8 0a2 2 0 002 2h2a2 2 0 002-2V9a2 2 0 00-2-2h-2a2 2 0 00-2 2v10z',
  money: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  users: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  video: 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z',
  eye: 'M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z',
  repeat: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
  shield: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  key: 'M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z',
  chat: 'M8 12h.01M12 12h.01M16 12h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
};

const faqs = [
  { question: 'Quin pressupost necessita la meva pime per començar?', answer: "Com a orientació, recomanem començar amb entre 300 i 500 euros al mes de pressupost en anuncis, que va íntegre a Google, més els honoraris de gestió, des de 150 euros al mes sense IVA. La xifra real depèn del que costa cada clic a les teves cerques i del teu marge. Abans de començar fem els números amb tu i, si no surten, t'ho diem." },
  { question: 'Quan hi haurà prou dades per avaluar les campanyes?', answer: 'Els anuncis poden començar a mostrar-se en pocs dies i els primers contactes solen arribar les primeres setmanes. Per valorar amb criteri el cost per contacte i la qualitat dels leads calen, en general, entre un i dos mesos de dades, més si el pressupost és baix o el teu cicle de venda és llarg.' },
  { question: 'Podeu continuar amb un compte que ja existeix?', answer: "Sí, i sol ser el més recomanable, perquè l'historial del compte té valor. Comencem amb una revisió de la configuració, les conversions, les campanyes i les cerques reals que han activat els teus anuncis. Mantenim el que funciona i corregim la resta per ordre d'impacte, sense esborrar el compte ni començar de zero." },
  { question: "Com es pausa o s'acaba el servei?", answer: "Treballem mes a mes, sense permanència. Si vols pausar les campanyes per temporada o acabar el servei, ens ho dius i ho deixem endreçat. El compte de Google Ads sempre és al teu nom, així que conserves l'historial, les conversions i les audiències, i el pots reprendre tu o amb qui decideixis." },
];

const pageSchema = localAgencySchema({
  pageUrl: `${SITE_URL}/ca/agencia-sem-per-pimes/`,
  lang: 'ca',
  cityName: 'Barcelona',
  postalCode: '08035',
  geo: { lat: 41.4114, lng: 2.1526 },
  areaServed: ["España", "Barcelona", "Sabadell", "Sant Cugat del Vallès", "Terrassa", "Vallès Occidental"],
  title: "▷ Google Ads per a Pimes | Campanyes SEM amb fee fix",
  description: "Campanyes Google Ads per a pimes amb compte propi i fee fix ✅ Resultats mesurats en leads i vendes ⭐ Informació detallada i clara",
  datePublished: '2026-07-15',
  dateModified: '2026-10-25',
  streetAddress: 'Carrer del General Mendoza, 10',
  hasMap: 'https://maps.app.goo.gl/9fbB12UcK32bgjj89',
  aggregateRating: { ratingValue: '5.0', reviewCount: '12' },
  breadcrumbName: 'Agència de Google Ads per a pimes',
  mainService: {
    name: 'Gestió de Google Ads per a pimes',
    serviceType: 'SEM / Google Ads',
    description: 'Campanyes de Google Ads per a pimes orientades a contactes i vendes, amb el compte a nom del client, honoraris fixos i sense permanència.',
    offers: [
      { name: 'Revisió inicial del compte de Google Ads', price: 900 },
      { name: 'Gestió i optimització de Google Ads', price: 150, from: true, monthly: true, description: 'Honoraris de gestió; el pressupost dels anuncis es paga a part a Google.' },
      { name: 'Gestió de comptes amb més inversió', price: 400, from: true, monthly: true },
    ],
  },
  faqs,
});
---

<BaseLayout
  title="▷ Google Ads per a Pimes | Campanyes SEM amb fee fix"
  description="Campanyes Google Ads per a pimes amb compte propi i fee fix ✅ Resultats mesurats en leads i vendes ⭐ Informació detallada i clara"
  locale="ca"
  alternates={alternates}
  schemas={[pageSchema]}
>

  <!-- ═══ HERO / H1 ═══════════════════════════════════════════════════════ -->
  <section class="pt-24 sm:pt-40 pb-20 px-4 sm:px-6 relative overflow-hidden text-center bg-white border-b border-black/5">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_40%,#000_75%,transparent_100%)]"></div>
    <div class="absolute -top-10 left-1/4 w-72 h-72 bg-accent/15 rounded-full blur-3xl opacity-30 animate-pulse"></div>
    <div class="absolute top-20 right-1/4 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl opacity-20"></div>

    <div class="max-w-5xl mx-auto reveal relative">
      <span class="inline-flex items-center gap-2 bg-accent/5 backdrop-blur-sm px-4 py-2 border border-accent/10 rounded-full text-accent text-[8px] sm:text-[10px] font-black uppercase tracking-[0.3em] mb-8 shadow-sm">
        <span class="w-1.5 h-1.5 bg-accent rounded-full animate-ping"></span>
        Publicitat a Google per a pimes
      </span>
            <h1 class="text-3xl sm:text-5xl md:text-7xl lg:text-8xl uppercase font-extrabold tracking-tighter leading-[0.88] mb-8 text-gradient flex flex-col items-center text-center">
                <span class="lg:whitespace-nowrap">Agència SEM </span>
                <span class="lg:whitespace-nowrap text-mktg-gradient">per a Pimes</span>
            </h1>
      <p class="text-lg sm:text-xl text-zinc-500 font-light leading-relaxed max-w-3xl mx-auto mb-8">
        Campanyes a Google pensades per aconseguir pressupostos, vendes i trucades que la teva empresa pugui atendre, amb el compte al teu nom i uns honoraris fixos que no depenen de quant gastis.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 mb-10">
        {['Sense permanències', 'Honoraris fixos', 'El compte és teu'].map((item) => (
          <span class="inline-flex items-center gap-2 text-[11px] sm:text-xs font-black uppercase tracking-widest text-zinc-700">
            <svg class="w-4 h-4 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            {item}
          </span>
        ))}
      </div>
      <a href="#contacto" class="contact-modal-trigger btn-mktg-v5 shadow-[0_10px_30px_rgba(0,0,0,0.1)] !py-4 sm:!py-5 !px-6 sm:!px-10 !text-[11px] !tracking-widest font-black">PARLEM DEL TEU NEGOCI</a>
    </div>
  </section>

  <LogoMarquee />

  <!-- ═══ OBJECTIU ═══════════════════════════════════════════════════════ -->
  <PSection kicker="Per què Google Ads" title="La teva inversió publicitària ha de respondre a un objectiu clar">
    <Fragment slot="intro">
      <p>Google Ads permet aparèixer avui mateix davant de qui busca el que vens. Aquesta rapidesa és el seu avantatge i també el seu risc: <strong>una campanya sense un objectiu concret gasta igual de ràpid que una de ben plantejada</strong>, només que sense tornar clients.</p>
      <p>A Nova comencem pel que la teva empresa necessita aconseguir i construïm les campanyes cap enrere. Quines cerques mereixen inversió, quin missatge necessita cada anunci i què ha de passar a la pàgina perquè el clic acabi en contacte. Si dubtes entre pagar per anuncis o treballar el posicionament, t'ho expliquem a <a href="/ca/blog/que-necesita-una-pime-seo-o-sem/">què necessita una pime, SEO o SEM</a>. Moltes vegades la resposta és combinar la publicitat amb el <a href="/ca/agencia-seo-per-pimes/">posicionament SEO</a>.</p>
    </Fragment>
    <PFlow
      steps={[
        { label: 'Objectiu de negoci', sub: 'pressupostos, vendes, trucades' },
        { label: 'Campanya adequada', sub: 'cerca, Shopping, vídeo' },
        { label: 'Pàgina de destinació', sub: 'respon a la cerca' },
        { label: 'Conversió mesurada', sub: 'contacte, venda, oportunitat' },
      ]}
      caption="L'ordre en què plantegem un compte. Primer l'objectiu; la campanya és l'eina per arribar-hi."
    />
  </PSection>

  <!-- ═══ OBJECTIUS ══════════════════════════════════════════════════════ -->
  <PSection kicker="Objectius" title="Què vols aconseguir amb les teves campanyes" tone="soft">
    <Fragment slot="intro">
      <p>Cada objectiu demana una configuració diferent: tipus de campanya, manera de pujar, pàgina de destinació i el que comptem com a conversió. Per això ho acordem abans de tocar el compte.</p>
    </Fragment>
    <PCards
      tone="soft"
      cols={2}
      items={[
        { icon: ICON.doc, title: 'Sol·licituds de pressupost', html: "Per a empreses de serveis amb un tiquet alt, com reformes, instal·lacions o assessories. Busquem persones que ja saben què necessiten i volen preu. Mesurem formularis complets, no clics, i filtrem les cerques de bricolatge o de feina. Ho apliquem en sectors com les <a href=\"/ca/agencia-constructores/google-ads/\">constructores</a> o les <a href=\"/ca/agencia-inmobiliarias/google-ads/\">immobiliàries</a>, on un sol contracte pot justificar mesos d'inversió." },
        { icon: ICON.cart, title: 'Vendes a la teva botiga en línia', html: "Si vens en línia, l'objectiu és facturar amb rendibilitat, no acumular visites. Treballem el catàleg, les campanyes de Shopping i la mesura d'ingressos per saber quins productes tornen el que s'hi ha invertit. Ho detallem al nostre servei de <a href=\"/ca/agencia-ecommerce/google-ads/\">Google Ads per a ecommerce</a>, amb la vista posada en el marge de cada producte." },
        { icon: ICON.phone, title: 'Trucades i contactes per al teu negoci', html: "Clíniques, despatxos, restaurants o centres esportius solen rebre clients per telèfon. Activem anuncis amb trucada, horaris ajustats a quan pots atendre i zones reals de servei. Tenim enfocaments específics per a <a href=\"/ca/agencia-dentistes/google-ads/\">dentistes</a>, <a href=\"/ca/agencia-advocats/google-ads/\">advocats</a>, <a href=\"/ca/agencia-restaurantes/google-ads/\">restaurants</a> i <a href=\"/ca/agencia-gimnasos/google-ads/\">gimnasos</a>." },
        { icon: ICON.users, title: "Oportunitats comercials per al teu equip de vendes", html: "En empreses B2B o industrials, l'anunci no tanca la venda; obre una conversa. Prioritzem cerques tècniques, formularis amb dades útils per al comercial i el seguiment de quins contactes acaben en oferta. Més detall a <a href=\"/ca/agencia-b2b/google-ads/\">Google Ads B2B</a> i a <a href=\"/ca/agencia-industrial/google-ads/\">Google Ads per a empreses industrials</a>." },
      ]}
    />
  </PSection>

  <!-- ═══ NÚMEROS ════════════════════════════════════════════════════════ -->
  <PSection id="numeros" kicker="Viabilitat" title="Abans d'invertir, comprovem si els números quadren">
    <Fragment slot="intro">
      <p>Hi ha negocis on Google Ads funciona molt bé i d'altres on el clic costa més del que deixa el client. <strong>Preferim saber-ho abans que gastis</strong> que descobrir-ho tres mesos després. Fem aquest càlcul amb les teves dades reals a la primera conversa.</p>
      <p>Prova de moure els valors. El resultat és el cost per clic a partir del qual les campanyes deixen de compensar amb aquest plantejament.</p>
    </Fragment>
    <SemCalc locale="ca" caption="Exemple amb valors il·lustratius d'una empresa de serveis, no són dades d'un client. Canvia cada valor per acostar-lo al teu negoci." />
    <PCards
      cols={2}
      variant="numbered"
      items={[
        { title: 'Marge dels teus productes o serveis', html: "El que importa no és el preu de venda, sinó el que queda després dels costos. Amb un marge alt pots pagar clics cars i continuar guanyant; amb un d'estret, cada euro de publicitat ha d'estar molt ben dirigit. Per això et preguntem pel marge aproximat de cada línia abans de proposar campanyes o pressupost." },
        { title: "Cost d'adquisició que pot assumir la teva empresa", html: "A partir del marge i de quants contactes acaben en venda calculem quant pots pagar com a màxim per un client nou. Si, a més, aquest client repeteix o contracta altres serveis, el límit puja. Aquesta xifra és la referència amb què jutgem cada campanya, no el nombre de clics." },
        { title: 'Demanda i competència a les cerques', html: "Revisem quanta gent busca el teu servei a la teva zona, quant costa aproximadament el clic i qui més s'hi anuncia. Una cerca amb poca demanda però molt precisa pot ser rendible; una altra amb molt volum i competidors amb més pressupost pot no ser-ho per a una pime. Entendre la <a href=\"/ca/blog/que-es-la-intencio-de-cerca-en-el-seo/\">intenció de cerca</a> ajuda a separar-les." },
        { title: 'Capacitat per atendre els contactes rebuts', html: "Més contactes només són una bona notícia si algú els atén a temps. Si el teu equip triga dos dies a tornar una trucada o no pot assumir més feina en temporada alta, ho tenim en compte en fixar el pressupost i els horaris. Una campanya no ha de generar més demanda de la que pots convertir en clients." },
      ]}
    />
  </PSection>

  <!-- ═══ COMPTE ACTUAL ══════════════════════════════════════════════════ -->
  <PSection id="auditoria" kicker="Revisió de compte" title="El teu compte de Google Ads està aprofitant el pressupost?" tone="soft" layout="split">
    <Fragment slot="intro">
      <p>Si ja inverteixes en Google Ads, el primer pas és mirar on va cada euro. La nostra revisió de compte recorre campanyes, cerques reals, conversions i pàgines de destinació, i acaba amb un pla ordenat per estalvi i impacte.</p>
      <p>També serveix com a <strong>segona opinió independent</strong> si treballes amb una altra agència i no tens clar què estàs pagant.</p>
    </Fragment>
    <PBars
      slot="aside"
      title="On se sol perdre el pressupost"
      rows={[
        { label: 'Cerques sense relació amb el que vens', value: 34, display: 'Alt' },
        { label: 'Conversions que no mesuren negoci', value: 26, display: 'Alt' },
        { label: 'Landing genèrica o lenta', value: 20, display: 'Mitjà' },
        { label: 'Campanyes solapades', value: 12, display: 'Mitjà' },
        { label: 'Horaris i zones sense ajustar', value: 8, display: 'Baix' },
      ]}
      caption="Esquema il·lustratiu dels problemes que més revisem, ordenats pel pes que solen tenir. No són percentatges d'un compte real."
    />
    <PCards
      variant="rows"
      tone="soft"
      items={[
        { title: 'Inversió destinada a cerques poc rellevants', html: "L'informe de termes de cerca mostra el que la gent va escriure realment abans de clicar el teu anunci. És habitual trobar-hi cerques de feina, de formació, de productes que no vens o d'altres ciutats. Cadascuna resta pressupost a les que sí que porten clients, i es corregeix amb paraules clau més ben triades i negatives." },
        { title: 'Campanyes que competeixen entre elles', html: "Quan diverses campanyes o grups d'anuncis pugen per la mateixa cerca, Google tria quin mostra i les dades es reparteixen. El resultat és que no saps què funciona i de vegades pagues més pel clic. Reordenem l'estructura perquè cada cerca important tingui una única campanya responsable." },
        { title: 'Conversions mal configurades o incompletes', html: "Si el compte compta com a conversió una visita a la pàgina de contacte, un clic al telèfon o un mateix formulari dues vegades, les pujes automàtiques optimitzen cap a una cosa que no és negoci. Comprovem què es mesura, com es mesura i si els números del compte quadren amb els contactes que rep la teva empresa." },
        { title: 'Pàgines de destinació que frenen els resultats', html: "Molts anuncis porten a la portada o a una pàgina que no parla del que s'ha buscat, carrega lenta al mòbil o amaga el formulari. El clic està pagat, però el contacte no arriba. Revisem cada pàgina que rep trànsit de pagament i marquem què cal canviar primer." },
      ]}
    />
  </PSection>

  <!-- ═══ CERCA ══════════════════════════════════════════════════════════ -->
  <PSection kicker="Campanyes de cerca" title="Captar la demanda que ja existeix" layout="split">
    <Fragment slot="intro">
      <p>Les campanyes de cerca són la base de gairebé qualsevol compte de pime. Apareixen quan algú escriu a Google exactament el que ofereixes, és a dir, quan la necessitat ja existeix. <strong>No cal convèncer ningú que et necessita</strong>, només que ets la millor opció.</p>
    </Fragment>
    <PSerp
      slot="aside"
      query="reforma de bany a Sabadell preu"
      results={[
        { url: 'latevaempresa.cat › reforma-banys', title: 'Reforma de bany a Sabadell · Pressupost en 48 h', desc: 'Plat de dutxa, enrajolat i lampisteria. Preu tancat i visita sense compromís al Vallès.', highlight: true, label: 'Anunci' },
        { url: 'competidor-a.com', title: 'Reformes integrals | Demana pressupost', desc: 'Reformem tota la teva casa. Més de 20 anys d\'experiència.', label: 'Anunci' },
        { url: 'directori-reformes.cat › sabadell', title: 'Preus de reforma de bany a Sabadell', desc: 'Compara pressupostos de diverses empreses de la zona.' },
      ]}
      caption="Il·lustració. Un anunci específic per al servei i la zona respon millor que un de genèric de la mateixa empresa."
    />
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start">
      <PCards
        cols={2}
        variant="check"
        class="lg:grid-cols-1 !mt-12"
        items={[
          { title: 'Campanyes de cerca per servei', html: "Separem cada servei important en la seva pròpia campanya o grup d'anuncis, amb el seu pressupost, les seves paraules clau i la seva pàgina. Així pots decidir quant invertir en cada línia i comparar quin servei porta clients a millor cost, en lloc de barrejar-ho tot en una sola campanya." },
          { title: 'Separació entre cerques de marca i genèriques', html: "Qui busca el nom de la teva empresa ja et coneix; qui busca el servei, encara no. Barrejar-les inflaria els resultats de manera enganyosa. Les separem per veure quant aporta de veritat la publicitat i per protegir la teva marca quan altres hi pugen, una cosa habitual en els <a href=\"/ca/agencia-hotels/google-ads/\">hotels</a> davant de les plataformes de reserves." },
          { title: "Paraules clau segons la intenció de l'usuari", html: "No és el mateix «quant costa reformar un bany» que «empresa reforma bany Sabadell». Prioritzem les cerques amb intenció de contractar, controlem les concordances per no obrir la porta a variacions sense sentit i reservem les més informatives per al SEO." },
          { title: 'Termes negatius per filtrar trànsit', html: "Mantenim llistes de paraules negatives per campanya i per compte: feina, gratis, cursos, segona mà, ciutats on no treballes o serveis que no ofereixes. Les revisem de manera contínua amb els termes reals, perquè cada setmana apareixen cerques noves." },
        ]}
      />
      <div class="mt-12">
        <PTree
          root="Compte d'una empresa de reformes"
          branches={[
