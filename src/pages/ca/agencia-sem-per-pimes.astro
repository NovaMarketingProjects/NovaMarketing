        { label: 'Negoci local amb un servei', fee: 150, ads: 400 },
        { label: 'Pime amb diversos serveis', fee: 250, ads: 1000 },
        { label: 'Compte amb Shopping o diverses zones', fee: 400, ads: 2500 },
