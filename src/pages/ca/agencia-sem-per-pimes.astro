      {[
        { title: 'Configuració o revisió inicial del compte', price: '900 €', note: "pagament únic · revisió d'un compte existent", text: "Si ja hi inverteixes, revisem campanyes, cerques, conversions i pàgines de destinació, i et lliurem un pla prioritzat en una videotrucada. Si comences de zero, la configuració del compte i de la mesura està inclosa en la gestió mensual.", items: ["Revisió d'estructura i cerques", 'Comprovació de conversions', 'Anàlisi de pàgines de destinació', 'Pla ordenat per impacte'] },
        { title: 'Honoraris de gestió i optimització', price: 'des de 150 € / mes', note: 'des de 400 € / mes en comptes més grans', text: "Una quota fixa segons el nombre de campanyes, serveis i formats, no un percentatge del que inverteixes. Inclou la gestió contínua del compte, els anuncis, la revisió de cerques, l'informe mensual i la línia directa amb el consultor.", items: ['Optimització contínua', 'Anuncis i recursos', 'Informe mensual de contactes i costos', 'Sense permanència, mes a mes'], featured: true },
        { title: 'Pressupost destinat als anuncis', price: 'el decideixes tu', note: 'orientatiu: des de 300-500 € / mes', text: "És el que pagues a Google pels clics, i Google el factura directament a la teva empresa. Va íntegre als anuncis. La xifra adequada depèn del cost del clic al teu sector i del teu marge; la calculem amb tu abans de començar.", items: ['Facturat per Google', 'Ajustable cada mes', 'Sense comissions sobre la inversió'] },
      ].map((p, i) => (
        <div class:list={['pd-rise rounded-3xl p-7 sm:p-8 flex flex-col border', p.featured ? 'bg-zinc-950 text-white border-zinc-950 shadow-2xl' : 'bg-white border-black/5 shadow-[0_15px_40px_rgba(0,0,0,0.06)]']} style={`--i:${i}`}>
