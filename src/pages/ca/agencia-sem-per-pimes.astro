  <!-- ═══ CONTACTE ═══════════════════════════════════════════════════════ -->
  <section id="contacto" class="py-20 sm:py-32 px-4 sm:px-6 relative bg-accent">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-12 sm:gap-20 items-center">
      <div class="reveal text-white">
        <span class="text-[10px] font-black uppercase tracking-[0.5em] mb-6 block opacity-70">Primer pas</span>
        <h2 class="text-4xl sm:text-6xl font-black uppercase tracking-tighter leading-[0.85] mb-10">Revisem si Google Ads encaixa en el teu negoci</h2>
        <ol class="space-y-5">
          {[
            ['Què vens i en quines zones', 'Els teus serveis o productes principals i on són els teus clients.'],
            ['Quins resultats necessites aconseguir', "Pressupostos, vendes, trucades o oportunitats per al teu equip comercial."],
            ['Quina inversió estàs valorant', 'Fem els números amb el teu marge per veure si encaixen.'],
            ['Quina proposta de campanyes té sentit per a la teva empresa', 'Per escrit, amb campanyes, pressupost recomanat i honoraris tancats.'],
          ].map(([t, d], i) => (
            <li class="flex gap-4">
              <span class="w-8 h-8 rounded-full bg-white/15 border border-white/30 flex items-center justify-center text-xs font-black flex-shrink-0">{i + 1}</span>
              <div>
                <h3 class="text-base sm:text-lg font-black tracking-tight">{t}</h3>
                <p class="text-sm font-light text-white/80">{d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="reveal">
        <div class="bg-white p-8 sm:p-16 shadow-[0_40px_100px_rgba(0,0,0,0.1)] rounded-sm">
          <form class="space-y-8" id="contact-form">
            <div class="grid sm:grid-cols-2 gap-6 text-[10px] font-black tracking-widest uppercase">
              <div class="flex flex-col gap-3">
                <label class="opacity-30">NOM *</label>
                <input type="text" name="name" aria-label="Nom" required class="border-b border-black/10 py-2 focus:border-accent outline-none">
              </div>
              <div class="flex flex-col gap-3">
                <label class="opacity-30">TELÈFON *</label>
                <input type="tel" name="phone" required autocomplete="tel" inputmode="tel" minlength="9" pattern="[0-9+\s.\(\)\-]{9,20}" title="Introdueix un telèfon vàlid (mínim 9 xifres)" aria-label="Telèfon" class="border-b border-black/10 py-2 focus:border-accent outline-none">
              </div>
            </div>
            <div class="flex flex-col gap-3 text-[10px] font-black tracking-widest uppercase">
              <label class="opacity-30">EMAIL PROFESSIONAL *</label>
              <input type="email" name="email" aria-label="Correu electrònic" required class="border-b border-black/10 py-2 focus:border-accent outline-none">
            </div>
            <div class="flex flex-col gap-3 text-[10px] font-black tracking-widest uppercase">
              <label class="opacity-30">WEB *</label>
              <input type="text" name="url" aria-label="Lloc web" placeholder="www.latevaempresa.com" class="border-b border-black/10 py-2 focus:border-accent outline-none">
            </div>
            <div class="flex flex-col gap-3 text-[10px] font-black tracking-widest uppercase">
              <label class="opacity-30">CONSULTA</label>
              <textarea name="msg" aria-label="Missatge" rows="3" class="border-b border-black/10 py-2 focus:border-accent outline-none resize-none" placeholder="Què vols anunciar a Google?"></textarea>
            </div>
            <div class="flex items-start gap-2">
              <input type="checkbox" id="contact-form-terms" name="terms" required class="mt-1 accent-accent">
              <label for="contact-form-terms" class="text-xs text-zinc-500 font-light cursor-pointer select-none normal-case tracking-normal">He llegit i accepto la <a href="/ca/privacitat/" class="underline hover:text-accent transition-colors">política de privacitat</a>.</label>
            </div>
            <button type="submit" class="w-full btn-mktg-v5 !py-6">VULL LLANÇAR LES MEVES CAMPANYES</button>
          </form>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button');
    if (btn) { btn.innerHTML = 'ENVIANT...'; btn.disabled = true; }
    const data = Object.fromEntries(new FormData(form));
    try {
      const res = await fetch('https://cms.novamarketing.es/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        window.location.href = '/ca/gracies/';
      } else { throw new Error(); }
    } catch {
      if (btn) { btn.innerHTML = 'ERROR — TORNA-HO A PROVAR'; btn.disabled = false; btn.style.background = '#ef4444'; }
    }
  });
</script>
