---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildAlternates } from '../../lib/i18n';
import { localAgencySchema } from '../../lib/schema';
import LogoMarquee from '../../components/sections/LogoMarquee.astro';
import FaqHome from '../../components/sections/FaqHome.astro';
import CityPills from '../../components/global/CityPills.astro';
import GoogleReviews from '../../components/global/GoogleReviews.astro';
import MoreCases from '../../components/casos/MoreCases.astro';
import PSection from '../../components/pillar/PSection.astro';
import PCards from '../../components/pillar/PCards.astro';
import PFlow from '../../components/pillar/PFlow.astro';
import PBars from '../../components/pillar/PBars.astro';
import PMatrix from '../../components/pillar/PMatrix.astro';
import PStack from '../../components/pillar/PStack.astro';
import PVenn from '../../components/pillar/PVenn.astro';
import PFunnel from '../../components/pillar/PFunnel.astro';
import PTree from '../../components/pillar/PTree.astro';
import PLines from '../../components/pillar/PLines.astro';
import PCounter from '../../components/pillar/PCounter.astro';
import PSerp from '../../components/pillar/PSerp.astro';
import SemCalc from '../../components/pillar/SemCalc.astro';
import SemBudget from '../../components/pillar/SemBudget.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://novamarketing.es';
const alternates = buildAlternates('/agencia-sem-para-pymes/', '/ca/agencia-sem-per-pimes/', SITE_URL);

const ICON = {
  search: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
  cart: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z',
  phone: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z',
  target: 'M12 3a9 9 0 100 18 9 9 0 000-18zm0 5a4 4 0 100 8 4 4 0 000-8z',
  doc: 'M9 12h6m-6 4h6M9 8h2m8-3v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2h6l4 4z',
  chart: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm8 0V5a2 2 0 012-2h0a2 2 0 012 2v14a2 2 0 01-2 2h0a2 2 0 01-2-2zm-8 0a2 2 0 002 2h2a2 2 0 002-2V9a2 2 0 00-2-2h-2a2 2 0 00-2 2v10z',
  money: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  users: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  video: 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z',
  eye: 'M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z',
  repeat: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
  shield: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  key: 'M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z',
  chat: 'M8 12h.01M12 12h.01M16 12h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
};

const faqs = [
  { question: 'Quin pressupost necessita la meva pime per començar?', answer: "Com a orientació, recomanem començar amb entre 300 i 500 euros al mes de pressupost en anuncis, que pagues íntegre a Google, més els honoraris de gestió, des de 150 euros al mes sense IVA. La xifra real depèn del que costa cada clic a les teves cerques i del teu marge. Abans de començar fem els números amb tu i, si no surten, t'ho diem." },
  { question: 'Quan hi haurà prou dades per avaluar les campanyes?', answer: 'Els anuncis poden començar a mostrar-se en pocs dies i els primers contactes solen arribar les primeres setmanes. Per valorar amb criteri el cost per contacte i la qualitat dels contactes calen, en general, entre un i dos mesos de dades. Més si el pressupost és baix o el teu cicle de venda és llarg.' },
  { question: 'Podeu continuar amb un compte que ja existeix?', answer: "Sí, i sol ser el més recomanable, perquè l'historial del compte té valor. Comencem revisant la configuració, les conversions, les campanyes i les cerques reals que han activat els teus anuncis. Mantenim el que funciona i corregim la resta per ordre d'impacte, sense esborrar el compte ni començar de zero." },
  { question: "Com es pausa o s'acaba el servei?", answer: "Treballem mes a mes, sense permanència. Si vols pausar les campanyes per temporada o acabar el servei, ens ho dius i ho deixem endreçat. El compte de Google Ads sempre és al teu nom, així que conserves l'historial, les conversions i les audiències, i el pots reprendre tu o amb qui decideixis." },
];

const pageSchema = localAgencySchema({
  pageUrl: `${SITE_URL}/ca/agencia-sem-per-pimes/`,
  lang: 'ca',
  cityName: 'Barcelona',
  postalCode: '08035',
  geo: { lat: 41.4114, lng: 2.1526 },
  areaServed: ["España", "Barcelona", "Sabadell", "Sant Cugat del Vallès", "Terrassa", "Vallès Occidental"],
  title: "▷ Google Ads per a Pimes | Campanyes SEM amb fee fix",
  description: "Campanyes Google Ads per a pimes amb compte propi i fee fix ✅ Resultats mesurats en leads i vendes ⭐ Informació detallada i clara",
  datePublished: '2026-07-15',
  dateModified: '2026-10-25',
  streetAddress: 'Carrer del General Mendoza, 10',
  hasMap: 'https://maps.app.goo.gl/9fbB12UcK32bgjj89',
  aggregateRating: { ratingValue: '5.0', reviewCount: '12' },
  breadcrumbName: 'Agència de Google Ads per a pimes',
  mainService: {
    name: 'Gestió de Google Ads per a pimes',
    serviceType: 'SEM / Google Ads',
    description: 'Campanyes de Google Ads per a pimes orientades a contactes i vendes, amb el compte a nom del client, honoraris fixos i sense permanència.',
    offers: [
      { name: 'Revisió inicial del compte de Google Ads', price: 900 },
      { name: 'Gestió i optimització de Google Ads', price: 150, from: true, monthly: true, description: 'Honoraris de gestió; el pressupost dels anuncis es paga a part a Google.' },
      { name: 'Gestió de comptes amb més inversió', price: 400, from: true, monthly: true },
    ],
  },
  faqs,
});
---

<BaseLayout
  title="▷ Google Ads per a Pimes | Campanyes SEM amb fee fix"
  description="Campanyes Google Ads per a pimes amb compte propi i fee fix ✅ Resultats mesurats en leads i vendes ⭐ Informació detallada i clara"
  locale="ca"
  alternates={alternates}
  schemas={[pageSchema]}
>

  <!-- ═══ HERO / H1 ═══════════════════════════════════════════════════════ -->
  <section class="pt-24 sm:pt-40 pb-20 px-4 sm:px-6 relative overflow-hidden text-center bg-white border-b border-black/5">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_40%,#000_75%,transparent_100%)]"></div>
    <div class="absolute -top-10 left-1/4 w-72 h-72 bg-accent/15 rounded-full blur-3xl opacity-30 animate-pulse"></div>
    <div class="absolute top-20 right-1/4 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl opacity-20"></div>

    <div class="max-w-5xl mx-auto reveal relative">
      <span class="inline-flex items-center gap-2 bg-accent/5 backdrop-blur-sm px-4 py-2 border border-accent/10 rounded-full text-accent text-[8px] sm:text-[10px] font-black uppercase tracking-[0.3em] mb-8 shadow-sm">
        <span class="w-1.5 h-1.5 bg-accent rounded-full animate-ping"></span>
        Publicitat a Google per a pimes
      </span>
            <h1 class="text-3xl sm:text-5xl md:text-7xl lg:text-8xl uppercase font-extrabold tracking-tighter leading-[0.88] mb-8 text-gradient flex flex-col items-center text-center">
                <span class="lg:whitespace-nowrap">Agència SEM </span>
                <span class="lg:whitespace-nowrap text-mktg-gradient">per a Pimes</span>
            </h1>
      <p class="text-lg sm:text-xl text-zinc-500 font-light leading-relaxed max-w-3xl mx-auto mb-8">
        Campanyes de Google Ads perquè la teva pime rebi pressupostos, vendes i trucades que pugui atendre. Cobrem uns honoraris fixos, no un percentatge del que inverteixes, i el compte és sempre al teu nom.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 mb-10">
        {['Sense permanències', 'Honoraris fixos', 'El compte és teu'].map((item) => (
          <span class="inline-flex items-center gap-2 text-[11px] sm:text-xs font-black uppercase tracking-widest text-zinc-700">
            <svg class="w-4 h-4 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            {item}
          </span>
        ))}
      </div>
      <a href="#contacto" class="contact-modal-trigger btn-mktg-v5 shadow-[0_10px_30px_rgba(0,0,0,0.1)] !py-4 sm:!py-5 !px-6 sm:!px-10 !text-[11px] !tracking-widest font-black">PARLEM DEL TEU NEGOCI</a>
    </div>
  </section>

  <LogoMarquee />

  <!-- ═══ OBJECTIU ═══════════════════════════════════════════════════════ -->
  <PSection kicker="Per què Google Ads" title="La teva inversió publicitària ha de respondre a un objectiu clar">
    <Fragment slot="intro">
      <p>Amb Google Ads pots aparèixer avui mateix davant de qui busca el que vens. Aquesta rapidesa és l'avantatge i també el risc: <strong>una campanya sense un objectiu concret gasta igual de ràpid que una de ben plantejada</strong>, però no porta clients.</p>
      <p>Per això comencem pel que necessita la teva empresa i construïm el compte cap enrere: quines cerques mereixen inversió, què ha de dir cada anunci i què ha de passar a la pàgina perquè el clic acabi en contacte. Si dubtes entre pagar anuncis o treballar el posicionament, ho comparem a <a href="/ca/blog/que-necesita-una-pime-seo-o-sem/">SEO o SEM per a una pime</a>. Sovint la resposta és combinar la publicitat amb el nostre <a href="/ca/agencia-seo-per-pimes/">servei de posicionament SEO</a>.</p>
    </Fragment>
    <PFlow
      steps={[
        { label: 'Objectiu de negoci', sub: 'pressupostos, vendes, trucades' },
        { label: 'Campanya adequada', sub: 'cerca, Shopping, vídeo' },
        { label: 'Pàgina de destinació', sub: 'respon a la cerca' },
        { label: 'Conversió mesurada', sub: 'contacte, venda, oportunitat' },
      ]}
      caption="L'ordre en què plantegem un compte: primer l'objectiu de negoci, després la campanya que el persegueix."
    />
  </PSection>

  <!-- ═══ OBJECTIUS ══════════════════════════════════════════════════════ -->
  <PSection kicker="Objectius" title="Què vols aconseguir amb les teves campanyes" tone="soft">
    <Fragment slot="intro">
      <p>Cada objectiu demana una configuració diferent: tipus de campanya, estratègia de puja, pàgina de destinació i què compta com a conversió. Ho acordem amb tu abans de tocar el compte, perquè d'aquesta decisió en depèn tota la resta.</p>
    </Fragment>
    <PCards
      tone="soft"
      cols={2}
      items={[
        { icon: ICON.doc, title: 'Sol·licituds de pressupost', html: "Per a serveis de tiquet alt, com reformes, instal·lacions o assessories. Busquem qui ja sap què necessita i vol preu, per exemple amb «pressupost reforma cuina». Mesurem formularis enviats, no clics, i excloem les cerques de bricolatge o de feina. Ho apliquem a <a href=\"/ca/agencia-constructores/google-ads/\">Google Ads per a constructores</a> i a les <a href=\"/ca/agencia-inmobiliarias/google-ads/\">campanyes per a immobiliàries</a>, on un sol contracte pot pagar mesos d'inversió." },
        { icon: ICON.cart, title: 'Vendes a la teva botiga en línia', html: "Si vens en línia, l'objectiu és facturar amb marge, no sumar visites. Treballem el catàleg, les campanyes de Shopping i la mesura d'ingressos per veure quins productes tornen el que s'hi ha invertit i quins no. Jutgem cada producte pel seu marge, no pel seu preu. Ho expliquem amb detall al nostre servei de <a href=\"/ca/agencia-ecommerce/google-ads/\">Google Ads per a ecommerce</a>." },
        { icon: ICON.phone, title: 'Trucades i contactes per al teu negoci', html: "Clíniques, despatxos, restaurants o gimnasos reben molts clients per telèfon. Activem anuncis amb botó de trucada, els mostrem només a les hores en què algú pot contestar i limitem la zona a on dones servei. Tenim enfocaments propis per a <a href=\"/ca/agencia-dentistes/google-ads/\">clíniques dentals</a>, <a href=\"/ca/agencia-advocats/google-ads/\">despatxos d'advocats</a>, <a href=\"/ca/agencia-restaurantes/google-ads/\">restaurants</a> i <a href=\"/ca/agencia-gimnasos/google-ads/\">gimnasos</a>." },
        { icon: ICON.users, title: "Oportunitats comercials per al teu equip de vendes", html: "En B2B o indústria, l'anunci no tanca la venda: obre una conversa amb el teu comercial. Prioritzem cerques tècniques com «fabricant de peces d'injecció», demanem al formulari les dades que el comercial necessita i seguim quins contactes acaben en oferta. Més detall a <a href=\"/ca/agencia-b2b/google-ads/\">Google Ads per a empreses B2B</a> i a <a href=\"/ca/agencia-industrial/google-ads/\">Google Ads per al sector industrial</a>." },
      ]}
    />
  </PSection>

  <!-- ═══ NÚMEROS ════════════════════════════════════════════════════════ -->
  <PSection id="numeros" kicker="Viabilitat" title="Abans d'invertir, comprovem si els números quadren">
    <Fragment slot="intro">
      <p>En alguns negocis Google Ads funciona molt bé i en d'altres el clic costa més del que deixa el client. <strong>Preferim saber-ho abans que gastis</strong>, no descobrir-ho tres mesos després. Fem aquest càlcul amb les teves dades reals a la primera conversa.</p>
      <p>Mou els valors de la calculadora. El resultat és el cost per clic màxim que pots pagar abans que les campanyes deixin de compensar.</p>
    </Fragment>
    <SemCalc locale="ca" caption="Exemple amb valors il·lustratius d'una empresa de serveis, no són dades d'un client. Canvia cada valor pel teu i mira com es mou el cost per clic màxim." />
    <PCards
      cols={2}
      variant="numbered"
      items={[
        { title: 'Marge dels teus productes o serveis', html: "Compta el que et queda després dels costos, no el preu de venda. Amb un marge alt pots pagar clics cars i continuar guanyant; amb un d'estret, cada euro ha d'anar a cerques molt precises. Per això et demanem el marge aproximat de cada línia de producte o servei abans de proposar campanyes o pressupost." },
        { title: "Cost d'adquisició que pot assumir la teva empresa", html: "Amb el teu marge i el percentatge de contactes que acaben en venda calculem quant pots pagar, com a màxim, per un client nou. Si aquest client repeteix o contracta més serveis, el límit puja. Aquesta xifra és la vara amb què mesurem cada campanya. El nombre de clics, per si sol, no decideix res." },
        { title: 'Demanda i competència a les cerques', html: "Revisem quanta gent busca el teu servei a la teva zona, quant costa el clic aproximat i qui més s'hi anuncia. Una cerca petita però precisa pot ser rendible; una altra amb molt volum i competidors amb més pressupost pot no ser-ho per a una pime. Per separar-les analitzem la <a href=\"/ca/blog/que-es-la-intencio-de-cerca-en-el-seo/\">intenció de cerca</a> de cada terme." },
        { title: 'Capacitat per atendre els contactes rebuts', html: "Més contactes només són una bona notícia si algú els atén a temps. Si el teu equip triga dos dies a tornar una trucada o va saturat en temporada alta, ajustem el pressupost i els horaris a aquesta realitat. La regla és senzilla: la campanya no ha de generar més demanda de la que pots convertir en clients." },
      ]}
    />
  </PSection>

  <!-- ═══ COMPTE ACTUAL ══════════════════════════════════════════════════ -->
  <PSection id="auditoria" kicker="Revisió de compte" title="El teu compte de Google Ads està aprofitant el pressupost?" tone="soft" layout="split">
    <Fragment slot="intro">
      <p>Si ja inverteixes en Google Ads, el primer pas és veure on va cada euro. La revisió de compte recorre campanyes, cerques reals, conversions i pàgines de destinació. Al final reps un pla amb els canvis ordenats per estalvi i impacte.</p>
      <p>També serveix com a <strong>segona opinió independent</strong> si treballes amb una altra agència i no tens clar què estàs pagant.</p>
    </Fragment>
    <PBars
      slot="aside"
      title="On se sol perdre el pressupost"
      rows={[
        { label: 'Cerques sense relació amb el que vens', value: 34, display: 'Alt' },
        { label: 'Conversions que no mesuren negoci', value: 26, display: 'Alt' },
        { label: 'Landing genèrica o lenta', value: 20, display: 'Mitjà' },
        { label: 'Campanyes solapades', value: 12, display: 'Mitjà' },
        { label: 'Horaris i zones sense ajustar', value: 8, display: 'Baix' },
      ]}
      caption="Esquema il·lustratiu dels problemes que més revisem, ordenats pel pes que solen tenir. No són percentatges d'un compte real."
    />
    <PCards
      variant="rows"
      tone="soft"
      items={[
        { title: 'Inversió destinada a cerques poc rellevants', html: "L'informe de termes de cerca mostra què va escriure la gent abans de clicar el teu anunci. És habitual trobar-hi cerques de feina, cursos, productes que no vens o altres ciutats, com «feina de paleta a Sabadell» en una empresa de reformes. Cadascuna resta pressupost a les que porten clients. Ho corregim amb paraules clau més ben triades i negatives." },
        { title: 'Campanyes que competeixen entre elles', html: "Quan dues campanyes o grups d'anuncis pugen per la mateixa cerca, Google tria quin mostra i les dades es reparteixen. Acabes sense saber què funciona i de vegades pagues més pel clic. Reordenem l'estructura amb una regla: cada cerca important té una sola campanya responsable." },
        { title: 'Conversions mal configurades o incompletes', html: "Si el compte registra com a conversió una visita a la pàgina de contacte, un clic al telèfon o el mateix formulari dues vegades, les pujes automàtiques optimitzen cap a una cosa que no és negoci. Comprovem què es mesura, com es mesura i si les conversions del compte quadren amb els contactes que t'arriben de veritat." },
        { title: 'Pàgines de destinació que frenen els resultats', html: "Molts anuncis porten a la portada o a una pàgina que no parla del que s'ha buscat, triga a carregar al mòbil o amaga el formulari. El clic ja està pagat, però el contacte no arriba. Revisem cada pàgina que rep trànsit de pagament i et lliurem una llista de canvis, començant pels que més contactes poden recuperar." },
      ]}
    />
  </PSection>

  <!-- ═══ CERCA ══════════════════════════════════════════════════════════ -->
  <PSection kicker="Campanyes de cerca" title="Captar la demanda que ja existeix" layout="split">
    <Fragment slot="intro">
      <p>Les campanyes de cerca són la base de gairebé qualsevol compte de pime. El teu anunci apareix quan algú escriu a Google el que ofereixes, és a dir, quan la necessitat ja existeix. <strong>No cal convèncer ningú que et necessita</strong>, només que ets la millor opció.</p>
      <p>També són la via més ràpida mentre el SEO madura. En el <a href="/ca/casos-exit/villazon-merce-abogados/">cas de Villazón Mercé Abogados</a>, les campanyes de cerca van cobrir les consultes penals urgents des del llançament del seu web nou.</p>
    </Fragment>
    <PSerp
      slot="aside"
      query="reforma de bany a Sabadell preu"
      results={[
        { url: 'latevaempresa.cat › reforma-banys', title: 'Reforma de bany a Sabadell · Pressupost en 48 h', desc: 'Plat de dutxa, enrajolat i lampisteria. Preu tancat i visita sense compromís al Vallès.', highlight: true, label: 'Anunci' },
        { url: 'competidor-a.com', title: 'Reformes integrals | Demana pressupost', desc: 'Reformem tota la teva casa. Més de 20 anys d\'experiència.', label: 'Anunci' },
        { url: 'directori-reformes.cat › sabadell', title: 'Preus de reforma de bany a Sabadell', desc: 'Compara pressupostos de diverses empreses de la zona.' },
      ]}
      caption="Il·lustració. Compara els dos anuncis: el que anomena el servei, la zona i el termini respon millor a la cerca que un de genèric."
    />
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start">
      <PCards
        cols={2}
        variant="check"
        class="lg:grid-cols-1 !mt-12"
        items={[
          { title: 'Campanyes de cerca per servei', html: "Cada servei important va en la seva pròpia campanya o grup d'anuncis, amb pressupost, paraules clau i pàgina propis. En una empresa de reformes, els banys i les reformes integrals van per separat. Així decideixes quant invertir en cada línia i veus quin servei porta clients a millor cost, en lloc de barrejar-ho tot en una sola campanya." },
          { title: 'Separació entre cerques de marca i genèriques', html: "Qui busca el nom de la teva empresa ja et coneix; qui busca el servei, encara no. Si barreges les dues cerques, els resultats semblen millors del que són. Les separem per veure quant aporta de veritat la publicitat i per protegir la teva marca quan altres hi pugen, una cosa freqüent a les <a href=\"/ca/agencia-hotels/google-ads/\">campanyes per a hotels</a>, que competeixen amb les plataformes de reserves pel seu propi nom." },
          { title: "Paraules clau segons la intenció de l'usuari", html: "No és el mateix «quant costa reformar un bany» que «empresa reforma bany Sabadell». Prioritzem les cerques amb intenció de contractar i controlem els tipus de concordança per no pagar variacions sense sentit. Les cerques informatives solen rendir més amb contingut, així que les deixem per al <a href=\"/ca/agencia-seo-per-pimes/\">posicionament orgànic</a>." },
          { title: 'Termes negatius per filtrar trànsit', html: "Mantenim llistes de paraules negatives per campanya i per compte: feina, gratis, cursos, segona mà, ciutats on no treballes o serveis que no ofereixes. Les revisem de manera contínua amb els termes reals que han activat els teus anuncis, perquè cada setmana apareixen cerques noves." },
        ]}
      />
      <div class="mt-12">
        <PTree
          root="Compte d'una empresa de reformes"
          branches={[
            { label: 'Campanya · Reforma de banys', leaves: ['reforma bany complet', 'canviar banyera per plat'] },
            { label: 'Campanya · Reformes integrals', leaves: ['reforma integral pis', 'reforma habitatge preu'] },
            { label: 'Campanya · Marca', leaves: ["nom de l'empresa"] },
          ]}
          caption="Exemple d'estructura: cada servei té la seva campanya i les seves paraules clau, i la marca va en una campanya a part."
        />
      </div>
    </div>
  </PSection>

  <!-- ═══ ECOMMERCE ══════════════════════════════════════════════════════ -->
  <PSection kicker="Shopping i Performance Max" title="Publicitat per vendre productes en línia" tone="soft" layout="split">
    <Fragment slot="intro">
      <p>En una botiga en línia l'anunci ensenya el producte amb foto i preu abans del clic. Per això <strong>la qualitat del catàleg pesa tant com la campanya</strong>. Treballem totes dues coses alhora i mesurem ingressos i marge, no només comandes.</p>
      <p>Si la teva botiga també ven a través de xarxes socials, ho coordinem amb <a href="/ca/agencia-ecommerce/meta-ads/">Meta Ads per a botigues en línia</a>.</p>
    </Fragment>
    <PStack
      slot="aside"
      layers={[
        { label: 'Vendes amb marge', sub: 'ingressos mesurats per producte' },
        { label: 'Shopping i Performance Max', sub: 'campanyes segons objectiu' },
        { label: 'Merchant Center', sub: 'catàleg aprovat i sense errors' },
        { label: 'Dades de producte', sub: 'títols, preus, estoc, imatges' },
      ]}
      caption="Llegeix l'esquema de baix a dalt: cada capa depèn de l'anterior, i un catàleg amb errors limita qualsevol campanya."
    />
    <PCards
      tone="soft"
      cols={2}
      items={[
        { icon: ICON.doc, title: 'Preparació del catàleg a Merchant Center', html: "Revisem el feed de productes: títols amb les paraules que fa servir la gent, com «cotxet 3 peces» en lloc del codi del fabricant, categories correctes, preu i estoc sincronitzats, imatges vàlides i cap producte rebutjat. Google decideix en quines cerques mostra cada producte a partir d'aquestes dades, així que un bon catàleg és la meitat de la feina." },
        { icon: ICON.cart, title: 'Campanyes de Google Shopping', html: "Agrupem els productes per categoria, marge o rendiment per pujar més pels que compensen i menys pels que no. Revisem quines cerques activa cada producte i hi afegim negatives, igual que a les campanyes de text. A <a href=\"/ca/casos-exit/palacio-del-bebe/\">Palacio del Bebé</a>, Shopping es va centrar en els productes de més marge i va aportar vendes des del primer mes mentre creixia el SEO." },
        { icon: ICON.chart, title: 'Performance Max segons els objectius del negoci', html: "Performance Max reparteix la inversió de manera automàtica entre cerca, Shopping, YouTube i altres espais. Funciona quan rep bons senyals: conversions correctes, el valor de cada venda i un catàleg net. Sense aquests senyals pot gastar en trànsit de poca qualitat. La nostra regla: l'activem quan les dades del compte la justifiquen, no per defecte." },
        { icon: ICON.money, title: 'Decisions d\'inversió per producte i marge', html: "No tots els productes mereixen la mateixa inversió. Separem els que deixen més marge, els més venuts i els que només consumeixen pressupost, i fixem un objectiu de retorn diferent per a cada grup. Així el compte inverteix més on la teva botiga guanya diners i menys on només factura." },
      ]}
    />
  </PSection>

  <!-- ═══ AUDIÈNCIES ═════════════════════════════════════════════════════ -->
  <PSection kicker="YouTube, Display i remarketing" title="Arribar a noves audiències i recuperar-ne l'atenció" layout="split">
    <Fragment slot="intro">
      <p>La cerca capta qui ja et busca. Per arribar abans a qui encara no et coneix, o per recuperar qui va visitar la teva web i no va contactar, hi ha altres formats. <strong>Els activem només quan el pressupost i l'objectiu ho justifiquen</strong>; per a moltes pimes, n'hi ha prou amb una cerca ben treballada al principi.</p>
      <p>Si necessites generar demanda a les xarxes socials, també gestionem Meta Ads. Ho fem, per exemple, amb <a href="/ca/agencia-gimnasos/meta-ads/">campanyes a xarxes per a gimnasos</a>, <a href="/ca/agencia-restaurantes/meta-ads/">Meta Ads per a restaurants</a> i <a href="/ca/agencia-inmobiliarias/meta-ads/">Meta Ads per a immobiliàries</a>.</p>
    </Fragment>
    <PVenn
      slot="aside"
      sets={[
        { label: 'Cerca', sub: 'demanda que ja existeix' },
        { label: 'Shopping i PMax', sub: 'producte i catàleg' },
        { label: 'YouTube i Display', sub: 'descobriment' },
      ]}
      center="El teu client"
      caption="Cada cercle cobreix un moment diferent de la compra. Combinem només els que encaixen amb el teu objectiu i el teu pressupost."
    />
    <PCards
      cols={2}
      items={[
        { icon: ICON.video, title: 'YouTube per presentar la teva proposta', html: "Un vídeo curt explica en segons el que un anunci de text no explica: com treballes, com és el teu producte o què et diferencia. El mostrem a segments concrets, com visitants de la teva web o persones interessades en temes propers al teu servei. Després mesurem si pugen les cerques de la teva marca i els contactes." },
        { icon: ICON.eye, title: "Display dins d'una estratègia de cobertura", html: "Els anuncis gràfics en webs i aplicacions costen poc per impressió, però es malbaraten amb facilitat. Els fem servir amb audiències acotades i un objectiu de cobertura clar, com reforçar la teva marca en una comarca o en un sector concret. Mai substitueixen les campanyes que generen contactes." },
        { icon: ICON.repeat, title: 'Remarketing quan sigui viable i pertinent', html: "Tornar a mostrar anuncis a qui ja ha visitat la teva web funciona quan la decisió triga dies o setmanes, com en una reforma o un tractament dental. Necessita un volum mínim de visites i el consentiment de galetes ben configurat. Si la teva web encara no té aquest trànsit, t'ho diem i no l'activem." },
        { icon: ICON.shield, title: 'Control d\'ubicacions i qualitat del trànsit', html: "Revisem en quines webs, aplicacions i canals de YouTube apareixen els teus anuncis i excloem els que porten clics accidentals o sense interès, com jocs infantils o pàgines de baixa qualitat. Així el pressupost de cobertura arriba a persones que poden acabar sent clients." },
      ]}
    />
  </PSection>

  <!-- ═══ ANUNCIS ════════════════════════════════════════════════════════ -->
  <PSection kicker="Redacció d'anuncis" title="Anuncis que connecten amb el que busca el teu client" tone="dark">
    <Fragment slot="intro">
      <p>A la pàgina de resultats el teu anunci competeix amb tres o quatre més en un parell de línies. Guanya el que respon millor a la cerca i dona un motiu per triar-lo. Escrivim els anuncis a partir dels dubtes reals dels teus clients, sense frases fetes del sector.</p>
    </Fragment>
    <PCards
      tone="dark"
      cols={2}
      variant="numbered"
      items={[
        { title: 'Missatges segons servei i necessitat', html: "Cada grup d'anuncis repeteix el que la persona ha buscat i respon al que la preocupa: urgència, preu, zona o especialitat. Un anunci per a «advocat d'herències» no pot ser el mateix que per a «advocat laboral». En salut, com a les <a href=\"/ca/agencia-psicolegs/google-ads/\">campanyes per a psicòlegs</a> o la <a href=\"/ca/agencia-terapeutes/google-ads/\">publicitat per a terapeutes</a>, el to pesa tant com l'oferta." },
        { title: 'Propostes de valor que es poden acreditar', html: "«Líders del sector» o «la millor qualitat» no convencen ningú. Fem servir arguments que pots demostrar: anys d'experiència, termini de resposta, garantia, preu tancat o valoracions de clients. Si l'anunci promet alguna cosa, la pàgina de destinació l'ha de confirmar. Si no pot, la traiem de l'anunci." },
        { title: "Recursos d'anunci útils per decidir", html: "Enllaços a serveis concrets, textos destacats, extractes de serveis, trucada, ubicació o formulari. Els recursos amplien l'anunci i donen informació abans del clic, cosa que filtra qui no encaixa. Per exemple, un text destacat amb «visita sense compromís al Vallès» evita clics de fora de la teva zona. Activem només els útils i els mantenim al dia." },
        { title: "Proves de missatges i crides a l'acció", html: "Provem variants de titulars i crides a l'acció, com «demana pressupost» davant de «consulta preus», i ens quedem amb les que porten més contactes de qualitat, no només més clics. Canviem un element cada vegada per saber què ha funcionat i aplicar-ho a la resta del compte." },
      ]}
    />
  </PSection>

  <!-- ═══ LANDING ════════════════════════════════════════════════════════ -->
  <PSection kicker="Pàgina de destinació" title="Del clic al contacte: la pàgina de destinació" layout="split">
    <Fragment slot="intro">
      <p>L'anunci porta la visita; la pàgina decideix si es converteix en contacte. Si la pàgina converteix millor, cada client et costa menys sense pujar el pressupost. Per això la revisem amb la mateixa atenció que les campanyes.</p>
      <p>Si la web necessita canvis de fons, ho coordinem amb el nostre servei de <a href="/ca/disseny-web-per-pimes/">disseny web per a pimes</a>. Per fer-ne una primera revisió pel teu compte, comença per aquesta <a href="/ca/blog/com-saber-si-la-teva-web-esta-ben-feta/">guia per revisar la teva web</a>.</p>
    </Fragment>
    <PFlow
      slot="aside"
      steps={[
        { label: 'Cerca', sub: '«dentista urgències Terrassa»' },
        { label: 'Anunci', sub: 'urgències avui a Terrassa' },
        { label: 'Pàgina', sub: 'urgències, horari, telèfon' },
        { label: 'Trucada', sub: 'cita el mateix dia' },
      ]}
      caption="Exemple de coherència: segueix la paraula «urgències» des de la cerca fins a la trucada."
    />
    <PCards
      cols={2}
      items={[
        { icon: ICON.target, title: 'Coherència entre cerca, anunci i pàgina', html: "Si algú busca un servei concret i arriba a la portada, ha de tornar a buscar. La pàgina ha de parlar del que prometia l'anunci, amb les mateixes paraules i la mateixa oferta. Aquesta coherència també millora el nivell de qualitat que Google assigna als teus anuncis i, amb ell, abarateix el clic." },
        { icon: ICON.doc, title: 'Formularis i vies de contacte senzilles', html: "Demanem només les dades necessàries per respondre, normalment nom, telèfon i què necessites. Deixem el telèfon i el botó de contacte a la vista al mòbil i oferim WhatsApp si el teu equip el pot atendre. Cada camp de més és un motiu per abandonar, sobretot des del mòbil." },
        { icon: ICON.shield, title: 'Proves de confiança a prop de la decisió', html: "Ressenyes, casos, anys d'experiència, certificacions i fotos reals de l'equip o de la feina. Les col·loquem al costat del formulari o del botó de trucada, que és on apareix el dubte. Qui no et coneix necessita motius per donar-te el seu telèfon, i una ressenya amb nom convenç més que un eslògan." },
        { icon: ICON.chart, title: 'Millores de conversió basades en el comportament', html: "Analitzem fins on baixa la gent, en quin camp abandona el formulari i com canvia el comportament entre mòbil i ordinador. Amb aquestes dades proposem canvis concrets i en mesurem l'efecte sobre els contactes. Si un canvi no millora els resultats, el retirem." },
      ]}
    />
  </PSection>

  <!-- ═══ MESURA ═════════════════════════════════════════════════════════ -->
  <PSection kicker="Mesura" title="Mesura per saber quines campanyes aporten negoci" tone="soft">
    <Fragment slot="intro">
      <p>Les pujes automàtiques de Google aprenen del que els dius que és una conversió. Si els dones dades pobres, busquen contactes pobres. <strong>Mesurar bé és la condició perquè tota la resta funcioni.</strong> Si no saps d'on arriben avui les teves visites, comença per <a href="/ca/blog/don-ve-el-trafic-web/">d'on ve el trànsit de la teva web</a>.</p>
    </Fragment>
    <div class="grid lg:grid-cols-[1.1fr_1fr] gap-10 items-start">
      <PCards
        tone="soft"
        variant="rows"
        class="!mt-12"
        items={[
          { title: 'Configuració de conversions rellevants', html: "Definim què compta com a conversió: formulari enviat, trucada de més d'una certa durada, compra amb el seu import o reserva. Ho configurem amb Google Tag Manager i GA4, eliminem duplicats i comprovem que cada acció es registra una sola vegada i a la campanya correcta. Reps la llista de conversions actives i què mesura cadascuna." },
          { title: 'Diferència entre contactes i oportunitats qualificades', html: "No tots els contactes valen el mateix. Un formulari d'algú de fora de la teva zona, o que demana una cosa que no fas, compta igual que un de bo si no els distingim. Et demanem una valoració senzilla dels contactes rebuts, per exemple útil o no útil, per saber quines campanyes porten els bons." },
          { title: 'Connexió amb els resultats comercials quan sigui possible', html: "Si fas servir un CRM o pots marcar quins contactes es converteixen en clients, importem aquesta informació a Google Ads. Així les pujes s'orienten a vendes reals i no a formularis. Si encara no en tens, compara <a href=\"/ca/blog/els-7-millors-crm-per-la-teva-pime/\">els 7 millors CRM per a una pime</a>; mentrestant, busquem una alternativa manual que doni una referència fiable." },
          { title: "Revisió de l'atribució i de la qualitat de les dades", html: "Comparem el que diu Google Ads amb GA4 i amb el que rep la teva empresa. Les diferències són normals, però s'han de poder explicar. Revisem el consentiment de galetes, el model d'atribució i les conversions de marca per no atribuir a la publicitat el que hauria arribat igualment. Si, a més, t'interessa com et citen els assistents d'IA, ho treballem com a <a href=\"/ca/agencia-geo-per-pimes/\">agència GEO per a pimes</a>." },
        ]}
      />
      <div class="mt-12">
        <PFunnel
          stages={[
            { label: 'Clics', sub: 'visites des dels anuncis', side: 'El que mesura la plataforma.' },
            { label: 'Contactes', sub: 'formularis i trucades', side: 'El que sol mesurar un compte.' },
            { label: 'Oportunitats', sub: 'contactes que encaixen', side: 'El que valora el teu equip.' },
            { label: 'Clients', sub: 'vendes tancades', side: 'El que paga la inversió.' },
          ]}
          caption="Esquema il·lustratiu. Com més avall de l'embut arriba la mesura, millors decisions prenen les campanyes."
        />
      </div>
    </div>
  </PSection>

  <!-- ═══ ESCALAR ════════════════════════════════════════════════════════ -->
  <PSection kicker="Optimització" title="Com decidim on invertir-hi més" layout="split">
    <Fragment slot="intro">
      <p>Optimitzar no consisteix a canviar coses cada dia. Consisteix a llegir les dades amb perspectiva i moure el pressupost cap al que funciona. Per a cada campanya creuem dues preguntes: <strong>és rendible?</strong> i <strong>té recorregut per créixer?</strong></p>
    </Fragment>
    <PMatrix
      slot="aside"
      xLabel="Volum disponible"
      yLabel="Rendibilitat"
      quadrants={['Mantenir i vigilar', 'Ampliar la inversió', 'Revisar o pausar', 'Millorar abans de créixer']}
      points={[
        { label: 'Servei de nínxol', x: 22, y: 80 },
        { label: 'Servei principal', x: 74, y: 78 },
        { label: 'Cerca genèrica', x: 76, y: 28 },
        { label: 'Zona secundària', x: 22, y: 22 },
      ]}
      caption="Exemple de classificació: a dalt a la dreta, el que mereix més inversió; a baix a l'esquerra, el que cal revisar o pausar."
    />
    <PCards
      cols={3}
      variant="numbered"
      items={[
        { title: 'Ajustos de pujes segons els resultats', html: "Triem l'estratègia de puja segons les dades disponibles: més control al principi i objectius de cost o de retorn quan hi ha prou volum. També ajustem per dispositiu, horari i zona quan les dades mostren diferències clares, per exemple si el mòbil porta contactes més barats que l'ordinador. Mai per suposicions." },
        { title: 'Redistribució del pressupost entre campanyes', html: "Cada mes revisem quines campanyes aconsegueixen clients a un cost acceptable i quines no. Movem pressupost de les segones a les primeres abans de demanar-te més inversió. Sovint hi ha marge de millora sense augmentar la despesa total, i ho veuràs reflectit a l'informe mensual." },
        { title: 'Condicions per ampliar la inversió', html: "Proposem invertir-hi més només si es compleixen tres condicions: el cost per client és dins del teu límit, la campanya es queda sense pressupost en cerques bones i el teu equip pot atendre més contactes. Si en falta alguna, primer la resolem. Més pressupost sobre una base fluixa només multiplica la despesa." },
      ]}
    />
  </PSection>

  <!-- ═══ ARRENCADA ══════════════════════════════════════════════════════ -->
  <PSection kicker="Primeres setmanes" title="Què passa durant l'arrencada de les teves campanyes" tone="soft">
    <Fragment slot="intro">
      <p>Les primeres setmanes d'un compte nou o reestructurat són d'aprenentatge. El cost per contacte pot moure's més del normal i convé no treure'n conclusions massa aviat. T'expliquem en cada fase què és esperable i què no.</p>
    </Fragment>
    <div class="grid lg:grid-cols-[1fr_1.1fr] gap-10 items-start">
      <PCards
        tone="soft"
        variant="numbered"
        class="lg:grid-cols-1"
