---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildAlternates } from '../../lib/i18n';
import { localAgencySchema } from '../../lib/schema';
import LogoMarquee from '../../components/sections/LogoMarquee.astro';
import FaqHome from '../../components/sections/FaqHome.astro';
import CityPills from '../../components/global/CityPills.astro';
import MoreCases from '../../components/casos/MoreCases.astro';
import PSection from '../../components/pillar/PSection.astro';
import PCards from '../../components/pillar/PCards.astro';
import PFlow from '../../components/pillar/PFlow.astro';
import PBars from '../../components/pillar/PBars.astro';
import PMatrix from '../../components/pillar/PMatrix.astro';
import PStack from '../../components/pillar/PStack.astro';
import PFunnel from '../../components/pillar/PFunnel.astro';
import PTree from '../../components/pillar/PTree.astro';
import PLines from '../../components/pillar/PLines.astro';
import PCounter from '../../components/pillar/PCounter.astro';
import PVenn from '../../components/pillar/PVenn.astro';
import GeoChat from '../../components/pillar/GeoChat.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://novamarketing.es';
const alternates = buildAlternates('/agencia-geo-para-pymes/', '/ca/agencia-geo-per-pimes/', SITE_URL);

const ICON = {
  search: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  target: 'M12 3a9 9 0 100 18 9 9 0 000-18zm0 5a4 4 0 100 8 4 4 0 000-8z',
  doc: 'M9 12h6m-6 4h6M9 8h2m8-3v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2h6l4 4z',
  link: 'M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5m7.328-1.672a4 4 0 000-5.656 4 4 0 00-5.656 0l-1.5 1.5',
  chart: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm8 0V5a2 2 0 012-2h0a2 2 0 012 2v14a2 2 0 01-2 2h0a2 2 0 01-2-2zm-8 0a2 2 0 002 2h2a2 2 0 002-2V9a2 2 0 00-2-2h-2a2 2 0 00-2 2v10z',
  money: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  users: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  pin: 'M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z',
  star: 'M12 3l2.6 5.3 5.9.9-4.2 4.1 1 5.8L12 16.3 6.7 19l1-5.8L3.5 9.2l5.9-.9L12 3z',
  alert: 'M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z',
};

const faqs = [
  { question: "Es pot garantir una aparició a ChatGPT?", answer: "No. Ningú controla el que respon un model de llenguatge, i les respostes canvien segons la pregunta, el moment i l'assistent. El que sí que podem assegurar és el mètode. Revisar què es diu avui de la teva empresa, corregir la informació que falla, millorar les pàgines i fonts que consulten els assistents i mesurar amb la mateixa mostra de preguntes si la teva presència millora. Desconfia de qui et prometi sortir sempre." },
  { question: "Necessito treballar el SEO per contractar GEO?", answer: "No és obligatori, però ajuda molt. Els cercadors amb IA i molts assistents es recolzen en pàgines que ja estan indexades, ben posicionades i citades per altres webs. Si la teva web té problemes de rastreig o continguts pobres, el GEO tindrà menys amb què treballar. A l'auditoria et diem si cal reforçar abans el posicionament orgànic o si podem començar directament per les respostes generades." },
  { question: "En quins assistents i cercadors té sentit centrar-se?", answer: "Normalment revisem ChatGPT, Gemini, Claude, Perplexity, Copilot i les respostes generades de Google, perquè són els que més fan servir avui els clients d'una pime a Espanya. La prioritat depèn del teu públic. Un comprador industrial no fa servir les mateixes eines que un pacient que busca dentista. Triem els assistents de la mostra amb tu i els mantenim estables per poder comparar." },
  { question: "Quan convé repetir les mesures?", answer: "Solem repetir la mostra completa cada mes en els plans de seguiment, i una revisió puntual després de canvis importants a la web o a fonts externes. Repetir-ho més sovint no aporta gaire, perquè les variacions del dia a dia es poden confondre amb avenços. El que és útil és comparar rondes fetes amb les mateixes preguntes, els mateixos assistents i condicions semblants." },
  { question: "Com es distingeix una menció d'una visita o una venda?", answer: "Una menció és que l'assistent anomeni la teva empresa a la seva resposta. Una visita arriba quan l'usuari clica una cita o busca la teva marca després, i una venda quan aquest contacte es converteix en client. Mesurem les tres coses per separat. Les mencions, a la mostra de consultes; les visites, a l'analítica de la teva web; i els contactes, preguntant l'origen als formularis i les trucades." },
  { question: "Què ha d'aportar la meva empresa al projecte?", answer: "Una persona que conegui bé el negoci, els serveis que vols potenciar i el tipus de client que t'interessa. També accessos a la web, a Google Search Console, a l'analítica i al Perfil d'Empresa a Google. Més endavant et demanarem dades, casos i opinions dels teus professionals, perquè el contingut amb experiència pròpia és el que més fàcilment es converteix en font." },
];

const pageSchema = localAgencySchema({
  pageUrl: `${SITE_URL}/ca/agencia-geo-per-pimes/`,
  lang: 'ca',
  cityName: 'Barcelona',
  postalCode: '08035',
  geo: { lat: 41.4114, lng: 2.1526 },
  areaServed: ["España", "Barcelona", "Sabadell", "Sant Cugat del Vallès", "Terrassa", "Vallès Occidental"],
  title: "▷ Posicionament en IA GEO per a Pimes | Estratègia personalitzada",
  description: "Servei de posicionament GEO (Generative Engine Optimization) per a pimes, amb recomanacions de ChatGPT, Gemini i Google AI 💡 Coneix la metodologia i resultats.",
  datePublished: '2026-07-15',
  dateModified: '2026-10-25',
  streetAddress: 'Carrer del General Mendoza, 10',
  hasMap: 'https://maps.app.goo.gl/9fbB12UcK32bgjj89',
  aggregateRating: { ratingValue: '5.0', reviewCount: '12' },
  breadcrumbName: 'Agència GEO per a pimes',
  mainService: {
    name: 'Posicionament GEO per a pimes',
    serviceType: 'GEO / AEO',
    description: 'Diagnòstic i millora de la presència de la teva marca a les respostes de ChatGPT, Gemini, Perplexity i Google, amb mesures periòdiques.',
    offers: [
      { name: 'Diagnòstic inicial de visibilitat en IA', price: 1800 },
      { name: 'Optimització de marca i continguts per a IA', price: 400, from: true, monthly: true },
      { name: 'Seguiment GEO per a projectes de més abast', price: 900, from: true, monthly: true },
    ],
  },
  faqs,
});
---

<BaseLayout
  title="▷ Posicionament en IA GEO per a Pimes | Estratègia personalitzada"
  description="Servei de posicionament GEO (Generative Engine Optimization) per a pimes, amb recomanacions de ChatGPT, Gemini i Google AI 💡 Coneix la metodologia i resultats."
  locale="ca"
  alternates={alternates}
  schemas={[pageSchema]}
>

  <!-- ═══ HERO / H1 ═══════════════════════════════════════════════════════ -->
  <section class="pt-24 sm:pt-40 pb-20 px-4 sm:px-6 relative overflow-hidden text-center bg-white border-b border-black/5">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_40%,#000_75%,transparent_100%)]"></div>
    <div class="absolute -top-10 left-1/4 w-72 h-72 bg-accent/15 rounded-full blur-3xl opacity-30 animate-pulse"></div>
    <div class="absolute top-20 right-1/4 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl opacity-20"></div>

    <div class="max-w-5xl mx-auto reveal relative">
      <span class="inline-flex items-center gap-2 bg-accent/5 backdrop-blur-sm px-4 py-2 border border-accent/10 rounded-full text-accent text-[8px] sm:text-[10px] font-black uppercase tracking-[0.3em] mb-8 shadow-sm">
        <span class="w-1.5 h-1.5 bg-accent rounded-full animate-ping"></span>
        Optimització per a motors generatius
      </span>
      <h1 class="text-3xl sm:text-5xl md:text-7xl lg:text-8xl uppercase font-extrabold tracking-tighter leading-[0.88] mb-8 text-gradient flex flex-col items-center text-center">
                <span class="lg:whitespace-nowrap">Agència GEO </span>
                <span class="lg:whitespace-nowrap">Posicionament </span>
                <span class="lg:whitespace-nowrap text-mktg-gradient">en IA</span>
            </h1>
      <p class="text-lg sm:text-xl text-zinc-500 font-light leading-relaxed max-w-3xl mx-auto mb-8">
        Revisem què responen ChatGPT, Gemini, Claude, Perplexity i Google quan els teus clients pregunten pel que vens, i treballem la informació i les fonts que fan que la teva empresa hi aparegui ben descrita.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 mb-10">
        {['Sense permanències', 'Tracte directe amb el consultor', 'Mesures documentades'].map((item) => (
          <span class="inline-flex items-center gap-2 text-[11px] sm:text-xs font-black uppercase tracking-widest text-zinc-700">
            <svg class="w-4 h-4 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            {item}
          </span>
        ))}
      </div>
      <a href="#contacto" class="contact-modal-trigger btn-mktg-v5 shadow-[0_10px_30px_rgba(0,0,0,0.1)] !py-4 sm:!py-5 !px-6 sm:!px-10 !text-[11px] !tracking-widest font-black">REVISAR LA MEVA PRESÈNCIA EN IA</a>
    </div>
  </section>

  <LogoMarquee />

  <!-- ═══ QUÈ TROBA EL CLIENT ═══════════════════════════════════════════ -->
  <PSection kicker="Per què GEO" title="Què troba un client quan pregunta per la teva empresa a una IA?" layout="split">
    <Fragment slot="intro">
      <p>Cada vegada més clients comencen la seva cerca amb una pregunta a un assistent. «Quina empresa em recomanes per…?», «Aquest proveïdor és de fiar?», «Quina diferència hi ha entre aquestes dues opcions?». <strong>La resposta arriba redactada, amb una llista curta de noms i algunes fonts</strong>, i sovint l'usuari no va més enllà.</p>
      <p>Si la teva empresa no hi surt, hi surt mal descrita o es confon amb una altra, perds l'oportunitat abans que el client visiti la teva web. El GEO, l'optimització per a motors generatius, consisteix a revisar aquestes respostes i treballar la informació de la qual depenen.</p>
      <p>A Nova ho fem com a part d'una <a href="/ca/">agència de màrqueting digital per a pimes</a>, connectat amb el teu <a href="/ca/agencia-seo-per-pimes/">posicionament a Google</a>, perquè els assistents beuen en bona part del que ja és visible al cercador.</p>
    </Fragment>
    <GeoChat
      slot="aside"
      locale="ca"
      question="Quina empresa de manteniment industrial em recomanes al Vallès?"
      intro="Aquestes són algunes opcions amb bona reputació a la zona:"
      items={[
        { name: 'Competidor A', desc: 'Manteniment preventiu per a naus i maquinària. Moltes opinions positives.' },
        { name: 'La teva empresa', desc: "Especialitzada en línies de producció, amb servei d'urgències 24 h.", highlight: true, label: 'Objectiu' },
        { name: 'Competidor B', desc: 'Empresa amb més de 30 anys, tot i que la seva web no detalla els serveis.' },
      ]}
      sources={['web del proveïdor', 'directori sectorial', 'ressenyes a Google']}
      caption="Il·lustració d'una resposta generada. L'objectiu és que la teva empresa hi aparegui i ho faci amb dades correctes."
    />
  </PSection>

  <!-- ═══ COM INFLUEIXEN LES RESPOSTES ══════════════════════════════════ -->
  <PSection kicker="Decisió de compra" title="Com intervenen les respostes generades en l'elecció d'una marca" tone="soft">
    <Fragment slot="intro">
      <p>Un assistent no substitueix tot el procés de compra, però sí que filtra. Redueix el mercat a tres o quatre noms, en resumeix les diferències i proposa criteris. L'empresa que no entra en aquesta llista curta s'ha d'esforçar molt més perquè el client la tingui en compte.</p>
      <p>Aquestes són les cinc situacions en què la resposta generada pesa més. Cadascuna demana una feina diferent.</p>
    </Fragment>
    <PFunnel
      stages={[
        { label: "Pregunta a l'assistent", sub: '«quina gestoria treballa amb autònoms a Terrassa»', side: 'El client encara no coneix marques.' },
        { label: 'Llista curta a la resposta', sub: 'tres o quatre empreses amb un resum', side: 'Aquí es guanya o es perd la consideració.' },
        { label: 'Comprovació a la web', sub: 'serveis, preus, opinions', side: 'La teva web confirma o contradiu el que ha llegit.' },
        { label: 'Contacte', sub: 'trucada, formulari, visita', side: 'Només hi arriben els qui han passat els filtres.' },
      ]}
      caption="Esquema il·lustratiu del recorregut. L'assistent actua com a primer filtre, no com a últim pas."
    />
    <PCards
      tone="soft"
      items={[
        { icon: ICON.search, title: 'Preguntes per descobrir proveïdors', html: "El client no sap a qui trucar i demana noms. És la consulta més directa i també la més disputada, perquè l'assistent sol mencionar poques empreses. Per entrar-hi cal que la teva activitat, la teva especialitat i la teva zona estiguin descrites amb claredat a la teva web i en fonts que el model pugui contrastar." },
        { icon: ICON.chart, title: 'Comparacions entre empreses i solucions', html: "Preguntes del tipus «X o Y, quina és millor per al meu cas?». L'assistent compara amb el que troba publicat. Si els teus avantatges no estan explicats enlloc, la comparació es farà amb les dades de la teva competència o amb informació antiga." },
        { icon: ICON.alert, title: 'Consultes sobre problemes concrets', html: `Moltes compres comencen amb un problema, no amb un servei. «La meva web no rep visites», «la màquina perd pressió». Les pàgines que expliquen causes i solucions amb detall són les que l'assistent cita. Entendre la <a href="/ca/blog/que-es-la-intencio-de-cerca-en-el-seo/">intenció que hi ha darrere de cada cerca</a> ajuda a cobrir-les.` },
        { icon: ICON.star, title: 'Cerques de referències i confiança', html: "«Aquesta empresa és de fiar?», «què en pensen els seus clients?». L'assistent recull ressenyes, mencions a la premsa i casos publicats. Una pime amb bones feines però sense cap rastre públic d'aquestes sembla, per al model, una empresa sense experiència demostrable." },
        { icon: ICON.pin, title: 'Preguntes sobre serveis en una ubicació', html: "Consultes amb ciutat o comarca, molt freqüents en serveis locals. Aquí compten el Perfil d'Empresa a Google, la coherència d'adreça i telèfon i les pàgines que expliquen quines zones atens realment. Una dada diferent a cada lloc fa dubtar l'assistent." },
      ]}
    />
  </PSection>

  <!-- ═══ MOSTRA DE VISIBILITAT ═════════════════════════════════════════ -->
  <PSection id="diagnostico" kicker="Diagnòstic" title="El punt de partida: una mostra de la teva visibilitat actual" layout="split">
    <Fragment slot="intro">
      <p>Abans de canviar res, mesurem. Preparem una mostra de preguntes reals dels teus clients, la llancem en diversos assistents i registrem cada resposta. <strong>No és un informe automàtic d'una eina</strong>, sinó una anàlisi revisada a mà que explica què es diu de la teva empresa i per què.</p>
      <p>Aquesta mostra és la referència amb què compararem cada revisió posterior. Per això la documentem amb tanta cura.</p>
    </Fragment>
    <PBars
      slot="aside"
      title="Mencions en una mostra de 40 consultes"
      max={40}
      rows={[
        { label: 'Competidor A', value: 22, display: '22 de 40' },
        { label: 'Competidor B', value: 15, display: '15 de 40' },
        { label: 'La teva empresa', value: 6, display: '6 de 40', note: 'dues amb dades desactualitzades' },
        { label: 'Competidor C', value: 4, display: '4 de 40' },
      ]}
      caption="Esquema il·lustratiu, no són dades d'un client. Així resumim la presència de cada marca a la mostra inicial."
    />
    <PCards
      variant="rows"
      items={[
        { title: 'Consultes representatives dels teus clients', html: "Definim amb tu entre 30 i 60 preguntes que faria un client real. Preguntes per trobar proveïdor, comparatives, dubtes sobre problemes i cerques amb ubicació. Partim dels teus serveis prioritaris, del que et pregunten a les reunions comercials i de les dades de cerca de la teva web." },
        { title: 'Models i cercadors inclosos a la revisió', html: `Normalment ChatGPT, Gemini, Claude, Perplexity, Copilot i les respostes generades de Google. Ajustem la llista al que fa servir el teu públic i la mantenim fixa per poder comparar. Per a la resta de la mesura fem servir les mateixes <a href="/ca/blog/millors-eines-seo-per-a-pimes/">eines SEO que recomanem a les pimes</a>.` },
        { title: 'Mencions de la teva marca i dels teus competidors', html: "A cada resposta anotem si hi apareixes, en quin lloc de la llista, amb quina descripció i quins competidors s'hi anomenen. Així veiem amb quines empreses et compara l'assistent, que no sempre coincideixen amb les que tu consideres competència." },
        { title: 'Fonts citades a les respostes', html: "Quan l'assistent enllaça fonts, les registrem. Webs de competidors, directoris, mitjans, fòrums, plataformes d'opinions. Aquesta llista indica on convé ser present i quines pàgines de la teva web ja s'estan fent servir com a referència." },
        { title: 'Registre de dates i condicions de cada prova', html: "Desem la data, l'assistent, el mode d'ús i si la consulta es va fer amb la cerca web activada o sense, juntament amb una captura de la resposta. Les respostes canvien amb el temps, i sense aquest registre no es pot saber si una millora és real o casual." },
      ]}
    />
  </PSection>

  <!-- ═══ QUÈ DIUEN ELS ASSISTENTS ══════════════════════════════════════ -->
  <PSection kicker="Percepció de marca" title="Què diuen els assistents sobre el teu negoci" tone="soft" layout="split">
    <Fragment slot="intro">
      <p>Aparèixer només és la meitat. L'altra meitat és com et descriuen. Un assistent pot anomenar la teva empresa i atribuir-li un servei que ja no ofereixes, una adreça antiga o una especialitat que no és la teva.</p>
      <p>Per això analitzem el contingut de cada resposta, no només si hi surts o no.</p>
    </Fragment>
    <PTree
      slot="aside"
      root="La teva empresa"
      branches={[
        { label: 'Serveis', leaves: ['els que vens', "els que t'atribueixen"] },
        { label: 'Persones', leaves: ['fundadors', 'experts que signen'] },
        { label: 'Sector i zona', leaves: ['categoria', 'àmbit geogràfic'] },
      ]}
      caption="Les relacions que revisem a cada resposta."
    />
    <PCards
      tone="soft"
      cols={2}
      items={[
        { icon: ICON.doc, title: 'Serveis que associen amb la teva marca', html: "Comparem els serveis que mencionen els assistents amb els que realment vols vendre. És habitual que una pime sigui coneguda per una línia de negoci antiga i que la nova, la més rendible, no aparegui en cap resposta." },
        { icon: ICON.alert, title: 'Dades incompletes o contradictòries', html: "Horaris diferents, adreces d'una seu anterior, preus de fa anys o un nom comercial que es confon amb una altra empresa. Localitzem d'on surt cada error, perquè l'assistent no se l'inventa sense més ni més, normalment el pren d'alguna font." },
        { icon: ICON.star, title: "Atributs que et diferencien d'altres empreses", html: "Rapidesa, especialització, garantia, tracte proper. Revisem si els assistents recullen les raons per les quals els teus clients et trien o si et descriuen amb frases genèriques que valdrien per a qualsevol empresa del teu sector." },
        { icon: ICON.users, title: 'Relació entre la teva marca, els teus experts i el teu sector', html: "Comprovem si els models connecten la teva empresa amb les persones que la dirigeixen i amb la categoria correcta. En serveis professionals, que l'assistent sàpiga qui és el teu advocat o la teva doctora i quina experiència té pesa tant com el nom de l'empresa." },
      ]}
    />
  </PSection>

  <!-- ═══ IDENTITAT ═════════════════════════════════════════════════════ -->
  <PSection kicker="Identitat de marca" title="Una identitat d'empresa comprensible a tota la web" layout="split">
    <Fragment slot="intro">
      <p>Els models construeixen una idea de la teva empresa ajuntant peces de molts llocs. Si cada peça diu una cosa diferent, la idea que en resulta és borrosa. La primera feina és que la teva web i els teus perfils expliquin la mateixa història, amb les mateixes paraules.</p>
      <p>És una base sobre la qual es recolza tota la resta, com mostra l'esquema.</p>
    </Fragment>
    <PStack
      slot="aside"
      layers={[
        { label: 'Fonts externes', sub: 'mitjans, directoris, opinions' },
        { label: 'Web tècnica i estructurada', sub: 'accés, marcatge, enllaços' },
        { label: 'Contingut que serveix de font', sub: 'respostes i evidències' },
        { label: 'Identitat clara', sub: 'qui ets, què fas, on' },
      ]}
      caption="Esquema de treball. Cada capa es recolza en l'anterior."
    />
    <PCards
      cols={2}
      items={[
        { icon: ICON.target, title: 'Informació corporativa clara i coherent', html: "Nom comercial, raó social, adreça, telèfon, any de fundació i àmbit de treball, iguals a la web, l'avís legal, el Perfil d'Empresa i els directoris. Sembla bàsic, però gairebé en totes les auditories trobem com a mínim una versió diferent d'alguna d'aquestes dades." },
        { icon: ICON.doc, title: 'Serveis i especialitats ben definits', html: "Una pàgina per cada servei important, amb un nom que el client entén, per a qui és, què inclou i què no. Les descripcions vagues com «solucions integrals» no donen a l'assistent res concret que pugui repetir quan algú pregunta per aquest servei." },
        { icon: ICON.users, title: 'Autors i professionals identificables', html: "Pàgines d'equip amb nom, càrrec, formació i experiència real, i articles signats per qui coneix el tema. Els assistents valoren saber qui avala una afirmació, i al teu client li passa el mateix abans de confiar en una empresa que no coneix." },
        { icon: ICON.link, title: 'Perfils externs alineats amb la teva activitat', html: `LinkedIn, Perfil d'Empresa a Google, associacions i plataformes del sector amb la mateixa descripció i enllaçant a la teva web. Si una altra persona gestiona la teva fitxa de Google, t'expliquem com <a href="/ca/blog/donar-acces-al-teu-perfil-dempresa-a-google/">donar-li accés al teu Perfil d'Empresa</a> sense compartir contrasenyes.` },
      ]}
