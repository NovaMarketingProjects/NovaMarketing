---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildAlternates } from '../../lib/i18n';
import { localAgencySchema } from '../../lib/schema';
import LogoMarquee from '../../components/sections/LogoMarquee.astro';
import FaqHome from '../../components/sections/FaqHome.astro';
import CityPills from '../../components/global/CityPills.astro';
import MoreCases from '../../components/casos/MoreCases.astro';
import PSection from '../../components/pillar/PSection.astro';
import PCards from '../../components/pillar/PCards.astro';
import PFlow from '../../components/pillar/PFlow.astro';
import PBars from '../../components/pillar/PBars.astro';
import PMatrix from '../../components/pillar/PMatrix.astro';
import PStack from '../../components/pillar/PStack.astro';
import PFunnel from '../../components/pillar/PFunnel.astro';
import PTree from '../../components/pillar/PTree.astro';
import PLines from '../../components/pillar/PLines.astro';
import PCounter from '../../components/pillar/PCounter.astro';
import PVenn from '../../components/pillar/PVenn.astro';
import GeoChat from '../../components/pillar/GeoChat.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://novamarketing.es';
const alternates = buildAlternates('/agencia-geo-para-pymes/', '/ca/agencia-geo-per-pimes/', SITE_URL);

const ICON = {
  search: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  target: 'M12 3a9 9 0 100 18 9 9 0 000-18zm0 5a4 4 0 100 8 4 4 0 000-8z',
  doc: 'M9 12h6m-6 4h6M9 8h2m8-3v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2h6l4 4z',
  link: 'M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5m7.328-1.672a4 4 0 000-5.656 4 4 0 00-5.656 0l-1.5 1.5',
  chart: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm8 0V5a2 2 0 012-2h0a2 2 0 012 2v14a2 2 0 01-2 2h0a2 2 0 01-2-2zm-8 0a2 2 0 002 2h2a2 2 0 002-2V9a2 2 0 00-2-2h-2a2 2 0 00-2 2v10z',
  money: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  users: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  pin: 'M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z',
  star: 'M12 3l2.6 5.3 5.9.9-4.2 4.1 1 5.8L12 16.3 6.7 19l1-5.8L3.5 9.2l5.9-.9L12 3z',
  alert: 'M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z',
};

const faqs = [
  { question: "Es pot garantir una aparició a ChatGPT?", answer: "No. Ningú controla el que respon un model de llenguatge, i les respostes canvien segons la pregunta, el moment i l'assistent. El que sí que podem assegurar és el mètode: revisar què es diu avui de la teva empresa, corregir la informació que falla, millorar les pàgines i fonts que consulten els assistents i mesurar amb la mateixa mostra de preguntes si la teva presència millora. Desconfia de qui et prometi sortir sempre." },
  { question: "Necessito treballar el SEO per contractar GEO?", answer: "No és obligatori, però ajuda molt. Els cercadors amb IA i molts assistents es recolzen en pàgines que ja estan indexades, ben posicionades i citades per altres webs. Si la teva web té problemes de rastreig o continguts pobres, el GEO tindrà menys amb què treballar. A l'auditoria et diem si cal reforçar abans el posicionament orgànic o si podem començar directament per les respostes generades." },
  { question: "En quins assistents i cercadors té sentit centrar-se?", answer: "Normalment revisem ChatGPT, Gemini, Claude, Perplexity, Copilot i les respostes generades de Google, perquè són els que més fan servir avui els clients d'una pime a Espanya. La prioritat depèn del teu públic. Un comprador industrial no fa servir les mateixes eines que un pacient que busca dentista. Triem els assistents de la mostra amb tu i els mantenim estables per poder comparar." },
  { question: "Quan convé repetir les mesures?", answer: "Solem repetir la mostra completa cada mes en els plans de seguiment, i una revisió puntual després de canvis importants a la web o a fonts externes. Repetir-ho més sovint no aporta gaire, perquè les variacions del dia a dia es poden confondre amb avenços. El que és útil és comparar rondes fetes amb les mateixes preguntes, els mateixos assistents i condicions semblants." },
  { question: "Com es distingeix una menció d'una visita o una venda?", answer: "Una menció és que l'assistent anomeni la teva empresa a la seva resposta. Una visita arriba quan l'usuari clica una cita o busca la teva marca després, i una venda quan aquest contacte es converteix en client. Mesurem les tres per separat: les mencions, a la mostra de consultes; les visites, a l'analítica de la teva web; i els contactes, preguntant l'origen als formularis i les trucades." },
  { question: "Què ha d'aportar la meva empresa al projecte?", answer: "Una persona que conegui bé el negoci, els serveis que vols potenciar i el tipus de client que t'interessa. També accessos a la web, a Google Search Console, a l'analítica i al Perfil d'Empresa a Google. Més endavant et demanarem dades, casos i opinions dels teus professionals, perquè el contingut amb experiència pròpia és el que més fàcilment es converteix en font." },
];

const pageSchema = localAgencySchema({
  pageUrl: `${SITE_URL}/ca/agencia-geo-per-pimes/`,
  lang: 'ca',
  cityName: 'Barcelona',
  postalCode: '08035',
  geo: { lat: 41.4114, lng: 2.1526 },
  areaServed: ["España", "Barcelona", "Sabadell", "Sant Cugat del Vallès", "Terrassa", "Vallès Occidental"],
  title: "▷ Posicionament en IA GEO per a Pimes | Estratègia personalitzada",
  description: "Servei de posicionament GEO (Generative Engine Optimization) per a pimes, amb recomanacions de ChatGPT, Gemini i Google AI 💡 Coneix la metodologia i resultats.",
  datePublished: '2026-07-15',
  dateModified: '2026-10-25',
  streetAddress: 'Carrer del General Mendoza, 10',
  hasMap: 'https://maps.app.goo.gl/9fbB12UcK32bgjj89',
  aggregateRating: { ratingValue: '5.0', reviewCount: '12' },
  breadcrumbName: 'Agència GEO per a pimes',
  mainService: {
    name: 'Posicionament GEO per a pimes',
    serviceType: 'GEO / AEO',
    description: 'Diagnòstic i millora de la presència de la teva marca a les respostes de ChatGPT, Gemini, Perplexity i Google, amb mesures periòdiques.',
    offers: [
      { name: 'Diagnòstic inicial de visibilitat en IA', price: 1800 },
      { name: 'Optimització de marca i continguts per a IA', price: 400, from: true, monthly: true },
      { name: 'Seguiment GEO per a projectes de més abast', price: 900, from: true, monthly: true },
    ],
  },
  faqs,
});
---

<BaseLayout
  title="▷ Posicionament en IA GEO per a Pimes | Estratègia personalitzada"
  description="Servei de posicionament GEO (Generative Engine Optimization) per a pimes, amb recomanacions de ChatGPT, Gemini i Google AI 💡 Coneix la metodologia i resultats."
  locale="ca"
  alternates={alternates}
  schemas={[pageSchema]}
>

  <!-- ═══ HERO / H1 ═══════════════════════════════════════════════════════ -->
  <section class="pt-24 sm:pt-40 pb-20 px-4 sm:px-6 relative overflow-hidden text-center bg-white border-b border-black/5">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_40%,#000_75%,transparent_100%)]"></div>
    <div class="absolute -top-10 left-1/4 w-72 h-72 bg-accent/15 rounded-full blur-3xl opacity-30 animate-pulse"></div>
    <div class="absolute top-20 right-1/4 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl opacity-20"></div>

    <div class="max-w-5xl mx-auto reveal relative">
      <span class="inline-flex items-center gap-2 bg-accent/5 backdrop-blur-sm px-4 py-2 border border-accent/10 rounded-full text-accent text-[8px] sm:text-[10px] font-black uppercase tracking-[0.3em] mb-8 shadow-sm">
        <span class="w-1.5 h-1.5 bg-accent rounded-full animate-ping"></span>
        Optimització per a motors generatius
      </span>
      <h1 class="text-3xl sm:text-5xl md:text-7xl lg:text-8xl uppercase font-extrabold tracking-tighter leading-[0.88] mb-8 text-gradient flex flex-col items-center text-center">
                <span class="lg:whitespace-nowrap">Agència GEO </span>
                <span class="lg:whitespace-nowrap">Posicionament </span>
                <span class="lg:whitespace-nowrap text-mktg-gradient">en IA</span>
            </h1>
      <p class="text-lg sm:text-xl text-zinc-500 font-light leading-relaxed mb-8">
        Comprovem què responen ChatGPT, Gemini, Perplexity i Google quan els teus clients pregunten pel que vens, i corregim la informació d'on surten aquestes respostes. Cada resposta la revisa a mà el mateix consultor, que t'ensenya l'abans i el després.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 mb-10">
        {['Sense permanències', 'Tracte directe amb el consultor', 'Mesures documentades'].map((item) => (
          <span class="inline-flex items-center gap-2 text-[11px] sm:text-xs font-black uppercase tracking-widest text-zinc-700">
            <svg class="w-4 h-4 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            {item}
          </span>
        ))}
      </div>
      <a href="#contacto" class="contact-modal-trigger btn-mktg-v5 shadow-[0_10px_30px_rgba(0,0,0,0.1)] !py-4 sm:!py-5 !px-6 sm:!px-10 !text-[11px] !tracking-widest font-black">REVISAR LA MEVA PRESÈNCIA EN IA</a>
    </div>
  </section>

  <LogoMarquee />

  <!-- ═══ QUÈ TROBA EL CLIENT ═══════════════════════════════════════════ -->
  <PSection kicker="Per què GEO" title="Què troba un client quan pregunta per la teva empresa a una IA?" layout="split">
    <Fragment slot="intro">
      <p>Cada vegada més clients comencen amb una pregunta a un assistent d'IA com ChatGPT. «Quina empresa em recomanes per…?», «Aquest proveïdor és de fiar?». <strong>L'assistent contesta amb un text ja redactat, una llista curta de noms i, de vegades, els enllaços d'on ha tret la informació</strong>. Aquests enllaços són les fonts citades. Sovint el client no va més enllà.</p>
      <p>Si la teva empresa no hi surt, hi surt amb dades velles o es confon amb una altra, perds el client abans que vegi la teva web. El GEO (optimització per a motors generatius) consisteix a revisar aquestes respostes i millorar la informació de la qual depenen. Al costat tens un exemple del que llegeix el teu client.</p>
      <p>Ho fem com a <a href="/ca/">agència de màrqueting digital per a pimes</a> i sempre al costat del teu <a href="/ca/agencia-seo-per-pimes/">posicionament a Google</a>, perquè els assistents es basen en bona part en el que ja troba el cercador.</p>
    </Fragment>
    <GeoChat
      slot="aside"
      locale="ca"
      question="Quina empresa de manteniment industrial em recomanes al Vallès?"
      intro="Aquestes són algunes opcions amb bona reputació a la zona:"
      items={[
        { name: 'Competidor A', desc: 'Manteniment preventiu per a naus i maquinària. Moltes opinions positives.' },
        { name: 'La teva empresa', desc: "Especialitzada en línies de producció, amb servei d'urgències 24 h.", highlight: true, label: 'Objectiu' },
        { name: 'Competidor B', desc: 'Empresa amb més de 30 anys, tot i que la seva web no detalla els serveis.' },
      ]}
      sources={['web del proveïdor', 'directori sectorial', 'ressenyes a Google']}
      caption="Il·lustració d'una resposta generada: només hi caben tres empreses, i a sota apareixen les fonts d'on surt cada dada."
    />
  </PSection>

  <!-- ═══ COM INFLUEIXEN LES RESPOSTES ══════════════════════════════════ -->
  <PSection kicker="Decisió de compra" title="Com intervenen les respostes generades en l'elecció d'una marca" tone="soft">
    <Fragment slot="intro">
      <p>Un assistent no tanca la venda per tu, però filtra. Redueix el mercat a tres o quatre noms i explica en què es diferencien. Si la teva empresa queda fora d'aquesta llista curta, és difícil que el client arribi a la teva web.</p>
      <p>L'esquema mostra en quin punt actua aquest filtre. A sota tens els cinc tipus de pregunta que pesen més i el que necessita cadascun.</p>
    </Fragment>
    <PFunnel
      stages={[
        { label: "Pregunta a l'assistent", sub: '«quina gestoria treballa amb autònoms a Terrassa»', side: 'El client encara no coneix marques.' },
        { label: 'Llista curta a la resposta', sub: 'tres o quatre empreses amb un resum', side: 'Aquí es guanya o es perd la consideració.' },
        { label: 'Comprovació a la web', sub: 'serveis, preus, opinions', side: 'La teva web confirma o contradiu el que ha llegit.' },
        { label: 'Contacte', sub: 'trucada, formulari, visita', side: 'Només hi arriben els qui han passat els filtres.' },
      ]}
      caption="Esquema il·lustratiu del recorregut: la llista curta del segon pas decideix qui arriba a rebre la trucada."
    />
    <PCards
      tone="soft"
      items={[
        { icon: ICON.search, title: 'Preguntes per descobrir proveïdors', html: "El client no sap a qui trucar i demana noms: «quina empresa de climatització em recomanes a Barcelona?». És la pregunta més disputada, perquè l'assistent anomena poques empreses. Per entrar-hi, la teva activitat, la teva especialitat i la teva zona han d'estar explicades amb claredat a la teva web i repetides en altres fonts que l'assistent pugui contrastar." },
        { icon: ICON.chart, title: 'Comparacions entre empreses i solucions', html: "«Em convé més l'empresa X o la Y per a una reforma d'oficina?». L'assistent compara amb el que troba publicat. Si els teus avantatges no estan escrits enlloc, la comparació es farà amb les dades de la teva competència o amb informació antiga. Revisem què es diu de tu en aquestes comparacions i què hi falta." },
        { icon: ICON.alert, title: 'Consultes sobre problemes concrets', html: `Moltes compres comencen per un problema: «la meva web no rep visites», «la màquina perd pressió». L'assistent cita les pàgines que expliquen causes i solucions amb detall. Entendre la <a href="/ca/blog/que-es-la-intencio-de-cerca-en-el-seo/">intenció de cerca darrere de cada consulta</a> ens ajuda a decidir quines pàgines escriure i quina pregunta ha de resoldre cadascuna.` },
        { icon: ICON.star, title: 'Cerques de referències i confiança', html: "«Aquesta empresa és de fiar?», «què en pensen els seus clients?». L'assistent aplega ressenyes, mencions a la premsa i casos publicats. Si les teves bones feines no deixen rastre públic, per a l'assistent ets una empresa sense experiència demostrable. Comprovem quines proves de la teva feina troba i quines li falten." },
        { icon: ICON.pin, title: 'Preguntes sobre serveis en una ubicació', html: `Preguntes amb ciutat o comarca, molt habituals en serveis locals. Aquí compten el Perfil d'Empresa a Google, la mateixa adreça i el mateix telèfon a tot arreu i pàgines que expliquin quines zones atens de debò. Ho treballem zona per zona, com en el <a href="/ca/agencia-geo-per-pimes/barcelona/">posicionament GEO a Barcelona</a> o el <a href="/ca/agencia-geo-per-pimes/sant-cugat/">posicionament en IA a Sant Cugat</a>.` },
      ]}
    />
  </PSection>

  <!-- ═══ MOSTRA DE VISIBILITAT ═════════════════════════════════════════ -->
  <PSection id="diagnostico" kicker="Diagnòstic" title="El punt de partida: una mostra de la teva visibilitat actual" layout="split">
    <Fragment slot="intro">
      <p>Abans de canviar res, mesurem. Preparem una llista de preguntes reals dels teus clients, les fem a diversos assistents i desem cada resposta. <strong>Les revisa una persona, una per una</strong>, i el resultat explica què es diu de la teva empresa i d'on surt.</p>
      <p>Aquesta mostra és la foto de partida. Totes les revisions posteriors s'hi comparen.</p>
    </Fragment>
    <PBars
      slot="aside"
      title="Mencions en una mostra de 40 consultes"
      max={40}
      rows={[
        { label: 'Competidor A', value: 22, display: '22 de 40' },
        { label: 'Competidor B', value: 15, display: '15 de 40' },
        { label: 'La teva empresa', value: 6, display: '6 de 40', note: 'dues amb dades desactualitzades' },
        { label: 'Competidor C', value: 4, display: '4 de 40' },
      ]}
      caption="Esquema il·lustratiu, no són dades d'un client: cada barra indica en quantes de les 40 preguntes apareix cada marca."
    />
    <PCards
      variant="rows"
      items={[
        { title: 'Consultes representatives dels teus clients', html: `Definim amb tu entre 30 i 60 preguntes com les que faria un client real, per exemple «quina assessoria laboral treballa amb restaurants a Sabadell?». Surten dels teus serveis prioritaris, del que et pregunten a les reunions comercials, de les cerques que ja arriben a la teva web i, si tens campanyes, dels termes que funcionen millor als teus <a href="/ca/agencia-sem-per-pimes/">anuncis de Google Ads</a>.` },
        { title: 'Models i cercadors inclosos a la revisió', html: `Normalment ChatGPT, Gemini, Claude, Perplexity, Copilot i les respostes generades de Google, que són els resums amb IA que apareixen damunt dels resultats. Ajustem la llista al que fa servir el teu públic i no la canviem entre rondes, per poder comparar. Per mesurar la teva web fem servir les <a href="/ca/blog/millors-eines-seo-per-a-pimes/">eines SEO que recomanem a les pimes</a>.` },
        { title: 'Mencions de la teva marca i dels teus competidors', html: "A cada resposta anotem si hi apareixes, en quina posició de la llista, com et descriuen i quins competidors hi surten. Reps una taula amb els teus competidors reals als assistents d'IA, que sovint no són els que tu tens al cap. Una empresa petita del polígon del costat pot estar ocupant el teu lloc." },
        { title: 'Fonts citades a les respostes', html: "Les fonts citades són les pàgines que l'assistent enllaça per avalar la seva resposta. Les apuntem totes: webs de competidors, directoris, mitjans, fòrums i portals d'opinions. Aquesta llista et diu on et convé ser present i quines pàgines de la teva web ja s'estan fent servir com a referència." },
        { title: 'Registre de dates i condicions de cada prova', html: "De cada prova desem la data, l'assistent, el mode d'ús, si tenia la cerca web activada i una captura de la resposta. Les respostes canvien amb el temps. Sense aquest registre no sabríem si una millora és real o fruit de l'atzar, i tu no ho podries comprovar." },
      ]}
    />
  </PSection>

  <!-- ═══ QUÈ DIUEN ELS ASSISTENTS ══════════════════════════════════════ -->
  <PSection kicker="Percepció de marca" title="Què diuen els assistents sobre el teu negoci" tone="soft" layout="split">
    <Fragment slot="intro">
      <p>Sortir-hi no n'hi ha prou. També importa com et descriuen. Un assistent pot anomenar la teva empresa i atribuir-li un servei que vas deixar d'oferir, una adreça antiga o una especialitat que no és la teva.</p>
      <p>Per això llegim cada resposta frase per frase i la comparem amb la realitat del teu negoci.</p>
    </Fragment>
    <PTree
      slot="aside"
      root="La teva empresa"
      branches={[
        { label: 'Serveis', leaves: ['els que vens', "els que t'atribueixen"] },
        { label: 'Persones', leaves: ['fundadors', 'experts que signen'] },
        { label: 'Sector i zona', leaves: ['categoria', 'àmbit geogràfic'] },
      ]}
      caption="A cada branca comparem el que diu l'assistent amb el que la teva empresa és i fa avui."
    />
    <PCards
      tone="soft"
      cols={2}
      items={[
        { icon: ICON.doc, title: 'Serveis que associen amb la teva marca', html: "Comparem els serveis que t'atribueixen els assistents amb els que vols vendre. És habitual que una pime continuï associada a una línia antiga i que la nova, la més rendible, no surti en cap resposta. Per exemple, una impremta que avui viu del gran format i que encara recomanen per a targetes de visita." },
        { icon: ICON.alert, title: 'Dades incompletes o contradictòries', html: "Horaris diferents, l'adreça d'una seu anterior, preus de fa anys o un nom comercial que es confon amb una altra empresa. Per a cada error busquem d'on surt, perquè l'assistent gairebé mai no se l'inventa: el pren d'alguna font. Reps la llista d'errors amb l'origen de cadascun." },
        { icon: ICON.star, title: "Atributs que et diferencien d'altres empreses", html: "Rapidesa, especialització, garantia, tracte proper. Revisem si els assistents recullen les raons per les quals els teus clients et trien o si et descriuen amb frases que valdrien per a qualsevol empresa del teu sector. Si els teus clients valoren que respons en 24 hores, això hauria de sortir a la resposta." },
        { icon: ICON.users, title: 'Relació entre la teva marca, els teus experts i el teu sector', html: "Comprovem si els assistents relacionen la teva empresa amb les persones que la dirigeixen i amb la categoria correcta. En serveis professionals pesa molt. Si algú pregunta «quina advocada laboralista de Terrassa té experiència en acomiadaments?», l'assistent necessita saber qui treballa al teu despatx i quins casos ha portat." },
      ]}
    />
  </PSection>

  <!-- ═══ IDENTITAT ═════════════════════════════════════════════════════ -->
  <PSection kicker="Identitat de marca" title="Una identitat d'empresa comprensible a tota la web" layout="split">
    <Fragment slot="intro">
      <p>Els assistents es fan una idea de la teva empresa ajuntant peces de molts llocs. Si cada peça diu una cosa diferent, la idea surt borrosa. El primer és que la teva web i els teus perfils expliquin el mateix, amb les mateixes paraules.</p>
      <p>A l'esquema, aquesta identitat és la base. Si falla, tot el que s'hi construeix a sobre perd valor.</p>
    </Fragment>
    <PStack
      slot="aside"
      layers={[
        { label: 'Fonts externes', sub: 'mitjans, directoris, opinions' },
        { label: 'Web tècnica i estructurada', sub: 'accés, marcatge, enllaços' },
        { label: 'Contingut que serveix de font', sub: 'respostes i evidències' },
        { label: 'Identitat clara', sub: 'qui ets, què fas, on' },
      ]}
      caption="Esquema de treball: la identitat clara és la base i cada capa es recolza en la que té a sota."
    />
    <PCards
      cols={2}
      items={[
        { icon: ICON.target, title: 'Informació corporativa clara i coherent', html: "Nom comercial, raó social, adreça, telèfon, any de fundació i zona de treball, idèntics a la web, l'avís legal, el Perfil d'Empresa i els directoris. Sembla bàsic, però gairebé en totes les auditories trobem alguna d'aquestes dades amb dues versions. Et donem la versió correcta i la llista de llocs on cal corregir-la." },
        { icon: ICON.doc, title: 'Serveis i especialitats ben definits', html: "Una pàgina per cada servei important, amb un nom que el teu client entengui, per a qui és, què inclou i què no. Frases com «solucions integrals» no donen a l'assistent res concret per repetir. «Manteniment de calderes industrials amb visita en 48 hores» sí que es pot repetir quan algú pregunta per aquest servei." },
        { icon: ICON.users, title: 'Autors i professionals identificables', html: "Pàgines d'equip amb nom, càrrec, formació i experiència real, i articles signats per qui coneix el tema. Els assistents tenen en compte qui avala una afirmació, i el teu client també, abans de confiar en una empresa que no coneix. Et diem quins professionals del teu equip haurien de tenir un perfil propi." },
        { icon: ICON.link, title: 'Perfils externs alineats amb la teva activitat', html: `LinkedIn, Perfil d'Empresa a Google, associacions i plataformes del sector, tots amb la mateixa descripció i un enllaç a la teva web. Revisem cada perfil i et passem el text que ha de portar. Si una altra persona gestiona la teva fitxa de Google, t'expliquem com <a href="/ca/blog/donar-acces-al-teu-perfil-dempresa-a-google/">donar accés al teu Perfil d'Empresa</a> sense compartir contrasenyes.` },
      ]}
    />
  </PSection>

  <!-- ═══ CONTINGUT FONT ════════════════════════════════════════════════ -->
  <PSection kicker="Contingut" title="Contingut que pot servir com a font" tone="soft">
    <Fragment slot="intro">
      <p>Un assistent cita el que li permet respondre bé: contingut concret, que es pot comprovar i escrit per algú que coneix el tema. Els textos genèrics que repeteixen el que diuen cent webs més gairebé mai no es citen.</p>
      <p>Treballem quatre tipus de contingut i comencem per les pàgines més properes a la venda.</p>
    </Fragment>
    <PCards
      tone="soft"
      cols={2}
      variant="check"
      items={[
        { title: 'Respostes directes a preguntes de compra', html: `Quant costa, quant triga, què inclou, quan no convé. Donem la resposta al primer paràgraf i ampliem després, una tècnica que també s'anomena AEO (optimització per a respostes). Amb respostes directes, preguntes freqüents i dades verificables, les pàgines de <a href="/ca/casos-exit/tattoox/">l'escola en línia Tattoox</a> apareixen avui a les respostes amb IA de Google per a les cerques principals del seu sector.` },
        { title: 'Explicacions avalades per experiència', html: "Casos, exemples, errors habituals i criteris que només coneix qui treballa al sector. Entrevistem els teus professionals, per exemple el teu cap d'obra sobre les errades més comunes en una reforma, i convertim aquest coneixement en contingut. Això distingeix la teva pàgina d'un text genèric i li dona motius per ser citada." },
        { title: 'Dades pròpies amb context i metodologia', html: "Terminis mitjans dels teus projectes, rangs de preu, resultats d'enquestes a clients. Els publiquem amb la data, el nombre de casos i el mètode, perquè s'entengui d'on surten. Una frase com «gairebé totes les nostres reformes de bany s'acaben en tres setmanes» només és creïble si dius sobre quantes obres i de quin període." },
        { title: 'Informació actualitzada i fàcil de verificar', html: "Data de revisió visible, preus vigents, normativa al dia i enllaços a fonts quan cal. També retirem o corregim les pàgines antigues que contradiuen la informació actual, perquè un assistent pot citar una tarifa de fa quatre anys si continua publicada a la teva web." },
      ]}
    />
  </PSection>

  <!-- ═══ PAPER DE LA WEB ═══════════════════════════════════════════════ -->
  <PSection kicker="Base tècnica" title="El paper de la teva web en l'estratègia GEO">
    <Fragment slot="intro">
      <p>La teva web és l'única font sobre la teva empresa que controles del tot. Si els rastrejadors dels assistents, els programes que llegeixen les webs per ells, no hi poden entrar o hi troben la informació desordenada, altres fonts n'ocupen el lloc.</p>
      <p>Revisem cinc punts tècnics. Si la web necessita canvis de fons, ho coordinem amb el nostre equip de <a href="/ca/disseny-web-per-pimes/">disseny web per a pimes</a> o amb el teu desenvolupador.</p>
    </Fragment>
    <PCards
      variant="numbered"
      cols={2}
      items={[
        { title: 'Accés al contingut que vols fer visible', html: "Revisem l'arxiu robots.txt, el tallafoc i la configuració del servidor per veure quins rastrejadors de cercadors i assistents hi poden entrar. De vegades trobem el rastrejador de ChatGPT bloquejat sense que ningú ho hagués decidit, per una configuració heretada. Tu decideixes què obrir i què no, però sabent què tries." },
        { title: 'Estructura semàntica de les pàgines', html: "Un únic títol principal, encapçalaments en ordre lògic i llistes o taules quan la informació ho demana. Una pàgina ben ordenada s'entén per parts. Si algú pregunta «quant triga una reforma de bany?», l'assistent pot agafar just el fragment que respon sense haver d'interpretar tota la pàgina." },
        { title: 'Dades estructurades coherents amb la informació publicada', html: "Les dades estructurades són un codi que el visitant no veu i que resumeix qui ets, què ofereixes i on ets. Marquem organització, negoci local, serveis, persones i preguntes freqüents, sempre fidel al que es veu a la pàgina. Si el marcatge diu una cosa diferent del text visible, resta credibilitat en lloc de sumar-ne." },
        { title: 'Enllaços interns que connecten conceptes i serveis', html: "Enllacem cada servei amb els seus casos, els seus autors i els articles que l'expliquen. Aquesta xarxa ajuda cercadors i assistents a entendre de què en sap la teva empresa i quines pàgines són les importants. Aquesta mateixa pàgina n'és un exemple: des d'aquí enllacem els sectors, les ciutats i els casos en què apliquem el GEO." },
        { title: 'Revisió del contingut que depèn de JavaScript', html: "Alguns rastrejadors no executen JavaScript o ho fan a mitges. Si els teus preus, serveis o opinions només apareixen després de carregar un script, potser no els veuen. Comparem l'HTML que entrega el teu servidor amb el que veu l'usuari i et diem què convé canviar i amb quina prioritat." },
      ]}
    />
  </PSection>

  <!-- ═══ FONTS EXTERNES ════════════════════════════════════════════════ -->
  <PSection kicker="Autoritat" title="Les fonts externes que parlen de la teva empresa" tone="dark">
    <Fragment slot="intro">
      <p>Els assistents es fien més del que confirmen diverses fonts independents. El que dius a la teva web compta, però compta més quan un mitjà, una associació o els teus clients diuen el mateix. L'esquema mostra com s'encadena aquesta confirmació.</p>
    </Fragment>
    <PFlow
      tone="dark"
      steps={[
        { label: 'Font externa', sub: 'mitjà, directori, ressenyes' },
        { label: 'Coincideix amb la teva web', sub: 'mateixes dades i serveis' },
        { label: 'El model ho confirma', sub: 'més confiança en la dada' },
        { label: 'Menció correcta', sub: 'a la resposta generada' },
      ]}
      caption="Esquema il·lustratiu: fixa't en el segon pas, perquè una dada que no coincideix amb la teva web perd força."
    />
    <PCards
      tone="dark"
      cols={2}
      variant="numbered"
      items={[
        { title: 'Mitjans i publicacions del teu sector', html: "Revistes especialitzades, diaris locals i blogs de referència en la teva activitat. Busquem oportunitats amb sentit, com una entrevista, un article amb dades pròpies o una col·laboració. Una nota de premsa genèrica rarament es cita. Un article amb dades del teu sector a la teva comarca sí que es pot convertir en font." },
        { title: 'Directoris i associacions professionals', html: "Col·legis professionals, cambres de comerç, associacions sectorials i directoris de qualitat. Els assistents els consulten sovint per confirmar que una empresa existeix i a què es dedica. Revisem en quins hi ets, en quins hi hauries de ser i si les teves dades són correctes a cadascun." },
        { title: "Plataformes d'opinions i referències", html: `Google, plataformes del sector i portals de comparació. La quantitat, la data i el text de les ressenyes influeixen en com et descriuen. Una ressenya que diu «van arreglar l'avaria el mateix dia» aporta més que cinc estrelles sense comentari. T'ajudem a muntar un sistema per <a href="/ca/blog/com-aconseguir-mes-ressenyes-a-google-per-a-la-teva-pime/">aconseguir més ressenyes a Google</a> i respondre-les.` },
        { title: 'Mencions que cal corregir o completar', html: "Articles amb un telèfon antic, fitxes duplicades, directoris amb l'activitat equivocada. Fem la llista, l'ordenem segons la importància de cada font i gestionem les correccions. Un error repetit en diversos llocs sol acabar a les respostes, així que comencem pels que es repeteixen més." },
      ]}
    />
  </PSection>

  <!-- ═══ PREGUNTES CLAU ════════════════════════════════════════════════ -->
  <PSection kicker="Consultes prioritàries" title="Preguntes on la teva pime ha de ser present">
    <Fragment slot="intro">
      <p>No totes les preguntes valen el mateix. Donem prioritat a les que fa algú que està decidint a qui contractar, perquè són les que acaben en una trucada. Aquestes quatre famílies entren sempre a la mostra.</p>
    </Fragment>
    <PCards
      cols={2}
      items={[
        { icon: ICON.search, tag: 'Descobriment', title: 'Qui pot resoldre el problema del client', html: `«Qui instal·la plaques solars en naus industrials?», «quin advocat porta divorcis a Sabadell?». Són les preguntes amb més intenció de compra i les que porten més directament a una trucada. Necessiten pàgines de servei clares i fonts externes que confirmin la teva especialitat, com treballem en el <a href="/ca/agencia-advocats/posicionamiento-geo/">posicionament en IA per a advocats</a>.` },
        { icon: ICON.chart, tag: 'Comparació', title: 'Quines alternatives hi ha i com es comparen', html: "«Què és millor per a una clínica petita, un programa de gestió al núvol o un d'instal·lat?». El client ja té opcions i demana a l'assistent que les compari. Publiquem comparatives honestes que expliquen quan encaixa la teva solució i quan no. Així la comparació es fa amb les teves dades i no amb informació aliena." },
        { icon: ICON.doc, tag: 'Criteris', title: 'Quins criteris convé revisar abans de contractar', html: `«Què he de demanar a una empresa de reformes abans de signar?». Qui respon bé aquesta pregunta marca les regles del joc, i de passada destaca els teus punts forts. És l'enfocament del nostre <a href="/ca/agencia-constructores/posicionamiento-geo/">GEO per a constructores i reformistes</a>. Amb guies i pàgines de servei escrites així, <a href="/ca/casos-exit/voltura-projects/">la web de reformes de Voltura Projects</a> ja apareixia citada en 6 respostes d'IA de Google als set mesos del llançament.` },
        { icon: ICON.target, tag: 'Encaix', title: 'Quin proveïdor encaixa en cada situació', html: "«Tinc un pressupost ajustat», «ho necessito per a la setmana que ve», «som una empresa de cinc persones». L'assistent recomana segons cada situació. Si el teu contingut explica per a qui és cada servei i per a qui no, la teva empresa apareix en els casos en què de debò encaixa i deixa de competir on no té opcions." },
      ]}
    />
  </PSection>

  <!-- ═══ MODEL DE NEGOCI ═══════════════════════════════════════════════ -->
  <PSection kicker="Experiència sectorial" title="GEO segons el teu model de negoci" tone="soft">
    <Fragment slot="intro">
      <p>Cada tipus d'empresa rep preguntes diferents i depèn de fonts diferents. Un despatx necessita que es coneguin els seus professionals i una botiga en línia, que les seves fitxes de producte estiguin completes.</p>
      <p>Ajustem la mostra a com compren els teus clients. Per als sectors en què més treballem tens una pàgina específica amb exemples de preguntes i fonts.</p>
    </Fragment>
    <PCards
      tone="soft"
      cols={2}
      items={[
        { icon: ICON.chart, title: 'Empreses B2B amb processos de compra llargs', html: `Hi decideixen diverses persones i comparen durant setmanes. L'enginyer pregunta per especificacions i el gerent per terminis i preu. Treballem fitxes tècniques, casos i contingut per a cada perfil del comitè de compra. Ho expliquem en detall a <a href="/ca/agencia-b2b/posicionamiento-geo/">GEO per a empreses B2B</a> i a <a href="/ca/agencia-industrial/posicionamiento-geo/">posicionament en IA per a la indústria</a>.` },
        { icon: ICON.users, title: 'Serveis professionals basats en la confiança', html: `El teu client vol saber qui l'atendrà i quina experiència té, i pregunta coses com «quin dentista de confiança fa implants a prop meu?». Treballem perfils de professionals, contingut signat i ressenyes per a <a href="/ca/agencia-advocats/posicionamiento-geo/">despatxos d'advocats</a>, <a href="/ca/agencia-dentistes/posicionamiento-geo/">clíniques dentals</a>, <a href="/ca/agencia-psicolegs/posicionamiento-geo/">consultes de psicologia</a> i <a href="/ca/agencia-terapeutes/posicionamiento-geo/">centres de teràpia</a>.` },
        { icon: ICON.money, title: 'Ecommerce amb productes que es comparen', html: `Els assistents recomanen productes segons característiques, preu i opinions: «quina cafetera de menys de 300 euros em recomanes?». Treballem fitxes completes, guies de compra i dades de producte iguals a la botiga i als comparadors. Ho detallem al nostre servei de <a href="/ca/agencia-ecommerce/posicionamiento-geo/">GEO per a botigues en línia</a>.` },
        { icon: ICON.pin, title: "Negocis locals amb una zona d'atenció", html: `Aquí la pregunta gairebé sempre inclou una ciutat: «gimnàs amb classes de pilates a Terrassa». Hi compten el Perfil d'Empresa, les ressenyes i una pàgina per cada zona que atens de debò. Tenim pàgines de <a href="/ca/agencia-restaurantes/posicionamiento-geo/">posicionament en IA per a restaurants</a>, <a href="/ca/agencia-hotels/posicionamiento-geo/">hotels i allotjaments</a>, <a href="/ca/agencia-gimnasos/posicionamiento-geo/">gimnasos i centres esportius</a> i <a href="/ca/agencia-inmobiliarias/posicionamiento-geo/">agències immobiliàries</a>.` },
      ]}
    />
    <div class="mt-12 text-center reveal">
      <p class="text-xs font-black uppercase tracking-[0.25em] text-zinc-400 mb-4">Agència GEO a la teva zona</p>
      <CityPills base="/ca/agencia-geo-per-pimes/" lang="ca" itemPrefix="Agència GEO a" homeLabel="Tot Espanya" />
    </div>
  </PSection>

  <!-- ═══ SEO, GEO I AEO ════════════════════════════════════════════════ -->
  <PSection kicker="Estratègia conjunta" title="SEO, GEO i AEO dins d'una mateixa estratègia" layout="split">
    <Fragment slot="intro">
      <p>El SEO treballa la teva posició als resultats de Google. El GEO, la teva presència a les respostes que redacten els assistents. L'AEO, que el teu contingut sigui la resposta directa a una pregunta concreta. Se solapen tant que tractar-los per separat sol portar a pagar dues vegades o a fer canvis que es contradiuen.</p>
      <p>Per això els planifiquem junts. Si encara dubtes entre invertir en cercadors o en anuncis, aquesta guia t'ajuda a <a href="/ca/blog/que-necesita-una-pime-seo-o-sem/">triar entre SEO i SEM</a>.</p>
    </Fragment>
    <PVenn
      slot="aside"
      sets={[
        { label: 'SEO', sub: 'resultats de Google' },
        { label: 'GEO', sub: 'respostes generades' },
        { label: 'AEO', sub: 'resposta directa' },
      ]}
      center="La teva marca"
      caption="Fixa't en la zona central: les tres disciplines comparteixen web sòlida, contingut útil i autoritat."
    />
    <PCards
      variant="rows"
      items={[
        { title: 'Què aporta el posicionament orgànic', html: `Indexació, arquitectura, continguts que posicionen i enllaços. Molts assistents busquen a la web abans de respondre i tendeixen a fer servir pàgines que ja estan ben situades a Google. Per això, en la majoria de projectes, la feina de la nostra <a href="/ca/agencia-seo-per-pimes/">agència SEO per a pimes</a> és el punt de partida del GEO.` },
        { title: 'Què treballem per a les respostes generades', html: "La identitat de l'empresa, l'exactitud de les dades, les fonts externes i la mesura als assistents. És la part que el SEO tradicional no cobreix. A Google competeixes per una posició en una llista. En un assistent compta com et descriu un text que redacta ell, i ser quart a Google no assegura ni una menció." },
        { title: "On encaixa l'optimització de respostes", html: "L'AEO busca que el teu contingut sigui la resposta directa: el fragment destacat de Google, el que llegeix un altaveu intel·ligent o la primera frase d'un assistent. L'apliquem sobretot a preguntes freqüents i pàgines de servei. Si algú pregunta «quant costa un diagnòstic GEO?», la xifra va a la primera línia." },
        { title: 'Com evitem duplicar esforços', html: `Un únic pla de treball, una sola persona responsable i un calendari compartit. Si també inverteixes en <a href="/ca/agencia-sem-per-pimes/">publicitat a Google Ads</a>, fem servir les dades de les campanyes per veure quines preguntes i serveis converteixen millor i començar per aquests. Així cada tasca es fa una vegada i al canal on rendeix més.` },
      ]}
    />
  </PSection>

  <!-- ═══ TROBALLES A ACCIONS ═══════════════════════════════════════════ -->
  <PSection kicker="Pla de treball" title="De les troballes a les accions" tone="soft" layout="split">
    <Fragment slot="intro">
      <p>El diagnòstic acaba amb una llista de tasques ordenada segons l'efecte que esperem a les respostes i l'esforç que exigeix cadascuna. Comencem pel que corregeix errors a les preguntes amb més valor comercial.</p>
      <p>Després repetim la mostra per veure què ha canviat i decidir el pas següent.</p>
    </Fragment>
    <PMatrix
      slot="aside"
      xLabel="Esforç"
      yLabel="Impacte a les respostes"
      quadrants={['Fer primer', 'Planificar', 'Si sobra temps', 'Descartar']}
      points={[
        { label: 'Corregir dades de contacte', x: 14, y: 84 },
        { label: 'Reescriure pàgina de servei', x: 34, y: 72 },
        { label: 'Estudi amb dades pròpies', x: 76, y: 78 },
        { label: 'Sortir en mitjans del sector', x: 66, y: 60 },
        { label: 'Directoris poc rellevants', x: 30, y: 22 },
      ]}
      caption="Exemple de priorització: a dalt a l'esquerra hi ha el que més millora les respostes amb menys esforç."
    />
    <PCards
      tone="soft"
      cols={2}
      variant="numbered"
      items={[
        { title: 'Corregir la informació essencial sobre la teva empresa', html: "Dades de contacte, serveis, seus i descripcions contradictòries a la web i a les fonts externes més consultades. Sol ser la tasca més ràpida i la primera que es nota, perquè elimina errors que els assistents anaven repetint. Canviar un telèfon antic en cinc directoris, per exemple, es pot resoldre en un matí." },
        { title: 'Millorar les pàgines amb més valor comercial', html: "Reescrivim les pàgines dels serveis que més t'interessa vendre perquè responguin les preguntes de la mostra. Hi afegim preus orientatius, terminis, casos i preguntes freqüents, i en revisem l'estructura i el marcatge. Si una pregunta important no té resposta en cap pàgina de la teva web, la creem." },
        { title: 'Desenvolupar els continguts i les evidències que falten', html: "Comparatives, guies de criteris, casos documentats o dades pròpies que el diagnòstic ha detectat com a absents. També accions fora de la teva web, com col·laboracions amb mitjans o l'alta en associacions, que confirmen el que hi dius. Cada peça neix d'una pregunta concreta de la mostra." },
        { title: 'Tornar a revisar la mostra de consultes', html: "Repetim les mateixes preguntes als mateixos assistents i ho comparem amb la ronda anterior. El que ha millorat es manté, el que no es mou es revisa, i les preguntes noves s'afegeixen amb la seva data per no barrejar resultats. Reps la comparació pregunta per pregunta." },
      ]}
    />
  </PSection>

  <!-- ═══ EVOLUCIÓ ══════════════════════════════════════════════════════ -->
  <PSection kicker="Mesura" title="Com interpretem l'evolució de la teva presència en IA">
    <Fragment slot="intro">
      <p>A cada ronda mesurem tres indicadors i els llegim junts. Més mencions amb dades errònies no és una bona notícia, i una cita que no porta visites tampoc no diu gaire. Per interpretar les visites convé saber <a href="/ca/blog/don-ve-el-trafic-web/">d'on ve el trànsit de la teva web</a> i com el registra l'analítica.</p>
    </Fragment>
    <div class="grid lg:grid-cols-[1fr_1.1fr] gap-10 items-start">
      <PCards
        variant="numbered"
        cols={2}
        class="lg:grid-cols-1"
        items={[
          { title: 'Freqüència de mencions a les consultes analitzades', html: "Quina part de les preguntes de la mostra inclou la teva empresa a la resposta, separada per assistent i per família de preguntes. Per exemple, 12 de 40 a ChatGPT i 6 de 40 a Gemini. És l'indicador més directe i també el que més varia d'una ronda a l'altra." },
          { title: 'Cites i enllaços cap als teus continguts', html: "Quantes vegades un assistent enllaça una pàgina de la teva web com a font, i quines. A més, revisem a l'analítica les visites que arriben des de ChatGPT, Perplexity i altres assistents, quan l'eina permet identificar-les. Així saps quines pàgines de la teva web treballen per tu a les respostes." },
          { title: 'Exactitud de la informació sobre la teva marca', html: "Percentatge de respostes en què les dades sobre la teva empresa són correctes: serveis, ubicació, atributs i persones. Ho mesurem a part perquè una presència mal descrita pot perjudicar més que no aparèixer-hi. Un assistent que et situa en una altra ciutat t'envia clients que no pots atendre." },
        ]}
      />
      <PLines
        title="Evolució dels tres indicadors per ronda"
        series={[
          { label: 'Mencions', points: [15, 18, 26, 31, 38, 42] },
          { label: 'Cites a la teva web', points: [5, 6, 10, 15, 19, 24], color: '#8b5cf6' },
          { label: 'Exactitud', points: [55, 70, 82, 86, 90, 92], color: '#16a34a', dashed: true },
        ]}
