    <PCards
      variant="rows"
      tone="soft"
      items={[
        { title: `Què determina el pressupost de la teva empresa`, html: `La mida de la web, la competència de les teves cerques, el nombre de serveis i zones, l'estat tècnic de partida i quant contingut cal crear. Una clínica amb una seu no necessita el mateix que un ecommerce amb 3.000 productes. Per això comencem per l'auditoria: amb les seves dades, la quota mensual deixa de ser una estimació.` },
      ]}
    />
  </PSection>

  <!-- ═══ CONSULTOR ══════════════════════════════════════════════════════ -->
