        { title: 'Acompanyament SEO mensual', price: 'des de 400 € / mes', note: 'negocis locals i petites empreses', items: ['Optimització tècnica contínua', 'Continguts i enllaçat intern', "SEO local i Perfil d'Empresa", 'Informe mensual de contactes', 'Línia directa amb el consultor'], featured: true },
        { title: 'Projectes de més abast o complexitat', price: 'des de 900 € / mes', note: 'empreses mitjanes i sectors competits', items: ['Estratègia SEO i GEO conjunta', 'Més volum de continguts', "Captació d'enllaços", 'Diverses seus o idiomes', 'Reunió mensual de negoci'] },
      ].map((p, i) => (
        <div class:list={['pd-rise rounded-3xl p-7 sm:p-8 flex flex-col border', p.featured ? 'bg-zinc-950 text-white border-zinc-950 shadow-2xl' : 'bg-white border-black/5 shadow-[0_15px_40px_rgba(0,0,0,0.06)]']} style={`--i:${i}`}>
