---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildAlternates } from '../../lib/i18n';
import { localAgencySchema } from '../../lib/schema';
import LogoMarquee from '../../components/sections/LogoMarquee.astro';
import FaqHome from '../../components/sections/FaqHome.astro';
import CityPills from '../../components/global/CityPills.astro';
import GoogleReviews from '../../components/global/GoogleReviews.astro';
import MoreCases from '../../components/casos/MoreCases.astro';
import PSection from '../../components/pillar/PSection.astro';
import PCards from '../../components/pillar/PCards.astro';
import PFlow from '../../components/pillar/PFlow.astro';
import PBars from '../../components/pillar/PBars.astro';
import PMatrix from '../../components/pillar/PMatrix.astro';
import PStack from '../../components/pillar/PStack.astro';
import PFunnel from '../../components/pillar/PFunnel.astro';
import PTree from '../../components/pillar/PTree.astro';
import PLines from '../../components/pillar/PLines.astro';
import PCounter from '../../components/pillar/PCounter.astro';
import PSerp from '../../components/pillar/PSerp.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://novamarketing.es';
const alternates = buildAlternates('/agencia-seo-para-pymes/', '/ca/agencia-seo-per-pimes/', SITE_URL);

const ICON = {
  search: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  target: 'M12 3a9 9 0 100 18 9 9 0 000-18zm0 5a4 4 0 100 8 4 4 0 000-8z',
  doc: 'M9 12h6m-6 4h6M9 8h2m8-3v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2h6l4 4z',
  link: 'M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5m7.328-1.672a4 4 0 000-5.656 4 4 0 00-5.656 0l-1.5 1.5',
  chart: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm8 0V5a2 2 0 012-2h0a2 2 0 012 2v14a2 2 0 01-2 2h0a2 2 0 01-2-2zm-8 0a2 2 0 002 2h2a2 2 0 002-2V9a2 2 0 00-2-2h-2a2 2 0 00-2 2v10z',
  money: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  users: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
};

const faqs = [
  { question: `Quan es pot començar a notar la feina SEO?`, answer: `Els primers moviments de posicions se solen veure entre el segon i el tercer mes, i els resultats consolidats entre el sisè i el dotzè. Depèn del punt de partida de la teva web, de la competència del sector i de quantes millores es poden aplicar al principi. A l'auditoria et diem què esperar a cada fase, sense terminis inventats.` },
  { question: `Què inclou la quota mensual?`, answer: `Inclou la feina acordada al pla de cada mes: millores tècniques, optimització i creació de continguts, enllaçat intern, SEO local i, als plans que ho preveuen, captació d'enllaços. També la mesura i un informe mensual amb el que s'ha fet, l'evolució de les pàgines treballades i els contactes que arriben des de Google.` },
  { question: `Podeu treballar sobre la meva web actual?`, answer: `Sí. La majoria de projectes parteixen d'una web existent, ja sigui WordPress, Shopify, PrestaShop o un desenvolupament a mida. Només recomanem refer-la quan la tecnologia impedeix aplicar les millores necessàries, i en aquest cas planifiquem la migració per no perdre el posicionament aconseguit.` },
  { question: `Què necessiteu del meu equip?`, answer: `Accessos a la web, Google Search Console, Google Analytics i el Perfil d'Empresa a Google, i una persona de contacte que conegui el negoci. Al principi et demanarem informació sobre els teus serveis, clients i marges. Després, sobretot, revisions puntuals dels continguts que publiquem.` },
  { question: `Com es relacionen el SEO i la visibilitat en IA?`, answer: `Els assistents d'IA i les respostes generades de Google es basen en contingut que ja està ben posicionat, ben estructurat i citat per altres fonts. Una bona feina SEO és la base del GEO. Si vols treballar de manera específica la teva presència a ChatGPT, Gemini o Perplexity, ho fem dins del nostre servei d'agència GEO.` },
  { question: `Quines condicions té el servei?`, answer: `Treballem mes a mes, sense permanència. Abans de començar reps un pressupost tancat per escrit amb l'abast de cada mes. Els comptes, la web i les dades són sempre teus, i si decideixes acabar el servei et lliurem tota la feina i la documentació.` },
];

const pageSchema = localAgencySchema({
  pageUrl: `${SITE_URL}/ca/agencia-seo-per-pimes/`,
  lang: 'ca',
  cityName: 'Barcelona',
  postalCode: '08035',
  geo: { lat: 41.4114, lng: 2.1526 },
  areaServed: ["España", "Barcelona", "Sabadell", "Sant Cugat del Vallès", "Terrassa", "Vallès Occidental"],
  title: "▷ Agència SEO per a Pimes | Posicionament a Google Estratègic",
  description: "Especialistes en SEO per a pimes amb informes clars ✅ Estratègies a mida i resultats mesurables 💡 Coneix com podem ajudar-te a Google",
  datePublished: '2026-07-15',
  dateModified: '2026-10-25',
  streetAddress: 'Carrer del General Mendoza, 10',
  hasMap: 'https://maps.app.goo.gl/9fbB12UcK32bgjj89',
  aggregateRating: { ratingValue: '5.0', reviewCount: '12' },
  breadcrumbName: 'Agència SEO per a pimes',
  mainService: {
    name: 'Posicionament SEO per a pimes',
    serviceType: 'Posicionament SEO',
    description: 'Auditoria, estratègia i acompanyament SEO mensual per a pimes: SEO tècnic, continguts, autoritat i SEO local, mesurat en contactes i vendes.',
    offers: [
      { name: 'Auditoria i estratègia SEO inicial', price: 1800 },
      { name: 'Acompanyament SEO mensual', price: 400, from: true, monthly: true },
      { name: 'SEO per a projectes de més abast', price: 900, from: true, monthly: true },
    ],
  },
  faqs,
});
---

<BaseLayout
  title="▷ Agència SEO per a Pimes | Posicionament a Google Estratègic"
  description="Especialistes en SEO per a pimes amb informes clars ✅ Estratègies a mida i resultats mesurables 💡 Coneix com podem ajudar-te a Google"
  locale="ca"
  alternates={alternates}
  schemas={[pageSchema]}
>

  <!-- ═══ HERO / H1 ═══════════════════════════════════════════════════════ -->
  <section class="pt-24 sm:pt-40 pb-20 px-4 sm:px-6 relative overflow-hidden text-center bg-white border-b border-black/5">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_40%,#000_75%,transparent_100%)]"></div>
    <div class="absolute -top-10 left-1/4 w-72 h-72 bg-accent/15 rounded-full blur-3xl opacity-30 animate-pulse"></div>
    <div class="absolute top-20 right-1/4 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl opacity-20"></div>

    <div class="max-w-5xl mx-auto reveal relative">
      <span class="inline-flex items-center gap-2 bg-accent/5 backdrop-blur-sm px-4 py-2 border border-accent/10 rounded-full text-accent text-[8px] sm:text-[10px] font-black uppercase tracking-[0.3em] mb-8 shadow-sm">
        <span class="w-1.5 h-1.5 bg-accent rounded-full animate-ping"></span>
        Posicionament web per a pimes
      </span>
      <h1 class="text-3xl sm:text-5xl md:text-7xl lg:text-8xl uppercase font-extrabold tracking-tighter leading-[0.88] mb-8 text-gradient flex flex-col items-center text-center">
                <span class="lg:whitespace-nowrap">Agència SEO </span>
                <span class="lg:whitespace-nowrap text-mktg-gradient">per a Pimes</span>
            </h1>
      <p class="text-lg sm:text-xl text-zinc-500 font-light leading-relaxed max-w-3xl mx-auto mb-8">
        Fem que la teva empresa aparegui quan els teus clients busquen el que vens, i mesurem la feina en contactes i vendes, no en informes de posicions.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 mb-10">
        {['Sense permanències', 'Tracte directe amb el consultor', 'Informes de negoci'].map((item) => (
          <span class="inline-flex items-center gap-2 text-[11px] sm:text-xs font-black uppercase tracking-widest text-zinc-700">
            <svg class="w-4 h-4 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            {item}
          </span>
        ))}
      </div>
      <a href="#contacto" class="contact-modal-trigger btn-mktg-v5 shadow-[0_10px_30px_rgba(0,0,0,0.1)] !py-4 sm:!py-5 !px-6 sm:!px-10 !text-[11px] !tracking-widest font-black">PARLEM DEL TEU NEGOCI</a>
    </div>
  </section>

  <LogoMarquee />

  <!-- ═══ OPORTUNITAT ═══════════════════════════════════════════════════ -->
  <PSection kicker="Per què SEO" title="Converteix les cerques dels teus clients en oportunitats de negoci" layout="split">
    <Fragment slot="intro">
      <p>Cada dia algú escriu a Google el servei que ofereixes, el problema que resols o el nom de la teva categoria de producte. <strong>Aquesta cerca és una necessitat expressada en el moment exacte en què existeix</strong>, i l'empresa que apareix amb una resposta clara se sol quedar el contacte.</p>
      <p>Nova és una agència SEO especialitzada en pimes. Treballem el posicionament orgànic com un canal comercial més, connectat amb la teva web, la teva <a href="/ca/agencia-sem-per-pimes/">publicitat a Google</a> i la teva <a href="/ca/agencia-geo-per-pimes/">presència a les respostes de la IA</a>, amb un objectiu que es pot mesurar. Quants clients nous arriben cada mes des del cercador.</p>
    </Fragment>
    <PSerp
      slot="aside"
      query="reformes integrals a Sabadell"
      results={[
        { url: 'latevaempresa.cat › reformes-integrals', title: 'Reformes integrals a Sabadell · Pressupost en 48 h', desc: 'Pisos, locals i cases. Preus orientatius, terminis i projectes reals al Vallès.', highlight: true, label: 'La teva empresa' },
        { url: 'competidor-a.com', title: 'Empresa de reformes | Reformes a Barcelona i rodalia', desc: "Més de 20 anys d'experiència en reformes de tota mena." },
        { url: 'directori-reformes.cat › sabadell', title: 'Les 10 millors empreses de reformes a Sabadell', desc: 'Compara opinions i demana pressupost a diverses empreses.' },
      ]}
      caption="Il·lustració. L'objectiu és que la teva pàgina sigui la resposta més clara a la cerca del teu client."
    />
    <PFlow
      steps={[
        { label: 'Cerca amb intenció', sub: '«empresa de reformes a Sabadell»' },
        { label: 'La teva pàgina a Google', sub: 'resultat orgànic o mapa' },
        { label: 'Pàgina que respon', sub: 'servei, preu, proves' },
        { label: 'Contacte o venda', sub: 'trucada, formulari, comanda' },
      ]}
      caption="El recorregut que optimitzem. Si falla una baula, el trànsit no es converteix en negoci."
    />
  </PSection>

  <!-- ═══ QUÈ FRENA EL POSICIONAMENT ═══════════════════════════════════ -->
  <PSection kicker="Diagnòstic" title="Què està frenant el posicionament de la teva empresa" tone="soft">
    <Fragment slot="intro">
      <p>Quan una web no capta clients des de Google gairebé mai hi ha una sola causa. Aquests són els sis bloquejos que trobem més sovint a les webs de pimes, i cadascun es corregeix de manera diferent.</p>
    </Fragment>
    <PCards
      tone="soft"
      items={[
        { icon: ICON.search, title: `Les teves pàgines importants no apareixen a Google`, html: `Pàgines de servei sense indexar, bloquejades per error o tan amagades a la navegació que Google gairebé no les visita. Si una pàgina no és a l'índex, no pot posicionar per bo que sigui el seu contingut.` },
        { icon: ICON.users, title: `Reps visites que no es converteixen en contactes`, html: `Trànsit de cerques informatives que no tenen relació amb el que vens, o pàgines que posicionen però no expliquen per què triar-te. Aquí el problema sol ser a la <a href="/ca/disseny-web-per-pimes/">web i la seva conversió</a>, no al SEO.` },
        { icon: ICON.target, title: `La teva competència ocupa les cerques més rendibles`, html: `Els teus competidors tenen una pàgina específica per a cada servei i zona, i tu una sola pàgina genèrica que intenta posicionar per tot. Google prefereix la resposta més precisa.` },
        { icon: ICON.code, title: `La teva web arrossega problemes tècnics`, html: `Lentitud al mòbil, contingut duplicat, redireccions en cadena o plantilles que generen centenars d'URL sense valor. Problemes invisibles per a l'usuari que gasten el rastreig de Google. Si no saps per on començar, revisa <a href="/ca/blog/com-saber-si-la-teva-web-esta-ben-feta/">com saber si la teva web està ben feta</a>.` },
        { icon: ICON.doc, title: `Els teus continguts no responen al que busca el client`, html: `Textos escrits des de l'empresa i no des del dubte del client. Sense preus orientatius, sense terminis, sense exemples. Entendre la <a href="/ca/blog/que-es-la-intencio-de-cerca-en-el-seo/">intenció de cerca</a> és el que separa una pàgina que posiciona d'una que només existeix.` },
        { icon: ICON.money, title: `Dependència de la publicitat per aconseguir visites`, html: `Si apagues els anuncis i els contactes desapareixen, el teu negoci lloga la seva visibilitat. El SEO construeix un canal propi que redueix aquesta dependència. T'expliquem quan convé cada canal a <a href="/ca/blog/que-necesita-una-pime-seo-o-sem/">què necessita una pime, SEO o SEM</a>.` },
      ]}
    />
    <PLines
      title="Visites mensuals segons el canal"
      series={[
        { label: 'Només publicitat', points: [10, 48, 50, 49, 51, 50, 49, 8, 6, 5, 5, 5], color: '#a1a1aa' },
        { label: 'Posicionament SEO', points: [8, 10, 14, 19, 25, 31, 38, 44, 50, 56, 61, 66] },
      ]}
      xLabels={['Mes 1', '', '', 'Mes 4', '', '', '', 'Mes 8', '', '', '', 'Mes 12']}
      marker={{ at: 7, label: 'Es pausa la inversió en anuncis' }}
      caption="Esquema il·lustratiu, no són dades d'un client. La publicitat dona visites immediates que s'aturen quan deixes de pagar; el SEO triga més a arrencar i s'acumula."
    />
  </PSection>

  <!-- ═══ MOMENT DE LA PIME ════════════════════════════════════════════ -->
  <PSection kicker="Punt de partida" title="Una estratègia SEO adaptada al moment de la teva pime">
    <Fragment slot="intro">
      <p>No és el mateix una web que no ha treballat mai el SEO que una que ha perdut la meitat del trànsit després d'una actualització de Google. L'ordre de les prioritats canvia segons el moment de la teva empresa.</p>
    </Fragment>
    <PCards
      variant="numbered"
      items={[
        { title: `Empreses que comencen a treballar el seu posicionament`, html: `Primer, que Google pugui rastrejar i indexar bé la web. Després, una pàgina sòlida per a cada servei principal i el <a href="#seo-local">Perfil d'Empresa</a> complet. Són les millores que abans es noten.` },
        { title: `Negocis amb el trànsit estancat`, html: `Revisem quines pàgines tenen potencial i no acaben de pujar, quines cerques es reparteixen entre diverses URL i quins continguts de la competència responen millor. Sol haver-hi marge sense crear res des de zero.` },
        { title: `Webs que han perdut visibilitat`, html: `Creuem les dates de caiguda amb actualitzacions de Google, canvis a la web i migracions. Fins que no sabem la causa no toquem res, perquè una correcció equivocada pot agreujar la pèrdua.` },
        { title: `Pimes que volen obrir nous mercats`, html: `Noves ciutats, nous serveis o un segon idioma. Planifiquem l'arquitectura abans de publicar perquè cada mercat tingui les seves pàgines pròpies i no competeixin entre si.` },
        { title: `Empreses que necessiten canviar d'agència SEO`, html: `Fem una revisió independent de la feina anterior, recuperem els accessos que faltin i mantenim el que funciona. El canvi no ha de suposar començar de zero.` },
      ]}
    />
  </PSection>

  <!-- ═══ AUDITORIA ══════════════════════════════════════════════════════ -->
  <PSection id="auditoria" kicker="Auditoria SEO" title="L'auditoria que ordena les teves prioritats" tone="soft" layout="split">
    <Fragment slot="intro">
      <p>Abans de proposar res, auditem. L'auditoria mesura la teva visibilitat real, revisa la salut tècnica de la web i la compara amb els teus competidors directes. <strong>No lliurem un llistat de cent errors automàtics</strong>, sinó un diagnòstic que entén qualsevol gerent, amb les tasques ordenades pel que aporten i el que costen.</p>
      <p>Si ja treballes amb una altra agència, també serveix com a segona opinió independent sobre la teva inversió actual.</p>
    </Fragment>
    <PMatrix
      slot="aside"
      xLabel="Esforç"
      yLabel="Impacte"
      quadrants={['Fer primer', 'Planificar', 'Si sobra temps', 'Descartar']}
      points={[
        { label: 'Desbloquejar la indexació', x: 14, y: 86 },
        { label: 'Títols de servei', x: 30, y: 70 },
        { label: 'Nova arquitectura', x: 78, y: 82 },
        { label: 'Pàgines per zona', x: 64, y: 62 },
        { label: 'Retocs menors', x: 26, y: 24 },
      ]}
      caption="Exemple de com prioritzem les tasques d'una auditoria segons impacte i esforç."
    />
    <PCards
      variant="rows"
      tone="soft"
      items={[
        { title: `Rastreig i indexació de les pàgines rellevants`, html: `Comprovem quines pàgines veu Google, quines indexa i quines queden fora, amb dades de Search Console i un rastreig complet de la web.` },
        { title: `Arquitectura i distribució de l'autoritat interna`, html: `Analitzem a quants clics de la portada són les teves pàgines de negoci i quants enllaços interns reben. Les pàgines que més venen han de ser les més fàcils de trobar.` },
        { title: `Rendiment de continguts i paraules clau`, html: `Quines pàgines atrauen trànsit, quines posicionen a prop del top 10 sense entrar-hi i quines competeixen entre si per la mateixa cerca.` },
        { title: `Comparativa de visibilitat amb els teus competidors`, html: `Mesurem la teva visibilitat davant de tres competidors directes i detectem les cerques que ells capten i tu no.` },
        { title: `Pla d'acció segons impacte i esforç`, html: `Acabem amb un pla ordenat i una videotrucada per repassar-lo. Sabràs què fer la primera setmana i què no mereix la inversió.` },
      ]}
    />
  </PSection>

  <!-- ═══ CERQUES ══════════════════════════════════════════════════════ -->
  <PSection kicker="Recerca de paraules clau" title="Trobem les cerques que acosten clients al teu negoci">
    <Fragment slot="intro">
      <p>No perseguim les paraules amb més volum, sinó les que fa algú que és a prop de contractar. Una cerca amb 50 consultes al mes i una intenció de compra clara pot aportar més clients que una altra amb 5.000 visites curioses.</p>
    </Fragment>
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start">
      <PCards
        cols={2}
        variant="check"
        class="lg:grid-cols-1 !mt-12"
        items={[
          { title: `Paraules clau amb intenció de contractació`, html: `Cerques amb servei, ubicació, preu o comparativa. Són les que abans es converteixen en trucades i pressupostos.` },
          { title: `Consultes que intervenen en la decisió de compra`, html: `Dubtes sobre terminis, costos o alternatives que el client resol abans de demanar pressupost. Respondre'ls et posa a la seva llista.` },
          { title: `Oportunitats que la teva competència encara no cobreix`, html: `Cerques amb demanda real en què ningú del teu sector té una pàgina específica. Solen ser les victòries més ràpides.` },
          { title: `Assignació de cerques a cada pàgina`, html: `Cada cerca important té una única pàgina responsable. Així evitem que dues URL de la teva web es treguin posicions entre si.` },
        ]}
      />
      <div class="mt-12 space-y-10">
        <PFunnel
          stages={[
            { label: 'Informativa', sub: '«com saber si la meva web està ben feta»', side: 'Atrau visites i confiança.' },
            { label: 'Comparativa', sub: '«agència SEO o consultor freelance»', side: 'Et col·loca a la llista curta.' },
            { label: 'Contractació', sub: '«agència SEO per a pimes a Barcelona»', side: 'Genera contactes.' },
          ]}
          caption="Les tres intencions que cobrim, de la més àmplia a la més propera a la compra."
        />
        <PTree
          root="Web d'una empresa de reformes"
          branches={[
            { label: 'Reformes integrals', leaves: ['reformes integrals Sabadell', 'preu reforma pis'] },
            { label: 'Reforma de banys', leaves: ['reforma bany complet', 'canviar banyera per plat de dutxa'] },
          ]}
          caption="Cada grup de cerques té la seva pròpia pàgina."
        />
      </div>
    </div>
  </PSection>

  <!-- ═══ BASE TÈCNICA ═══════════════════════════════════════════════════ -->
  <PSection kicker="SEO tècnic" title="Una base tècnica que permet créixer" tone="soft" layout="split">
    <Fragment slot="intro">
      <p>El contingut i els enllaços només rendeixen si la web és tècnicament sòlida. És la part menys visible del SEO i la que més es nota quan falla.</p>
    </Fragment>
    <PStack
      slot="aside"
      layers={[
        { label: 'Clients des de Google', sub: 'contactes i vendes' },
        { label: 'Autoritat', sub: 'enllaços i mencions' },
        { label: 'Contingut', sub: 'pàgines que responen' },
        { label: 'Rendiment', sub: 'velocitat i experiència' },
        { label: 'Rastreig i indexació', sub: 'Google troba i entén' },
      ]}
      caption="Cada capa es recolza en l'anterior."
    />
    <PCards
      tone="soft"
      items={[
        { icon: ICON.search, title: `Control d'indexació i contingut duplicat`, html: `Canòniques, etiquetes noindex, paràmetres d'URL i sitemaps coherents, perquè Google dediqui el seu temps a les pàgines que importen.` },
