---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildAlternates } from '../../lib/i18n';
import { localAgencySchema } from '../../lib/schema';
import { strapiClient } from '../../lib/strapi';
import LogoMarquee from '../../components/sections/LogoMarquee.astro';
import FaqHome from '../../components/sections/FaqHome.astro';
import GoogleReviews from '../../components/global/GoogleReviews.astro';
import SectorLinks from '../../components/sections/SectorLinks.astro';
import SiblingServices from '../../components/sections/SiblingServices.astro';
import WhereWeWork from '../../components/sections/WhereWeWork.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://novamarketing.es';
const alternates = buildAlternates('/agencia-dentistas/meta-ads/', '/agencia-dentistes/meta-ads/', SITE_URL);

let allCases: any[] = [];
try {
  // Casos de éxito: primero los etiquetados con la categoría de este sector;
  // si el sector no tiene ninguno, se muestran todos los casos.
  const casesRes = await strapiClient.getCaseStudies('es');
  const cases = casesRes.data.map((i: any) => i.attributes ?? i);
  const SECTOR_CATEGORY_SLUGS = ["dentistas","dentistes"];
  const bySector = cases.filter((c: any) => {
    const cats = (c.categories || []).map((cat: any) => (cat.slug || cat.attributes?.slug || '').toLowerCase().replace(/[^a-z0-9]/g, ''));
    return cats.some((s: string) => SECTOR_CATEGORY_SLUGS.includes(s));
  });
  allCases = bySector.length > 0 ? bySector : cases;
} catch {}

