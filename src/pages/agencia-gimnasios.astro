---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildAlternates } from '../lib/i18n';
import { localAgencySchema } from '../lib/schema';
import { strapiClient } from '../lib/strapi';
import LogoMarquee from '../components/sections/LogoMarquee.astro';
import FaqHome from '../components/sections/FaqHome.astro';
import CityPills from '../components/global/CityPills.astro';
import GoogleReviews from '../components/global/GoogleReviews.astro';
import SectorLinks from '../components/sections/SectorLinks.astro';
import WhereWeWork from '../components/sections/WhereWeWork.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://novamarketing.es';
const alternates = buildAlternates('/agencia-gimnasios/', '/agencia-gimnasos/', SITE_URL);

let allCases: any[] = [];
try {
  // Casos de éxito: primero los etiquetados con la categoría de este sector;
  // si el sector no tiene ninguno, se muestran todos los casos.
  const casesRes = await strapiClient.getCaseStudies('es');
  const cases = casesRes.data.map((i: any) => i.attributes ?? i);
  const SECTOR_CATEGORY_SLUGS = ["gimnasios","gimnasos"];
  const bySector = cases.filter((c: any) => {
    const cats = (c.categories || []).map((cat: any) => (cat.slug || cat.attributes?.slug || '').toLowerCase().replace(/[^a-z0-9]/g, ''));
    return cats.some((s: string) => SECTOR_CATEGORY_SLUGS.includes(s));
  });
  allCases = bySector.length > 0 ? bySector : cases;
} catch {}

const heroChecks = [
  "Sin permanencias",
  "Trato directo con el consultor",
  "Resultados medidos en altas"
];

const services = [
  {
    "href": "/agencia-gimnasios/seo/",
    "t": "SEO para Gimnasios",
    "d": "Contenido y ficha de Google optimizada para que aparezcas cuando alguien busca gimnasios en tu zona."
  },
  {
    "href": "/agencia-gimnasios/google-ads/",
    "t": "Google Ads para Gimnasios",
    "d": "Campañas de búsqueda que ponen tu gimnasio delante de quien ya te está buscando, pagando solo por altas reales."
  },
  {
    "href": "/agencia-gimnasios/meta-ads/",
    "t": "Meta Ads para Gimnasios",
    "d": "Campañas en Instagram y Facebook que generan confianza antes de dar el primer paso, sin sonar a anuncio genérico."
  },
  {
    "href": "/agencia-gimnasios/email-marketing/",
    "t": "Email Marketing para Gimnasios",
    "d": "Automatizaciones y campañas que mantienen el vínculo con tus altas y aprovechan tu lista de contactos."
  },
  {
    "href": "/agencia-gimnasios/diseno-web/",
    "t": "Diseño Web para Gimnasios",
    "d": "Una web rápida y que transmite confianza desde el primer segundo, pensada para convertir la visita en altas."
  },
  {
    "href": "/agencia-gimnasios/posicionamiento-geo/",
    "t": "GEO y Visibilidad en IA para Gimnasios",
    "d": "Cuando alguien pregunta a ChatGPT qué opción elegir, trabajamos tus señales para que la IA recomiende tu gimnasio."
  }
];

const steps = [
  {
    "title": "Diagnóstico de Estacionalidad y Altas",
    "desc": "Analizamos tu web, tu ficha de Google y tu competencia directa. Detectamos dónde se pierden los altas que ya te buscan y dónde está la oportunidad que tu competencia ya explota."
  },
  {
    "title": "Estrategia de Picos y Ofertas",
    "desc": "Recibes un plan por escrito. Qué canales activar, qué presupuesto necesita cada uno y qué resultado es razonable esperar en 3, 6 y 12 meses."
  },
  {
    "title": "Ejecución Multicanal para Altas",
    "desc": "SEO local para captar la búsqueda, Ads para escalar altas, email para no perder el vínculo y una web pensada para convertir la visita. Cada canal con su función."
  },
  {
    "title": "Medición de Altas y Coste por Alta",
    "desc": "Medimos altas de verdad, no likes ni impresiones. En el informe mensual ves cuánto has invertido y cuántos altas ha generado cada canal."
  },
  {
    "title": "Optimización de la Retención",
    "desc": "Revisamos cada semana campañas y conversión, cortamos lo que no rinde y reinvertimos en lo que funciona."
  }
];

const auditCards = [
  {
    "bg": "bg-purple-100",
    "color": "text-purple-600",
    "icon": "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z",
    "t": "Análisis completo de tu gimnasio",
    "d": "Velocidad, confianza y facilidad de contacto revisadas con datos reales. Dónde y por qué se pierden altas."
  },
  {
    "bg": "bg-green-100",
    "color": "text-green-600",
    "icon": "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6",
    "t": "Plan de acción priorizado por altas",
    "d": "No una lista infinita de tareas, sino un plan ordenado por impacto y esfuerzo. Sabrás qué arreglar la primera semana."
  },
  {
    "bg": "bg-purple-100",
    "color": "text-purple-600",
    "icon": "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    "t": "Enfoque en altas, no en tráfico",
    "d": "Cada recomendación se traduce a altas. Qué canal escalar y qué campaña cortar porque genera clics sin generar resultado."
  },
  {
    "bg": "bg-amber-100",
    "color": "text-amber-600",
    "icon": "M9 12h6m-6 4h6M9 8h2m8-3v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2h6l4 4z",
    "t": "Auditoría de tus campañas de captación",
    "d": "Revisamos tus cuentas de Google y Meta campaña a campaña. Qué parte de tu inversión trae resultados y qué parte se pierde en clics que nunca contactan."
  },
  {
    "bg": "bg-blue-100",
    "color": "text-blue-600",
    "icon": "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm8 0V5a2 2 0 012-2h0a2 2 0 012 2v14a2 2 0 01-2 2h0a2 2 0 01-2-2zm-8 0a2 2 0 002 2h2a2 2 0 002-2V9a2 2 0 00-2-2h-2a2 2 0 00-2 2v10z",
    "t": "Comparativa con otros negocios de gimnasios",
    "d": "Comparamos tu presencia con tus tres competidores directos más cercanos. Qué visibilidad y qué canales trabajan que tú aún no."
  }
];

const comparison = [
  {
    "c": "Quién será tu contacto",
    "o": "Gestor junior con 20-30 cuentas",
    "n": "Sergio Galo's"
  },
  {
    "c": "Estacionalidad",
    "o": "Misma inversión todo el año",
    "n": "Presupuesto ajustado a los picos de enero y septiembre"
  },
  {
    "c": "Qué se mide",
    "o": "Clics e impresiones",
    "n": "Altas nuevas y coste por alta"
  },
  {
    "c": "Retención",
    "o": "Solo capta, no fideliza",
    "n": "Estrategia de email y contenido para retener socios"
  },
  {
    "c": "Permanencia",
    "o": "6-12 meses habituales",
    "n": "Mes a mes, sin permanencia"
  },
  {
    "c": "Visibilidad en IA (GEO)",
    "o": "Solo canales tradicionales",
    "n": "SEO + GEO integrados con método propio"
  },
  {
    "c": "Transparencia de precios",
    "o": "Presupuestos opacos con extras sorpresa",
    "n": "Precio cerrado por escrito antes de empezar"
  }
];

const criteria = [
  {
    "title": "Pide casos verificables de centros deportivos",
    "desc": "Un muro de logos no demuestra nada. Pide casos con datos concretos: cuántas altas, con qué inversión y en cuánto tiempo. Si no pueden enseñarte ni uno, sigue buscando."
  },
  {
    "title": "Pregunta quién llevará tu cuenta",
    "desc": "Exige conocer a la persona que trabajará tu proyecto antes de firmar. En nova hablas siempre con el consultor que ejecuta tu estrategia."
  },
  {
    "title": "Exige propiedad de tus activos",
    "desc": "Tu web, tu dominio y tus cuentas publicitarias deben estar a tu nombre. Lo contrario es una dependencia, no un servicio."
  },
  {
    "title": "Comprueba que planifican la estacionalidad",
    "desc": "Un gimnasio no vende igual en enero que en julio. Una agencia que no ajusta el presupuesto al calendario deportivo desperdicia tu dinero medio año."
  },
  {
    "title": "Revisa qué mide el informe mensual",
    "desc": "El informe debe hablar de altas nuevas y coste por alta, no solo de alcance o impresiones. Todo lo demás es decoración."
  },
  {
    "title": "Huye de las permanencias largas",
    "desc": "Una permanencia de 12 meses protege a la agencia, no a ti. Por eso en nova trabajamos mes a mes."
  },
  {
    "title": "Que piense también en retención",
    "desc": "Captar sin retener es llenar un cubo agujereado. Una buena estrategia también trabaja que el socio nuevo siga viniendo en marzo."
  }
];

const faqs = [
  {
    "question": "¿Cuánto cuesta una agencia de marketing para gimnasios?",
    "answer": "Depende de los canales que actives. Los planes mensuales parten de 400 euros al mes para centros que arrancan con uno o dos canales. Antes de empezar recibes un presupuesto cerrado por escrito."
  },
  {
    "question": "¿Qué incluye el servicio de marketing para gimnasios?",
    "answer": "Incluye un diagnóstico inicial, una estrategia documentada y la ejecución mensual de cada canal activado. SEO local, Google Ads, Meta Ads, email marketing, diseño web y visibilidad en la IA, con presupuesto ajustado a tu estacionalidad."
  },
  {
    "question": "¿Quién llevará mi cuenta?",
    "answer": "Siempre la misma persona, el consultor fundador. Nada de gestores junior que cambian cada trimestre."
  },
  {
    "question": "¿Trabajáis la campaña de enero y septiembre?",
    "answer": "Sí, son los dos picos que más altas generan y ajustamos el presupuesto para aprovecharlos, sin descuidar el resto del año."
  },
  {
    "question": "¿Cuánto tardaré en ver resultados?",
    "answer": "Las campañas de pago pueden generar altas la primera semana, y el SEO local consolida resultados entre el tercer y el sexto mes."
  },
  {
    "question": "¿Trabajáis con permanencia?",
    "answer": "No, trabajamos mes a mes. Nuestra permanencia real es el resultado que ves en tus altas cada mes."
  }
];

const pageSchema = localAgencySchema({
  pageUrl: `${SITE_URL}/agencia-gimnasios/`,
  lang: 'es',
  cityName: 'Barcelona',
  postalCode: '08035',
  geo: { lat: 41.4114, lng: 2.1526 },
  areaServed: ["España", "Barcelona", "Sabadell", "Sant Cugat del Vallès", "Terrassa", "Vallès Occidental"],
  title: "▷ Marketing para gimnasios | Estrategias y resultados medibles",
  description: "Especialistas en marketing para gimnasios con servicios en SEO, Google Ads, Meta Ads y diseño web ✅ estrategias que captan altas y fidelizan socios",
  datePublished: '2026-08-17',
  dateModified: '2026-08-17',
  streetAddress: 'Carrer del General Mendoza, 10',
  hasMap: 'https://maps.app.goo.gl/9fbB12UcK32bgjj89',
  aggregateRating: { ratingValue: '5.0', reviewCount: '12' },
  breadcrumbName: "Agencia para Gimnasios",
  faqs,
});
---

<BaseLayout
  title="▷ Marketing para gimnasios | Estrategias y resultados medibles"
  description="Especialistas en marketing para gimnasios con servicios en SEO, Google Ads, Meta Ads y diseño web ✅ estrategias que captan altas y fidelizan socios"
  locale="es"
  alternates={alternates}
  schemas={[pageSchema]}
>

    <!-- ═══ HERO / H1 ═══════════════════════════════════════════════════════ -->
    <section class="pt-24 sm:pt-40 pb-20 px-4 sm:px-6 relative overflow-hidden text-center bg-white border-b border-black/5">
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_40%,#000_75%,transparent_100%)]"></div>
        <div class="absolute -top-10 left-1/4 w-72 h-72 bg-accent/15 rounded-full blur-3xl opacity-30 animate-pulse"></div>
        <div class="absolute top-20 right-1/4 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl opacity-20"></div>

        <div class="max-w-5xl mx-auto reveal">
            <span class="inline-flex items-center gap-2 bg-accent/5 backdrop-blur-sm px-4 py-2 border border-accent/10 rounded-full text-accent text-[8px] sm:text-[10px] font-black uppercase tracking-[0.3em] mb-8 shadow-sm">
                <span class="w-1.5 h-1.5 bg-accent rounded-full animate-ping"></span>
                Marketing para Gimnasios y Centros Deportivos
            </span>
            <h1 class="text-3xl sm:text-5xl md:text-7xl lg:text-8xl uppercase font-extrabold tracking-tighter leading-[0.88] mb-8 text-gradient flex flex-col items-center text-center">
                <span class="lg:whitespace-nowrap">Agencia de marketing digital </span>
                <span class="lg:whitespace-nowrap text-mktg-gradient">para Gimnasios</span>
            </h1>
            <p class="text-lg sm:text-xl text-zinc-500 font-light leading-relaxed w-[75%] mx-auto mb-8">
                Tu gimnasio puede captar altas nuevas cada mes, no solo en enero. Marketing digital para gimnasios con campañas geolocalizadas, ofertas de prueba y resultados que se miden en altas, no en likes.
            </p>
            <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 mb-10">
                {heroChecks.map(item => (
                    <span class="inline-flex items-center gap-2 text-[11px] sm:text-xs font-black uppercase tracking-widest text-zinc-700">
                        <svg class="w-4 h-4 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                        </svg>
                        {item}
                    </span>
                ))}
            </div>
            <div class="flex justify-center mt-4">
                <a href="#contacto" class="contact-modal-trigger btn-mktg-v5 shadow-[0_10px_30px_rgba(0,0,0,0.1)] !py-4 sm:!py-5 !px-6 sm:!px-10 !text-[11px] !tracking-widest font-black">
                    HABLEMOS DE TU GIMNASIO
                </a>
            </div>
        </div>
    </section>

    <LogoMarquee />

    <!-- ═══ INTRO ═══════════════════════════════════════════════════════ -->
    <section class="py-16 sm:py-24 bg-white px-4 sm:px-6 border-b border-black/5">
        <div class="max-w-6xl mx-auto reveal grid md:grid-cols-[1.3fr_1fr] gap-10 md:gap-16 items-center">
            <div>
                <p class="text-[10px] sm:text-xs font-black uppercase tracking-[0.3em] text-accent mb-4">¿Por qué una agencia para gimnasios?</p>
                <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tighter uppercase mb-8 text-zinc-900 leading-[0.9]">
                    La agencia de marketing para tu gimnasio
                </h2>
                <div class="space-y-6 text-zinc-600 font-light text-base sm:text-lg leading-relaxed">
                    <p>
                        Captar una alta no es solo cuestión de precio, es cuestión de estar delante en el momento exacto en que alguien decide apuntarse: la primera semana de enero, la vuelta de vacaciones en septiembre o cuando pasa por delante de tu puerta buscando gimnasio cerca. Si tu ficha de Google y tus campañas no están listas para esos picos, la competencia se lleva la alta.
                    </p>
                    <p>
                        Nova es una <strong class="font-semibold text-zinc-900">agencia de marketing especializada en gimnasios y centros deportivos</strong>. Sabemos cuándo escalar la inversión, qué oferta de prueba convierte mejor y cómo hacer que una alta se quede más de dos meses. <strong class="font-semibold text-zinc-900">Altas nuevas y retención, no solo tráfico a tu web</strong>.
                    </p>
                </div>
            </div>
            <div class="hidden md:block">
                <img src="/sergio-galos-agencia-gimnasios.webp" alt="Sergio Galo's, consultor de marketing para gimnasios" title="Sergio Galo's, consultor de marketing para gimnasios" class="w-full h-auto" loading="lazy" width="473" height="591" />
            </div>
        </div>
    </section>

    <!-- ═══ SERVICIOS ══════════════════════════════════════════════════ -->
    <section class="py-20 sm:py-32 bg-zinc-50 border-b border-black/5 px-4 sm:px-6">
        <div class="max-w-7xl mx-auto text-center reveal">
            <span class="text-[10px] sm:text-xs font-black uppercase tracking-[0.3em] text-accent mb-4 block">Qué hacemos</span>
            <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tighter uppercase mb-6 text-zinc-900 leading-[0.9]">
                Servicios de Marketing Online para Gimnasios
            </h2>
            <div class="text-zinc-500 font-light text-sm sm:text-base leading-relaxed max-w-3xl mx-auto mb-16 space-y-4">
                <p>
                    Tu gimnasio que crece no depende de un solo canal, depende de un <strong class="font-semibold text-zinc-700">sistema donde cada canal hace su trabajo</strong>. Estas son las seis piezas que combinamos según lo que necesite tu gimnasio.
                </p>
                <p>
                    No pagas por un paquete cerrado de acciones, pagas por las que tu negocio necesita.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 text-left">
                {services.map(s => (
                    <div class="service-card p-8 bg-white rounded-2xl border border-zinc-100/80 shadow-sm hover:shadow-2xl hover:-translate-y-2 hover:border-accent/10 transition-all duration-500 relative overflow-hidden flex flex-col justify-between">
                        <h3 class="text-xl font-black uppercase tracking-tighter mb-4 text-zinc-900">
                            <a href={s.href} class="hover:text-accent transition-colors">{s.t}</a>
                        </h3>
                        <p class="text-sm text-zinc-500 font-light leading-relaxed mb-4">{s.d}</p>
                        <a href={s.href} class="text-[11px] font-black tracking-widest text-accent hover:underline">SABER MÁS →</a>
                    </div>
                ))}
            </div>

            <div class="mt-12 text-center reveal">
                <a href="#contacto" class="contact-modal-trigger btn-mktg-v5 shadow-[0_10px_30px_rgba(37,211,102,0.3)] !py-4 sm:!py-5 !px-6 sm:!px-10 !text-[11px] !tracking-widest font-black">
                    HABLEMOS DE TU GIMNASIO
                </a>
            </div>
        </div>
    </section>

    <!-- ═══ ESTRATEGIA ════════════════════════════════════════ -->
    <section class="py-20 sm:py-32 bg-white px-4 sm:px-6 relative overflow-hidden">
        <div class="max-w-5xl mx-auto">
            <div class="text-center mb-16 sm:mb-24 reveal">
                <span class="text-[10px] sm:text-xs font-black uppercase tracking-[0.3em] text-accent mb-4 block">Cómo trabajamos</span>
                <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tighter uppercase mb-6 text-zinc-900 leading-[0.9]">
                    Estrategias de marketing digital para gimnasios
                </h2>
                <p class="text-zinc-500 font-light text-sm sm:text-base leading-relaxed max-w-2xl mx-auto">
                    Una metodología documentada para que tu negocio crezca cada mes, paso a paso y sin humo.
                </p>
            </div>

            <div id="timeline-container" class="relative">
                <div class="hidden md:block absolute left-1/2 top-4 bottom-4 w-px bg-zinc-200 -translate-x-1/2"></div>
                <div id="progress-bar" class="hidden md:block absolute left-1/2 top-4 w-px bg-accent -translate-x-1/2 transition-all duration-100"></div>

                <div class="space-y-16 md:space-y-24 flex flex-col items-center">
                    {steps.map((step, index) => (
                        <div class="flex flex-col md:flex-row items-center gap-6 md:gap-12 w-full relative reveal">
                            <div class:list={["flex-1 w-full", index % 2 === 0 ? "md:order-1 md:text-right" : "md:order-3 md:text-left"]}>
                                <div class="p-8 sm:p-10 bg-zinc-50 border border-black/5 rounded-3xl hover:border-accent/10 hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 relative overflow-hidden group">
                                    <h3 class="text-xl font-black uppercase tracking-tighter mb-2 text-zinc-900">{index + 1}. {step.title}</h3>
                                    <div class:list={["h-0.5 bg-accent w-full mb-4 opacity-80", index % 2 === 0 ? "md:ml-auto" : ""]}></div>
                                    <p class:list={["text-sm text-zinc-500 font-light max-w-md", index % 2 === 0 ? "md:ml-auto" : ""]}>{step.desc}</p>
                                    <div class="absolute -bottom-6 -right-5 text-8xl font-black text-black/[0.02] select-none z-0 group-hover:scale-105 transition-transform duration-500">0{index+1}</div>
                                </div>
                            </div>
                            <div class="md:order-2 w-12 h-12 rounded-full border-2 border-zinc-200 bg-white flex items-center justify-center font-black text-lg z-10 shrink-0 shadow-sm node-circle transition-all">
                                0{index + 1}
                            </div>
                            <div class:list={["hidden md:block md:flex-1", index % 2 === 0 ? "md:order-3" : "md:order-1"]}></div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <!-- ═══ AUDITORÍA ═════════════════════════════════════════ -->
    <section class="py-20 sm:py-32 bg-zinc-50/50 px-4 sm:px-6 border-t border-black/5 overflow-hidden">
        <div class="max-w-7xl mx-auto grid lg:grid-cols-[6fr_4fr] gap-12 lg:gap-16 items-start">

            <div class="reveal lg:col-span-2">
                <span class="text-[10px] sm:text-xs font-black uppercase tracking-[0.3em] text-accent mb-4 block">Punto de partida</span>
                <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tighter uppercase text-zinc-900 leading-[0.9]">
                    Auditoría de marketing digital para tu gimnasio
                </h2>
            </div>

            <div class="reveal">
                <div class="space-y-5 text-zinc-600 font-light text-base leading-relaxed mb-8">
                    <p>
                        ¿Sabes cuánta gente busca gimnasio en tu zona cada mes? ¿Cuántas de tus visitas a la web acaban en una alta? Casi ningún centro lo sabe con datos, y ahí empieza todo.
                    </p>
                    <p>
                        Nuestra <strong class="font-semibold text-zinc-900">auditoría de marketing para gimnasios</strong> revisa tu ficha de Google, tu web y tu competencia con una sola pregunta en mente. Dónde se pierden las altas que ya te están buscando. Y termina con un plan de acción priorizado por impacto.
